            && (cf == 0x80031BDCu || cf == 0x80031C58u || cf == 0x80031C2Cu
                || cf == 0x80031DA8u || cf == 0x80031F58u || cf == 0x80031FF8u
                || cf == 0x80031B3Cu || cf == 0x8004DEF8u)) {
            static int cg_n;
            if (cg_n < 64) {
                cg_n++;
                r861_out("[clobber-guard] stack-region store 0x%08X <- 0x%08X from fn 0x%08X (%s)\n",
                        a, v, cf,
                        (v >= 0x80010000u && v < 0x80060000u) ? "looks-like-ra" : "data/tag");
            }
            /* R187.1: LOG-ONLY. The first R187 guard BLOCKED these stores and
             * the sandbox showed them to be legitimate register saves at the
             * top of the game's stack (the game sets SP=0x80200000 itself —
             * fn_80019548 symbol). Blocking broke real frames. The tripwire
             * now records the FULL store sequence at the stack frontier so
             * the Mac digest shows the exact writer/value when the ra slot
             * (restored later as 0x80200000) gets its poison — then the fix
             * is a one-liner at the named source. */
        }
    }
    /* R1258 (Jos c115 direction, ownership test): the sub-arena band store
     * catcher. Prints the SAVED core entry args (src/dst/expanded header) and
     * INRANGE - whether the store target lies inside the authorized
     * [dst, dst+expanded) range. INRANGE=1: this memory was allocated to the
     * decompress - payload, NOT protected metadata (drop that theory for
     * this address). INRANGE=0: wild write - trace the upstream producer. */
    if (a >= 0x80077440u && a < 0x80077470u) {
        uint32_t cfr = xenolift_ring_n > 0 ? xenolift_ring[(xenolift_ring_n - 1u) % 64u] : 0u;
        if (cfr == 0x80032EB4u || cfr == 0x80032E88u || cfr == 0x80019BE4u) {
            static int r1258_lz;
            if (r1258_lz < 12) {
                r1258_lz++;
                uint32_t dst_ = xenolift_r1258_lz_r5, ext_ = xenolift_r1258_lz_ep0;
                int inr = (dst_ != 0u && a >= dst_ && a < dst_ + ext_);
                int own_ = -1;
                for (int q = 0; q < 16; q++) {
                    uint32_t hb = xenolift_r1259_hand_blk[q];
                    if (hb != 0u && a >= hb && a < hb + xenolift_r1259_hand_want[q] + 8u) { own_ = q; break; }
                }
                r861_out("[lzarena] R1258 w32 store 0x%08X <- 0x%08X writer=%08X SAVED src=%08X dst=%08X ext=%08X range[%08X,%08X) INRANGE=%d HANDOWNER=%d epoch=%u live_r16=%08X sp=%08X\n",
                        a, v, cfr, xenolift_r1258_lz_r4, dst_, ext_, dst_, dst_ + ext_, inr, own_,
                        xenolift_r1258_lz_epoch, r[16], r[29]);
            }
        }
    }
    /* R81 poison hunt: the irq-chain walk faulted at 0x8F5A0014 — an
     * entry's +12 field holds 0x8F5A0008 (NOT a file-data constant: the
     * word exists in SLUS at 0x3BD20 as the instruction `lw a0, 8(s6)`).
     * Any store of this exact value names the writer. */
    if (a >= 0x80000080u && a < 0x800000C0u) {
        static int ex_n;
        if (ex_n < 20)
            r861_out("[exch] install 0x%08X <- %08X (fn 0x%08X)\n", a, v,
                    xenolift_ring_n > 0 ? xenolift_ring[(xenolift_ring_n - 1u) % 64u] : 0);
        ex_n++;
    }
    /* R1102 (b8-c276): STAGE-2 HEADER WRITE CAMERA. c276 R1097 (now live
     * after the c275 bound fix) caught fn 0x8004B54C (Vsync) writing
     * code-word values (02A21021, 3C01801F) into the stage-2 module header
     * cells 0x801D3008/0x801D3010 WHILE THEY HELD ZERO - the f15 header
     * that should read 00000005 80072878 80072898 800728D8 (R705 fldreloc2
     * receipt). Open question this camera settles: is the write PRE-expansion
     * (harmless bootstrap into empty space) or POST-expansion (corruption of
     * a live header = the install-corruption writer)? Receipts time, sp, and
     * the four header words AT WRITE TIME - expansion signature 00000005 at
     * +0x801D3000 = live header; zeros = wiped/pre-era. */
    if (a == 0x801D3008u || a == 0x801D3010u) {
        static int r1102_n;
        if (r1102_n < 12) { r1102_n++;
            r861_out("[hdrw] R1102 store %08X <- %08X at fn %08X t=%lds ring_n=%d | hdr words @write: %08X %08X %08X %08X (live f15 header = 00000005 80072878 80072898 800728D8; zeros = wiped/pre-expansion)\n",
                    a, v,
                    xenolift_ring_n > 0 ? xenolift_ring[(xenolift_ring_n - 1u) % 64u] : 0,
                    (long)(xl_wall() - g_boot_wall_t0), (int)xenolift_ring_n,
                    xenolift_mem_read32(0x801D3000u), xenolift_mem_read32(0x801D3004u),
                    xenolift_mem_read32(0x801D3008u), xenolift_mem_read32(0x801D300Cu));
        }
    }
    if (v == 0x8F5A0008u) {
        uint32_t cf = xenolift_ring_n > 0 ? xenolift_ring[(xenolift_ring_n - 1u) % 64u] : 0;
        r861_out("[poison] store 0x%08X <- 8F5A0008 at fn 0x%08X\n", a, cf);
    }
    uint32_t off = xenolift_phys(a);
    if (off >= XENOLIFT_RAM_SIZE) {
        io_log(io_phys(off), 1, v);
        if (io_phys(off) == 0x1F801070) {
            /* I_STAT: writing 1s ACKNOWLEDGES (clears) those interrupts */
            uint32_t cur;
            memcpy(&cur, xenolift_mem + off, 4);
            cur &= ~v;
            memcpy(xenolift_mem + off, &cur, 4);
            return;
        }
        if (io_special_write(io_phys(off), v)) {
            return;
        }
    }
    { uint32_t r1215_old = 0xDEAD0001u; if (r1215_trcam_pre(off, 4u, &r1215_old)) r1215_trcam_post(a, off, 4u, v, r1215_old, g_r1197_t_active); }
    { uint32_t r1197_old = 0xDEAD0001u; int r1197_hit = r1197_tblw_pre(off, 4u, &r1197_old);
    memcpy(xenolift_mem + off, &v, 4);
    if (r1197_hit) r1197_tblw_post(a, off, 4u, v, r1197_old, g_r1197_t_active); }
}
void xenolift_mem_write32(uint32_t a, uint32_t v)
{
    /* R1204 (c9 receipts) [cbcell] camera: the poll-dispatcher crash chain
     * (cur_fn 80041C64/80041BA8/80041C68, addr=0xFFFFFFFF r4=0xFFFFFFFF,
     * deref via [0x800564AC] behind a beq-zero guard that cannot catch -1)
     * needs its writer named. R1128 already treats 564AC/564A8/56770 as
     * libcd cells (restored across restarts only when 0 or < 0x02000000).
     * This camera receipts EVERY write32 to those three cells with the
     * R1198 attribution tuple (line/width/sw_active/cur_fn) so the -1's
     * origin is named: guest macro vs runtime/unknown vs R1128-restore.
     * Camera only, no behavior change (c354 discipline). */
    /* R1248 (c105): the spin posture is a HALF-STAMPED completion -
     * the receipted completion posture zeroes FE1C, FDF8 AND FE04, but the
     * fetch-spin ends with FE1C=0, FE04=0 and FDF8=2048 SURVIVING (the
     * fetch's own per-sector arm). No finisher zeroed FDF8, so the game's
     * release gate never released, no next request was staged, and the
     * legacy fetch polls the data FIFO forever. Watchpoint the three
     * completion cells: every write with old->new + cur_fn names the armer
     * of the surviving 2048 and the absent zeroer. Cap 120 then sparse. */
    if (a == 0x8004FDF8u || a == 0x8004FE04u || a == 0x8004FE1Cu) {
        static uint32_t r1248_n;
        r1248_n++;
        if (r1248_n <= 1000u || (r1248_n & 65535u) == 0u) {
            r861_out("[finstamp] R1248 #%u ea=%08X %u -> %u cur_fn=%08X w=%u act=%d sched=%d\n",
                    r1248_n, a, xenolift_mem_read32(a), v,
                    (unsigned)xenolift_cur_fn, xenolift_sw_width,
                    cd_read_active, cd_scheduled);
        }
    }
    if (a == 0x800564ACu || a == 0x800564A8u || a == 0x80056770u) {
        static uint32_t r1204_n;
        r1204_n++;
        if (r1204_n <= 48u || (r1204_n & 65535u) == 0u) {
            r861_out("[cbcell] R1204 #%u ea=%08X %08X -> %08X | line=%u w=%u sw_active=%d cur_fn=%08X\n",
                    r1204_n, a, xenolift_mem_read32(a), v,
                    xenolift_sw_line, xenolift_sw_width, xenolift_sw_active,
                    (unsigned)xenolift_cur_fn);
        }
    }
    uint32_t sv_l = g_r1197_t_line, sv_w = g_r1197_t_width; int sv_a = g_r1197_t_active;
    g_r1197_t_line = xenolift_sw_line; g_r1197_t_width = xenolift_sw_width; g_r1197_t_active = xenolift_sw_active;
    xenolift_sw_active = 0; /* clear BEFORE any helper or callback can inherit it */
    xenolift_mem_write32_inner(a, v);
    /* R1240 (Jos c83 final width gap): the heap initializer family writes
     * freelist metadata with WORD stores; w8/w16/bulk/CD cameras cannot
     * see a w32, and the emitted code calls the heap family DIRECTLY (no
     * dispatch = entry cameras blind). CONFIRMED post-inner print with the
     * landed value re-read, physical band + head cells, cap receipt once.
     * Camera only, no behavior change. */
    { uint32_t pa = a & 0x1FFFFFFFu;
      if ((pa >= 0x77400u && pa < 0x78000u) || pa == 0x59320u || pa == 0x59324u) {
        static int bn32;
        if (bn32 < 128) { bn32++;
            r861_out("[bandhist] R1240 w32 CONFIRMED ea=0x%08X v=%08X landed=%08X fn=0x%08X\n", a, v, *(uint32_t *)(xenolift_mem + pa), xenolift_cur_fn);
        } else if (bn32 == 128) { bn32++;
            r861_out("[bandhist] R1240 w32 camera CAP (128) reached - further band word writes not logged\n"); }
      } }
    g_r1197_t_line = sv_l; g_r1197_t_width = sv_w; g_r1197_t_active = sv_a;
    xenolift_sw_active = sv_a; /* restore incoming metadata on EVERY exit (Jos c495) */
}


static void xenolift_mem_write16_inner(uint32_t a, uint32_t v)
{
    /* R1218 (c44): NARROW-BLAST CAMERA - the bypass-width district writes.
     * c44 receipts: coordinator slot zeroed mid-era (coordw old EBE10222 ->
     * 00000000 543DAE66...; coordw is a POLLING camera - the fn name is the
     * era, not the writer) AND ftab file#14 entry bytes at 0x80010104+
     * blanked (fldx2 GATE-DECLINED LBA=0 - the retarget reads the entry
     * DIRECTLY at the hardcoded address, so the BYTES were zeroed). Word
     * guards (R1083 slot whitelist, R517 mangle) sit on the width-4 path
     * only; BIOS copy gates (0x28/0x2A/0x2B) and SB/SH stores route through
     * write8/write16 - a byte blast erases the districts one innocent byte
     * at a time. Camera at both districts, both narrow widths, print-only,
     * shared cap 24 (receipt = writer named at WRITE time with cur_fn live). */
    if ((a >= 0x80077E88u && a < 0x80077E98u)
        || (a >= 0x80010100u && a < 0x80010180u)) {
        static uint32_t r1218_n;
        if (r1218_n < 24u) {
            r1218_n++;
            r861_out("[narrowblast] R1218 w2 ea=%08X old=%04X new=%04X cur_fn=%08X r31=%08X macro=%d @t=%lds\n",
                    a, ((unsigned)xenolift_mem[a - 0x80000000u]) | ((unsigned)xenolift_mem[a - 0x80000000u + 1u] << 8), (unsigned)v,
                    (unsigned)xenolift_cur_fn, (unsigned)r[31],
                    g_r1197_t_active,
                    (long)(xl_wall() - g_boot_wall_t0));
        }
    }
    /* R743: sh stores write the scratchpad too (c318: entry's sp copies are
     * halfword stores - the 32-bit-only watch missed them entirely). */
    if (a >= 0x1F800000u && a < 0x1F801000u) {
        if (spw_total < 0x7FFFFFFF) spw_total++;
        if (spw_total <= 16) {
            r861_out("[spstub] R743 scratchpad sh %08X <- %04X at fn %08X\n",
                    a, v & 0xFFFFu, (unsigned)xenolift_cur_fn);
        }
    }

    /* R1085 (b8-c254): SLOT-SHIELD 16-bit path. c254 verdict: the R1083/R1084
     * 32-bit shield ran with ZERO drop receipts while coordw still receipts
     * the taint values at the coordinator slot - the garbage lands in 16-bit
     * halves (EBE1/0222, 543D/AE66 per c252-c254 coordw receipts), the same
     * halfword-write class the R518 mangleguard documented for the 0x03
     * family. Whitelist = the legitimate slot halfwords (R682 build-time
     * prologue + R1005 expansion words, receipted shapes). Drop + receipt. */
    if (a >= 0x80077E88u && a < 0x80077E98u
        && v != 0x8E02u && v != 0x0050u && v != 0x3C04u && v != 0x800Au
        && v != 0x2484u && v != 0xA3F0u && v != 0x0002u && v != 0x1303u
        && v != 0x27BDu && v != 0xFFC8u && v != 0x3C03u && v != 0x8001u
        && v != 0x8C63u && v != 0x0000u && v != 0x2402u && v != 0xFFFFu) {
        static uint32_t mgs16_last; static int mgs16_n; static uint32_t mgs16_tot;
        if ((a != mgs16_last || mgs16_n < 2) && mgs16_tot < 12u) {
            mgs16_tot++;
            r861_out("[mangleguard] R1085 slot mangle hw a=%08X val=%04X dropped (r31=%08X) — 16-bit taint class, translated prologue preserved\n",
                    (unsigned)a, (unsigned)(v & 0xFFFFu), (unsigned)r[31]);
            mgs16_last = a; mgs16_n++;
        }
        return;
    }
    /* R518 mangleguard (16-bit path): c85 proof — =MANGLE= silent while FE1C
     * still received 0304FE0C at fn 800317E0 => the mangled pointer pairs are
     * stored as HALFWORDS; the R517 write32 guard never sees them. High half
     * of the family = v in [0x0300,0x0400) landing on a word-aligned +2 slot.
     * The full value is never a usable pointer in this address space. Drop +
     * receipt + continue (R487/R488 bus-error semantics). */
    if (a >= 0x80010000u && a < 0x80200000u && (a & 3u) == 2u
        && v >= 0x0300u && v < 0x0400u) {
        static uint32_t mg16_last; static int mg16_n; static uint32_t mg16_tot;
        if ((a != mg16_last || mg16_n < 4) && mg16_tot < 24u) {
            mg16_tot++;
            r861_out("[mangleguard] R518 hw mangle a=%08X val=%04X dropped (r31=%08X) — chain preserved\n",
                    (unsigned)a, (unsigned)(v & 0xFFFFu), (unsigned)r[31]);
            mg16_last = a; mg16_n++;
        }
        return;
    }

    /* R488: garbage-family WRITE drop (16-bit path) — c54 proof: the SH
     * header store in fn_80039044+320 (0xA106BDD0 = 0x8006BE00 - 0xDF000030)
     * faulted here; R487's drop only covered write32. Real HW eats the bus
     * error; we drop + receipt + continue. */
    if ((a >= 0x80200000u) || (a < 0x80000000u && a > 0x00100000u
          && !(a >= 0x1F800000u && a <= 0x1FAF0000u)) || (a >= 0xBFC10000u)) {
        static uint32_t dw16_last; static int dw16_n; static uint32_t dw16_tot;
        if ((a != dw16_last || dw16_n < 4) && dw16_tot < 24u) {
            dw16_tot++;
            r861_out("[wdrop] garbage write16 0x%08X val=%08X dropped (r31=%08X) — continuing\n",
                    (unsigned)a, (unsigned)v, (unsigned)r[31]);
            dw16_last = a; dw16_n++;
        }
        return;
    }
    if (a >= 0x801EF558u && a < 0x801EF660u) { /* R437 frclash */
        static int s_frc16_n;
        long f6_el = (g_boot_wall_t0 ? (long)(xl_wall() - g_boot_wall_t0) : 0);
        if (f6_el >= 5 && s_frc16_n < 12)
            r861_out("[frclash] W16 0x%08X val=%08X @t=%lds r31=%08X\n",
                    (unsigned)a, (unsigned)v, f6_el, (unsigned)r[31]);
        s_frc16_n++;
    }
    /* R433 ctxb16 */
    if (a >= 0x80059394u && a <= 0x80069397u) {
        static int s_ctxb16_n;
        long c6_el = (g_boot_wall_t0 ? (long)(xl_wall() - g_boot_wall_t0) : 0);
        if (s_ctxb16_n < 8)
            r861_out("[ctxb] write16 0x%08X val=%08X @t=%lds r31=%08X r16=%08X\n",
                    (unsigned)a, (unsigned)v, c6_el, (unsigned)r[31], (unsigned)r[16]);
        s_ctxb16_n++;
    }
    /* R192 lzss-guard: block writes past the RAM ceiling while the
     * decompressor is armed — the final-partial-group overrun dies
     * here instead of halting the machine. */
    if (lzss_armed && a >= 0x80200000u) {
        if (lzss_over_n < 8) {
            r861_out("[lzss-guard] suppressed write to 0x%08X (val 0x%08X)\n", a, v);
        }
        lzss_over_n++;
        g_lzss_overrun_reads++; /* R926: fuel for the translated loop's clean abort */
        lzss_last_a = a;
        /* R1161: adaptive print backoff - first 100 lines every 4096
         * ops (a real overrun still reads clearly), then 1-per-million
         * (c346: 32K lines at 131M ops = 95MB log, park wedged again -
         * same class as the c343 fault-storm flood). Recovery check
         * below runs at the same reduced cadence; threshold margin is
         * one extra million ops worst case. */
        if (((lzss_over_n & 0xFFF) == 0 && lzss_over_n < 409600u) ||
            (lzss_over_n % 1048576u) == 0u) {
            r861_out("[lzss-runaway] %d ops suppressed, write frontier 0x%08X inpast=%d cur_fn=%08X aborts=%u\n", lzss_over_n, lzss_last_a, lzss_inpast_n, xenolift_cur_fn, g_lzss_abort_fired);
        }
        return;
    }
    uint32_t off = xenolift_phys(a);
    if (off >= XENOLIFT_RAM_SIZE) {
        io_log(io_phys(off), 1, v);
        /* 16-bit GP1 writes: zero-extended to a full command word */
        if (io_special_write(io_phys(off), (uint32_t)(v & 0xFFFFu))) {
            return;
        }
    }
    uint16_t h = (uint16_t)v;
    { uint32_t r1215_old = 0xDEAD0001u; if (r1215_trcam_pre(off, 2u, &r1215_old)) r1215_trcam_post(a, off, 2u, v, r1215_old, g_r1197_t_active); }
    { uint32_t r1197_old = 0xDEAD0001u; int r1197_hit = r1197_tblw_pre(off, 2u, &r1197_old);
    memcpy(xenolift_mem + off, &h, 2);
    if (r1197_hit) r1197_tblw_post(a, off, 2u, v, r1197_old, g_r1197_t_active); }
}
void xenolift_mem_write16(uint32_t a, uint32_t v)
{
    uint32_t sv_l = g_r1197_t_line, sv_w = g_r1197_t_width; int sv_a = g_r1197_t_active;
    g_r1197_t_line = xenolift_sw_line; g_r1197_t_width = xenolift_sw_width; g_r1197_t_active = xenolift_sw_active;
    xenolift_sw_active = 0;
    xenolift_mem_write16_inner(a, v);
    /* R1239 (Jos c83): CONFIRMED mutations only - R1238 printed BEFORE inner
     * (attempts); print AFTER, re-reading what actually landed. Physical band
     * via a & 0x1FFFFFFF (KSEG0/KSEG1/mirror), freelist heads included, cap
     * receipt printed once at exhaustion. */
    { uint32_t pa = a & 0x1FFFFFFFu;
      if ((pa >= 0x77400u && pa < 0x78000u) || pa == 0x59320u || pa == 0x59324u) {
        static int bn16;
        if (bn16 < 48) { bn16++;
            uint16_t rv; memcpy(&rv, xenolift_mem + pa, 2);
            r861_out("[bandhist] R1239 w16 CONFIRMED ea=0x%08X v=%04X landed=%04X fn=0x%08X\n", a, v & 0xFFFFu, rv, xenolift_cur_fn);
        } else if (bn16 == 48) { bn16++;
            r861_out("[bandhist] R1239 w16 camera CAP (48) reached - further band halfword writes not logged\n"); } } }
    g_r1197_t_line = sv_l; g_r1197_t_width = sv_w; g_r1197_t_active = sv_a;
    xenolift_sw_active = sv_a;
}


/* R658: transition-era flag — set when the f15 field request is stamped. */
uint32_t g_statshield_era = 0;

/* R660 [phase-bulk]: c230 — the f15 request stamped, the game streamed 8
 * sectors natively, then the boot concluded @14s BEFORE the alarm-side R651
 * bulk (1s cadence + settle) could fire — death state FDF8=75796, exactly
 * the posture the bulk completes. Anti-race doctrine, 3rd application: the
 * bulk also fires from the dispatcher-family entry hook (main thread), so
 * the install completes in the same breath as the read that needs it. */
static uint32_t xenolift_f15_bulk(const char *tag)
{
    /* R663: family-wide + in-flight-only (never fire at the full-remaining
     * posture — the native FILE-CB walk must run its bookkeeping first, its
     * finalize chain is what advances the game's own request queue). */
    static const uint32_t r663_sz[19] = {
        0u,0u,0u,0u,0u,0u,0u,0u,0u,0u,0u,0u,0u,0u,0u,92180u,166564u,70944u,14360u
    };
    uint32_t f15c = xenolift_mem_read32(0x80059F0Cu);
    uint32_t f15r = xenolift_mem_read32(0x8004FDF8u);
    if (f15c < 15u || f15c > 18u || f15r == 0u) return 0u;
    if (f15r >= r663_sz[f15c]) return 0u;   /* full posture = walk not started, wait */
    uint32_t lba = xenolift_mem_read32(0x8004FE04u);
    uint32_t dst = xenolift_mem_read32(0x8004FE08u);
    uint32_t rem = f15r;
    int nsec = 0;
    while (rem > 0u && nsec < 64) {
        unsigned char sbuf[2048];
        if (disc_read_lba(lba, sbuf) != 0) break;
        uint32_t chunk = (rem < 2048u) ? rem : 2048u;
        for (uint32_t i = 0u; i + 4u <= chunk; i += 4u) {
            uint32_t w;
            memcpy(&w, sbuf + i, sizeof(w));
            xenolift_mem_write32(dst + i, w);
        }
        lba += 1u; dst += 0x800u;
        rem = (rem > 2048u) ? (rem - 2048u) : 0u;
        nsec++;
    }
    xenolift_mem_write32(0x8004FE04u, lba);
    xenolift_mem_write32(0x8004FE08u, dst);
    xenolift_mem_write32(0x8004FDF8u, rem);
    if (rem == 0u) {
        xenolift_mem_write32(0x8004FDFCu, 0u);
        xenolift_mem_write32(0x8004FE1Cu, 6u);
    }
    r861_out("[mtrans] R660 f15 bulk (%s): %d sectors LBA %u..%u, FDF8 %u -> %u%s\n",
            tag, nsec, lba - (uint32_t)nsec, (lba > 0u ? lba - 1u : 0u), f15r, rem,
            rem == 0u ? " DONE posture set" : " (partial)");
    return 1u;
}
static void xenolift_mem_write8_inner(uint32_t a, uint32_t v)
{
