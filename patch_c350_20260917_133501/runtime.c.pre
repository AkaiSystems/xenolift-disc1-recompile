                        r[5] = 0x8005A210u;
                        r861_out("[cd] wl: slot-1 — dispatching 0x%08X (a0=%u)\n", tgt, r[4]);
                        g_guest_depth++, xenolift_dispatch(tgt), g_guest_depth--;
                    }
