       * path; the write32-only catcher missed it. LZSS-family byte stores
       * into the sub-arena band: print SAVED core args + the ALLOCATION
       * ownership check (header-range membership alone proves nothing). */
      if (pa >= 0x77440u && pa < 0x77470u) {
          uint32_t cfr8 = xenolift_ring_n > 0 ? xenolift_ring[(xenolift_ring_n - 1u) % 64u] : 0u;
