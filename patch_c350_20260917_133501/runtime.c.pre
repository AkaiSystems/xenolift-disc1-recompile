                    bn = backtrace(bt, 28);
                    r861_out("[wedge] R1199 alarm-interrupted pc=%llx n=%u anchor=%u host_base=%p (the PC the LAST alarm interrupted + WHICH thread it interrupted; distinguishes handler execution from the interrupted code; symbolize pc-host_base offset vs xenogears_boot)\n",
                            (unsigned long long)g_r1199_intr_pc, (unsigned)g_r1199_intr_n, (unsigned)g_r1199_on_anchor,
                            (void*)(uintptr_t)&g_r1195_r32_hits);
