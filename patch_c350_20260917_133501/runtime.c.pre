        g_park_stage = 6; /* R365: native backtrace */
        void *bt[32];
        int n = backtrace(bt, 32);
        char **syms = backtrace_symbols(bt, n);
        r861_out("[xenolift] call stack at watchdog:\n");
        for (int i = 0; i < n; i++) r861_out("  %s\n", syms ? syms[i] : "?");
        free(syms);
    }
    g_exit_why = "watchdog-alarm";
    exit(0);
}

/* ---- CD-ROM disc image: a real ISO9660 file system ----
 * The kernel just called FileOpen — it wants files from the disc.
 * ISO9660 keeps a Primary Volume Descriptor at fixed sector 16, with
 * the root directory record chained from it; every file is then just
 * an LBA (sector number) plus a byte length. Raw .bin rips wrap each
 * 2048-byte data sector in a 2352-byte frame (sync + header before
 * the data), plain .iso images store bare 2048-byte sectors.
 * Paths on PS1 use backslashes: "XENOGEARS\FONT\TITLE.FNT" */

#include <stdlib.h>
static int g_mod6_live = 0; /* R253: set at MovieModuleEntry 0x800737EC */
static int g_movie_live = 0; /* R254: set when the movie PLAYER chain actually starts */

/* R262: g_disc hoisted above */
/* R262: g_sec_bytes declared above; initialised at disc open */
static uint32_t g_sec_off = 0u;       /* user data offset in frame */

typedef struct {
    uint32_t lba;   /* first sector of the file */
    uint32_t size;  /* file length in bytes */
    uint32_t pos;   /* current read position */
    int in_use;
} DiscFile;

static DiscFile g_files[16];

/* R1033 ARCHIVE-TABLE REPLICA SEED (b8-c186, ATLAS lane):
 * c183-c186 receipts closed every upstream door of the archive system:
 * ArchiveReadFileFromCdSector never called, ArchiveInit (0x80028230)
 * never entered, and NO code in the exe or any overlay capture
 * references it (no jal, no lui+imm pair, no literal) - the retail
 * kernel's init path is not in our captures, so g_ArchiveTable
 * (cell 0x8004FDF0) is never set. c186 seekcam receipts: the seek
 * cells are only ever CLEARED (no CdIntToPos write ever happens,
 * FE04=0 in every line) and the ArchiveDecodeSize-family fault reads
 * the unset table (crash trail 0x80028774: lw a0, FDF0 + entry-byte
 * loads). Static decode of the exe @0x80028330-0x8002835C gives
 * ArchiveInit's EXACT cell-store chain:
 *   0x8002833C sw s1, FDF0  (g_ArchiveTable = a0)
 *   0x80028344 sw s2, FDF4  (g_ArchiveHeader = a1)
 *   0x8002834C sw r0, FE14  (g_CurArchiveOffset = 0)
 *   0x80028354 sw r0, FDFC
 *   0x8002835C sw r0, FDF8
 * and decomp libarchive.c:57-59 gives the CD fills this init performs:
 *   ArchiveReadFileFromCdSector(0x18, pArchiveTable, 0x10*2048, 0, 0)
 *   ArchiveReadFileFromCdSector(0x28, pArchiveHeader, 0x7A, 0, 0)
 * This heal is a faithful replica (same class as R900 bank seed /
 * R1014 sound-heap re-seed): read the real disc sectors via the
 * runtime's own disc_read_lba into the guest RAM gap 0x80090000-
 * 0x80098080 (between the module window end 0x80090000 and the
 * module staging buffer 0x8009BD40), guarded by an EMPTINESS CHECK -
 * if any word is nonzero the seed SKIPS with a receipt (no
 * corrupting placement guess). Then perform the five decoded stores.
 * Source references: decomp libarchive.c ArchiveInit (lines 11-60),
 * static decode @0x80028330. */
/* R1117 (b8-c296): HEAL REGISTRY. Jos's prevention question (c295/296):
 * heals create new walls when their preconditions rot silently (R1033
 * = the proof: a c186 placement guess became the three-day archive
 * churn). The registry declares every standing heal's TRIGGER, CELLS,
 * PRECONDITION, CLASS and RETIRE condition; it receipts once per
 * process at first full handoff so every cycle's digest names what is
 * armed. WARDEN audits this table at era changes; LEDGER reconciles it
 * with LESSONS. Classes: GUARDED = reads the cell first, stands down
 * when healthy (R1116 rule); DEFENSIVE = acts only on provably invalid
 * state (taint/zero checks, no placement guess); GUESS = placement or
 * value guessed without a retail-proven counterpart - RETIRE or
 * source-prove these first. */
static void r1117_healreg_dump(void)
{
    static int done;
    if (done) return;
    done = 1;
    r861_out("[healreg] R1117 registry (12 standing families):\n");
    r861_out("[healreg] R1033/R1116 arcseed trig=first-handoff cells=4FDF0..4FDF8 prec=cells-zero cls=GUARDED(c296 SKIP receipted) retire=era2-ArchiveInit\n");
    r861_out("[healreg] R1082 coordheal trig=0x80077E88-door-r16invalid cells=r16->800AF990 prec=r16-invalid cls=GUESS(source-prove-or-retire) retire=decomp-FieldInit-decode\n");
    r861_out("[healreg] R1024 door-a1 trig=0x80077E88-door-a1garbage cells=a1->800B0704 prec=a1-out-of-contract cls=GUESS(source-prove-or-retire) retire=decomp-ovlcb-decode\n");
    r861_out("[healreg] R1016 coordarg trig=out-of-RAM-a0 cells=a0->0 prec=a0-out-of-RAM cls=DEFENSIVE retire=era2-taint-audit\n");
    r861_out("[healreg] R1100 archbase trig=cell-4FDF0-read-zero cells=4FDF0->80010004 prec=cell-zero cls=DEFENSIVE retire=era2-ArchiveInit\n");
    r861_out("[healreg] R1014 sndheal trig=post-restore-wipe cells=59410/5941C->seed prec=head-zero cls=DEFENSIVE retire=era2-restore\n");
    r861_out("[healreg] R900 bankheal trig=allocator-door-head-null cells=800B3260/64->801FBFF8 prec=head-zero cls=DEFENSIVE retire=era2-alloc\n");
    r861_out("[healreg] R933 cdcb trig=cd-callback-slot-invalid cells=callback-slot prec=slot-garbage cls=DEFENSIVE retire=era2-libcd\n");
    r861_out("[healreg] R935 freelist trig=heap-head-invalid cells=heap-head prec=head-invalid cls=DEFENSIVE retire=era2-alloc\n");
    r861_out("[healreg] R1062 archheal trig=field-table-empty cells=0x80090000-8KB prec=region-empty cls=GUESS(post-R703-suspect-audit) retire=decomp-fieldFAT\n");
    r861_out("[healreg] R1088+R1091 coordfamily trig=coordinator-adjacent cells=coord-cells prec=invalid-value cls=GUESS(source-prove-or-retire) retire=decomp-coord\n");
    r861_out("[healreg] R746+R758+R684 walkchain trig=walk/dispatch-era cells=walk-cells prec=invalid-state cls=GUESS(era1-legacy-audit) retire=era2-walk\n");
}

static void r1033_archive_seed(void)
{
    static int done;
    if (done) return;
    done = 1;
    /* R1116 (b8-c295): STAND DOWN WHEN THE CELL IS HEALTHY. c295 receipts
     * closed the three-day archive churn root: [hook] 0x8004FDF0
     * 80010004 -> 80090000 with cur_fn=Vsync; sw_line+sp receipts
     * falsified the guest-writer and stack-collision hypotheses, and the
     * runtime source decode found THIS seed as the writer. The R1033
     * replica overwrites start's healthy install (0x80010004, the exe's
     * baked table - [ftab] healthy decodes every cycle) with the
     * runtime-staged copy at 0x80090000, a region the field module
     * expansion (R703, spanning 0x8006FAF0..) later writes over - leaving
     * module bytes where the FAT should be (R1063 c226 ordering proof:
     * guest re-poisons [0x90000,0x92000) after the heal copy). The
     * replica now stands down whenever the cell is already initialized;
     * it only serves the genuinely-uninitialized case. */
    {
        uint32_t r1116_cell;
        memcpy(&r1116_cell, &xenolift_mem[0x4FDF0u], 4u);
        if (r1116_cell != 0u) {
            r861_out("[arcseed] R1116 SKIP: g_ArchiveTable already healthy %08X (start's install) - replica stands down, no overwrite\n", r1116_cell);
            return;
        }
    }
    uint32_t tbl = 0x80090000u, hdr = 0x80098000u;
    int occupied = 0;
    for (uint32_t i = 0u; i < 0x8080u; i += 4u) {
        uint32_t w;
        memcpy(&w, &xenolift_mem[(tbl + i) & 0x1FFFFFFu], 4u);
        if (w != 0u) { occupied = 1; break; }
    }
    if (occupied) {
        r861_out("[arcseed] R1033 SKIP: candidate region %08X..%08X nonzero (occupied) - no seed\n", tbl, tbl + 0x8080u);
        return;
    }
    uint8_t sec[2048];
    for (uint32_t k = 0u; k < 16u; k++) {
        if (disc_read_lba(0x18u + k, sec) != 0) {
            r861_out("[arcseed] R1033 FAIL: disc_read_lba LBA=%u unreadable\n", 0x18u + k);
            return;
        }
        memcpy(&xenolift_mem[(tbl + k * 2048u) & 0x1FFFFFFu], sec, 2048u);
    }
    if (disc_read_lba(0x28u, sec) != 0) {
        r861_out("[arcseed] R1033 FAIL: disc_read_lba LBA=%u unreadable\n", 0x28u);
        return;
    }
    memcpy(&xenolift_mem[hdr & 0x1FFFFFFu], sec, 2048u);
    /* ArchiveInit's five stores, decoded @0x8002833C-0x8002835C */
    xenolift_mem_write32(0x8004FDF0u, tbl);   /* g_ArchiveTable = table buffer */
    xenolift_mem_write32(0x8004FDF4u, hdr);   /* g_ArchiveHeader = header buffer */
    xenolift_mem_write32(0x8004FE14u, 0u);    /* g_CurArchiveOffset = 0 */
    xenolift_mem_write32(0x8004FDFCu, 0u);
    xenolift_mem_write32(0x8004FDF8u, 0u);
    uint32_t b0, b1, b2;
    memcpy(&b0, &xenolift_mem[tbl & 0x1FFFFFFu], 4u);
    memcpy(&b1, &xenolift_mem[(tbl + 4u) & 0x1FFFFFFu], 4u);
    memcpy(&b2, &xenolift_mem[hdr & 0x1FFFFFFu], 4u);
    r861_out("[arcseed] R1033 ArchiveInit REPLICA SEEDED: tbl=%08X hdr=%08X (16 sectors @LBA 0x18 + hdr @LBA 0x28; stores decoded @0x8002833C) tbl[0]=%08X tbl[1]=%08X hdr[0]=%08X\n",
             tbl, hdr, b0, b1, b2);
    { /* R1034 decode aid: dump first 8 words of tbl + hdr (entry format:
         * bytes[0..2]=LBA, bytes[3..6]=size per decomp ArchiveDecodeSize) */
        uint32_t wd[8]; int wi;
        for (wi = 0; wi < 8; wi++) {
            memcpy(&wd[wi], &xenolift_mem[(tbl + wi * 4u) & 0x1FFFFFFu], 4u);
        }
        r861_out("[arcseed] R1034 tbl[0..7]: %08X %08X %08X %08X %08X %08X %08X %08X\n",
                 wd[0], wd[1], wd[2], wd[3], wd[4], wd[5], wd[6], wd[7]);
        for (wi = 0; wi < 8; wi++) {
            memcpy(&wd[wi], &xenolift_mem[(hdr + wi * 4u) & 0x1FFFFFFu], 4u);
        }
        r861_out("[arcseed] R1034 hdr[0..7]: %08X %08X %08X %08X %08X %08X %08X %08X\n",
                 wd[0], wd[1], wd[2], wd[3], wd[4], wd[5], wd[6], wd[7]);
    }
}

static int disc_read_lba(uint32_t lba, void *dst)
{
    if (g_disc == NULL) {
        return -1;
    }
    if (fseek(g_disc, (long)lba * (long)g_sec_bytes + (long)g_sec_off, SEEK_SET) != 0) {
        return -1;
    }
    int rr = fread(dst, 1, 2048, g_disc) == 2048 ? 0 : -1;
    /* R1239 (Jos c83): OVERLAP check - a 2048-byte sector starting BELOW
     * the band that reaches into it is a band write too; captured at the
     * destination AFTER the read lands. */
    if ((uint8_t *)dst + 2048u > xenolift_mem + 0x77400u && (uint8_t *)dst < xenolift_mem + 0x78000u) {
        r861_out("[bandhist] R1239 cd-delivery lba=%u dst_off=%ld overlaps heap band\n", lba, (long)((uint8_t *)dst - xenolift_mem));
        r1238_band_bulk("cd-delivery post-write");
    }
    return rr;
}

/* compare an ISO name (uppercase, may end in ";1") to a path component */
static int iso_name_eq(const char *iso, uint32_t iso_len, const char *want)
{
    if (iso_len >= 2 && iso[iso_len - 2] == ';') {
        iso_len -= 2; /* strip version suffix, e.g. "TITLE.FNT;1" */
    }
    uint32_t n = 0;
    while (want[n] != 0) {
        n++;
    }
    if (n != iso_len) {
        return 0;
    }
    for (uint32_t i = 0; i < iso_len; i++) {
        char a = iso[i];
        char b = want[i];
        if (a >= 'a' && a <= 'z') {
            a = (char)(a - 'a' + 'A');
        }
        if (b >= 'a' && b <= 'z') {
            b = (char)(b - 'a' + 'A');
        }
        if (a != b) {
            return 0;
        }
    }
    return 1;
}

/* find a file/dir record inside one directory buffer; returns record
 * extent LBA and size, or -1. dir==NULL means the root directory. */
static int iso_lookup(const uint8_t *dir, uint32_t dir_size,
                      const char *name, int want_dir,
                      uint32_t *out_lba, uint32_t *out_size)
{
    uint32_t p = 0;
    while (p + 33 <= dir_size) {
        uint32_t rec_len = dir[p];
        if (rec_len == 0) {
            p = (p + 2048) & ~(uint32_t)2047; /* skip to next sector */
            continue;
        }
        if (p + rec_len > dir_size) {
            break;
        }
        uint32_t name_len = dir[p + 32];
        uint32_t flags = dir[p + 25];
        if (name_len > 0 && iso_name_eq((const char *)&dir[p + 33], name_len, name)) {
            int is_dir = (flags & 0x02u) != 0;
            if (is_dir == want_dir || (want_dir == 0 && is_dir)) {
                /* a path component that names a directory works too */
                *out_lba = (uint32_t)dir[p + 2] |
                           ((uint32_t)dir[p + 3] << 8) |
                           ((uint32_t)dir[p + 4] << 16) |
                           ((uint32_t)dir[p + 5] << 24);
                *out_size = (uint32_t)dir[p + 10] |
                            ((uint32_t)dir[p + 11] << 8) |
                            ((uint32_t)dir[p + 12] << 16) |
                            ((uint32_t)dir[p + 13] << 24);
                return 0;
            }
        }
        p += rec_len;
    }
    return -1;
}

/* resolve a kernel path like "XENOGEARS\TITLE.FNT" against the disc */
/* R1347 (c317): the watcher-side SetLoc serve v2. The c316 receipts:
 * the serve FIRED at the tail (stale pending=3 + data_n=2060
 * discarded, 3-byte answer primed, INT1 armed - the tail model
 * state at last receipted: seek==FE04, NO seek mismatch; the
 * status-poll path is proven dead in the tail era, so the
 * watcher is the right site). BUT the discard SELF-CANNIBALIZED
 * on the next tick: the serve's own armed pending=3 matched the
 * discard's leftover terms and was cleared before conversion.
 * v2 adds the armed guard: r1346_armed set at serve, reset when
 * FE1C leaves 1; the discard skips the armed state. */
static void r1346_serve(void)
{
    static int r1346_armed;
    uint32_t fe1c_w = ((uint32_t)xenolift_mem[0x4FE1Cu]) | ((uint32_t)xenolift_mem[0x4FE1Du] << 8);
    uint32_t owed = xenolift_mem_read32(0x8004FDF8u);
    if (fe1c_w != 1u) {
        r1346_armed = 0;
        return;
    }
    if (!(cd_last_cmd == 0x02u && !cd_read_active && owed != 0u))
        return;
    if (!r1346_armed && (cd_pending != 0u || cd_data_n != 0u)) {
        static int r1346d_n;
        if (r1346d_n++ < 8u)
            r861_out("[stalecd] R1347 watcher-side stale discard: pending=%u data_n=%u resp_n=%u seek=%u FE04=%08X\n",
                    cd_pending, cd_data_n, cd_resp_n, cd_seek_lba,
                    xenolift_mem_read32(0x8004FE04u));
        cd_pending = 0u;
        cd_data_pos = 0u; cd_data_n = 0u; cd_data_loaded = 0u;
    }
    if (cd_resp_n < 3u && cd_pending == 0u) {
        static int r1346p_n;
        cd_resp[0] = 0x02u; cd_resp[1] = 0x01u; cd_resp[2] = 0x01u;
        cd_resp_n = 3u; cd_resp_pos = 0u;
        memcpy(cd_last_full, cd_resp, sizeof cd_resp);
        cd_last_full_n = 3u;
        cd_pending = 3u;
        r1346_armed = 1;
        if (r1346p_n++ < 8u)
            r861_out("[wserve] R1347 watcher-side SetLoc serve: 3-byte answer primed + INT1 armed (seek=%u FE04=%08X owes=%08X)\n",
                    cd_seek_lba, xenolift_mem_read32(0x8004FE04u), owed);
        /* R1349 (c322): the c319-c321 verdicts - the armed INT1 never
         * converts because the delivery recipe is incomplete: the
         * scheduled-delivery door's proven recipe is pending + the
         * KERNEL OP FLAG (0x800578A6) - the game's flag-check fns
         * (8004B894/8004293C, cycling every tail iteration) run the
         * collector only when the op flag is nonzero. The c319
         * out-of-context force ran the collector early and the evt
         * tick cleared the flag - retired (removed below). Set the
         * flag per the door's recipe; the pop handler clears it on
         * consumption. */
        { uint16_t one = 1;
          memcpy(xenolift_mem + (0x800578A6u & 0x1FFFFFFFu), &one, 2);
          { static int r1349_n; if (r1349_n++ < 8u)
            r861_out("[wopflag] R1349 kernel op flag SET post-arm: pend=%u resp=%u/%u fe1c=%u seek=%u - door recipe completed (collector runs at the next flag check)\n",
                    (unsigned)cd_pending, (unsigned)cd_resp_pos, (unsigned)cd_resp_n, xenolift_mem_read32(0x8004FE1Cu), cd_seek_lba); } }
        g_r1350_conv_refill = 1000u;
        { static int r1350_n; if (r1350_n++ < 8u)
            r861_out("[wconv] R1350 conversion-budget refill requested (1000) - the serve answer gets its conversion pass at the next tick\n"); }
        g_r1351_genuine_answer = 1u; /* R1351: a real ISO answer is primed - exempt the BIOS-style pair */
    }
}

static int iso_resolve(const char *path, uint32_t *out_lba, uint32_t *out_size)
{
    if (g_disc == NULL) {
        return -1;
    }
    uint8_t pvd[2048];
    if (disc_read_lba(16, pvd) != 0 || memcmp(pvd + 1, "CD001", 5) != 0) {
        r861_out("[disc] no ISO9660 volume found\n");
        return -1;
    }
    /* root directory record lives at PVD offset 156 */
    uint32_t lba = (uint32_t)pvd[156 + 2] |
                   ((uint32_t)pvd[156 + 3] << 8) |
                   ((uint32_t)pvd[156 + 4] << 16) |
                   ((uint32_t)pvd[156 + 5] << 24);
    uint32_t size = (uint32_t)pvd[156 + 10] |
                    ((uint32_t)pvd[156 + 11] << 8) |
                    ((uint32_t)pvd[156 + 12] << 16) |
                    ((uint32_t)pvd[156 + 13] << 24);

    char comp[128];
    const char *q = path;
    for (;;) {
        /* pull one path component, accepting \ or / separators */
        uint32_t n = 0;
        while (*q != 0 && *q != '\\' && *q != '/' && n + 1 < sizeof comp) {
            comp[n++] = *q++;
        }
        comp[n] = 0;
        int last = (*q == 0);
        if (*q == '\\' || *q == '/') {
            q++;
        }
        if (n == 0) {
            if (last) {
                break;
            }
            continue;
        }

        uint32_t next_lba, next_size;
        /* lba/size currently name the directory we are inside;
         * load it and look for the component within it */
        uint8_t *dirbuf = malloc(size ? size : 2048);
        if (dirbuf == NULL) {
            return -1;
        }
        int ok = 0;
        for (uint32_t done = 0; done < size; done += 2048) {
            if (disc_read_lba(lba + done / 2048, dirbuf + done) != 0) {
                break;
            }
            ok = 1;
        }
        if (!ok) {
            free(dirbuf);
            return -1;
        }
        int found = iso_lookup(dirbuf, size, comp, 0, &next_lba, &next_size);
        free(dirbuf);
        if (found != 0) {
            return -1;
        }
        lba = next_lba;
        size = next_size;
        if (last) {
            break;
        }
    }
    *out_lba = lba;
    *out_size = size;
    return 0;
}

int xenolift_disc_mount(const char *path)
{
    g_disc = fopen(path, "rb");
    if (g_disc == NULL) {
        return -1;
    }
    uint8_t hdr[16];
    if (fread(hdr, 1, 16, g_disc) != 16) {
        fclose(g_disc);
        g_disc = NULL;
        return -1;
    }
    static const uint8_t sync[12] =
        { 0x00, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0x00 };
    if (memcmp(hdr, sync, 12) == 0) {
        g_sec_bytes = 2352u;
        g_sec_off = (hdr[15] == 2) ? 0x18u : 0x10u; /* mode2 form1 : mode1 */
    } else {
        g_sec_bytes = 2048u;
        g_sec_off = 0u;
    }
    uint8_t pvd[2048];
    if (disc_read_lba(16, pvd) != 0 || memcmp(pvd + 1, "CD001", 5) != 0) {
        r861_out("[disc] %s: no ISO9660 volume (wrong file?)\n", path);
        fclose(g_disc);
        g_disc = NULL;
        return -1;
    }
    for (int i = 0; i < 16; i++) {
        g_files[i].in_use = 0;
    }
    r861_out("[disc] mounted %s (%u-byte sectors)\n", path, g_sec_bytes);
    return 0;
}

/* read from an open file into PS1 RAM; returns bytes read */
static int disc_file_read(int fd, uint32_t dst, uint32_t len)
{
    if (fd < 0 || fd >= 16 || !g_files[fd].in_use) {
        return -1;
    }
    DiscFile *f = &g_files[fd];
    uint32_t remain = f->size > f->pos ? f->size - f->pos : 0;
    if (len > remain) {
        len = remain;
    }
    uint32_t done = 0;
    uint8_t sec[2048];
    while (done < len) {
        uint32_t chunk = len - done;
        uint32_t in_off = (f->pos + done) & 2047u;
        uint32_t avail = 2048 - in_off;
        if (chunk > avail) {
            chunk = avail;
        }
        if (disc_read_lba(f->lba + (f->pos + done) / 2048, sec) != 0) {
            break;
        }
        for (uint32_t i = 0; i < chunk; i++) {
            xenolift_mem_write8(dst + done + i, sec[in_off + i]);
        }
        done += chunk;
    }
    return (int)done;
}

/* ---- BIOS HLE: the A0/B0/C0 call gates ----
 * PS1 programs call built-in services by loading the function number into
 * r9 and jumping to one of three magic addresses (0xA0/0xB0/0xC0); the
 * kernel also reaches the same services via the `syscall` instruction.
 * Names below are from the nocash PSXSPX kernel specification.
 * Convention: args in a0-a2 (r4-r6), return value in v0 (r2). */

    static const char *A_names[] = {
    "FileOpen", "FileSeek", "FileRead",
    "FileWrite", "FileClose", "FileIoctl",
    "exit", "FileGetDeviceFlag", "FileGetc",
    "FilePutc", "todigit", "atof",
    "strtoul", "strtol", "abs",
    "labs", "atoi", "atol",
    "atob", "SaveState", "RestoreState",
    "strcat", "strncat", "strcmp",
    "strncmp", "strcpy", "strncpy",
    "strlen", "index", "rindex",
    "strchr", "strrchr", "strpbrk",
    "strspn", "strcspn", "strtok",
    "strstr", "toupper", "tolower",
    "bcopy", "bzero", "bcmp",
    "memcpy", "memset", "memmove",
    "memcmp", "memchr", "rand",
    "srand", "qsort", "strtod",
    "malloc", "free", "lsearch",
    "bsearch", "calloc", "realloc",
    "InitHeap", "SystemErrorExit", "std_in_getchar",
