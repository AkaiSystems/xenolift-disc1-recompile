          memcpy(&lim, xenolift_mem + 0x595E4, 4);
          r861_out("[fl] limit cells: 0x800695BC=%08X 0x800695E4=%08X\n", evc, lim); }
        while (it++ < 24) {
            uint32_t w0, d8, n12;
            if (!(a >= 0x80000000u && a < 0x80200000u)) {
                r861_out("[fl]  #%d INVALID addr 0x%08X\n", it, a); break;
            }
            memcpy(&w0, xenolift_mem + (a - 0x80000000u), 4);
            memcpy(&d8, xenolift_mem + (a - 0x80000000u) + 8, 4);
            memcpy(&n12, xenolift_mem + (a - 0x80000000u) + 12, 4);
            r861_out("[fl]  #%d entry=0x%08X w0=%08X data=%08X next=%08X (size %d)\n",
                    it, a, w0, d8, n12, (int32_t)(n12 - d8));
            if (n12 == 0u) { r861_out("[fl]  terminator\n"); break; }
            if (n12 == first || n12 == a) {
                r861_out("[fl]  *** CYCLE: 0x%08X -> 0x%08X ***\n", a, n12); break;
            }
            a = n12;
        }
        if (it > 24) r861_out("[fl]  WALK LIMIT hit\n");
