                      uint32_t hb = xenolift_r1259_hand_blk[q];
                      if (hb != 0u && a >= hb && a < hb + xenolift_r1259_hand_want[q] + 8u) { own8 = q; break; }
                  }
                  r861_out("[lzarena8] R1259 w8 store 0x%08X <- 0x%02X writer=%08X SAVED src=%08X dst=%08X ext=%08X HANDOWNER=%d ep=%u\n",
                          a, v & 0xFFu, cfr8, xenolift_r1258_lz_r4, xenolift_r1258_lz_r5,
                          xenolift_r1258_lz_ep0, own8, xenolift_r1258_lz_epoch);
