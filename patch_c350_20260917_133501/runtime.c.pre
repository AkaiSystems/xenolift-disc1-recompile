                      for (uint32_t off = 0; off < 0x200000u - 16; off += 4) {
                        uint32_t w0,w1,w2,w3;
                        memcpy(&w0, xenolift_mem + off, 4);    if (w0 != p0) continue;
                        memcpy(&w1, xenolift_mem + off + 4, 4);  if (w1 != p1) continue;
                        memcpy(&w2, xenolift_mem + off + 8, 4);  if (w2 != p2) continue;
                        memcpy(&w3, xenolift_mem + off + 12, 4); if (w3 != p3) continue;
                        r861_out(" @%08X", 0x80000000u + off);
                      }
                      r861_out("\n[wildhdr3] R732 staged copy @801E1AEC (window-offset 0x83D8 equiv):");
                      for (uint32_t i = 0; i < 24; i++) { uint32_t w; memcpy(&w, xenolift_mem + 0x1E1AECu + i*4, 4); r861_out(" %08X", w); }
                      r861_out("\n");
                    }
                    r861_out("[wildhdr2] R731 archive status FE1C=%u FE20=%u - dispatch table @800288F4:", (unsigned)fe1c, (unsigned)fe20);
                    for (int k = 0; k < 16; k++) { uint32_t w; memcpy(&w, xenolift_mem + (0x800288F4u - 0x80000000u) + 4*k, 4);
                      r861_out(" [%d]=%08X", k, w); }
