                           * receipts print. FE48 has been 0 for the
                           * whole project - the one cell nobody ever
                           * set. (a) and (b) already hold; setting (c)
                           * completes the contract and the poll
                           * returns 0 -> the spin EXITS with our
                           * delivered sectors on board. */
                          xenolift_mem_write32(0x8005FE48u, 1u);
                          /* R893 (c488): the poll's success path ALSO
                           * requires FE1C(5F)==0 - the ARCHIVE-LAYER error
                           * cell 0x8005FE1C, which NO receipt ever printed
                           * (digest shows the 4F copy only). If nonzero,
                           * PollArchiveTransfer returns 1 (error) forever
                           * and WaitArchiveCdData's loop never exits.
                           * Zero it with the done flag - full success
                           * posture: FDFC=0 + FE48=1 + FE1C(5F)=0. */
                          xenolift_mem_write32(0x8005FE1Cu, 0u);
                          r861_out("[mvdoor] R892 ARCHIVE-TRANSFER-DONE SET (FE48(5F)=1) - PollArchiveTransfer contract complete (FDFC=0 + FE1C=0 + FE48!=0) - poll returns 0, spin exits with %u sectors delivered to %08X\n",
                                  r891_nsec, r891_dst);
                      } else {
                          r861_out("[mvdoor] R891 no valid dst (FE08=%08X) - event posture only; will re-fire while owed\n", r891_dst);
                      } }
                }
            }
            uint32_t f5_seek = cd_seek_lba;
            uint32_t fe1c = xenolift_mem_read32(0x8004FE1Cu);
            if (fe1c == 9u && f5_seek >= 108873u && f5_seek <= 108883u) {
                if (!r835_f5_fired) {
                    r835_f5_fired = 1;
                    uint32_t dst = xenolift_mem_read32(0x8004FE08u);
                    r861_out("[f5fix] R835 FILE#5 DOOR OPEN: seek=%u FE1C=9 FE08(dst)=%08X FDF8=%08X FE20=%08X F0C=%08X - delivering file#5 (LBA 108873, 21984B, 11 sectors)\n",
                            f5_seek, dst, xenolift_mem_read32(0x8004FDF8u),
                            xenolift_mem_read32(0x8004FE20u), xenolift_mem_read32(0x80059F0Cu));
                    if (dst >= 0x80010000u && dst < 0x801F0000u && (dst & 3u) == 0u) {
                        for (uint32_t i = 0; i < 11u; i++)
                            disc_read_lba(108873u + i, xenolift_mem + (dst - 0x80000000u) + i * 2048u);
                        r861_out("[f5fix] R835 file#5 delivered to %08X (%u bytes)\n", dst, 11u * 2048u);
                    } else {
                        r861_out("[f5fix] R835 no valid destination cell - completion posture only (kernel re-requests with destination set)\n");
                    }
                    { uint32_t z = 0;
                      memcpy(xenolift_mem + (0x8004FDF8u & 0x1FFFFFFFu), &z, 4);
                      memcpy(xenolift_mem + (0x8004FE1Cu & 0x1FFFFFFFu), &z, 4);
                      memcpy(xenolift_mem + (0x8004FE04u & 0x1FFFFFFFu), &z, 4); }
                    r861_out("[f5fix] R835 completion posture stamped (FDF8/FE1C/FE04 zeroed) - kernel wait releases, state walks past 9\n");
                }
            } else if (fe1c != 9u) {
                r835_f5_fired = 0; /* re-arm for the next door instance */
            }
        }
        /* R1205 (c8-c12 receipts) MOVIE-STREAM ARM - the 109166 band.
         * The movie stream has no file-table entry, so the R896 sdoor
         * (108884/108886 only) and every FDF8!=0 gate can never serve it.
         * Receipted posture (c8 cmd=09 parked, c10/c12 cmd=06 idle):
         * FE04==seek in [109166,109678), FE1C=0, FDF8=0, sched=0,
         * pend=0, arm1=0, batch FE08=0 (no ring dst armed - no direct
         * delivery possible), STARTER (0x8002A68C) registered as sync
         * cb in 564A8 (cbcell c11), movie-poll alive n=9.2M, module
         * countdown cells all 0. The drive CAN serve (c9 drain: sector
         * 109166 FIFO-loaded, header 24:17:41 verified). Act like the
         * drive: demand-load the sector into the FIFO + post the R879
         * announcement tuple (A22C+1, slotbits|6, flag 578A6=1). NO
         * FE04/FDF8 completion stamps - the stream continues; the game's
         * own handler/data-port streamer (sector consumed -> seek++ ->
         * INT1 pending) advances from here. Stickiness = 2 consecutive
         * watcher ticks (R887 fingerprint discipline: boot reads are
         * milliseconds, this idle posture persists for seconds). Fire
         * cap 24. */
        { static unsigned r1205_streak, r1205_fires;
          uint32_t r1205_cb = xenolift_mem_read32(0x800564A8u);
          unsigned r1205_match =
              (r1205_fires < 24u
              && cd_scheduled == 0u && cd_pending == 0u
              && cd_arm_int1_pending == 0u
              && (cd_last_cmd == 0x06u || cd_last_cmd == 0x09u)
              && cd_seek_lba >= 109166u && cd_seek_lba < 109678u
              && xenolift_mem_read32(0x8004FE04u) == cd_seek_lba
              && xenolift_mem_read32(0x8004FE1Cu) == 0u
              && xenolift_mem_read32(0x8004FDF8u) == 0u
              && xenolift_mem_read32(0x8006A22Cu) == 0u
              && r1205_cb >= 0x80010000u && r1205_cb < 0x80080000u);
          if (r1205_match) r1205_streak++;
          else r1205_streak = 0u;
          if (r1205_streak >= 2u) {
              if (!cd_data_loaded)
                  cd_data_load(); /* never announce data without it (R879) */
              xenolift_mem_write32(0x8006A22Cu,
                  xenolift_mem_read32(0x8006A22Cu) + 1u);
              uint32_t r1205_sb = xenolift_mem_read32(0x80056788u);
              xenolift_mem_write32(0x80056788u, r1205_sb | 6u);
              uint16_t r1205_one = 1;
              memcpy(xenolift_mem + (0x800578A6u & 0x1FFFFFFFu), &r1205_one, 2);
              r1205_fires++;
              r1205_streak = 0u;
              r861_out("[mvdoor] R1205 MOVIE-STREAM ARM: LBA %u sector FIFO-loaded + data event posted (A22C->%u slotbits %08X->%08X flag578A6=1 cb564A8=%08X) - game handler/streamer drains from here (fire %u/24)\n",
                      cd_seek_lba,
                      (unsigned)xenolift_mem_read32(0x8006A22Cu),
                      r1205_sb, r1205_sb | 6u, r1205_cb, r1205_fires);
              r1137_cb_restore("R1205 event post");
          }
        }
        /* R1206 (c14-c15 receipts) LATE OVERLAY CAPTURE - the healthy
         * 3586-function emit form requires a POPULATED overlay_region.bin
         * (the tool folds it and discovers the module's functions; the
         * 209-seam HLE contract lives there). The base capture fired only
         * at boot-main entry #2 - crash-restart-heavy runs re-entered AFTER
         * the install chain and captured populated windows, but c10's clean
         * run hit entry #2 pre-install and its zeros fed the c14 emit
         * (2562 functions, 2 seams). This site guarantees the file: once
         * per run, when the game reaches the movie era (seek >= 109000 -
         * the module is installed by then; c14's coordw receipts prove the
         * coordinator window populated even in the 2562-form run) and the
         * window holds >= 1000 nonzero words and the on-disk file is
         * missing or empty, write the 0x8006F000 window (same format as
         * the entry-#2 site, same R783 poison check). */
        { static int r1206_done;
          if (!r1206_done && cd_seek_lba >= 109000u) {
              uint32_t r1206_nz = 0;
              for (uint32_t w = 0; w < (0x21000u >> 2); w++)
                  if (xenolift_mem_read32(0x8006F000u + 4u*w) != 0u) r1206_nz++;
              long r1206_old = -1;
              FILE *r1206_fo = fopen("overlay_region.bin", "rb");
              if (r1206_fo) {
                  static uint32_t r1206_obuf[0x21000u >> 2];
                  size_t r1206_got = fread(r1206_obuf, 1, 0x21000u, r1206_fo);
                  fclose(r1206_fo);
                  if (r1206_got >= 0x21000u) {
                      r1206_old = 0;
                      for (size_t w = 0; w < (0x21000u >> 2); w++)
                          if (r1206_obuf[w] != 0u) r1206_old++;
                  }
              }
              if (r1206_nz >= 1000u && r1206_old < 1000) {
                  if (!xenolift_coord_text_poisoned()) {
                      /* R1260 INPUT/CAPTURE SEPARATION (Jos c124): captures
                       * NEVER write the emitter input. Unique name per capture;
                       * promotion to overlay_input.bin is a verified explicit
                       * action only. */
                      static int _ovc2_n = 0;
                      char _ovn2[80];
                      snprintf(_ovn2, sizeof _ovn2, "overlay_capture_%lld_%d.bin", (long long)xl_wall(), ++_ovc2_n);
                      FILE *r1206_f = fopen(_ovn2, "wb");
                      if (r1206_f) {
                          fwrite(xenolift_mem + (0x8006F000u - 0x80000000u), 1, 0x21000u, r1206_f);
                          fclose(r1206_f);
                          r1206_done = 1;
                          r861_out("[ovl] R1206 LATE CAPTURE: movie-era window (seek=%u, %u nonzero words, old file %ld) -> %s written (R1260 unique capture, never the input) - promote to overlay_input.bin only after verification\n",
                                  cd_seek_lba, r1206_nz, r1206_old, _ovn2);
                      }
                  }
              }
          }
        }
        if (!g_stream_era) continue;
        time_t now = xl_wall();
        if (g_boot_wall_t0 == 0) continue;
        if (g_fldsec_total != w_last_cnt) {
            w_last_cnt = g_fldsec_total; w_last_chg = now; continue;
        }
        if (w_last_chg == 0) w_last_chg = now; /* first observation after era latch */
        if (w_n < 10u && (now - w_last_chg) >= 15) {
            w_n++;
            g_r1195_host_read++; /* R1196: watcher's own reads are HOST reads */
            r861_out("[fldfrz2] R825 HOST watcher t=%lds sectors=%u | seek=%u | walker: FAEC=%08x 92C0=%08x 92BC=%08x 92D0=%08x F0C=%08x F10=%08x FE1C=%08x FE20=%08x FDF8=%08x FE04=%08x FDE4=%08x | q10=%08x q14=%08x q18=%08x\n",
                    (long)(now - g_boot_wall_t0), g_fldsec_total,
                    cd_seek_lba,
                    xenolift_mem_read32(0x8005FAECu /* R1175: was 0x80059FAECu (nine-digit typo, faulting class) */), /* R1171-HELD: nine-digit typo class (truncates to 0x0059FAEC); correction held for atos+guest-writer verification per Jos c360; its fault while held is the diagnostic being measured */
                    xenolift_mem_read32(0x800592C0u),
                    xenolift_mem_read32(0x800592BCu),
                    xenolift_mem_read32(0x800592D0u),
                    xenolift_mem_read32(0x80059F0Cu),
                    xenolift_mem_read32(0x80059F10u),
                    xenolift_mem_read32(0x8004FE1Cu),
                    xenolift_mem_read32(0x8004FE20u),
                    xenolift_mem_read32(0x8004FDF8u),
                    xenolift_mem_read32(0x8004FE04u),
                    xenolift_mem_read32(0x8004FDE4u),
                    xenolift_mem_read32(0x80059F10u),
                    xenolift_mem_read32(0x80059F14u),
                    xenolift_mem_read32(0x80059F18u));
            g_r1195_host_read--; /* R1196 */
            w_last_chg = now; /* re-arm: next receipt 15s later if still stalled */
        }
        /* R1220 (c50): GENERAL SCHEDULED-READ DELIVERY DOOR (generalizes
         * R1219, which covered only seek>=144000). The receipt census across
         * c45/c46/c49/c50 names ONE recurring class - a game-issued
         * scheduled read whose pending INT1 sits undelivered while sector
         * flow is frozen, each era at a NEW LBA with no door covering it:
         * 108884/108886 (sdoor), 108933-108995 (fld2arm), 109166-109678
         * (R1205 movie door), 144024+ (R1219), and c49/c50's file#18 at
         * LBA 109158 - the MODULE file staged at the mount latch (801EF300,
         * READ ISSUED size=14360): its INT1 sat pending 30s with 0 pumps
         * (pendclr receipt @t=82s), the staging stayed incomplete, the
         * unpack ran on short input, the LZSS dictionary pointer went wild
         * (lzss-guard-r suppressed read @0x80C5A0F4), and the era died in
         * the decompressor (SIGSEGV 80032EB4 -> SIGILL 8002AC18). The
         * per-band doors keep chasing the same posture; the general form
         * retires the class: ANY scheduled read (cmd 02 ReadN or 06,
         * FDF8>0) with an undelivered pending INT and frozen sector flow
         * gets the PROVEN cd_force_deliver_int1 (handler pair + collector
         * + h4; R898 defer-safe; R1181 no-forge guards inside; delivers
         * only the CURRENT request's pending INT - never a consumed
         * event, per the c351 discipline). Frozen-flow = this watcher block
         * only runs when g_fldsec_total is unchanged - healthy streaming
         * (fldsec count changing) never reaches here. Fire cap 32; the
         * movie-era precedent: ONE delivered INT1 wakes the game's own
         * handler chain (sector consumed -> seek++ -> next INT1 advances
         * natively). */
        {
            static unsigned r1220_fires;
            if (r1220_fires < 32u
                && cd_scheduled != 0u
                && cd_pending != 0u
                && (cd_last_cmd == 0x02u || cd_last_cmd == 0x06u)
                && xenolift_mem_read32(0x8004FDF8u) > 0u) {
                r1220_fires++;
                r861_out("[fldrd] R1220 GENERAL-READ DOOR: stuck INT1 at seek=%u FDF8=%u pend=%u sched=%u cmd=%02x - force-delivering (drive role)\n",
                        cd_seek_lba,
                        xenolift_mem_read32(0x8004FDF8u),
                        (unsigned)cd_pending, (unsigned)cd_scheduled,
                        (unsigned)cd_last_cmd);
                cd_force_deliver_int1("R1220 general-read door");
            }
        }

        /* R1222 (c57): STARTER RE-REGISTRATION HEAL. The receipts name the
         * interactive blocker one cell wide: in boot 1 the game ITSELF
         * registers 0x8002A68C (the STARTER, the pad-confirm callback -
         * [cbcell] R1204: 564A8 00000000 -> 8002A68C via fn_80040FB4/
         * fn_8004111C, caller 8002A484; then [task] enter 0x8002A68C n=5)
         * into handler cell 0x800564A8 - the h2 the wait-loop collector
         * dispatches when the game's menu loop asks. In the R692 restart
         * era (boot 2) the re-init chain (fn 800357C0/800358BC wipes +
         * the init fill spray, c57: 88888888/04040404/D3D3D3D3 fills are
         * the game's OWN BSS-init class, not pad data) zeroes 564A8, and
         * the game never re-registers: every R1212/hcell receipt holds it
         * at 00000000 -> 00000000 for the whole parked menu era, while the
         * hook camera (active - it printed the boot-1 write) never
         * receipts a re-registration store. No registration -> the
         * collector's h2 is NULL -> the STARTER never dispatches -> the
         * pad confirm never injects -> the menu polls 104s parked until
         * budget expiry (c54/c55/c56). The shell-reload on hardware gives
         * the BIOS a fresh exe whose boot chain re-runs the registration;
         * our boot-2 chain demonstrably skips it. Restore the game's OWN
         * registered value to its OWN cell, once per boot epoch, only when
         * the cell is EMPTY (if the game ever re-registers natively, this
         * never fires and its own value wins), only in post-restart eras
         * (epoch >= 1 - boot 1's registration is the receipted source),
         * and only while the menu posture holds (g_CurGameState==0 = state
         * 0 = KernelMenuMain, per the statetbl R1104 receipts). This is
         * state restoration from the game's own boot-1 contract, not
         * invention - same family as the R1216 pick preservation. */
        {
            static uint32_t r1222_epoch_done;
            if (xenolift_boot_epoch >= 1u
                && r1222_epoch_done != xenolift_boot_epoch
                && xenolift_mem_read32(0x800564A8u) == 0u
                && xenolift_mem_read32(0x80018088u) == 0u) {
                r1222_epoch_done = xenolift_boot_epoch;
                xenolift_mem_write32(0x800564A8u, 0x8002A68Cu);
                r861_out("[starter-heal] R1222 STARTER re-registration: cell 0x800564A8 re-seeded 0 -> 0x8002A68C @epoch %u (the game's own boot-1 registration value; boot-2 re-init wiped it and never re-registered - the c54/c56 STARTER-silence fix)\n",
                        (unsigned)xenolift_boot_epoch);
            }
        }
    }
    return NULL;
}
static int xenolift_kick2_armed, xenolift_kick2_ticks;
static time_t g_boot_wall_t0; /* R315: process-start wall clock for the run budget */
/* R783 CAPTURE POISON GUARDS (c366): the c365 ASCII formatter sprayed TEXT
 * "0000" over the coordinator (0x80077E88 = 30303030x4) and the poisoned
 * window was captured to overlay_fault.bin, then folded by the emit as
 * CODE - the whole translation became ASCII, the guest hung, and the
 * watchdog killed the cycle at 240s with no digest. These predicates run
 * at CAPTURE time: a poisoned window NEVER overwrites a good capture
 * file. coord_text = >=12 nonzero coordinator bytes all printable ASCII.
 * coord_same = 4 identical words (zeros or 30303030x4). The BASE capture
 * ([ovl], boot entry #2) LEGALLY has zero coordinator (module installs
 * later) so it only refuses TEXT poison; the FAULT-moment captures
 * ([ovlfault]/[fldcap]) must hold REAL installed code and refuse text,
 * identical-words, and zeros alike. */
static int xenolift_coord_text_poisoned(void)
{
    int nz = 0, allpr = 1;
    for (int i = 0; i < 16; i++) {
        unsigned char c = xenolift_mem[0x80077E88u - 0x80000000u + i];
        if (c) { nz++; if (c < 0x20u || c > 0x7Eu) allpr = 0; }
    }
    return (nz >= 12 && allpr);
}
static int xenolift_coord_same(void)
{
    uint32_t w0 = xenolift_mem_read32(0x80077E88u);
    uint32_t w1 = xenolift_mem_read32(0x80077E88u + 4u);
    uint32_t w2 = xenolift_mem_read32(0x80077E88u + 8u);
    uint32_t w3 = xenolift_mem_read32(0x80077E88u + 12u);
    return (w0 == w1 && w1 == w2 && w2 == w3);
}
/* R790: shared field-module expansion (coordinator-entry + phase-hook paths) */
static void xenolift_field_expand_all(const char *via);

/* R786 PROLOGUE FINGERPRINT (c369): shape predicates (text/same/zero) were
 * beaten by a mixed-garbage capture (coordinator EBE10222/543DAE66/... —
 * the run's fault targets matched the folded words exactly). The REAL
 * coordinator prologue is stable module code 8E020050 3C04800A (healthy
 * eras + fldreloc expansion agree). Captures write ONLY on exact match,
 * so a wrong-moment snapshot never replaces a good one. */
/* R793 FAULT-CAPTURE STABILITY GATE (c376): the fault capture passed the
 * R786 PROLOGUE fingerprint but its content beyond the prologue drifted
 * ~0.04% per run (31775 -> 31763 nonzero words) - each drift re-signed the
 * emit signature and forced a fresh emit (c376: 235s compile, run skipped
 * by the R789 dynamic cap). Same policy as R789/R791: keep the compile
 * cache valid on small drift; rewrite ONLY on >20% drift or missing file.
 * The prologue fingerprint (R786) still guards BOTH writes on top. */
static long xenolift_fault_old_nz(const char *path)
{
    FILE *f = fopen(path, "rb");
    if (!f) return -1;
    static unsigned char b[135168];
    size_t got = fread(b, 1, 135168, f);
    fclose(f);
    if (got < 135168) return -1;
    long nz = 0;
    for (size_t o = 0; o + 4 <= got; o += 4)
        if (b[o] | b[o+1] | b[o+2] | b[o+3]) nz++;
    return nz;
}
static int xenolift_fault_gate(long new_nz, const char *via)
{
    long old_nz = xenolift_fault_old_nz("overlay_fault.bin");
    if (old_nz <= 4000) return 1;
    long drift = (new_nz > old_nz) ? (new_nz - old_nz) : (old_nz - new_nz);
    long base = (new_nz > old_nz) ? new_nz : old_nz;
    long pct = base > 0 ? (drift * 100) / base : 100;
    r861_out("[faultgate] R793 %s: new %ld vs old %ld nonzero (drift %ld%%) - %s\n",
            via, new_nz, old_nz, pct,
            (pct <= 20) ? "era-noise, SKIPPED (compile cache preserved, R793)" : "era-jump, REWRITING");
    return pct > 20;
}
static int xenolift_coord_prologue_ok(void)
{
    return xenolift_mem_read32(0x80077E88u) == 0x8E020050u
        && xenolift_mem_read32(0x80077E88u + 4u) == 0x3C04800Au;
}

/* R1141 (b8-c324): BLANK-PAGE GUARD - the coordinator window remap.
 * c324 receipts name the death exactly as R682 predicted: [coordw]
 * shows the window written healthy at t=8s (real prologue 27BDFFC8
 * 3C038001 by 0x8004299C), then ZEROED at t=23s during the crash-kit
 * anchor (fn 0x80019524 = start, whose translated code carries the
 * BSS clear-loop 1485FFFE/AC800000 - every anchor re-dispatch re-
 * clears the window 0x8006F000+ as BSS), and then dispatch #9 fell
 * through to the REAL field-cb body ([cbreal] R758 - first time ever)
 * into the blank page: [segvdie] R964 death site cur_fn=0x80077E88,
 * words@cur_fn all ZERO, all recovery declined. On hardware the
 * loader re-expands the module after start clears BSS; our restart
 * path never does. FIX, receipt-keyed: snapshot the emitter-mapped
 * overlay window (the R686/R786-fingerprinted REAL expanded field
 * module) at real_main entry BEFORE guest code can clear it; at the
 * real-entry dispatch door, if the coordinator words are all zero
 * (the R682-proven dead posture), remap the pristine window and
 * let the dispatch run real code. Healthy/loaded windows (prologue
 * or any nonzero) pass untouched - stand-down discipline. */
static uint8_t g_r1141_pristine[135168];
static uint8_t g_r1141_saved;
static uint8_t g_r1145_pristine2[135168];
static uint8_t g_r1145_saved2;
void xenolift_ovl_snapshot(void)
{
    if (!g_r1141_saved) {
        memcpy(g_r1141_pristine, xenolift_mem + (0x8006F000u & 0x1FFFFFFFu), 135168);
        g_r1141_saved = 1;
    }
    /* R1145 (b8-c328): STAGE-2 WINDOW SNAPSHOT. c328 receipts: the same
     * BSS-clear wipe class that hit the coordinator window (c324, R1141)
     * hit the STAGE-2 module window - [crash] cur_fn=0x801D3190 faulting
     * on ALL-ZERO words with r31=0x801D3064 (the stage-2 dispatch caller
     * the [fldcb]/[ovlcb] receipts have shown calling the coordinator
     * since c280). Build receipts every cycle: "overlay stage-2 module:
     * 135168 bytes mapped at 0x801D3000 (33079 nonzero words)". Snapshot
     * before start's clear can touch it, same R1141 pattern. */
    if (!g_r1145_saved2) {
        memcpy(g_r1145_pristine2, xenolift_mem + (0x801D3000u & 0x1FFFFFFFu), 135168);
        g_r1145_saved2 = 1;
    }
}
int xenolift_blank_page_guard(void)
{
    /* R1142 (b8-c325): GARBAGE-WINDOW CLASS added to the heal. c325
     * receipt: the blankheal correctly stood down (window NOT zero) but
     * the real-entry dispatch executed LZSS-SOURCE GARBAGE as code -
     * [coordw] last-writer @t=22s fn 0x800381F4 wrote 3FFCCCE1
     * B142E144 (compressed-source-class staging bytes) AFTER the real
     * prologue (27BDFFC8 written t=9s by 0x80042A58), and [cbreal]
     * dispatch #9 fell through into it -> sig 0xB addr 0xA7A00032
     * executing data-as-code. Both HEALTHY window forms are
     * receipted constants: R682 build-time prologue 0x8E020050
     * (banner receipt EVERY cycle) and the real expanded-module
     * prologue 0x27BDFFC8 (c324/c325 coordw receipts). Rule at the
     * real-entry door: if the first word is neither, the window does
     * not hold dispatchable code - remap the pristine snapshot (the
     * completed-expansion contract). Zero page = same remap. */
    if (!g_r1141_saved) return 0;
    uint32_t w0 = xenolift_mem_read32(0x80077E88u);
    if (w0 == 0x8E020050u || w0 == 0x27BDFFC8u) {
        return 0; /* receipted-healthy window form - pass untouched */
    }
    { static int pr_n; if (pr_n < 4) { pr_n++; r1238_band_bulk("pristine-restore-6F000 PRE"); } }
    memcpy(xenolift_mem + (0x8006F000u & 0x1FFFFFFFu), g_r1141_pristine, 135168);
    { static int po_n; if (po_n < 4) { po_n++; r1238_band_bulk("pristine-restore-6F000 POST"); } };
    xenolift_receipt("[winheal] R1142 window remap @0x80077E88 real-entry door: first word %08X neither R682 prologue (8E020050) nor real prologue (27BDFFC8) - %s class (c324: zeros via anchor BSS-clear; c325: LZSS-source staging garbage via 0x800381F4 executed as code) - pristine expanded module remapped\n",
            w0, (w0 == 0u) ? "blank-page" : "garbage");
    return 1;
}

/* R1145 (b8-c328): STAGE-2 BLANK-PAGE GUARD - the same anchor-wipe class
 * caught on the stage-2 window (cur_fn=0x801D3190 all-zero fault, caller
 * 0x801D3064, c328 receipts). Zero-check only: the c328 fault dump shows
 * zeros (the receipted death posture for this window); healthy stage-2
 * pass untouched. Called from the same real-entry door as the coordinator
 * guard - the coordinator body is what dispatches into stage-2. */
int xenolift_stage2_blank_guard(void)
{
    if (!g_r1145_saved2) return 0;
    /* R1147 (b8-c330): HEADER-WIPE branch. c330 receipts name the game's
     * OWN teardown path: [instw]/[hdrw] show fn 0x8004C01C
     * (ClearMemoryDuringVsyncInterrupt, psyq memclr) storing zeros at
     * 0x801D3008/0x801D3010 at t=84s, while the receipted healthy f15
     * header reads 00000005 80072878 80072898 800728D8 - i.e. 0x801D3004
     * and 0x801D3008 hold the nonzero fn pointers 0x80072878/0x80072898
     * when healthy. The teardown wipes the header; the re-dispatch that
     * follows (fldcb caller chain) must find the window real. Remap when
     * the receipted header cells are blank while pristine holds nonzero
     * (stand-down contract: healthy header = pass untouched). */
    {
        uint32_t h4 = xenolift_mem_read32(0x801D3004u);
        uint32_t h8 = xenolift_mem_read32(0x801D3008u);
        uint32_t p4, p8;
        memcpy(&p4, g_r1145_pristine2 + (0x801D3004u - 0x801D3000u), 4);
        memcpy(&p8, g_r1145_pristine2 + (0x801D3008u - 0x801D3000u), 4);
        if (h4 == 0u && h8 == 0u && (p4 != 0u || p8 != 0u)) {
            memcpy(xenolift_mem + (0x801D3000u & 0x1FFFFFFFu), g_r1145_pristine2, 135168);
            xenolift_receipt("[stg2heal] R1147 header-wiped stage-2 window REMAPPED from pristine @0x801D3000 (c330: game's own memclr 0x8004C01C tore down header cells 3008/3010 @t=84s; healthy f15 header receipted 00000005 80072878 80072898 800728D8; re-dispatch must find the window real)\n");
            return 1;
        }
    }
    if (xenolift_mem_read32(0x801D3064u) | xenolift_mem_read32(0x801D3064u + 4u)
        | xenolift_mem_read32(0x801D3190u) | xenolift_mem_read32(0x801D3190u + 4u)) {
        return 0; /* stage-2 dispatch sites hold code - pass untouched */
    }
    memcpy(xenolift_mem + (0x801D3000u & 0x1FFFFFFFu), g_r1145_pristine2, 135168);
    xenolift_receipt("[stg2heal] R1145 blank stage-2 window REMAPPED from pristine snapshot @0x801D3000 (c328 death: cur_fn=0x801D3190 all-zero fault, caller 0x801D3064 - the same anchor BSS-clear wipe class as the c324 coordinator window; build receipt: 33079 nonzero words)\n");
    return 1;
}
static uint8_t cd_read_active, cd_data[2064], cd_data_loaded;
static void cd_force_deliver_int1(const char *why); /* R258 */
static volatile unsigned g_cdf_defer; /* R898: watcher-side defer flag - drained at the anchor's next dispatch boundary */

static uint8_t g_slot4_dispatch_pending; /* INT1 collected, handler not yet run */
static uint8_t g_cd_irq_force; /* R101: INT1 armed -> dispatch the registered CD IRQ handler pair at the next wait tick */
static uint8_t cd_arm_int1_pending; /* arm INT1 after the 802-ack of the pair */
static uint32_t cd_data_pos, cd_data_n;

static uint32_t cd_bcd(uint8_t x) { return ((x >> 4) & 15u) * 10u + (x & 15u); }
static FILE *g_disc = NULL; static uint32_t g_sec_bytes = 2048u; /* R262: hoisted decls (used by cd_cmd GetTD) */

static void cd_data_load(void)
{
    /* The kernel reads each sector as TWO DMA transfers: 12 bytes of
     * CD-XA header (minute/second/frame in BCD — it verifies the
     * sector's own address from the header!) followed by the 2048
     * user bytes. fn 0x80041534 BCD-decodes header[0..2] and the data
     * handler compares it with the expected LBA. */
    /* R105: the kernel's request stream interleaves — our seek tracking
     * can lag the kernel's expected-LBA cell (FE04). The FIFO must hold
     * the sector the CURRENT request expects or the header compare
     * fails / the wrong bytes drain. Re-anchor on every load. */
    {
        uint32_t want = xenolift_mem_read32(0x8004FE04u);
        if (want != 0u && want != cd_seek_lba) {
            /* R601: c168 receipts — the advance fired 40x to 108997 and the
             * needle was dragged back to 108996 EVERY time. FE04 holds the
             * batch start LBA all era, so this re-anchor is the counter-
             * force. While the ReadS streak is live, keep the advanced
             * needle; a genuine re-aim arrives as Setloc (0x02), which
             * clears the streak. */
            if (!cd_stream_live) {
                r861_out("[cd] FIFO re-anchor: seek %u -> expected %u\n",
                        cd_seek_lba, want);
                cd_seek_lba = want;
            } else {
                static int ra_skip_n;
                if (ra_skip_n < 20) { ra_skip_n++;
                    r861_out("[adv599] R601 re-anchor skipped (stream live): seek=%u expected=%u\n",
                            cd_seek_lba, want); }
            }
        }
    }
    uint32_t msf = cd_seek_lba + 150u; /* MSF = LBA + 150 */
    uint8_t mm = (uint8_t)((msf / 75u) / 60u), ss = (uint8_t)((msf / 75u) % 60u),
            ff = (uint8_t)(msf % 75u);
    if (cd_last_cmd == 0x13u) { /* R310: GetTN answer pending = command context; loading a stale
        * sector here dresses the completion up as a DATA event -> collector counts slot-4
        * -> wl dispatches h4 (sector copier) = the wrong-worker loop (cycle-58). */
        r861_out("[cd] sector-load suppressed: GetTN (cmd 0x13) answer pending — no data event\n");
        return;
    }
    { /* R1299 (c195/c197, Jos snapshot-resolution): THE SERVE RING - the last 16
       * real sector serves with wall timestamps. At any frozen posture this
       * decides STARTED-THEN-STOPPED (serves present at the request range, an
       * age gap to the freeze) vs NEVER-STARTED (zero serves at the range).
       * ARITHMETIC CORRECTED (Jos caught): the c196-freeze FE04=0x0001A9C3 =
       * 108,995 - my earlier 109,123 was a conflation with the f17ins note
       * (file#17 LBA), and the file#17 queued-request story is WITHDRAWN;
       * the era evidence is the 8x file#14 size-lookups (caller 80019A48).
       * The request identity stays OPEN until the receipts close it. */
        static uint32_t r1299_lba[16]; static time_t r1299_t[16]; static uint32_t r1299_n;
        r1299_lba[r1299_n & 15u] = cd_seek_lba;
        r1299_t[r1299_n & 15u] = xl_wall();
        r1299_n++;
    }
    cd_data_loaded = 1;
    cd_data_pos = 0;
    cd_data[0] = (uint8_t)((mm / 10u) << 4 | (mm % 10u)); /* minute BCD */
    cd_data[1] = (uint8_t)((ss / 10u) << 4 | (ss % 10u)); /* second BCD */
    cd_data[2] = (uint8_t)((ff / 10u) << 4 | (ff % 10u)); /* frame BCD */
    cd_data[3] = 0x02; /* mode 2 (XA) */
    memset(cd_data + 4, 0, 8); /* subheader + padding */
    /* R607 (c174 verdict): the archive callback validates each served
     * sector header against its expected position; served header was 108996
     * on EVERY serve (50+ identical headers on a 46-sector file = validator
     * can never reach the final sector = file never completes, F0C frozen
     * at 14). The dispatch-time R602 heal fires, but a per-dispatch drag-
     * back re-targets the needle before this load runs. LAST-MOMENT ASSERT:
     * stream live = the stream pointer IS the truth — snap the needle right
     * before reading the payload so the served sector + header match. */
    if (cd_stream_live && xenolift_stream_next >= 108997u && xenolift_stream_next <= 109040u
        && cd_seek_lba != xenolift_stream_next) {
        static int r607_n;
        if (r607_n < 60) { r607_n++;
            r861_out("[adv599] R607 load-time assert: seek %u -> stream %u (drag-back defeated at payload-read)\n",
                    cd_seek_lba, xenolift_stream_next); }
        cd_seek_lba = xenolift_stream_next;
    }
    if (disc_read_lba(cd_seek_lba, cd_data + 12) != 0)
        memset(cd_data + 12, 0, 2048); /* no disc: zeros */
    cd_data_n = 2060;
    g_sectors_loaded++;
    { /* R1314 (c213/c214, Jos sector-correctness order): the SERVED-SECTOR
       * identity - lba + header + payload signature, so the digest can
       * match every serve against the fetch dests. The c212 question:
       * fetch dests advance while entries report seek=0/FE04=0 and the
       * same req word - intentional reread, stale instrumentation, or
       * WRONG-SECTOR delivery. SAME sum/xor across advancing dests = the
       * same bytes repeatedly delivered. */
        static uint32_t ssrv_n, ssrv_sum, ssrv_xor, wi;
        ssrv_sum = 0; ssrv_xor = 0;
        for (wi = 0; wi < 512u; wi++) { uint32_t w; memcpy(&w, cd_data + 12 + wi * 4u, 4u); ssrv_sum += w; ssrv_xor ^= w; }
        if (ssrv_n < 64u || (ssrv_n & 511u) == 0u) {
            r861_out("[xfer] R1314 sector serve: lba=%u msf=%02X:%02X:%02X sum=%08X xor=%08X (served identity - match vs fetch dest)\n",
                cd_seek_lba, cd_data[0], cd_data[1], cd_data[2], ssrv_sum, ssrv_xor);
        }
        ssrv_n++;
    }
    if (cd_seek_lba < 108500u || cd_seek_lba > 109400u) { /* R305: new-region delivery (state-1 files live at LBA 41/11055/36637/45581) */
            static int bigread_n = 60;
            if (bigread_n-- > 0)
                r861_out("[bigread] sector LBA %u -> data FIFO (NEW-REGION read chain ACTIVE)\n", cd_seek_lba);
        }
        r861_out("[cd] sector LBA %u loaded into data FIFO (header %02X:%02X:%02X + 2048 bytes)\n",
            cd_seek_lba, cd_data[0], cd_data[1], cd_data[2]);
}

/* Commands in the kernel's per-command handler table (0x80056570): their
 * completions set slot byte 3, which the event pump treats as "keep
 * looping" forever — the pump only exits on slot 2 or 5. On real
 * hardware the interrupt dispatcher runs these handlers; without
 * interrupts the cleanest emulation is to let the sync "clear stale"
 * path ack these responses silently so the slot byte stays 2. */
static int cd_flag_suppressed(uint8_t c)
{
    (void)c;
    return 0; /* experiment: deliver every response with the op flag */
}

int cd_getstat_spins = 0; /* R213: consecutive idle GetStat re-primes
                              * (the kernel POLLING for progress) */

int cd_motor_on = 1; /* R212: spindle state — Stop (0x08) turns it OFF;
                       * Setloc/ReadN/Seek/Init spin it back up. GetStat must
                       * report the LIVE state or the kernel's post-Stop poll
                       * never sees the motor-off transition it waits for. */

static void cd_cmd(uint8_t cmd)
{
    /* R533 [cmdtl]: field-era command timeline - c101: dirack4 fired 3x, the
     * Setloc ack popped, yet the game RE-ISSUED the same Setloc (seek 108934):
     * a retry loop whose missing next-step must be NAMED, not guessed.
     * Log every disc-command dispatch in the field era, in order, with the
     * full state at dispatch. (Probe-only cycle - no new heals.) */
    {
        static int ct_n;
        if (cd_seek_lba >= 108900u && ct_n < 80u) {
            ct_n++;
            r861_out("[cmdtl] R533 #%d cmd %02x->%02x seek=%u FE1C=%u FE20=%u resp=%u/%u pend=%u sched=%u data=%u/%u FDF8=%u FE04=%08x\n",
                    ct_n, cd_last_cmd, cmd, cd_seek_lba,
                    xenolift_mem_read32(0x8004FE1Cu), xenolift_mem_read32(0x8004FE20u),
                    cd_resp_n, cd_resp_pos, cd_pending, cd_scheduled,
                    cd_data_pos, cd_data_n,
                    xenolift_mem_read32(0x8004FDF8u), xenolift_mem_read32(0x8004FE04u));
        }
    }
    /* R1235 (c79, Jos direction): THE ONE DIR-2 SYNC-DELIVERY DOOR (the
     * R1233 watcher-site copy is REMOVED - c78 receipts proved that host
     * does not run in the stall era; a single door here at the alarm tick
     * is era-guaranteed, so there is exactly ONE accounting state to reason
     * about. Repeated-tick and era-reset discipline, per Jos's checklist:
     * (a) the whole WRITE RANGE [dst, dst+nsec*2048) is validated against
     * RAM end 0x80200000 - not just the destination start - an
     * out-of-range delivery is refused and receipted, never truncated;
     * (b) one-shot per LBA within the era: a2_last_lba blocks any repeated
     * tick from re-delivering the same LBA (double-delivery class);
     * (c) era reset: xenolift_boot_epoch (R693, bumped at every shell
     * restart / pristine restore) rolls the accounting - a NEW era gets a
     * fresh 2-delivery budget and a cleared last-LBA, so a legitimate
     * re-read of the same LBA after a restore is NOT blocked by the prior
     * era's latch, while the per-era cap still bounds total deliveries.
     * The receipt prints epoch/fires/last_lba/range-end so the cap is
     * verifiable from the log alone. The dir-2 request posture (c77/c78):
     * FE04=0x3A6E0 (LBA 239328) with FE08 staging, FDF8=0, drive never
     * seeks there - same class as the R835/R896 dir-1 doors. */
    {
        /* R1243 (c97 placement fix, was R1242): TWO receipted never-staged postures. (a) The
         * 239328-band retry treadmill - ~60 cmdtl cycles (Setloc->ReadN->
         * GetStat->GetTN->Stop->ReadS) at FDF8=0 resp=0/0 loaded=0: the drive
         * SEEKS there fine now, so the R1235 premise "a2_req != cd_seek_lba
         * (the drive never seeks there)" is OBSOLETE and blocked the door for
         * the whole c93-c96 era. (b) The post-file-18 request at LBA 109166
         * (FE04=109166, staging 801FAB00, t=50s, 4M polls): file 18 streamed
         * NATIVELY 109158..109165 (8 sectors, 14360B), then the game queued
         * the NEXT read - no band covered it (R1220 general door needs
         * FDF8>0). Fix: TWO bands [239300..239400] and [109100..109200], a
         * strict stall gate (FDF8==0, nothing loaded, no pending INT, response
         * FIFO EMPTY = model fully idle while the game's request cell holds
         * the seek) held for 2 consecutive alarm ticks (R1205 streak
         * precedent), the obsolete seek-inequality guard DROPPED. C97 LESSON: R1242 shipped
         * this door at the on_alarm site and ZERO receipts appeared - not
         * even the unconditional era-reset. Cause: on_alarm RETURNS EARLY at
         * the g_guest_depth>0 guard while the game spins inside guest
         * dispatches ("on_alarm deferred - anchor mid-guest-step" = the whole
         * treadmill era). Era-guaranteed is NOT spin-reached. THIS copy
         * lives in cd_cmd, which the R533 cmdtl camera proves runs on EVERY
         * disc-command dispatch during the spin (80 ladder receipts while
         * the alarm was deferred) - the streak now counts COMMAND DISPATCHES
         * (>=4 consecutive with the posture held) instead of alarm ticks. All
         * R1235 discipline intact: full write-range validation vs 0x80200000
         * (refused+receipted, never truncated), one-shot per LBA per era
         * (a2_last_lba), epoch-reset accounting, fires cap raised 2->4/era to
         * cover both bands, receipt on every fire. */
        static uint32_t a2_epoch_prev = 0xFFFFFFFFu;
        static uint32_t a2_streak_lba = 0u, a2_streak = 0u; /* R1242 2-tick stall streak */
        static uint32_t a2_fires = 0u;
        static uint32_t a2_last_lba = 0u;
        if (a2_epoch_prev != xenolift_boot_epoch) {
            a2_epoch_prev = xenolift_boot_epoch;
            a2_fires = 0u;
            a2_last_lba = 0u;
            a2_streak_lba = 0u; a2_streak = 0u;
            r861_out("[d2door] R1235 era reset: epoch=%u -> fresh delivery budget (4/era per R1242, last-LBA cleared)\n",
                    (unsigned)xenolift_boot_epoch);
        }
        uint32_t a2_req = xenolift_mem_read32(0x8004FE04u);
        int a2_band = (a2_req >= 239300u && a2_req <= 239400u)
                   || (a2_req >= 109100u && a2_req <= 109200u);
        if (a2_band
            && xenolift_mem_read32(0x8004FDF8u) == 0u
            && cd_pending == 0u && cd_resp_n == 0u
            && a2_last_lba != a2_req) {
            if (a2_streak_lba == a2_req) a2_streak++;
            else { a2_streak_lba = a2_req; a2_streak = 1u; }
        } else {
            a2_streak = 0u;
        }
        if (a2_fires < 4u && a2_streak >= 4u && a2_last_lba != a2_req) {
            uint32_t a2_dst = xenolift_mem_read32(0x8004FE08u);
            uint32_t a2_size = xenolift_mem_read32(0x8004FDF8u);
            if (a2_size == 0u || a2_size > 0x40000u) a2_size = 14360u;
            uint32_t a2_nsec = (a2_size + 2047u) / 2048u;
            if (a2_nsec > 32u) a2_nsec = 32u;
            uint64_t a2_end = (uint64_t)a2_dst + (uint64_t)a2_nsec * 2048u;
            if (a2_dst >= 0x80010000u && (a2_dst & 3u) == 0u && a2_end <= 0x80200000ull) {
                for (uint32_t i = 0u; i < a2_nsec; i++)
                    disc_read_lba(a2_req + i,
                        xenolift_mem + (a2_dst - 0x80000000u) + i * 2048u);
                xenolift_mem_write32(0x8006A22Cu,
                    xenolift_mem_read32(0x8006A22Cu) + 1u);
                uint32_t a2_sb = xenolift_mem_read32(0x80056788u);
                xenolift_mem_write32(0x80056788u, a2_sb | 6u);
                uint16_t a2_one = 1;
                memcpy(xenolift_mem + (0x800578A6u & 0x1FFFFFFFu), &a2_one, 2);
                xenolift_mem_write32(0x8005FDFCu, 0u);
                xenolift_mem_write32(0x8005FE48u, 1u);
                xenolift_mem_write32(0x8005FE1Cu, 0u);
                xenolift_mem_write32(0x8004FDF8u, 0u);
                xenolift_mem_write32(0x8004FE1Cu, 0u);
                xenolift_mem_write32(0x8004FE04u, 0u);
                a2_last_lba = a2_req; a2_fires++; a2_streak = 0u;
                r861_out("[d2door] R1243 SYNC DELIVERY (band %s): LBA %u size %u -> %u sectors to [%08X..%08llX) (RAM end 80200000, whole range validated); drive parked at %u; event posted (A22C+1 sb %08X->%08X); success+ledger posture stamped; epoch=%u fires=%u last=%u\n",
                        (a2_req >= 239300u && a2_req <= 239400u) ? "dir2-239xxx" : "post18-109xxx",
                        a2_req, a2_size, a2_nsec, a2_dst,
                        (unsigned long long)a2_end, (unsigned)cd_seek_lba,
                        a2_sb, a2_sb | 6u, (unsigned)xenolift_boot_epoch,
                        a2_fires, a2_last_lba);
                fflush(stderr);
            } else {
                r861_out("[d2door] R1235 dir-2 request LBA %u REFUSED: dst %08X or range-end %llX invalid (dst must be RAM-aligned >=80010000, whole write range must end <=80200000) - no delivery\n",
                        a2_req, a2_dst, (unsigned long long)a2_end);
            }
        }
    }
    /* R598 [ReadS stream advance]: c166 verdict — the field-era file layer
     * re-issues 0x09 (ReadS, streaming read) ~80x (cmdtl 09->09) and our
     * model re-served THE SAME sector every time (cd-dma LBA 108996 x80,
     * seek frozen per c159's f15stream comment). Per psx-spx, ReadN/ReadS
     * AUTO-ADVANCE: after a sector is delivered the drive reads the NEXT
     * sector. The game's re-issues are its per-sector streaming cadence —
     * each expects a NEW sector. Advance one LBA per consecutive 0x09
     * (any other command between resets the streak; Setloc re-anchors
     * anyway). Gate: only in the file-15 batch range (108996..109040) —
     * boot-era reads are 0x06+Setloc and never touch this range. When the
     * batch's last sector (109040) is consumed the game's own finalize
     * takes over (node done-form 00001524 -> stepper F0C 14->15). */
    {
        /* R599 (c167): R598's streak never survived the game's GetStat
         * (0x01) polls between ReadS re-issues — per psx-spx the drive
         * keeps streaming once reading; polls don't re-anchor it. Only a
         * new Setloc does. Streak survives 0x01; breaks on 0x02. */
        static int rs_streak;
        /* R602 (c169): c169 receipts — every advance (108996->108997) was
         * dragged back to 108996 before the next 0x09 (40+ identical
         * advances; FE04=0 so the old R105 re-anchor is NOT the resetter —
         * some per-dispatch path re-targets the needle). Fix: while the
         * stream is live, THE STREAM POINTER IS THE TRUTH — snap seek to
         * the stream's next LBA at every 0x09 dispatch, defeating ANY
         * drag-back regardless of its source. First 0x09 seeds the pointer
         * at seek+1 (current sector already served). Setloc (0x02) kills
         * the stream (fresh seek = fresh stream). Range-capped at 109040:
         * past the batch's last sector, stop snapping so the game's own
         * finalize takes over. */
        static uint32_t rs_next;
        if ((cmd == 0x06u || cmd == 0x1Bu) && cd_seek_lba >= 108995u && cd_seek_lba < 109041u) {
            /* R1315 (c215, Jos PSX-SPX behavioral repair - separate from the
             * c214 labels per Jos order): the stream advance rides REAL read
             * commands (ReadN 06 / ReadS 1B). 0x09 is PAUSE - the old key
             * (cmd == 0x09u) advanced the needle on Pause commands, the
             * wrong-mapping-as-behavior class; the next run receipts which
             * change affected execution. */
            if (!rs_streak) { rs_streak = 1; rs_next = cd_seek_lba + 1u; }
            if (rs_next >= 108997u && rs_next <= 109040u && cd_seek_lba != rs_next) {
                { static int rs_n;
                  if (rs_n < 60) { rs_n++;
                    r861_out("[adv599] R602 needle heal: seek %u -> stream %u (FE1C=%u FDF8=%u F0C=%u)\n",
                            cd_seek_lba, rs_next, xenolift_mem_read32(0x8004FE1Cu),
                            xenolift_mem_read32(0x8004FDF8u),
                            xenolift_mem_read32(0x80059F0Cu)); } }
                cd_seek_lba = rs_next;
                xenolift_stream_next = rs_next; /* R607 mirror for load-time assert */
            } else if (rs_next >= 108997u && rs_next <= 109040u) {
                { static int rs_n2;
                  if (rs_n2 < 60) { rs_n2++;
                    r861_out("[adv599] R602 stream serve: seek %u (FE1C=%u)\n",
                            cd_seek_lba, xenolift_mem_read32(0x8004FE1Cu)); } }
            }
            rs_next++;
            xenolift_stream_next = rs_next; /* R607 */
        } else if (cmd == 0x02u) {
            rs_streak = 0;      /* Setloc: fresh seek = fresh stream */
        } else if (cmd == 0x09u) {
            /* R1315 (c215): PAUSE in the behavioral stream logic - PSX-SPX:
             * Pause ENDS reading. The needle-heal no longer advances on it
             * (the old key did); the streak and stream-live flags retire. */
            static int rj_n;
            if (rj_n < 12) { rj_n++;
                r861_out("[adv599] R1315 PAUSE retire (behavioral): streak=%d seek=%u stream_live=%d FE04=%08X - the needle no longer advances on Pause\n",
                        rs_streak, cd_seek_lba, (int)cd_stream_live, xenolift_mem_read32(0x8004FE04u)); }
            rs_streak = 0;
            cd_stream_live = 0;
        }
        if (cmd == 0x02u) {
            rs_streak = 0;           /* Setloc re-anchors the drive */
            cd_stream_live = 0;      /* R601: genuine re-aim ends the streak */
        } else if (cmd == 0x06u || cmd == 0x1Bu) {
            /* R1315 (c215, Jos PSX-SPX correction): ReadN (06) / ReadS (1B)
             * keep the stream alive - NOT 0x09 (PAUSE ends reading). GetStat
             * (01) is PASSIVE: it neither extends nor breaks the streak. */
            rs_streak = 1;
            if (cd_seek_lba >= 108995u && cd_seek_lba < 109041u)
                cd_stream_live = 1;  /* R601: real read in the batch range = streak live */
        } else if (cmd == 0x09u) {
            rs_streak = 0;           /* R1315: PAUSE ends reading - no new stream ownership */
            cd_stream_live = 0;
        } else
            rs_streak = 0;
    }
    cd_last_cmd = cmd;
    { /* R1312 (c211, Jos transfer-identity order): last_cmd is NOT transfer
       * state - an interleaved GetStat changes last_cmd without identifying
       * whether a read remains OUTSTANDING (the c209/210 posture cmd01
       * fe1c6 FE04<150 FDF8=0 act=0 cannot be served on last_cmd evidence
       * alone). This LEDGER preserves the transfer identity across status
       * commands: SETLOC (02) re-aims - a DIFFERENT LBA retires the prior
       * record and arms a new one (same LBA re-issue keeps it); READN (06)
       * and READS (09) stamp dest=FE08 + len=FDF8 (the length the game
       * ITSELF armed, receipted by [fdw]); the STATUS FAMILY (01 GetStat,
       * 13 GetTN, 14 GetTD) is PASSIVE - it only counts the intervene,
       * NEVER retires; STOP (08) retires; a boot restart retires. The
       * drive-OWN completion (FDF8 drained + read_active cleared + FIFO
       * empty) retires at the poll camera below. Cameras only - NO
       * delivery behavior change: the R1311 narrow test stays as shipped,
       * judged by the Jos criterion (one correct sector consumed by the
       * IDENTIFIED request + the loader transition), never by door-fire. */
        { /* R1314 (c214, Jos command-semantics order): the RAW command-byte
           * audit - print the actual byte the game writes to the command
           * register (PSX-SPX / DuckStation: 01 GetStat, 02 Setloc = target
           * only, 06 ReadN, 09 PAUSE = ends reading, INT3 then INT2, 0D
           * Setfilter = NOT a read, 1B ReadS). Receipts whether logged cmd
           * numbers are raw bytes or internal aliases BEFORE any
           * transfer-ownership reassessment. */
            static uint32_t cb_n;
            if (cb_n < 48u || (cb_n % 1024u) == 0u)
                r861_out("[xfer] R1314 CMD byte: %02X seq=%u (raw byte as written - PSX-SPX table applied downstream)\n", (unsigned)cmd, cd_sched_seq);
            cb_n++;
        }
        uint32_t lba_now = xenolift_mem_read32(0x8004FE04u);
        if (cmd == 0x02u) {
            /* R1314 (c213/c214, Jos correction): Setloc is POSITIONING
             * INTENT, never a transfer record - it carries neither dest
             * nor length, so a Setloc-armed record (the c212 live=1
             * lba=1 dest=0 len=0 receipt) proves RETENTION, not an
             * outstanding read. A Setloc to a DIFFERENT lba retires a
             * live STREAM; it NEVER arms one. A retained live=1 flag is
             * NEVER permission to inject another sector. */
            if (cd_x_live && lba_now != cd_x_lba) {
                if (cd_x_pr < 24) { cd_x_pr++;
                    r861_out("[xfer] R1314 STREAM retire (Setloc re-aim): stream lba=%u dest=%08X len=%u seq=%u gst=%u age=%us -> pos lba=%u\n", cd_x_lba, cd_x_dest, cd_x_len, cd_x_seq, cd_x_gst, xl_wall() - cd_x_arm_t, lba_now); }
                cd_x_live = 0;
            }
            if (cd_x_pr < 24) { cd_x_pr++;
                r861_out("[xfer] R1314 POS intent (Setloc): lba=%u seq=%u (positioning only - NO serve authority)\n", lba_now, cd_sched_seq); }
            cd_pos_lba = lba_now; cd_pos_t = xl_wall();
        } else if (cmd == 0x06u || cmd == 0x1Bu) {
            /* R1314 (c214, Jos PSX-SPX correction): the STREAM arms ONLY at
             * ReadN (06) and ReadS (1B). 0x09 is PAUSE - INT3 then INT2, it
             * ENDS reading; the old label booked Pause commands as read
             * arms (the "ARM (ReadS) lba=0 dest=0 len=0" records at cmd 09
             * were Pauses). */
            uint32_t dst_now = xenolift_mem_read32(0x8004FE08u), len_now = xenolift_mem_read32(0x8004FDF8u);
            if (!cd_x_live) { cd_x_live = 1; cd_x_lba = cd_seek_lba; cd_x_gst = 0; cd_x_arm_t = xl_wall(); }
            if (cd_x_pr < 24) { cd_x_pr++;
                r861_out("[xfer] R1314 STREAM-ARM (%s): lba=%u dest=%08X len=%u seq=%u gst=%u (the sole outstanding-read identity - dest+len stamped at issue)\n", cmd == 0x06u ? "ReadN" : "ReadS", cd_x_lba, dst_now, len_now, cd_sched_seq, cd_x_gst); }
            cd_x_dest = dst_now; cd_x_len = len_now; cd_x_seq = cd_sched_seq;
        } else if (cmd == 0x09u) {
            /* R1314 (c214): PAUSE (09) - PSX-SPX: ends reading; INT3 ack
             * then INT2 completion (the runtime INT2 for this class is
             * UNRECEIPTED - the response census decides). Retires any
             * live stream - a distinct class from Stop (08). */
            if (cd_x_live) {
                if (cd_x_pr < 24) { cd_x_pr++;
                    r861_out("[xfer] R1314 STREAM retire (PAUSE 09): lba=%u dest=%08X len=%u seq=%u gst=%u age=%us (PSX-SPX: Pause ENDS reading - INT3 then INT2)\n", cd_x_lba, cd_x_dest, cd_x_len, cd_x_seq, cd_x_gst, xl_wall() - cd_x_arm_t); }
                cd_x_live = 0;
            } else if (cd_x_pr < 24) { cd_x_pr++;
                r861_out("[xfer] R1314 PAUSE (09) with no live stream (idle pause - INT3 then INT2 expected)\n"); }
        } else if (cmd == 0x01u || cmd == 0x13u || cmd == 0x14u || cmd == 0x0Du) {
            /* R1314 (c214, Jos correction): 0x0D is SETFILTER - NOT a read
             * command (the c190/c191 read-inference is RETRACTED). Passive
             * to the stream: counts as an intervene, never retires, never
             * arms. The c191-era serve keyed on 0x0D is SUSPECT, receipted
             * separately before any behavioral change. */
            if (cd_x_live) cd_x_gst++;   /* PASSIVE: the status command intervenes, NEVER retires */
        } else if (cmd == 0x08u) {
            if (cd_x_live && cd_x_pr < 24) { cd_x_pr++;
                r861_out("[xfer] R1312 RETIRE (Stop 08): lba=%u len=%u gst=%u age=%us\n", cd_x_lba, cd_x_len, cd_x_gst, xl_wall() - cd_x_arm_t); }
            cd_x_live = 0;
        }
    }
    /* R1289 (c190, DISAMBIGUATION CAMERA - the c188 final wedge): after the
     * R502 retraction the boot lives by its own protocol and the final
     * epoch wedges at seek=0 cmd 0x0D FE1C=8 FDF8=2048 A22C=0 pend=0
     * sched=0, FROZEN through the whole w50-w95 witness window (mvloop x6
     * identical, the [chg] trail names the game own 8002AC0C setting FE1C=8
     * right after the Setmode/0x0E step completed FE1C=12). 0x0D is in NO
     * handler: the builder primes only the bare stat byte. The c149-151
     * decode names the post-restart directory re-read as "GetTN + ReadN at
     * LBA 0" - so EITHER 0x0D is the game ReadN encoding and the armed
     * 2048B at seek=0 is a DATA request the machinery never serves (A22C
     * never sets), OR the bare stat is malformed (the R262 GetTN lesson:
     * one stat byte = retry forever) or never popped. THIS CAMERA names
     * it: full drive state at arrival + the [rspop0d] pop camera. PASS =
     * the receipts pick the c191 fix: pops-and-FE1C-still-8 -> 0x0D is a
     * READ, serve the sector (the zrf0 composite); no-pops -> deliver and
     * complete the ack. CAMERAS ONLY, no behavior change. */
    if (cmd == 0x0Du) {
        static int r1289_n;
        if (r1289_n < 16) { r1289_n++;
            r861_out("[cmd0d] R1289 cmd 0x0D arrival #%d: seek=%u act=%d loaded=%d pos=%u/%u resp=%u/%u FDF8=%u A22C=%08X A228=%08X FDFC=%08X pend=%d sched=%d FE1C=%u FE20=%u motor=%d\n",
                    r1289_n, cd_seek_lba, cd_read_active, cd_data_loaded, cd_data_pos, cd_data_n,
                    cd_resp_pos, cd_resp_n, xenolift_mem_read32(0x8004FDF8u),
                    xenolift_mem_read32(0x8006A22Cu), xenolift_mem_read32(0x8006A228u),
                    xenolift_mem_read32(0x8004FDFCu), cd_pending, cd_scheduled,
                    xenolift_mem_read32(0x8004FE1Cu), xenolift_mem_read32(0x8005FE20u), cd_motor_on);
        }
    }
    /* R908 (b8-c9, manager - SEEK-DONE STATUS POST, REEL/ATLAS lanes):
     * the movie-era loop (fn_80042A58, emitted source 123835) polls
     * LW(*(0x800567B4)) & 0x01000000 - the drive-status bit - and exits
     * only when it CLEARS. c9 receipts: seek=108886 last_cmd=0E pend=0
     * sched=0 - the kernel issued CdlSeek(0x0E, file#7 = first movie
     * slice) and polls for seek-done; our engine takes the command but
     * never posts the status transition, so the loop spun 83M polls to
     * the budget fuse. SERVICE: when 0x0E lands, clear bit24 at the
     * status struct the kernel polls (a real seek completes in ~100ms;
     * the loop's WaitForVerticalRetrace throttle makes an immediate
     * post frame-accurate). Receipt [seekdone] cap 6 - before/after word
     * so the next digest names the full struct word if polarity is off. */
    if (cmd == 0x0Eu) {
        uint32_t sd_p = xenolift_mem_read32(0x800567B4u);
        if (sd_p >= 0x80010000u && sd_p < 0x80200000u) {
            uint32_t sd_w = xenolift_mem_read32(sd_p);
            if (sd_w & 0x01000000u) {
                xenolift_mem_write32(sd_p, sd_w & ~0x01000000u);
                static int r908_n;
                if (r908_n < 6) { r908_n++;
                    r861_out("[seekdone] R908 CdlSeek(0x0E) status posted: struct@%08X word0 %08X -> %08X (bit24 cleared - movie loop 80042A58 exit condition met)\n",
                            sd_p, sd_w, sd_w & ~0x01000000u);
                }
            }
        }
    }
    if (cmd == 0x02u || cmd == 0x06u || cmd == 0x07u
        || cmd == 0x09u || cmd == 0x0Au) /* R212: spin-up cmds */
        cd_motor_on = 1;
    if (cmd != 0x13u) /* R213: GetStat IS the poll — don't reset on it */
        cd_getstat_spins = 0;
    cd_resp_n = 0;
    cd_resp_pos = 0;
    /* R124 (psx-spx): stat bit1 = spindle on; bit5 (0x20) = Reading.
     * Nop/GetStat returns LIVE state; Pause's first response keeps
     * bit5 set when issued mid-read. */
    uint8_t stat0 = 0x02u;
    if (cmd == 0x01u || cmd == 0x09u)
        stat0 = cd_read_active ? (0x02u | 0x20u) : 0x02u;
    cd_resp[cd_resp_n++] = stat0;
    /* R262 TOC/POSITION COMMANDS (psx-spx "CDROM Controller Command Summary").
     * Cycle-10: the movie player issued 0x13 in a retry treadmill (84
     * re-primes). 0x13 is GetTN — INT3(stat,first,last) — NOT a status poll
     * (R213 mislabeled it GetStat = 0x01); one stat byte = malformed TOC =
     * retry forever. Jos's disc = single MODE2 data track. */
    if (cmd == 0x13u) {                       /* GetTN: first/last track, BCD */
        cd_resp[cd_resp_n++] = 0x01u; cd_resp[cd_resp_n++] = 0x01u;
        r861_out("[cd] GetTN -> stat %02X first 01 last 01\n", stat0);
    } else if (cmd == 0x14u) {                /* GetTD(track): INT3(stat,mm,ss) BCD */
        uint32_t trk = cd_param_n ? cd_bcd(cd_params[0]) : 0u;
        uint32_t lba_abs;                     /* absolute frame incl. 150 lead-in */
        if (trk == 0u) {                      /* track 0 = lead-out = disc length */
            long bytes = 0; if (g_disc) { long cur = ftell(g_disc); fseek(g_disc, 0, SEEK_END); bytes = ftell(g_disc); fseek(g_disc, cur, SEEK_SET); }
            lba_abs = (bytes > 0 ? (uint32_t)(bytes / (long)g_sec_bytes) : 305352u) + 150u;
        } else lba_abs = 150u;                /* track 1 starts at 00:02:00 */
        { uint32_t mm = lba_abs / 4500u, ss = (lba_abs / 75u) % 60u;
          cd_resp[cd_resp_n++] = (uint8_t)(((mm / 10u) << 4) | (mm % 10u));
          cd_resp[cd_resp_n++] = (uint8_t)(((ss / 10u) << 4) | (ss % 10u));
          r861_out("[cd] GetTD(%u) -> %02u:%02u\n", trk, mm, ss); }
    } else if (cmd == 0x10u || cmd == 0x11u) { /* GetlocL / GetlocP: 8 bytes, BCD */
        uint32_t a = cd_seek_lba + 150u, mm = a / 4500u, ss = (a / 75u) % 60u, ff = a % 75u;
        uint8_t bmm = (uint8_t)(((mm / 10u) << 4) | (mm % 10u)), bss = (uint8_t)(((ss / 10u) << 4) | (ss % 10u)), bff = (uint8_t)(((ff / 10u) << 4) | (ff % 10u));
        cd_resp_n = 0;                        /* no stat byte in these two */
        if (cmd == 0x10u) { cd_resp[cd_resp_n++] = bmm; cd_resp[cd_resp_n++] = bss; cd_resp[cd_resp_n++] = bff;
                            cd_resp[cd_resp_n++] = 0x02u; cd_resp[cd_resp_n++] = 0x00u; cd_resp[cd_resp_n++] = 0x00u; cd_resp[cd_resp_n++] = 0x08u; cd_resp[cd_resp_n++] = 0x00u; }
        else              { uint32_t rl = cd_seek_lba, rm = rl / 4500u, rs = (rl / 75u) % 60u, rf = rl % 75u;
                            cd_resp[cd_resp_n++] = 0x01u; cd_resp[cd_resp_n++] = 0x01u;
                            cd_resp[cd_resp_n++] = (uint8_t)(((rm / 10u) << 4) | (rm % 10u)); cd_resp[cd_resp_n++] = (uint8_t)(((rs / 10u) << 4) | (rs % 10u)); cd_resp[cd_resp_n++] = (uint8_t)(((rf / 10u) << 4) | (rf % 10u));
                            cd_resp[cd_resp_n++] = bmm; cd_resp[cd_resp_n++] = bss; cd_resp[cd_resp_n++] = bff; }
        r861_out("[cd] Getloc%c -> %02X:%02X:%02X (LBA %u)\n", cmd == 0x10u ? 'L' : 'P', bmm, bss, bff, cd_seek_lba);
    }
    if (cmd == 0x02u && cd_param_n >= 3u) { /* Setloc(amm,ass,asect) BCD */
        { static int w02n = 12;
          if (w02n > 0) { w02n--;
              r861_out("[cdw02] Setloc issue: FE04=%u FE1C=%u FE20=%u pending=%u resp_n=%u read_active=%u motor=%u sched=%u seek(before)=%u\n",
                      xenolift_mem_read32(0x8004FE04u), xenolift_mem[0x4FE1Cu], xenolift_mem[0x4FE20u],
                      cd_pending, cd_resp_n, cd_read_active, cd_motor_on, cd_scheduled, cd_seek_lba);
          } }
        /* R1262 (c133 receipts, first-fault fix): the post-reinit driver
         * handshake issues Setloc BCD 00:00:00 (position 0 = disc start)
         * then ReadS - the raw formula underflowed to 4294967146
         * (0xFFFFFFAA = -150), leaving a garbage seek the ReadS arm
         * cannot re-anchor (FE04=0 skips the want!=0 re-anchor guard),
         * so disc_read_lba can never load data and the fetch polls 0x40
         * forever (c127 wedge: 300M polls, cur_fn 80042AA8). Hardware
         * truth: the data track begins at MSF 00:02:00; MSF below that
         * is lead-in, which no ReadS in this model serves - CLAMP to
         * LBA 0 (disc start), which is what the position-0 request
         * means. */
        {
            int32_t r1262_lba = (int32_t)((cd_bcd(cd_params[0]) * 60u + cd_bcd(cd_params[1])) * 75u
                    + cd_bcd(cd_params[2])) - 150;
            if (r1262_lba < 0) {
                static int r1262_n;
                if (r1262_n < 8u) { r1262_n++;
                    r861_out("[setloc-clamp] R1262 Setloc MSF %02X:%02X:%02X below data track - clamped to LBA 0\n",
                            cd_params[0], cd_params[1], cd_params[2]);
                }
                r1262_lba = 0;
            }
            cd_seek_lba = (uint32_t)r1262_lba;
        }
        r861_out("[cd] Setloc BCD %02X:%02X:%02X -> LBA %u\n",
                cd_params[0], cd_params[1], cd_params[2], cd_seek_lba);
        /* R896 (c492, manager - THE TIMING FIX): the c492 death tail proved
         * the install chain runs its factory IMMEDIATELY after the seek and
         * reads the member's NATIVE TABLE from the staging buffer to compute
         * size (heap factory(0x800AFC98) size=0, dec len=0, all zeros) —
         * our doorbell delivered file#7's 7 sectors AFTER the chain already
         * consumed the empty buffer. Delivery must be SYNCHRONOUS at seek
         * time so the factory reads REAL bytes. Gate: the archive-era pair
         * (file#6 LBA 108884 / file#7 LBA 108886 — the c492 evidence class;
         * boot files #2-#5 keep the proven FIFO/doorbell machinery). */
        { static unsigned r896_fires;
          uint32_t r896_size = 0u;
          if (cd_seek_lba == 108884u) r896_size = 2660u;
          else if (cd_seek_lba == 108886u) r896_size = 13768u;
          if (r896_size != 0u && r896_fires < 16u) {
              uint32_t r896_dst = xenolift_mem_read32(0x8004FE08u);
              if (r896_dst >= 0x80010000u && r896_dst < 0x801F0000u
                  && (r896_dst & 3u) == 0u) {
                  uint32_t r896_nsec = (r896_size + 2047u) / 2048u;
                  for (uint32_t i = 0u; i < r896_nsec; i++)
                      disc_read_lba(cd_seek_lba + i,
                          xenolift_mem + (r896_dst - 0x80000000u) + i * 2048u);
                  /* event announcement, same as the doorbell (R891 pattern) */
                  xenolift_mem_write32(0x8006A22Cu,
                      xenolift_mem_read32(0x8006A22Cu) + 1u);
                  uint32_t sb = xenolift_mem_read32(0x80056788u);
                  xenolift_mem_write32(0x80056788u, sb | 6u);
                  uint16_t one2 = 1;
                  memcpy(xenolift_mem + (0x800578A6u & 0x1FFFFFFFu), &one2, 2);
                  /* the archive layer's success posture (R892/R893 contract) */
                  xenolift_mem_write32(0x8005FDFCu, 0u);
                  xenolift_mem_write32(0x8005FE48u, 1u);
                  xenolift_mem_write32(0x8005FE1Cu, 0u);
                  /* R897 (c493): c493's exitdiag showed FDF8(4F)=0x0A64 still
                   * owed at kit exit — the kernel's OWN consumption ledger
                   * never counted down because our sync delivery bypassed
                   * the FIFO and I deliberately skipped the ledger stamps.
                   * WRONG CALL: the proven f5fix/R891 pattern zeroes
                   * FDF8/FE1C/FE04 at delivery-complete so the kernel's
                   * WaitArchiveCdData sees the read finished WITH data on
                   * board. Stamp them here, same as the doorbell does. */
                  xenolift_mem_write32(0x8004FDF8u, 0u);
                  xenolift_mem_write32(0x8004FE1Cu, 0u);
                  xenolift_mem_write32(0x8004FE04u, 0u);
                  r896_fires++;
                  r861_out("[sdoor] R896 SYNC DELIVERY AT SEEK: LBA %u size %u -> %u sectors to dst %08X BEFORE the install chain runs (factory reads the REAL native table now); event posted (A22C+1 slotbits %08X->%08X flag578A6=1); archive posture FDFC(5F)=0 FE48(5F)=1 FE1C(5F)=0\n",
                          cd_seek_lba, r896_size, r896_nsec, r896_dst,
                          sb, sb | 6u);
                  fflush(stderr);
              } else {
                  r861_out("[sdoor] R896 seek LBA %u known (size %u) but FE08 dst invalid (%08X) - no sync delivery\n",
                          cd_seek_lba, r896_size, r896_dst);
              }
          }
        }
    } else if (cmd == 0x0Eu && cd_param_n >= 1u) { /* Setmode — R149
         * (STR_PIPELINE.md checklist #3): the movie player sets mode
         * 0x80/0xE0 (2x double-speed + XA-ADPCM + raw sectors) before
         * STR streaming. Log the transition; 2x does not change our
         * instant-serve model but flags the STR phase in the digest. */
        uint8_t m = cd_params[0];
        r861_out("[cd] Setmode 0x%02X (speed=%sx XA=%s realidx=%s ReportAF=%s)\n",
                m, (m & 0x80u) ? "2x" : "1x", (m & 0x20u) ? "on" : "off",
                (m & 0x08u) ? "raw" : "cooked", (m & 0x10u) ? "on" : "off");
    } else if (cmd == 0x06u || cmd == 0x09u) { /* ReadN/ReadS: data will be
        served from seek LBA. R163: per psx-spx, 0x09 = CdlReadS (streams
        sectors like ReadN, variable speed) — the R124-era model wrongly
        classed it as Pause and STOPPED the drive, starving the kernel's
        deep-boot 0x09 requests (cycle-14 park: file#6, FDF8=2660 stuck,
        read_active=0, 329 response re-primes, no sectors). */
        /* Anchor the served sector to the CDFS's OWN expected LBA
         * (cell 0x8004FE04): the data handler verifies the sector
         * header address against this cell (compare in fn 0x8002B084),
         * and it advances by +1 per accepted sector (MIPS delay-slot
         * increment at 0x8002B178). Anchoring here keeps the header
         * check passing even when our event ordering made the kernel
         * issue ReadN before it processed the Setloc. */
        uint32_t expect = xenolift_mem_read32(0x8004FE04u);
        if (expect != cd_seek_lba) {
            r861_out("[cd] ReadN: serving LBA %u (kernel expected, "
                            "was seeked %u)\n", expect, cd_seek_lba);
            cd_seek_lba = expect;
        }
        cd_read_active = 1;
        cd_data_loaded = 0; /* load on first demand (status poll/data read) */
    } else if (cmd == 0x08u) { /* Stop (0x09 re-classed ReadS in R163) */
        cd_read_active = 0;
    }
    /* R263: remember the FULL response so a re-prime replays it. Cycle-11:
     * GetTN answered (stat,01,01), consumed, then the kernel re-read the port
     * and the re-prime handed back ONE status byte = truncated TOC = re-ask
     * treadmill (10x). */
    memcpy(cd_last_full, cd_resp, sizeof cd_resp); cd_last_full_n = cd_resp_n;
    if (cd_resp_n > 1u) { memcpy(cd_pend_ans, cd_resp, sizeof cd_resp); cd_pend_ans_n = cd_resp_n; cd_pend_ans_cmd = (uint8_t)cmd; } /* R307 */
    mv_last_cd_pass = mv_pass_now;
    cd_param_n = 0; /* parameter fifo consumed by the command */
    /* Event-driven arrival: the response is NOT pending yet. It becomes
     * "ready" (INT3 raised) when the kernel's event-flag check function
     * (fn 0x8004B894, which reads the RAM flag cell 0x800578A6) is next
     * entered — our stand-in for the asynchronous controller interrupt.
     * The kernel's wait loops poll that flag cell, not the CD registers,
     * so a read-triggered delay would never fire inside them. */
    cd_pending = 0;
    cd_scheduled = 1;
    cd_sched_seq++; /* R1291v3: seq on every SET */
    /* R252 LOG BUDGET: a stuck wait class (cycle-1-R250 GetStat treadmill)
     * can log millions of lines — the GB-scale run.log stalled the digest
     * greps 220s (bridge watchdog kill mid-digest). First 40, then every
     * 65536th. */
    static uint32_t cd_log_n;
    cd_log_n++;
    if (cd_log_n <= 40u || (cd_log_n & 65535u) == 0u)
        r861_out("[cd] command 0x%02X -> INT3 scheduled (event delivery) (n=%u seq=%u t=%u era=%u)\n", cmd, cd_log_n, cd_sched_seq, xl_wall(), xenolift_r1302_era);
}

uint32_t cdreg_r[8], cdreg_w[8]; /* per-index read/write counters (R95) */
static int cd_write(uint32_t p, uint32_t v)
{
    if (p >= 0x1F801800u && p <= 0x1F801803u) cdreg_w[p - 0x1F801800u]++;
    {   /* R1246 (c103): while the fetch camera is armed, receipt every CD
         * register write (addr, index, width, value) so the legacy fetch's
         * command sequence and the model's command processing are visible.
         * Decays after 24 prints so streaming-era writes don't flood. */
        if (g_r1246_fetch && g_r1246_wprints < 16u) {
            r861_out("[fetchw] R1246 reg write %08X val=%u idx=%u (#%u)\n",
                    p, v, cd_index, g_r1246_wprints);
            if (++g_r1246_wprints >= 16u) g_r1246_fetch = 0;
        }
    }
    v &= 0xFFu;
    switch (p) {
    case 0x1F801800:
        cd_index = v & 3u; /* register bank select */
        return 1;          /* reads of 800 return STATUS, not the index */
    case 0x1F801801:
        if ((cd_index & 3u) == 0u) {
            cd_cmd((uint8_t)v); /* command register (bank 0) */
        }
        return 1;
    case 0x1F801802:
        if ((cd_index & 3u) == 0u) { /* parameter fifo (bank 0) */
            if (cd_param_n < sizeof(cd_params))
                cd_params[cd_param_n++] = (uint8_t)v;
            return 1;
        }
        if ((cd_index & 3u) == 1u && (v & 7u) == 7u && cd_arm_int1_pending) {
            /* final ack concluding a ReadN's INT3: the drive now has the
             * sector ready -> raise INT1 so the pump's slot-4 data
             * handler drains the FIFO into the kernel's buffer. */
            cd_arm_int1_pending = 0;
            cd_resp[0] = 0x02; /* data-ready status byte */
            cd_resp_n = 1;
            cd_resp_pos = 0;
            cd_pending = 1; cd_pending_stamp(1u, 1u);
            if (!cd_data_loaded)
                cd_data_load();
            r861_out("[cd] ReadN ack pair done -> INT1 armed (LBA %u, %u bytes)\n",
                    cd_seek_lba, cd_data_n);
            g_cd_irq_force = 1;
            return 1;
        }
        /* fall through to bank1 ack handling */
    case 0x1F801803:
        if ((cd_index & 3u) == 0u) {
            /* request register: bit7 = want-data (arm the NEXT data
             * interrupt). It does NOT reset the data FIFO — the kernel
             * issues it before EVERY DMA arm (see fn 0x80042AA8), and
             * the position read + data read of one sector must see a
             * CONTINUOUS stream (12-byte header, then 2048 user bytes).
             * The FIFO reload happens in the DMA drain hook, when a
             * sector is fully consumed. */
            return 1;
        }
        if ((cd_index & 3u) == 1u && (v & 7u) == 7u) {
            /* acknowledge interrupt (write 7 to the flag register). The
             * sync "clear stale" path acks responses it doesn't want —
             * from the driver's point of view the op is over either way,
             * so the kernel op flag must clear here too (otherwise the
             * event pump spins forever waiting for a consumed response
             * that was discarded). */
            uint16_t zero = 0;
            int was_pending = (cd_pending != 0);
            uint8_t was_level = cd_pending;
            cd_pending = 0;
            if (was_pending) { /* R1167: cleared-line - acknowledged? */
                xenolift_receipt("[pendclr] R1167 pending INT%u (site=%u cmd=%02X LBA=%u) CLEARED @t=%lds, %lds after armed, %u pumps since set, clears=%u\n",
                    (unsigned)was_level, (unsigned)g_pend_site, (unsigned)g_pend_cmd,
                    g_pend_lba, (long)(xl_wall() - g_boot_wall_t0),
                    (long)(xl_wall() - g_pend_set_t), g_pend_pumps, g_pend_clears);
                g_pend_clears++;
            }
            cd_resp_n = cd_resp_pos = 0;
            if (was_pending && was_level == 3u && cd_read_active
                && cd_last_cmd == 0x06u) { /* R1317 (c222): PAUSE (09) no longer rides the ReadN INT1 ack-pair - Jos PSX-SPX corrected model; the R163-era ReadS grouping retired */
                /* this ack pair concludes a ReadN's INT3: after the
                 * final 802-ack, raise INT1 (sector data ready). */
                cd_arm_int1_pending = 1;
            }
            /* R124 (psx-spx): Pause (0x09) delivers a SECOND response
             * — INT2 (Complete), 1 stat byte with bit5 Read CLEARED —
             * after its INT3 ack. The kernel's fd layer treats the
             * INT2 as "drive officially stopped, request done": it
             * pops the queue and services the next request (the
             * overlay module file read). Without this the pump polls
             * GetStat forever on a state that never changes. */
            if (was_pending && was_level == 3u
                && (cd_last_cmd == 0x0Au
                    || cd_last_cmd == 0x07u
                    || cd_last_cmd == 0x08u
                    || cd_last_cmd == 0x1Au
                    || cd_last_cmd == 0x09u)) { /* R1317 (c222): PAUSE second-response INT2 restored - the R163 removal retracted; Pause ENDS reading per PSX-SPX */ /* R262: GetID has the same INT3-then-INT2 shape */ /* 0x09 ReadS removed R163; R208: Stop (0x08) same shape — cycle-41 Mac: reads completed FDF8->0, kernel sent Stop (0x08) between files and parked polling its completion; the re-prime treadmill spun (7x, last_cmd=0x08) because the Stop INT2 never armed */
                /* R124: Pause second response INT2; R132: Init (0x0A)
                 * has the SAME two-response shape per psx-spx
                 * (INT3(stat) then INT2(stat)). R147: Seek (0x07) TOO —
                 * the R146 Mac read file 18 COMPLETE (FDF8->0, all
                 * sectors to the 0x801F0494 install region, module
                 * native at 0x8006F000), then issued Seek(0x07) to LBA
                 * 109166 (first-past-the-module territory), got the
                 * INT3 ack, and PARKED in the fd processor (r31=
                 * 0x80041C78, r16=0xE fd queue, r11/r15 holding the
                 * movie-module tail 0x80076F3B/43) waiting for the
                 * Seek's INT2 that this model never armed — the same
                 * missing-second-response class R123 found for Pause.
                 * Stat: motor on, Read cleared (the drive is AT the
                 * target, not reading). */
                cd_resp[0] = 0x02u; /* motor on, Read cleared */
                cd_resp_n = 1;
                cd_resp_pos = 0;
                cd_pending = 2; cd_pending_stamp(2u, 2u); /* INT2: Complete */
                if (cd_last_cmd == 0x1Au) { /* GetID INT2: stat, flags, type(0x20=mode2 licensed), atip, "SCEA" */
                    cd_resp[1] = 0x00u; cd_resp[2] = 0x20u; cd_resp[3] = 0x00u;
                    cd_resp[4] = 'S'; cd_resp[5] = 'C'; cd_resp[6] = 'E'; cd_resp[7] = 'A';
                    cd_resp_n = 8;
                    r861_out("[cd] GetID complete: INT2 (licensed mode2, SCEA) armed\n");
                } else if (cd_last_cmd == 0x07u)
                    r861_out("[cd] Seek complete: INT2 (at target %u) armed\n", cd_seek_lba);
                else if (cd_last_cmd == 0x08u) {
                    r861_out("[cd] Stop complete: INT2 (drive stopped) armed\n");
                    cd_motor_on = 0; /* R212: spindle OFF after Stop */
                }
                else
                    r861_out("[cd] Pause complete: INT2 (drive stopped) armed\n");
            }
            if (was_pending) {
                memcpy(xenolift_mem + (0x800578A6u & 0x1FFFFFFFu), &zero, 2);
                r861_out("[cd] interrupt acknowledged (op flag cleared)\n");

{ static uint32_t ack_cam; uint32_t ac_fe1c = xenolift_mem_read32(0x8004FE1Cu);
  if (cd_seek_lba >= 108933u && cd_seek_lba < 108996u) {
    /* R561 STARVE FIX: c129 verdict — the guest ack loop runs in execution
     * context where the SIGALRM heartbeat STARVES (wd fired t=30s then not
     * until t=200s; the f14pump armed its only sector on the only tick it
     * got). This code runs on EVERY ack INSIDE the loop — re-arm the host
     * timer here so on_alarm keeps ticking through the loop, and count acks
     * between ticks so the next digest shows the starvation directly. */
    g_ack_starve++;
    alarm(1); /* fresh 1s heartbeat from inside the loop — pump engine stays alive */
    if (ack_cam < 16u) { ack_cam++; /* R875: streaming-era canary cap */
      r861_out("[ackcam] R561 field-era ack#%u starve=%u t=%lds: FE1C=%u pend=%u last_cmd=%02X seek=%u resp_n=%u resp_pos=%u data=%u/%u\n",
              ack_cam, g_ack_starve, (long)(xl_wall() - g_boot_wall_t0), ac_fe1c, cd_pending, cd_last_cmd, cd_seek_lba, cd_resp_n, cd_resp_pos, cd_data_pos, cd_data_n);
    } } }
            } else {
                r861_out("[cd] interrupt acknowledged\n");
            }
        }
        return (cd_index & 3u) == 1u ? 1 : 0;
    }
    return 0;
}

/* R396 REGISTER-POLL DELIVERY. Cycles 152/153 park: field-era ReadN
 * waits in the kernel's LOW-LEVEL driver poll (fault regs: r3=0x1F801802,
 * r31 in the 0x80028xxx CD driver) reading the INT flag register — but a
 * SCHEDULED response (cd_scheduled=1) only becomes pending when the
 * kernel's event-flag check fn (0x8004B894/0x8004293C/0x800286CC dispatch
 * hooks) runs, which this wait loop never reaches -> deadlock (park:
 * sched=1 resp_n=1 pending=0 for 130s+). psx-spx hardware truth:
 * 1F801802h/1F801803h.Index1 bits 0-2 ("Response Received") show the
 * drive's interrupt AS SOON AS the response is ready — no event-layer
 * gating. Deliver inline at the INT-flag poll: pure HLE state writes +
 * the RAM flag cell 0x800578A6 the kernel polls (R113 instant-release
 * precedent). NO guest dispatch from this MMIO-read context (R350).
 * Guard mirrors the event-hook defer: skip while a sector event is in
 * flight (cd_pending!=0) or mid-stream (0x800286CC variant guard). */
static void cd_sched_poll_release(void)
{
    uint8_t r1294_ent = cd_scheduled; /* R1294 (Jos v4): entry state for the WIN receipt at fn end */
    /* R399 SEEK-WIDEN: cycle 156 — the kernel mounted state 1 (FIELD,
     * Channel F + native commit at fn_80036760: req(8088)=1, sentinel
     * 92C0=-1), restart step consumed it, and the mount chain issued the
     * field data seek (Setloc 24:14:33 -> LBA 108933) — then stalled: the
     * seek reply has NO delivery vehicle in this era (the R395 menu-frame
     * assist died with the menu era; the event-hook fns are not reached;
     * the R398 gate accepted only cmd 06). The seek reply (cmd 02) needs
     * the same poll delivery. Boot-safety: the cmd-06 deliveries fired 6x
     * during boot c156 with zero harm (hardware-faithful: the reply IS
     * ready; the INT flag register must show it) — cmd-02 seeks during
     * boot module reads share the identical signature and are equally
     * hardware-faithful. R397 gate history: ungated release broke boot
     * (c154) by stealing deliveries with NO signature match; the
     * response-wait signature (FE1C==2 + FE04==seek + FDF8!=0) is the
     * safety boundary, not the command byte. */

    /* R611 TRUE ENDGAME BRANCH: c178 proved the R610 twin could never fire —
     * the shared gate tail (FDF8!=0, FE04==seek) re-applied the read-era legs
     * to the completion posture that lacks them BY DEFINITION. Hoisted here,
     * the tail legs are bypassed ONLY for this exact fingerprint:
     * GetStat poll + state-7 seek-waiter + needle inside file-15 band +
     * ledger drained (the R607 success state) + stream ring slot armed. */
    int r611_end = (cd_last_cmd == 0x01u
        && xenolift_mem_read32(0x8004FE1Cu) == 7u
        && cd_seek_lba >= 108995u && cd_seek_lba < 109041u
        && xenolift_mem_read32(0x8004FDF8u) == 0u
        /* R1301 (c199, Jos repair-the-branch): the FE08 term was a stale
         * c179-era hardcode (0x8007F2F8 - the old field ring slot); the c198
         * receipts show the game polling this EXACT posture with FE08=80213680
         * then 80200680 (schdd seq 264 blocked x8: cmd=01 fe1c=7 FDF8=0
         * seek=109004 FE04=109041 resp=0/1 A22C=4) - the gate declined the
         * posture it was built for because ONE term fossilized. Loosened to
         * a RAM-pointer sanity check: any valid response/ring slot. Delivery
         * then runs through the EXISTING R612/R615 machinery (status 0x02,
         * receipted accepted) + R613 event leg - ONE delivery per scheduled
         * seq (sched must be 1 and the delivery clears it through the
         * normal bookkeeping; unread responses preserved - the r611 branch
         * primes only its own 1-byte answer in its own posture). */
        && xenolift_mem_read32(0x8004FE08u) >= 0x80010000u
        && xenolift_mem_read32(0x8004FE08u) < 0x80200000u);
    /* R397 FIELD-SIGNATURE GATE (kept): response-wait state + request
     * matches drive + bytes still wanted — boot and plain movie eras
     * can never match when no read is armed (FDF8==0 / FE04 mismatch). */
    /* R401 STATE-WIDEN: c158 park — the field Setloc reply waits at
     * FE1C=1 (seek-issued wait), NOT state 2 (read-issued); the R400
     * release sat in every polled branch yet never fired because the
     * gate demanded state 2 only. Accept BOTH reply-wait states. */
    /* R614 TRUE TOP-LEVEL HOIST (c181: r613post=0 while 11 releases fired
     * as ordinary cmd-02/06 seek replies — the OUTER command leg
     * (cmd==02||06) gates the WHOLE chain, so the cmd-01 completion
     * branch inside the OR-chain could never fire. Same lesson as R611,
     * one level up: the completion posture must own its OWN top-level
     * leg, not share the read-era command gate. */
    /* R628 INSTALL-DONE LEG (c198: RESUMEFIX fired, file-14 install COMPLETED
     * - FDF8 walked full->0, done-path ran, PA positioned next entry FE04=108989.
     * New park posture: cmd=02 sched=1 pend=0 at fe1c=0 with FDF8==0 FDFC==0 -
     * the CONCLUDED wait. The c181-era gate demands fe1c 1/2 + FDF8!=0
     * (read-in-flight); this waiter is read-finished, drive at the answered
     * position. The scheduled reply was queued at issue - deliver it. */
    /* R1203 (c8 receipts): ReadS stream-accept release. The movie-threshold
     * posture receipts cmd=09 at seek=109166 holding EVERY R628 concluded-wait
     * condition (FE1C=0, FDF8=0, FE04==seek, sched=1, pend=0, resp_n=1 armed)
     * with NO release path that knows 0x09 - the 02/06-only gates leave the
     * command-ack queued forever (c8 fld2sig: loaded=0, data=0/2060, movie-poll
     * alive n=8.69M deferring the watchdog). The drive CAN serve the band
     * (drain receipt: 'sector LBA 109166 loaded into data FIFO') and the
     * data-port streamer (sector consumed -> seek++ -> INT1 pending) streams
     * continuously once the ack lands. Same disease R628 named for
     * install-done. ReadS = the game's movie stream command. */
    { /* R1300 (c196, THE MOVIE-WAIT GETSTAT DELIVERY - the c197 receipts
       * name the defect): the seq chain receipted the terminal wedge
       * COMPLETE for the first time - SET (cmd 02 seq 127) -> BLOCKED x4
       * (FDF8=14360 armed, seek=3, resp=0/0) -> defib6 completed the load
       * (dest-held, 2nd receipt) -> CLEAR ran (seq 127, sched=0) -> the
       * game own timeout moved it to FE1C=10/cmd 01 -> BLOCKED x4 (seq 128,
       * cmd=01 fe1c=10 FDF8=0 seek=3 FE04=109158 A22C=5) -> NO CLEAR, NO
       * DELIVERY - the notification is proven LOST (the c351 discipline
       * satisfied: scheduled + blocked-with-terms + never-cleared to the
       * fuse). THE DEFECT: the c169-era R412 cmd-01/fe1c-10 release gate is
       * STRUCTURALLY DEAD - nested inside the cmd-02/06 outer conjunction,
       * it can never match (cmd 02||06 AND cmd 01 = always false), and its
       * field-band terms (seek==FE04, FDF8!=0) decline this posture anyway.
       * THE FIX: deliver the 1-byte ready status (0x02 motor-on, per the
       * R612/R615 precedent the game receipted accepting for its read-era
       * GetStat polls, R594/Pause psx-spx status byte) + INT3 + the flag
       * word - the sanctioned response-delivery class (R612 delivered 426
       * receipted). NOTHING ELSE: no FE1C writes, no A22C writes (the game
       * clears its own flags - receipted), no slotbits event (that was the
       * seek-complete posture). REVERT: if the game stays parked (FE1C
       * never moves off 10, no new SETs) after deliveries, revert next
       * cycle. PASS: FE1C moves, new SETs issue, the movie era advances
       * (mdec receipts). */
        static int r1300_n;
        /* R1302 (c200, Jos #5 RETIRE): the R1300 parallel door RETIRED - its
         * class (cmd-01 GetStat probe waiting at fe1c 10) is now owned by the
         * REPAIRED R412 branch in the main release ladder below (the c169
         * nesting bug fixed in place, band restriction removed). The c199 run
         * VALIDATED the door's delivery content end-to-end (seq 128 delivered
         * exactly once, CLEAR L1300, schdd WIN, guest consumed it - new
         * commands + FE1C walked 10->11), so the repaired branch delivers the
         * same content through the NORMAL bookkeeping (shared body: computed
         * status, sched retire at L2378, INT3 pend=3, flag 578A6, R613 event
         * leg). No parallel path remains. */
    }
    if (cd_scheduled && cd_pending == 0u
        && (cd_last_cmd == 0x02u || cd_last_cmd == 0x06u || cd_last_cmd == 0x09u)
        && xenolift_mem_read32(0x8004FE1Cu) == 0u
        && xenolift_mem_read32(0x8004FDF8u) == 0u
        /* R629 (c199): the real concluded park holds FDFC=1 (PA stamped
         * its entry-positioned flag at install-done, PA#5 receipt). The
         * FDFC==0 demand was one flag too strict - 3 boot-region releases
         * fired but the seek=108989 field park never matched. Concluded
         * posture = fe1c==0 + FDF8==0 + FE04==seek; FDFC is not a gate. */
        && cd_seek_lba != 0u
        && xenolift_mem_read32(0x8004FE04u) == cd_seek_lba) {
        cd_restore_pend();
        { static int r628n; if (r628n < 8) { r628n++; /* R875: streaming-era canary cap */
            r861_out("[cd] R628 install-done release: cmd=%02X stat=%02X seek=%u FE04=%u - concluded-wait answer delivered\n",
                    cd_last_cmd, cd_resp[0], cd_seek_lba, xenolift_mem_read32(0x8004FE04u)); } }
        cd_scheduled = 0;
                        { static int sdw_2333; if (sdw_2333 < 2) { sdw_2333++; r861_out("[schdw] R1291 CLEAR site L2333 ran (seq=%u t=%u): pend=%u act=%u sched=0 FDF8=%u FE04=%08X fe1c=%u last_cmd=%02X resp=%u/%u (popped/armed = guest-ack vs runtime-only)\n", cd_sched_seq, xl_wall(), (unsigned)cd_pending, cd_read_active ? 1u : 0u, xenolift_mem_read32(0x8004FDF8u), xenolift_mem_read32(0x8004FE04u), xenolift_mem_read32(0x8004FE1Cu), (unsigned)cd_last_cmd, (unsigned)cd_resp_pos, (unsigned)cd_resp_n); } } /* R1291v3 schdw tracer */
        cd_pending = 3; cd_pending_stamp(3u, 3u); /* INT3: response ready in the FIFO */
    }
    if (cd_scheduled && cd_pending == 0u
        && (r611_end
            || ((cd_last_cmd == 0x02u || cd_last_cmd == 0x06u)
                && (xenolift_mem_read32(0x8004FE1Cu) == 1u
                    || xenolift_mem_read32(0x8004FE1Cu) == 2u)
                && cd_seek_lba != 0u
                && xenolift_mem_read32(0x8004FE04u) == cd_seek_lba
                && xenolift_mem_read32(0x8004FDF8u) != 0u)
            /* R1302 (c200, Jos REPAIR-THE-BRANCH, replaces the retired R1300
             * door): the R412 cmd-01 probe arm was nested INSIDE the cmd-02/06
             * conjunction since c169 - STRUCTURALLY DEAD (cmd 02||06 AND cmd
             * 01 = always false), which is why the c197 seq-128 response
             * scheduled, blocked x4, and never delivered. Now a GENUINE
             * alternative arm: band restriction REMOVED (the c197 receipts
             * show the waiter at seek=3), content VALIDATED by the c199 run
             * (seq 128 delivered once, guest consumed, FE1C walked 10->11).
             * EXACTLY-ONCE + UNREAD-PRESERVE: fires only when the response
             * FIFO holds no unread bytes; the outstanding scheduled response
             * is delivered once and retired through the NORMAL bookkeeping
             * (shared body: computed status, sched=0 at L2378, INT3 + flag). */
            || (cd_last_cmd == 0x01u
                && (xenolift_mem_read32(0x8004FE1Cu) == 10u
                    || xenolift_mem_read32(0x8004FE1Cu) == 11u)
                && (cd_resp_n == 0u || cd_resp_pos >= cd_resp_n))
            /* R1310 (c209, the seq-130/132 repair): the c208 receipts name
             * the NEXT missing transition - the game ALIVE polling GetStat
             * (cmd 0x01) every ~2s while waiting in its OWN protocol
             * states: schdd seq 130 BLOCKED (cmd=01 fe1c=10 FDF8=2048
             * seek=1 resp=0/1) then seq 132 BLOCKED x8 (cmd=01 fe1c=11
             * FDF8=0 FE04=1 seek=1 resp=0/1), every poll declined, the
             * game own timeout walking it into the fault era, 16
             * recoveries, TRUE DEATH. The R1302 arm above declines BOTH
             * postures: fe1c=11 is not its wait state, and resp=0/1 is
             * the command OWN 1-byte ack ARMED AT SET (the builder primes
             * it at arrival - the same receipted principle as the c206
             * seq-129 correction, now demonstrated for the GetStat class:
             * an armed-unpopped 1-byte envelope during the poll loop is
             * the pending delivery, NOT stale unread data). THIS arm
             * admits the RECEIPTED poll postures: cmd 0x01 + wait state
             * 10 or 11 + the single-byte own-ack envelope (n==1, pos<1)
             * when the R1302 arm declined - delivered through the SAME
             * shared body (cd_restore_pend re-primes the command own
             * envelope; sched retired at L2378 = exactly-once per seq;
             * INT3 + flag 578A6; NO R613 event, r611_end stays false).
             * REVERT next cycle if the game stays in the fe1c=11 wait
             * after deliveries with NO new SETs and NO LBA consumption
             * progress (the pre-registered rule). */
            || (cd_last_cmd == 0x01u
                && (xenolift_mem_read32(0x8004FE1Cu) == 10u
                    || xenolift_mem_read32(0x8004FE1Cu) == 11u)
                && cd_resp_n == 1u
                && cd_resp_pos < 1u)
            /* R1302 (c200, the seq-129 repair): the c199 receipts name the
             * NEXT missing transition as the same class one state later -
             * schdd seq 129 BLOCKED x4: cmd=13 (GetTN) fe1c=11 with the
             * 3-byte TOC answer ALREADY ARMED in the FIFO (resp=0/3,
             * A22C=5). The ladder had NO arm for the game's directory-wait
             * state. THIS arm delivers the ARMED answer through the shared
             * body: cd_restore_pend re-primes the full multi-byte TOC answer
             * (R307/R262 hardware order - one stat byte = retry forever),
             * retired once through the normal bookkeeping. The armed-but-
             * unpopped FIFO (pos<n) is the NORMAL build-time posture for a
             * multi-byte answer, not stale unread data - the R1302 unread
             * guard applies only to the GetStat arm. */
            || (cd_last_cmd == 0x13u
                && xenolift_mem_read32(0x8004FE1Cu) == 11u)
            /* R1304 (c202, the seq-140/149/161 repair): the c201 receipts
             * name the NEXT missing transition - the game advanced PAST
             * the served+consumed GetTN to the directory sector re-read
             * (Setloc 0 -> GetTN answered -> ReadN LBA 0) and waits at
             * fe1c=10: schdd BLOCKED seq 140, 149, 161 in BOTH eras at
             * three dest buffers (80075AF8, 80077AF8, 800792F8): cmd=02
             * fe1c=10 FDF8=2048 FE04=0 seek=0 resp=0/0 A22C=5 - the ladder
             * has NO arm for a read-command ack in the fe1c=10
             * response-wait state (the cmd-02/06 arms demand fe1c 1|2 and
             * seek!=0; the R412 fe1c-10 class was repaired for cmd-01
             * only). THIS arm admits the RECEIPTED posture: read command +
             * wait-state 10 + drive at its own FE04 position + bytes
             * armed (FDF8!=0) + no unread response bytes (exactly-once,
             * unread-preserve). Delivery runs through the SAME shared
             * body: restore_pend = the command's OWN saved ack envelope
             * (no hardcode - the game receipted accepting these envelopes
             * for its read-era commands, R612/R628 precedent), sched
             * retired at L2378, INT3, flag 578A6; NO R613 event (r611_end
             * stays false - no seek-complete forgery). The data phase is
             * untouched: the drive serves sectors through its own
             * machinery; only the queued ACK is released. REVERT: if the
             * game stays parked at fe1c=10 after ack deliveries (no new
             * SETs, no drain progress), revert next cycle. */
            || ((cd_last_cmd == 0x02u || cd_last_cmd == 0x06u)
                && xenolift_mem_read32(0x8004FE1Cu) == 10u
                && xenolift_mem_read32(0x8004FE04u) == cd_seek_lba
                && xenolift_mem_read32(0x8004FDF8u) != 0u
                && (cd_resp_n == 0u || cd_resp_pos >= cd_resp_n))
            /* R1308 (c206, the seq-129/139 SYSTEM-AREA read-ack repair):
             * the c206 receipts (R1306 wait-branch camera) FALSIFIED the
             * spin diagnostic - LegacyCdDataWait returns ret==0 with
             * FDFC==0 and FE1C==0 on the SAME invocation (16 receipts,
             * no value change), all three "spin exit" terms met, yet the
             * game frame loop continues: the label was misidentifying
             * the stall. The REAL blocker is receipted WITH TERMS by
             * schdd: seq 139 BLOCKED x3+ - cmd=02 fe1c=1 FDF8=0
             * FE04=00000001 seek=0 FDFC=0 FE08=800772F8 resp=0/1
             * A22C=5 - and the same class at seq 124/129 (c205/c206).
             * THE READ-ACK FOR THE SYSTEM-AREA DIRECTORY READS (LBA
             * 0-149, the game own post-archive Setloc-0 -> ReadN chain)
             * HAS NO ARM: the cmd-02/06 arms demand seek!=0 + FE04==seek
             * + FDF8!=0 (terms written for the field-band class - the
             * c346 audit lesson: conditions written for a different
             * class), and R1304 admits fe1c=10 only. THIS arm admits the
             * RECEIPTED posture: read command + the fe1c 1|2 response-
             * wait states + drive parked at seek==0 + a system-area
             * request LBA in FE04 (nonzero, <150). resp=0/1 at the
             * block is THIS command own 1-byte ack armed at SET (the
             * builder primes it on arrival) - NOT a stale unread byte,
             * so no unread guard here (the R1302 judgment: armed-
             * unpopped is the normal build-time posture of an answer).
             * Delivery = the SAME shared body: restore_pend re-primes
             * the command OWN envelope, sched retired at L2378
             * (exactly-once: the outer cd_scheduled gate + the retire
             * make each seq deliver once), INT3 + flag 578A6, NO R613
             * event (r611_end false - no seek-complete forgery). The
             * data phase is untouched: sectors flow through the drive
             * own machinery. REVERT: if the game stays at the fe1c=1
             * system-area wait after ack deliveries (no new SETs, no
             * LBA 0/1 consumption progress), revert next cycle. */
            || ((cd_last_cmd == 0x02u || cd_last_cmd == 0x06u)
                && (xenolift_mem_read32(0x8004FE1Cu) == 1u
                    || xenolift_mem_read32(0x8004FE1Cu) == 2u)
                && cd_seek_lba == 0u
                && xenolift_mem_read32(0x8004FE04u) != 0u
                && xenolift_mem_read32(0x8004FE04u) < 150u)
            /* R1322 (c242, the seq-112 state-1 re-aim ack): the c239/c241
             * receipts name the state-1 file#15 chain missing transition -
             * the state-1 CB entered, the f15 request stamped (FE04=108995
             * FDF8=92180 F0C=15), the drive ARMED (act=1 seek=108995
             * data=2060/0), yet READ ISSUED file#15 never fires and
             * schdd seq 112 BLOCKS x4+ on the receipted posture: cmd=02
             * fe1c=0 FDF8=0 FDFC=0 seek=108995 FE04=108989 resp=0/3 -
             * the PA restamped FE04 to the NEXT entry LBA while the
             * drive sits armed at seek (the R628 arm declines by exactly
             * one term, FE04==seek; every other arm demands the
             * read-in-flight shape fe1c 1|2 FDF8!=0 or the system-area
             * shape seek==0). THIS arm admits the RECEIPTED re-aim
             * posture: Setloc + fe1c=0 + FDF8=0 + both cells valid
             * file-band LBAs but unequal + the drive armed - delivered
             * through the SAME shared body (restore_pend re-primes the
             * command OWN envelope, sched retired at L2378 =
             * exactly-once per seq, INT3 + flag 578A6, NO R613 event -
             * no seek-complete forgery). The data phase is untouched:
             * the drive serves the next request sectors through its own
             * machinery once the game issues them. REVERT: if the game
             * stays parked (no READ ISSUED file#15, no new SETs) after
             * ack deliveries, revert next cycle. */
            || (cd_last_cmd == 0x02u
                && xenolift_mem_read32(0x8004FE1Cu) == 0u
                && xenolift_mem_read32(0x8004FDF8u) == 0u
                && cd_seek_lba >= 108900u && cd_seek_lba < 109200u
                && xenolift_mem_read32(0x8004FE04u) >= 108900u
                && xenolift_mem_read32(0x8004FE04u) < 109200u
                && xenolift_mem_read32(0x8004FE04u) != cd_seek_lba
                && cd_read_active)
            )) {
        /* R398: mid-stream guard REMOVED — cd_cmd(0x06) sets
         * cd_read_active=1 BEFORE the stat INT3 can ever deliver, so the
         * guard blocked the release in the exact scenario it gates (c155:
         * park signature matched, release silent, CD6 empty). The
         * sector-event defer is already covered by cd_pending==0. */
        /* R612 CONTENT FIX (c179: r611release=11 fired, waiter STILL parked):
         * the restore handed back the PREVIOUS cmd's answer (the seek-ack
         * envelope, n=3) for a cmd-0x01 GetStat poll — wrong envelope, wrong
         * content. The game accepted status 0x02 (motor on, not reading, not
         * seeking) for its read-era GetStat polls (R594 Pause precedent,
         * psx-spx status byte). Completion posture = seek done: deliver the
         * 1-byte status directly. */
        if (cd_last_cmd == 0x01u
            && (r611_end || xenolift_mem_read32(0x8004FE1Cu) == 10u)) {
            /* R615 + R1302 (c200, Jos): the status is COMPUTED from live
             * drive state, never hardcoded - motor-on bit always (the drive
             * streams ring sectors nonstop, fldsec receipts; a motor-off
             * GetStat tells the driver to re-spin instead of concluding),
             * reading bit only while a read is active, per psx-spx GetStat
             * semantics (R594 Pause precedent; c199-validated content). */
            cd_resp[0] = 0x02u | (cd_read_active ? 0x08u : 0u);
            cd_resp_n = 1u;
            cd_resp_pos = 0u;
        } else {
            cd_restore_pend(); /* R308: restore the full multi-byte answer */
        }
        { static int r610n; if (r610n < 400) { r610n++;
            r861_out("[cd] R612 endgame release: cmd=%02X stat=%02X fe1c=%u seek=%u - scheduled answer delivered\n",
                    cd_last_cmd, cd_resp[0], xenolift_mem_read32(0x8004FE1Cu), cd_seek_lba); } }
        cd_scheduled = 0;
                        { static int sdw_2378; if (sdw_2378 < 2) { sdw_2378++; r861_out("[schdw] R1291 CLEAR site L2378 ran (seq=%u t=%u): pend=%u act=%u sched=0 FDF8=%u FE04=%08X fe1c=%u last_cmd=%02X resp=%u/%u (popped/armed = guest-ack vs runtime-only)\n", cd_sched_seq, xl_wall(), (unsigned)cd_pending, cd_read_active ? 1u : 0u, xenolift_mem_read32(0x8004FDF8u), xenolift_mem_read32(0x8004FE04u), xenolift_mem_read32(0x8004FE1Cu), (unsigned)cd_last_cmd, (unsigned)cd_resp_pos, (unsigned)cd_resp_n); } } /* R1291v3 schdw tracer */
        cd_pending = 3; cd_pending_stamp(3u, 4u); /* INT3: response ready in the FIFO */
        uint16_t one = 1;
        memcpy(xenolift_mem + (0x800578A6u & 0x1FFFFFFFu), &one, 2);
        /* R613 EVENT LEG (c180: 426 GetStat answers popped, waiter STILL
         * parked — the answer leg was never the gate). fn_80041CA0 (the
         * game's own event dispatcher, MODSRC-shipped disasm) routes on
         * the SLOT BITS word 0x80056788: bit2 (mask 4) set -> the
         * registered seek-complete handler chain (0x800564AC cell); bit2
         * clear -> the 80041CE0 branch (the parked path we keep seeing).
         * Post the EVENT, not just the answer: slotbits |= 4 in the
         * completion posture. Wrong-bit worst case = same parked path
         * (receipt decides). */
        if (r611_end) {
            uint32_t slotbits = xenolift_mem_read32(0x80056788u);
            xenolift_mem_write32(0x80056788u, slotbits | 4u);
            { static int r613n; if (r613n < 8) { r613n++; /* R875: streaming-era canary cap - __xvprintf smash class (c466) */
                r861_out("[cd] R613 event post: slotbits %08X -> %08X (bit2=seek-complete event, handler cell 564AC=%08X)\n",
                        slotbits, slotbits | 4u, xenolift_mem_read32(0x800564ACu)); }
            /* R616: track the true walk frontier — the release receipt caps
             * hid how far the needle got each run (=ENDREL= tail now shows
             * it, but a hard number in =COUNTS= survives cap+tail edits). */
            { static uint32_t walk_steps; static long walk_t_prev;
              if (cd_seek_lba > g_walk_max) g_walk_max = cd_seek_lba;
              g_walk_last_t = g_boot_wall_t0 ? (long)(xl_wall() - g_boot_wall_t0) : 0L;
              walk_steps++;
              /* R623 EARLY LATCH: c193 fired the 92BC stamp at wrap (t=201)
               * = 4s before park -> zero observation window for the mount
               * waiter. Stamp at walk-era ENTRY instead so the whole walk
               * (84s, ~20 mount polls) runs with the success signal live.
               * Wrap-site stamp stays as a held/not-held receipt. */
              { static int early_latched;
                if (!early_latched && g_walk_max >= 109000u) {
                    early_latched = 1;
                    uint32_t lv = xenolift_mem_read32(0x800592BCu);
                    if (lv == 0u) {
                        xenolift_mem_write32(0x800592BCu, 1u);
                        r861_out("[cd] R623 mountlatch-early: 92BC forced 0 -> 1 at walk-era entry t=%lds (mount-success stamped early; watch MNTACC idx/req/92D0 across the walk)\n", g_walk_last_t);
                    } else {
                        r861_out("[cd] R623 mountlatch-early: 92BC already %08X at walk entry\n", lv);
                    }
                } }
              long now = g_boot_wall_t0 ? (long)(xl_wall() - g_boot_wall_t0) : 0L;
              if ((walk_steps & 4095u) == 0u) /* R875: was &1 - streaming-era canary cap */
                  r861_out("[cd] R617 walk frontier: steps=%u max_seek=%u t=%lds dt=%lds\n",
                          walk_steps, g_walk_max, now, now - walk_t_prev);
              walk_t_prev = now;
              /* R618 WRAP DETECTOR (c187: walk hit 109038, 2 sectors from
               * file-15 end 109040, then the game re-seeked to 108996 and
               * restarted the read — mount never concluded). One-shot: when
               * the needle drops far below the walk's max, dump the read
               * queue node + counters to fingerprint the restart decision. */
              { static int wrapped;
                if (!wrapped && g_walk_max >= 109010u && cd_seek_lba + 4u < g_walk_max) {
                    wrapped = 1;
                    r861_out("[cd] R618 WRAP DETECTED: seek %u -> %u (max %u) t=%lds | "
                            "F0C=%08X F10=%08X F14=%08X F18=%08X FDF8=%08X FDE4=%08X FE04=%08X FE08=%08X "
                            "FE1C=%08X FE20=%08X cur92C0=%08X req8088=%08X idxFAEC=%08X 92D0=%08X 92BC=%08X\n",
                            g_walk_max, cd_seek_lba, g_walk_max, now,
                            xenolift_mem_read32(0x80059F0Cu),
                            xenolift_mem_read32(0x80059F10u),
                            xenolift_mem_read32(0x80059F14u),
                            xenolift_mem_read32(0x80059F18u),
                            xenolift_mem_read32(0x8004FDF8u),
                            xenolift_mem_read32(0x8004FDE4u),
                            xenolift_mem_read32(0x8004FE04u),
                            xenolift_mem_read32(0x8004FE08u),
                            xenolift_mem_read32(0x8004FE1Cu),
                            xenolift_mem_read32(0x8004FE20u),
                            xenolift_mem_read32(0x800592C0u),
                            xenolift_mem_read32(0x80018088u),
                            xenolift_mem_read32(0x8005FAECu),
                            xenolift_mem_read32(0x800592D0u),
                            xenolift_mem_read32(0x800592BCu));
                    /* R619 (c189 fingerprint verdict): at wrap the game's
                     * remaining-bytes FDF8=0 — the read is DONE from its own
                     * accounting, yet the mount never concludes (92D0=0,
                     * idx=1 frozen) and the read restarts. The recorded plan:
                     * stamp the mount-success latch 92BC at exactly this
                     * moment (one-shot) and watch whether the mount waiter
                     * concludes (idx/req/F0C advance) or the game clears it. */
                    { uint32_t latch_v = xenolift_mem_read32(0x800592BCu);
                      if (latch_v == 0u) {
                          xenolift_mem_write32(0x800592BCu, 1u);
                          r861_out("[cd] R619 mountlatch: 92BC forced 0 -> 1 at wrap (mount-success stamp, one-shot) - watch MNTACC idx/req/92D0 next\n");
                      } else {
                          r861_out("[cd] R619 mountlatch: 92BC already %08X at wrap - NOT forced\n", latch_v);
                      } }
                } } } }
        }
        { static int rpd_logs; if (rpd_logs++ < 24)
            r861_out("[cd] INT3 delivered at INT-flag poll (register ctx, cmd 0x%02X FE1C=%u FDF8=%u)\n",
                    cd_last_cmd, xenolift_mem_read32(0x8004FE1Cu), xenolift_mem_read32(0x8004FDF8u)); }
    }
    /* R398 near-miss: every field condition holds EXCEPT FE1C==2 — log once
     * so the next digest NAMES the blocker instead of silence. */
    if (cd_scheduled && cd_pending == 0u && cd_last_cmd == 0x06u
        && cd_seek_lba != 0u
        && xenolift_mem_read32(0x8004FE04u) == cd_seek_lba
        && xenolift_mem_read32(0x8004FDF8u) != 0u
        && xenolift_mem_read32(0x8004FE1Cu) != 2u) {
        static int nm_logs;
        if (nm_logs++ < 24)
            r861_out("[cd] poll-release near-miss: FE1C=%u (need 2) sched=%u pend=%u cmd=%02X seek=%u FE04=%08X FDF8=%u act=%u\n",
                    xenolift_mem_read32(0x8004FE1Cu), cd_scheduled, cd_pending,
                    cd_last_cmd, cd_seek_lba, xenolift_mem_read32(0x8004FE04u),
                    xenolift_mem_read32(0x8004FDF8u), cd_read_active);
    }
    /* R1291v4 (Jos c193 placement correction): THE DELIVERY-DECISION RECEIPT
     * now sits at the END of the ladder - it fires only when EVERY release
     * branch above has DECLINED this invocation, so the observation is
     * genuinely post-ladder (a top-of-ladder print would observe ENTRY
     * state, a different thing). Every gate term printed with the seq:
     * first 8 evaluations then 1 per 4096. ABSENT here while [cd] SET
     * prints continue = this whole delivery path ran cold - a different
     * missing transition, also distinguishable now. */
    if (cd_scheduled && cd_pending == 0u) {
        /* R1294 (Jos v4): ONE read per gate term per invocation, snapshot-
         * compared - print on FIRST occurrence, on ANY GATE VALUE CHANGE
         * (labeled GATE-CHANGE), and 1-per-4096 for identical repeats, so
         * the decisive transition survives the log budget. Plain RAM cell
         * reads only (the established mvloop/zrf pattern) - nothing routed
         * through the CD register path, no device state can change. */
        static uint32_t schdd_n, schdd_rep;
        static uint32_t p_seq, p_cmd, p_fe1c, p_fdf8, p_fe04, p_seek, p_fdfc, p_fe08, p_rp, p_rn, p_a22c;
        uint32_t g_seq = cd_sched_seq, g_cmd = cd_last_cmd;
        uint32_t g_fe1c = xenolift_mem_read32(0x8004FE1Cu), g_fdf8 = xenolift_mem_read32(0x8004FDF8u);
        uint32_t g_fe04 = xenolift_mem_read32(0x8004FE04u), g_seek = cd_seek_lba;
        uint32_t g_fdfc = xenolift_mem_read32(0x8004FDFCu), g_fe08 = xenolift_mem_read32(0x8004FE08u);
        uint32_t g_rp = cd_resp_pos, g_rn = cd_resp_n, g_a22c = xenolift_mem_read32(0x8006A22Cu);
        int changed = (g_seq != p_seq || g_cmd != p_cmd || g_fe1c != p_fe1c || g_fdf8 != p_fdf8
                       || g_fe04 != p_fe04 || g_seek != p_seek || g_fdfc != p_fdfc || g_fe08 != p_fe08
                       || g_rp != p_rp || g_rn != p_rn || g_a22c != p_a22c);
        schdd_n++;
        if (schdd_n <= 8u || changed || (schdd_n & 4095u) == 0u) {
            if (!changed && ++schdd_rep > 24u) goto schdd_done;
            if (changed) schdd_rep = 0;
            p_seq = g_seq; p_cmd = g_cmd; p_fe1c = g_fe1c; p_fdf8 = g_fdf8; p_fe04 = g_fe04;
            p_seek = g_seek; p_fdfc = g_fdfc; p_fe08 = g_fe08; p_rp = g_rp; p_rn = g_rn; p_a22c = g_a22c;
            r861_out("[schdd] R1291 delivery decision BLOCKED after all gates declined (call=%u seq=%u t=%u%s): cmd=%02X fe1c=%u FDF8=%u FE04=%08X seek=%u FDFC=%08X FE08=%08X resp=%u/%u A22C=%08X - name the gate that should have matched\n",
                    schdd_n, g_seq, xl_wall(), changed ? " GATE-CHANGE" : "", g_cmd,
                    g_fe1c, g_fdf8, g_fe04, g_seek, g_fdfc, g_fe08, g_rp, g_rn, g_a22c);
        }
        schdd_done: ;
    }
    /* R1294 (Jos v4): THE WIN RECEIPT - which invocation delivered, with
     * the SAME sequence ID as the SET/CLEAR prints; the branch's own
     * [cd] R6xx print (adjacent in the log) names the winning branch. */
    if (r1294_ent && !cd_scheduled) {
        static uint32_t schdd_win_n;
        if (schdd_win_n < 32u) { schdd_win_n++;
            r861_out("[schdd] R1291 delivery WIN (n=%u seq=%u t=%u cmd=%02X): a release branch delivered THIS invocation - the adjacent [cd] R6xx print names the winning branch\n",
                    schdd_win_n, cd_sched_seq, xl_wall(), (unsigned)cd_last_cmd);
        }
    }
    /* R1295 (c194, THE FIX - the earliest demonstrated broken dependency in
     * the affected era): THE FE04-MATCHING NEVER-ARMED ARM. The c193 live
     * seq chain receipted the missing transition end-to-end: in the
     * state-1 movie era (state setup COMPLETED - real gdesc cells, real
     * 18088=1, hasOverlay=1), the game polls GetStat (cmd 01) at
     * FE04=109123 (file#17 LBA, stamped by its own ftab reader) with
     * FDF8=0 - the request was NEVER ARMED - and every release gate
     * declined (schdd BLOCKED with every term printed, seqs 976-1006,
     * the game actively re-issuing - sched is NOT stale-frozen). The
     * c62-era R496 arm matches file-table members against cd_seek_lba
     * (the PARKED position, 0) instead of FE04 (the queued request
     * LBA) - this exact class. WIDEN: when the blocked posture holds,
     * look the FE04 LBA up in the game own file table (0x800100A5,
     * 7-byte members, m=1..12) and arm FDF8 with the member size
     * exactly like a fresh announce - the established rescue machinery
     * (defib staged-ring + porter) then serves it. GUARD RAILS: one arm
     * per LBA (never re-arm the same request), file-band LBAs only
     * (>100000, <300000), sane sizes (8..0x100000), the movie-wait
     * states only (fe1c 6 or 10), the parked drive only (seek<150),
     * nothing armed in flight (FDF8==0, pend==0, cmd==01). REVERT
     * criterion per the c174 lesson: the fire must lead to GUEST-SIDE
     * consumption (FDF8 drains below the armed size, FE1C moves, new
     * LBAs) - fire with zero consumption next cycle = revert. */
    if (cd_scheduled && cd_pending == 0u && cd_last_cmd == 0x01u
        && xenolift_mem_read32(0x8004FDF8u) == 0u && cd_seek_lba < 150u) {
        uint32_t r1295_fe1c = xenolift_mem_read32(0x8004FE1Cu);
        uint32_t r1295_lba = xenolift_mem_read32(0x8004FE04u);
        if ((r1295_fe1c == 6u || r1295_fe1c == 10u)
            && r1295_lba > 100000u && r1295_lba < 300000u) {
            for (uint32_t m = 1u; m <= 12u; m++) {
                const uint8_t *fe = xenolift_mem + 0x000100A5u + 7u * (m - 1u);
                uint32_t mlba = fe[0] | (fe[1] << 8) | (fe[2] << 16);
                uint32_t msize = fe[3] | (fe[4] << 8) | (fe[5] << 16) | ((uint32_t)fe[6] << 24);
                if (mlba == r1295_lba && msize >= 8u && msize <= 0x100000u) {
                    static uint32_t r1295_served;
                    if (r1295_served != r1295_lba) {
                        r1295_served = r1295_lba;
                        xenolift_mem_write32(0x8004FDF8u, msize);
                        r861_out("[armfe] R1295 FE04-MATCH ARM: re-request lba %u (file-table member %u, size %u) never armed (FDF8=0, seek parked at %u, fe1c=%u, seq=%u) - armed FDF8=%u, rescue follows; REVERT if no guest-side consumption\n",
                                r1295_lba, m, msize, cd_seek_lba, r1295_fe1c, cd_sched_seq, msize);
                    }
                    break;
                }
            }
        }
    }
}
/* R403 FIELD-DATA CAMERA: c160 — the field read chain UNLOCKED (Setloc cmd-02
 * AND ReadN cmd-06 both delivered at the FE1C RAM-poll; counters drifted by
 * exactly 2 deliveries with boot sections untouched) — the run now stalls one
 * stage LATER: data phase started (1 sector loaded, data_n=2060) but NOTHING
 * flows (FDF8=125048 owed, no dmaarm/cd-dma for LBA 108933, field dest zero,
 * fd-ticks +1 only). The guest sits in ANOTHER RAM-poll wait at the data stage
 * while the boot-era sector pump (fd-tick -> handler pair -> h2 ->
 * LegacyCdSectorFetch -> ch3 DMA) never gets its dispatch. Camera: log which
 * disc registers, RAM cells, and dispatch contexts are touched while the
 * field-data signature holds. Latch resets per instance (Lesson 32). */
static int fld_data_sig(void)
{
    /* R404 RECURSION GUARD (c161 crash, 2s in): the camera probes watch
     * reads of FE04/FDF8/FE1C/578A6 — and this helper ITSELF reads
     * FE04/FDF8 through the same hook => probe -> sig -> read -> probe
     * -> ... unbounded recursion -> stack guard page -> SIGBUS at
     * xenolift_mem_read32+792 (crash kit resolved it: cur_fn 0x80041820
     * r31 0x80041CA0, sig 10, boot file-2 read). Guard at the ROOT:
     * re-entered sig checks simply return 0. */
    static int in_sig;
    if (in_sig) return 0;
    in_sig = 1;
    /* R405 ERA-GATE: c162 — the camera's 96-line budget was eaten whole
     * by BOOT module reads (seeks 108754-108886; mapped pattern: guest
     * polls 800 idx0 while sectors flow, seek +1 / FDF8 -2048 per sector).
     * The field stage (seek 108933+) never logged. Gate the shared sig to
     * the field's disc region: >=108900 (boot files 108754-108886, file-18
     * 109158 stays visible after). Boot's pattern is banked; the field
     * stage is the unmapped stall. */
    int r = cd_scheduled == 0u && cd_pending == 0u && cd_last_cmd == 0x06u
        && cd_seek_lba >= 108900u
        && xenolift_mem_read32(0x8004FE04u) == cd_seek_lba
        && xenolift_mem_read32(0x8004FDF8u) != 0u;
    in_sig = 0;
    return r;
}
static uint32_t fld_seen;   /* per-instance combo latch */
static int fld_was;         /* signature held last check? */
static uint32_t fld_n;      /* total budget 96 */
static void fld_data_note(int in_sig)
{
    if (in_sig && !fld_was)
        fld_seen = 0; /* new instance: reset latch (Lesson 32) */
    fld_was = in_sig;
}

static uint32_t cd_read_impl(uint32_t p)
{

    if (p >= 0x1F801800u && p <= 0x1F801803u) cdreg_r[p - 0x1F801800u]++;
    {   /* R403 fld-data camera: disc-register poll map */
        int fs = fld_data_sig(); fld_data_note(fs);
        if (fs && fld_n < 96u) {
            unsigned combo = (unsigned)((p - 0x1F801800u) * 4u) + (cd_index & 3u);
            if (combo < 32u && !((fld_seen >> combo) & 1u)) {
                fld_seen |= 1u << combo;
                r861_out("[cd] fld-data poll reg=1F8018%02X idx=%u seek=%u FDF8=%u\n",
                        (unsigned)(p - 0x1F801800u), (unsigned)(cd_index & 3u),
                        cd_seek_lba, xenolift_mem_read32(0x8004FDF8u));
                fld_n++;
            }
        }
    }

    /* R400 FIELD-POLL MAP: cycles 156/157 — the R399 release (in the 802/803
     * idx1 INT-flag branches) NEVER fires for the field read (CD6 shows only
     * the 6 boot deliveries) even though EVERY gate condition matches the
     * park (FE1C=2 cmd=06 seek=FE04 FDF8!=0 sched=1 pending=0) => the field
     * wait polls some OTHER register/index. Log each distinct (reg,idx) read
     * while the signature holds — once per combo, budget 16. No lines next
     * digest = the wait is on a RAM cell (0x800578A6 flag family), not MMIO. */
    /* R401 STATE-WIDEN: c158 park — the field Setloc reply waits at
     * FE1C=1 (seek-issued wait), NOT state 2 (read-issued); the R400
     * release sat in every polled branch yet never fired because the
     * gate demanded state 2 only. Accept BOTH reply-wait states. */
    if (cd_scheduled && cd_pending == 0u
        && (cd_last_cmd == 0x02u || cd_last_cmd == 0x06u)
        && (xenolift_mem_read32(0x8004FE1Cu) == 1u
            || xenolift_mem_read32(0x8004FE1Cu) == 2u)
        && cd_seek_lba != 0u
        && xenolift_mem_read32(0x8004FE04u) == cd_seek_lba
        && xenolift_mem_read32(0x8004FDF8u) != 0u) {
        unsigned combo = (unsigned)((p - 0x1F801800u) * 4u) + (cd_index & 3u);
        static uint32_t fpm_seen;
        if (combo < 32u && !((fpm_seen >> combo) & 1u)) {
            fpm_seen |= 1u << combo;
            r861_out("[cd] field-poll reg=1F8018%02X idx=%u (signature hold)\n",
                    (unsigned)(p - 0x1F801800u), (unsigned)(cd_index & 3u));
        }
    }

    switch (p) {
    case 0x1F801800: /* status: index | motor | resp fifo | data fifo */
        {   /* R1245 (c102): 14.4M reads of 1800 stuck at 0x24 (= hardwired
             * 0x04 | resp-nonempty 0x20) with NO pops during the spin -
             * the spinner is neither fn_80042A58 (its bit24 test would
             * exit) nor the fd-processor (it pops when 0x20 sets). The
             * [trail] camera is alarm-driven and DEFERS during guest spins,
             * so it filmed nothing. This camera lives in the read path
             * itself: every 500000th 1800 read prints the spinner's cur_fn
             * + the full CD posture. Cap 40 prints. */
            static uint32_t sp1245_n, sp1245_p;
            if (++sp1245_n % 500000u == 0u && sp1245_p < 40u) { sp1245_p++;
                r861_out("[spinpost] R1248 n=%u resp_bit=%u cur_fn=%08X resp_n=%u pos=%u resp0=%02X last_cmd=%02X seek=%u act=%d sched=%d pend=%u FE04=%u FDF8=%u FE1C=%u FE20=%u FE08=%08X req59EF8=%08X\n",
                        sp1245_n, (unsigned)((cd_resp_pos < cd_resp_n) ? 1u : 0u),
                        xenolift_cur_fn, cd_resp_n, cd_resp_pos, cd_resp[0], cd_last_cmd, cd_seek_lba,
                        cd_read_active, cd_scheduled, cd_pending,
                        xenolift_mem_read32(0x8004FE04u), xenolift_mem_read32(0x8004FDF8u),
                        xenolift_mem_read32(0x8004FE1Cu), xenolift_mem_read32(0x8004FE20u),
                        xenolift_mem_read32(0x8004FE08u), xenolift_mem_read32(0x80059EF8u));
            }
        }
        g_r918_poll_requested = 1; /* R918: request, don't run - release executes at the dispatch boundary (depth==0), not inside this guest step */
        /* R1263 (c137-c139 receipts): LEGACY-FETCH SECTOR-SERVE DOOR. The c139
         * receipts named the stuck request: fetch entry #306 - the 239xxx-band
         * reader (descriptor 02021353, the same one that read 239327 into
         * 801F7B20) jumps FE08 by exactly +0x800 to 801F8320 with FDF8=2048,
         * FE04=0, drive idle - the reader wants the NEXT contiguous sector
         * (239328, the sync-file start) served through the FIFO drain path
         * one sector at a time, exactly like its boot ladder ([cd-dma]
         * 2048/2048 receipts, FDF8 2048->0 at 80041534, FE08 += 0x800 ringw).
         * The R1243 d2door wrote the sync file directly into
         * [801F8320..801FC320) but BYPASSED the reader's drain loop, so FDF8
         * never drains and the 0x40 poll spun 263M polls (c137/c138 spinpost
         * census: cur_fn=80042AA8, act=0 sched=0 pend=0, resp frozen). Serve
         * each 2048-byte slot once: stamp FE04 with the sector (so the
         * cd_data_load re-anchor cannot fall to LBA 0), arm read_active +
         * !data_loaded, and the SAME poll's cd_data_load below loads the
         * sector into the FIFO; the game's own drain then does FDF8 -= 2048
         * and FE08 += 0x800. Bounded to the 8-slot sync window, one serve
         * per FE08 slot.
         * R1264 (c140/c141 verdict): the c141 build forensics PROVED the
         * binary was fresh R1263 with this door compiled in (banner token
         * and secserve present in xenogears_boot), the spinpost census
         * matched every printed term (act=0 sched=0 pend=0 FDF8=2048
         * FE08=801F8320) - the ONLY unprinted gate term was cd_data_n==0,
         * and the status byte cannot acquit it: the 0x40 bit is computed
         * as (cd_read_active && cd_data_pos < cd_data_n), so 0x24 says
         * nothing about a consumed-but-unreset FIFO (the 239327 sector's
         * 2060 bytes can sit fully drained with data_n never reset).
         * R1264 relaxed the term to NO UNCONSUMED BYTES - did not fire
         * either: the c142 cd-dma receipts named the true blocker - the
         * 239327 sector loaded 2060 bytes into the FIFO and the game's
         * DMA drained only 644 to 0x800596F8, leaving 1416 UNCONSUMED
         * bytes in the FIFO forever, so (data_pos < data_n) held eternally
         * and BOTH the R1263 and R1264 gates stayed closed (binary proven
         * fresh R1264 with secserve in it both cycles - c142 BINPROOF).
         * R1265 DROPS the FIFO term entirely: the drive-idle terms
         * (read_active/scheduled/pending all 0) already prove any FIFO
         * content is stale leftovers from a completed request - dead
         * bytes cannot matter to a new request. On serve, FLUSH the stale
         * FIFO (receipt the flushed data_n/data_pos as proof) and arm the
         * fresh sector; cd_data_load then reloads cleanly and the game's
         * 12+2048 header/data drain proceeds exactly like its boot ladder. */
        {
            static uint32_t r1263_fired[8];
            uint32_t fe08d = xenolift_mem_read32(0x8004FE08u);
            uint32_t fdf8d = xenolift_mem_read32(0x8004FDF8u);
            if (!cd_read_active && !cd_scheduled && !cd_pending
                && fdf8d == 2048u
                && fe08d >= 0x801F8320u && fe08d < 0x801FC320u
                && ((fe08d - 0x801F8320u) & 0x7FFu) == 0u) {
                uint32_t slot = (fe08d - 0x801F8320u) >> 11;
                if (slot < 8u && r1263_fired[slot] != fe08d) {
                    r1263_fired[slot] = fe08d;
                    cd_seek_lba = 239328u + slot;
                    xenolift_mem_write32(0x8004FE04u, cd_seek_lba);
                    cd_read_active = 1; cd_data_loaded = 0;
                    if (cd_data_pos < cd_data_n) {
                        r861_out("[secserve] R1265 stale-FIFO flush slot=%u data_n=%u data_pos=%u - the c142 blocker receipted: unconsumed leftovers from the completed 239327 request\n",
                                 slot, cd_data_n, cd_data_pos);
                        cd_data_pos = cd_data_n = 0;
                    }
                    r861_out("[secserve] R1265 legacy-fetch serve slot=%u FE08=%08X FDF8=%u -> sector %u armed via FE04 stamp + read_active, same-poll cd_data_load, game drains\n",
                             slot, fe08d, fdf8d, cd_seek_lba);
                }
            }
        }
        /* R1268 (c151 verdict): DIRECTORY-SERVE DOOR - the ring base
         * 0x20 below the sync window. The c151 receipts: after the
         * movie file#18 completed (LZSS consumed it into the module
         * window, state 6 re-entered), the game RE-READ the directory:
         * Setloc MSF 00:00:00 (clamped to LBA 0, clamp receipt 18546),
         * GetTN + ReadN re-issued (cmdtl #25/#26), then the fd-retire
         * released FE1C 7->0 and the zrf0 R515 heal armed FDF8=2048
         * for the zero-length directory request. The DATA HANDLER
         * entered ONCE with FE08=801F8300 FDF8=0x800 FE04=0 - the ring
         * base, 0x20 BELOW the secserve window (801F8320-801FC320), so
         * the sync serve rejects it; the game then polls 0x24 for its
         * 2048 bytes forever (360M+ reads receipted). The boot-ladder
         * receipts prove the shape: the fetch read the directory as
         * LBA 0/1/2 with +0x800 per slot (fetchcam #280-285, FE04
         * 0/1/2) - the disc-start sectors ARE slot==LBA. Serve exactly
         * the receipted posture: drive idle, FDF8==2048 armed,
         * FE08==0x801F8300 exactly (the ring base - slot 0 only; if
         * the game wants LBA 1 at 801F8B00 the receipts will say so
         * and the door extends), FE04==0. R1269 (c152 verdict): the
         * sched term is DROPPED - the c152 run froze with the door
         * compiled in but never firing because finstamp #951 armed
         * FDF8=2048 with sched=1 left STALE from the movie teardown
         * (the c151 run had sched=0 at the same arm - trajectory
         * nondeterminism). FE04==0 + pend==0 + act==0 prove no
         * request is armed regardless of the stale flag; on serve the
         * stale sched is CLEARED (receipted) so it stops blocking the
         * other idle-gated doors. Serve sequence mirrors the R1265
         * secserve: seek stamp + read_active + stale-FIFO flush +
         * same-poll cd_data_load. Budget 16. */
        if (!cd_read_active && !cd_pending) {
            uint32_t fe08_dir = xenolift_mem_read32(0x8004FE08u);
            uint32_t fdf8_dir = xenolift_mem_read32(0x8004FDF8u);
            static int r1268_budget = 16;
            if (r1268_budget > 0
                && fdf8_dir == 2048u
                && fe08_dir == 0x801F8300u
                && xenolift_mem_read32(0x8004FE04u) == 0u) {
                r1268_budget--;
                if (cd_scheduled) {
                    r861_out("[dirserve] R1269 stale sched flag CLEARED on serve (FE04=0 proves no request armed; the c152 wedge sat blocked by it - finstamp #951 armed FDF8=2048 with sched=1 left over from the movie teardown)\n");
                    cd_scheduled = 0;
                        { static int sdw_2705; if (sdw_2705 < 2) { sdw_2705++; r861_out("[schdw] R1291 CLEAR site L2705 ran (seq=%u t=%u): pend=%u act=%u sched=0 FDF8=%u FE04=%08X fe1c=%u last_cmd=%02X resp=%u/%u (popped/armed = guest-ack vs runtime-only)\n", cd_sched_seq, xl_wall(), (unsigned)cd_pending, cd_read_active ? 1u : 0u, xenolift_mem_read32(0x8004FDF8u), xenolift_mem_read32(0x8004FE04u), xenolift_mem_read32(0x8004FE1Cu), (unsigned)cd_last_cmd, (unsigned)cd_resp_pos, (unsigned)cd_resp_n); } } /* R1291v3 schdw tracer */
                }
                cd_seek_lba = 0u;
                xenolift_mem_write32(0x8004FE04u, 0u);
                cd_read_active = 1; cd_data_loaded = 0;
                if (cd_data_pos < cd_data_n) {
                    r861_out("[dirserve] R1268 stale-FIFO flush data_n=%u data_pos=%u - leftover bytes from a completed request cannot matter at drive-idle (R1265 lesson)\n",
                             cd_data_n, cd_data_pos);
                    cd_data_pos = cd_data_n = 0;
                }
                r861_out("[dirserve] R1268 directory-serve FE08=%08X FDF8=%u FE04=0 -> sector LBA 0 armed (read_active + same-poll cd_data_load, game drains), budget=%d\n",
                         fe08_dir, fdf8_dir, r1268_budget);
            }
        }
        if (cd_read_active && !cd_data_loaded)
            cd_data_load(); /* serve on demand */
        /* R123: the fd-processor context (BIOS-style INT handling,
         * r31=0x80041CA0) polls this status register waiting for
         * bit 0x20 (response byte available). Our per-command
         * status byte gets consumed during INT3 processing, leaving
         * the FIFO empty -> bit 0x20 never lights -> infinite poll.
         * On real HW a status read reflects the drive's LIVE state:
         * re-prime the FIFO with a GetStat-style status byte so the
         * handler can fetch it and complete its processing. */
        /* R132: TREADMILL FIX — only re-prime at DRIVE-IDLE. The
         * R131 condition included cd_read_active, so during streams
         * EVERY status poll refilled the FIFO with a fake byte; the
         * kernel consumed 100000 of them in a poll treadmill until
         * the budget died mid-stream and the fd spin froze. During
         * active reads the native INT1 machinery owns the loop. */
        /* R391 FIELD-SEEK ASSIST (HOISTED — cycle 148: the assist never fired because it lived INSIDE the FIFO-empty gate; the field stall holds 1 stray byte in the FIFO (resp_n=1,pos=0) so the gate can never open. Hoisted above the gate so every status poll checks the field-stall config) — cycles 146/147 parked IDENTICALLY: field read
                 * fully armed (FE04==seek LBA 108933, ~124KB batch at 801D0BD8) but the
                 * state machine wedged in state 1 (FE1C==1) after SetLoc (last_cmd=02):
                 * pending=0, data_n=0, resp FIFO holds only the 1-byte re-prime, reads-done
                 * frozen, every movie-era assist refire=0 (their gates don't match the
                 * field-era config). The movie-era SetLoc advanced 1->2 on a 3-byte answer
                 * ([rspop] 02/01/01 pattern, last_cmd=0x02) delivered via the INT1
                 * handler-pair conversion. Manufacture exactly that: prime the canonical
                 * 3-byte SetLoc answer + arm INT1 (pending=3) so the established fd-tick
                 * handler-pair path converts it natively. No guest dispatch here (R350). */
                if (cd_last_cmd == 0x02u) {
                    /* R1341 (c310): stale-leftover discard for the re-read SetLoc
                     * posture. The c309 receipts: the game's re-read Setloc at
                     * 108933 waits at FE1C=1; the assist that serves the 3-byte
                     * answer refuses because the PREVIOUS request left cd_pending=1
                     * and a stale 2060B sector (cd_data_n) - leftovers no live
                     * stream owns (cd_read_active=0). Discard them (the fldbell
                     * R503 precedent) so the assist's clean-state terms pass and
                     * the SetLoc reply is served through the established
                     * handler-pair path. */
                    {
                        uint32_t fe1c_p = ((uint32_t)xenolift_mem[0x4FE1Cu]) | ((uint32_t)xenolift_mem[0x4FE1Du] << 8);
                        if (fe1c_p == 1u && !cd_read_active
                            && (cd_pending != 0u || cd_data_n != 0u)) {
                            static int r1341_n;
                            if (r1341_n++ < 8u)
                                r861_out("[stalecd] R1341 stale CD state discarded for SetLoc serve: pending=%u data_n=%u resp_n=%u seek=%u FE04=%08X\n",
                                        cd_pending, cd_data_n, cd_resp_n, cd_seek_lba,
                                        xenolift_mem_read32(0x8004FE04u));
                            cd_pending = 0u;
                            cd_data_pos = 0u; cd_data_n = 0u; cd_data_loaded = 0u;
                        }
                    }
                                /* R1345 (c315): v3 idle-only - the v2 change-detection cap was
                                 * eaten by the boot-era ACTIVE-STREAM LBA walk (40 prints by
                                 * line 3263, read_active=1 throughout); gate the prints on
                                 * read_active==0 (the idle Setloc-wait class that matters at
                                 * the tail) so the cap survives to the tail era. */
                                {
                                    uint32_t fe1c_q = ((uint32_t)xenolift_mem[0x4FE1Cu]) | ((uint32_t)xenolift_mem[0x4FE1Du] << 8);
                                    if (fe1c_q == 1u && cd_last_cmd == 0x02u) {
                                        static int r1345_n, have_last;
                                        static uint32_t l_p, l_d, l_r, l_s, l_f;
                                        uint32_t vp = cd_pending, vd = cd_data_n;
                                        uint32_t vr = (uint32_t)cd_read_active, vs = cd_seek_lba;
                                        uint32_t vf = xenolift_mem_read32(0x8004FE04u);
                                        if (r1345_n < 40 && vr == 0u && (!have_last || vp != l_p || vd != l_d
                                                || vr != l_r || vs != l_s || vf != l_f)) {
                                            r1345_n++; have_last = 1;
                                            l_p = vp; l_d = vd; l_r = vr; l_s = vs; l_f = vf;
                                            r861_out("[stalecd-near] R1345 SetLoc-wait state (idle, changed): pending=%u data_n=%u read_active=%u resp_n=%u seek=%u FE04=%08X seekmism=%u\n",
                                                    vp, vd, vr, cd_resp_n, vs, vf, (unsigned)(vf != vs));
                                        }
                                    }
                                }
                    static int fassist_budget = 400;
                    uint32_t fe04f = xenolift_mem_read32(0x8004FE04u);
                    uint32_t fe1c_f = ((uint32_t)xenolift_mem[0x4FE1Cu]) | ((uint32_t)xenolift_mem[0x4FE1Du] << 8);
                    if (fassist_budget > 0
                        && fe04f != 0u && fe04f == cd_seek_lba
                        && fe1c_f == 1u
                        && cd_pending == 0u && cd_data_n == 0u
                        && cd_resp_n < 3u) {
                        fassist_budget--;
                        cd_resp[0] = 0x02u; cd_resp[1] = 0x01u; cd_resp[2] = 0x01u;
                        cd_resp_n = 3u; cd_resp_pos = 0u;
                        memcpy(cd_last_full, cd_resp, sizeof cd_resp);
                        cd_last_full_n = 3u;
                        cd_pending = 3u;
                        r861_out("[cd] FIELD-SEEK assist: 3-byte SetLoc answer primed + INT1 armed (LBA %u, FE1C=%u)\n",
                                cd_seek_lba, fe1c_f);
                    }
                }
        /* R503 FLDBELL: the field pump's GetStat hang (c69, menu->Field era):
         * sched=1 read is STALLED-DEAD (FDF8=0, pend=0, arm1=0, FE1C=10,
         * last_cmd=0x01, resp_n=0) and cd_read_active stays 1, which blocks
         * the generic re-prime below forever -> the delivery bell never rings,
         * pump frozen t=46s..109s at seek 108995 with a stale 2060B sector in
         * the FIFO. Treat the drained read as done (discard leftover like the
         * proven fd-kick pattern) so the standing re-prime answers GetStat
         * and state 10 walks on. */
        {
            static int fldbell_budget = 500;
            uint32_t fdf8_b = xenolift_mem_read32(0x8004FDF8u);
            uint32_t fe1c_b = ((uint32_t)xenolift_mem[0x4FE1Cu]) | ((uint32_t)xenolift_mem[0x4FE1Du] << 8);
            if (fldbell_budget > 0
                && cd_read_active
                /* R1185 (c386 receipts): the m5 scene-load park runs this same
                 * stalled-dead class with FE1C=0, not 10 - fldfrz receipts
                 * (act=1 sched=1 arm1=0 loaded=1 data=0/2060 cmd=01 resp=0/0
                 * FDF8=0 FE1C=0, seek=108873) match every other condition of
                 * the c69 signature. The load-bearing invariant is FDF8==0
                 * (request fully consumed) while the model still reports
                 * reading; the FE1C window value was an artifact of the c69
                 * instance. Accept both window values; budget still caps. */
                && (fe1c_b == 0x0Au || fe1c_b == 0x00u)
                && cd_last_cmd == 0x01u
                && cd_resp_n == 0u && cd_resp_pos == 0u
                && cd_pending == 0u
                && cd_arm_int1_pending == 0u
                && fdf8_b == 0u) {
                fldbell_budget--;
                if (cd_data_pos < cd_data_n) {
                    r861_out("[fldbell] R503: stale FIFO leftover %u bytes discarded (stalled-dead read)\n",
                            cd_data_n - cd_data_pos);
                    cd_data_pos = cd_data_n = 0;
                    cd_data_loaded = 0;
                }
                cd_read_active = 0;
                r861_out("[fldbell] R503: stalled-dead read closed at seek=%u (FE1C=%u) - GetStat re-prime unlocked\n",
                        cd_seek_lba, fe1c_b);
            }
        }
        if (cd_resp_pos >= cd_resp_n && !cd_read_active
                                         && (cd_pending || cd_last_cmd)) {
            static int reprimed_budget = 100000;
            if (reprimed_budget > 0) {
                reprimed_budget--;
                /* R212: live motor state — after Stop the kernel polls
                 * GetStat waiting for the spindle-off transition; answering
                 * 0x02 (motor on) forever = the cycle-45 GetStat treadmill
                 * (last_cmd=0x13, 7+ re-primes, phase machinery done, FE1C=11). */
                cd_resp[0] = cd_read_active ? 0x22u : (cd_motor_on ? 0x02u : 0x00u); /* +bit5: reading */
                cd_resp_n = 1;
                cd_resp_pos = 0;
                if (cd_last_full_n > 1u && cd_last_cmd != 0x01u) { /* R263: multi-byte answers (GetTN/GetTD/Getloc/GetID) replay whole */
                    memcpy(cd_resp, cd_last_full, sizeof cd_resp);
                    cd_resp_n = cd_last_full_n;
                    if (cd_last_cmd != 0x10u && cd_last_cmd != 0x11u) /* live stat byte where the response starts with stat */
                        cd_resp[0] = cd_read_active ? 0x22u : (cd_motor_on ? 0x02u : 0x00u);
                }
                /* R538 [fldack]: c106 named the wedge family — every clean
                 * sector advance in the timeline follows a 3-byte answer
                 * ([02 01 01], rspop n=3); both wedge postures (FE1C=10
                 * c105, FE1C=7 c106) sat in a GetStat wait where we primed
                 * ONE byte — the game popped it and waited for the rest
                 * forever. In the field file-14 window, answer GetStat with
                 * the full ack family like every successful posture. */
                if (cd_last_cmd == 0x01u && cd_scheduled
                    && cd_seek_lba >= 108933u && cd_seek_lba <= 108995u
                    && cd_resp_n < 3u) {
