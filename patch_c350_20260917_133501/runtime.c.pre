    if (a >= 0x8004FB40u && a <= 0x8004FBF0u && v != 0u) {
        static int fbw_n;
        if (fbw_n < 64) {
            fbw_n++;
            r861_out("[fbw] R1333 ARCHIVE-BAND WRITE %08X <- %08X writer_fn=%08X\n",
                    a, v, (unsigned)xenolift_cur_fn);
        }
    }

    /* R763 INSTANCE-REGION WRITE WATCH: c341 verdict - banks 1-3 are ALL
     * ZEROS (bank 0 = the only real data; the bank theory is dead) and the
     * module's instance region 0x801D2D2C-0x801D2DAC (BELOW the stage-2
     * module base 0x801D3000; the crash-site ctx that feeds the helper's
     * computed-garbage jump) is ALL ZEROS. Question this camera answers: does
     * ANYTHING ever write the instance region (module init/constructor), or
     * is the init path never reached? Log ALL writes (incl. zeros - zeroing
     * IS init) with writer fn. Cap 64. */
    if (a >= 0x801D2D00u && a <= 0x801D2DB0u) {
        static int iw_n;
        if (iw_n < 64) {
            iw_n++;
            r861_out("[instw] R763 WRITE %08X <- %08X writer_fn=%08X\n",
