                  { uint32_t cb; memcpy(&cb, xenolift_mem + (0x8001809Cu - 0x80000000u), 4);
                    r861_out("\n[wildhdr2] R731 cb-cell @8001809C = %08X (relay-restored? descw2 says 80077E88)", cb);
                    if (cb >= 0x80000000u && cb < 0x80200000u) {
                      for (int k = 0; k < 4; k++) { uint32_t w; memcpy(&w, xenolift_mem + (cb - 0x80000000u) + 4*k, 4);
