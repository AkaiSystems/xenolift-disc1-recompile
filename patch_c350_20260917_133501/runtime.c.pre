         * wave) clear the stale latch so the watchdog resumes. */
        static volatile sig_atomic_t r1213_last_n;
        static volatile sig_atomic_t r1213_flow_wins;
        if (g_r861_n == r1213_last_n) {
            r861_out("[park] R1213 TRUE STAGE-HANG at stage %d - zero receipts across alarm window (c122 class) - backstop exit 77\n", g_park_stage);
            _exit(77);
        }
        r1213_last_n = g_r861_n;
        if (++r1213_flow_wins > 8) {
            r1213_flow_wins = 0;
