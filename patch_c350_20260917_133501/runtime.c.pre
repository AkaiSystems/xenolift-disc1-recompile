              xenolift_sighex(_b, &_n, xenolift_mem_read32(r964_fn));
              xenolift_sigput(_b, &_n, " ");
              xenolift_sighex(_b, &_n, xenolift_mem_read32(r964_fn + 4u));
              xenolift_sigput(_b, &_n, " ");
              xenolift_sighex(_b, &_n, xenolift_mem_read32(r964_fn + 8u));
              xenolift_sigput(_b, &_n, " ");
              xenolift_sighex(_b, &_n, xenolift_mem_read32(r964_fn + 12u));
              xenolift_sigput(_b, &_n, "\n");
              (void)!write(2, _b, (size_t)_n); }
    }
    _exit(99);
}
int main(int argc, char **argv)
{
    g_boot_wall_t0 = time(NULL); /* R315: budget clock from PROCESS START —
     * cycle-63 verdict: run_t0 started at FIRST ALARM (t=30s) so the
     * over-budget check quantized to wall 240s = dead heat with the
     * bridge's 240s SIGKILL, bridge won 3 cycles straight. From process
     * start + 195s budget we halt at ~195s with 45s margin. */
    xenolift_install_kit_handler(SIGSEGV); /* R649 + R1207 SA_ONSTACK */
    xenolift_install_kit_handler(SIGBUS);  /* R649 + R1207 SA_ONSTACK */
    xenolift_install_kit_handler(SIGABRT); /* R649 + R1207 SA_ONSTACK */
    /* R716: boot 2 died touching NO exit door (c285-287: no atexit, no SEGV,
     * no return from the R692 loop) = a terminating signal we never caught.
     * Prime suspect SIGFPE: MIPS div-by-zero is UNPREDICTABLE, never a trap -
     * but translated C `a / b` raises it on the host. A data-dependent path
     * boot 1 never took. Catch every remaining terminator so the next silent
     * death prints its door instead. */
    xenolift_install_kit_handler(SIGFPE);
    xenolift_install_kit_handler(SIGILL);
    xenolift_install_kit_handler(SIGTRAP);
    xenolift_install_kit_handler(SIGSYS);
    xenolift_install_kit_handler(SIGPIPE);
    { /* R930: SA_SIGINFO versions for the terminator signals - the plain
         * signal() handler gets no ucontext, so SIGILL died unnamed (c36).
         * These name the host PC before delegating to the exitdiag path. */
        struct sigaction sd;
        memset(&sd, 0, sizeof sd);
        sd.sa_sigaction = xenolift_sigdiag;
        sd.sa_flags = SA_SIGINFO;
        sigemptyset(&sd.sa_mask);
        sigaction(SIGILL, &sd, NULL);
        sigaction(SIGFPE, &sd, NULL);
        sigaction(SIGTRAP, &sd, NULL);
        sigaction(SIGSYS, &sd, NULL);
    }
    atexit(xenolift_exitdiag_clean);        /* R649: clean main-return also reports */
    /* R261 BIG STACK: cycle-9 crash = SIGSEGV inside vfprintf with the fault
     * address 0x398 below the frame pointer = the 8MB main-thread stack
     * exhausted (R228 predicted this class). The movie slice pair
     * fn_8007670C<->fn_800767DC alternates at IDENTICAL call offsets
     * (+1402/+582) = a tail-jump loop emitted as calls = unbounded host
     * recursion once the loop runs unblocked. Run the guest on a 2GB
     * pthread stack; sigaltstack is per-thread so the crash kit installs
     * inside the thread (unchanged code path). */
    pthread_attr_t at; pthread_t th; struct xl_main_args a = { argc, argv, 1 };
    pthread_attr_init(&at);
    if (pthread_attr_setstacksize(&at, (size_t)XENOLIFT_GUEST_STACK) != 0
        || pthread_create(&th, &at, xl_main_thread, &a) != 0) {
        r861_out("[xenolift] big-stack thread unavailable — running on the main stack\n");
        return xenolift_real_main(argc, argv);
    }
    r861_out("[xenolift] guest running on a %lluMB thread stack (R261)\n", (unsigned long long)(XENOLIFT_GUEST_STACK >> 20));
    pthread_join(th, NULL);
    return a.rc;
}
static int xenolift_real_main(int argc, char **argv)
{
