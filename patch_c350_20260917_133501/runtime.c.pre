        uint32_t fe1c_spin = xenolift_mem_read32(0x8004FE1Cu);
        uint32_t midstream_stall = (cd_read_active && cd_data_pos < cd_data_n
                                    && xenolift_mem_read32(0x8004FDF8u) > 2048u);
        if (((fe04_spin != 0u && fe04_spin != cd_seek_lba)
             || xenolift_mem_read32(0x8004FDFCu) == 1u)
            && (fe1c_spin == 0u || midstream_stall)
            && cd_pending <= 1u && cd_scheduled == 0u
            && cd_arm_int1_pending == 0u
            && ++cd_poll_n > 256u) {
            cd_poll_n = 0;
            {
                static int spin_kick_busy;
                if (!spin_kick_busy) {
                uint32_t sr[32]; uint32_t shi, slo;
                spin_kick_busy = 1;
                memcpy(sr, r, sizeof r); shi = hi; slo = lo;
                /* R160: full register-file + hi/lo save/restore, same
                 * mid-read crash class as the spin-conv. */
                if (cd_data_pos < cd_data_n) {
                    r861_out("[cd] spin-kick: discarding stale FIFO leftover (%u bytes, request done)\n",
                            cd_data_n - cd_data_pos);
                    cd_data_pos = cd_data_n = 0;
                cd_data_loaded = 0; /* R167: flag stuck 1 = starved demand */
                    cd_arm_int1_pending = 0;
                    cd_pending = 0;
                }
                r861_out("[cd] spin-kick: queued request FE04=0x%08X unserved (seek=%u) — dispatching h2\n",
                        fe04_spin, cd_seek_lba);
                if (!r1179_forge_blocked("L5718")) { g_guest_depth++, xenolift_dispatch(0x800415B4u), g_guest_depth--; }
                {
                    uint32_t h2 = xenolift_mem_read32(0x800564A8u);
                    if (h2 < 0x80010000u || h2 >= 0x80060000u) {
                        h2 = 0x8002A68Cu; /* R164: known h2 fallback */
                        r861_out("[cd] spin-kick: slot cell blank — using known h2 0x8002A68C\n");
                    }
                    {
                        r[4] = xenolift_mem[0x56788];
                        r[5] = 0x8005A210u;
                        if (midstream_stall) {
                    uint32_t h4 = xenolift_mem_read32(0x800564ACu);
                    uint32_t save4 = r[4], save5 = r[5];
                    if (h4 < 0x80010000u || h4 >= 0x80060000u) {
                        h4 = 0x8002B084u; /* R168: known h4 fallback */
                        r861_out("[cd] spin-drain: h4 cell blank — using known 0x8002B084\n");
                    }
                    r[4] = xenolift_mem[0x56789];
                    r[5] = 0x8005A218u;
                    r861_out("[cd] spin-drain: mid-stream stall (LBA %u, FDF8 %u, fifo %u/%u) — dispatching h4 0x%08X\n",
                            cd_seek_lba, xenolift_mem_read32(0x8004FDF8u),
                            cd_data_pos, cd_data_n, h4);
                    if (!r1179_forge_blocked("spin-L5769")) { g_guest_depth++, xenolift_dispatch(h4), g_guest_depth--; }
                    r[4] = save4; r[5] = save5; /* restore h2's args */
                }
                r861_out("[cd] spin-kick: dispatch h2 0x%08X (a0=%u)\n", h2, r[4]);
                        r861_out("[cd] spin-kick: pre-h2: FE14=%08X FE08=%08X FE38=%08X gate48=%08X struct=%08X node0=%08X\n",
                                xenolift_mem_read32(0x8004FE14u), xenolift_mem_read32(0x8004FE08u),
                                xenolift_mem_read32(0x8004FE38u), xenolift_mem_read32(0x8004FE48u),
                                xenolift_mem_read32(0x80059EF8u), xenolift_mem_read32(0x80059F10u));
                        if (!r1179_forge_blocked("spin-L5777")) { g_guest_depth++, xenolift_dispatch(h2), g_guest_depth--; }
                    }
                }
                memcpy(r, sr, sizeof r); hi = shi; lo = slo;
                spin_kick_busy = 0;
                }
            }
        }
        }
    }

    /* CDROM/SIO dialogs are BYTE-granular — route them through the
     * special handlers just like the 16/32-bit paths (previously byte
     * reads silently bypassed the hardware model) */
    if (off >= XENOLIFT_RAM_SIZE && io_special_read(io_phys(off), &tmp)) {
        io_log(io_phys(off), 0, tmp);
        return tmp & 0xFFu;
    }
    uint8_t v = xenolift_mem[off];
    if (off >= XENOLIFT_RAM_SIZE) {
        io_log(io_phys(off), 0, v);
    }
    return v;
}

extern uint32_t xenolift_ring[64]; extern int xenolift_ring_n; /* R81 */
static uint32_t spw_total = 0; /* R742: FILE-SCOPE scratchpad write counter (c317: fn-local decl was invisible to the fault block) */
static uint32_t g_region1047_exec, g_region1049_exec, g_region_targets_hit; /* R1050: camera-region liveness counters (c198-c206 placement-class lesson) */

/* R1051 (b8-c207) BODY CAMERA: the camlive receipt settled the placement
 * era - both dispatch-hook camera regions executed 262144+ times with
 * target_matches=0, so translated fns calling translated fns NEVER route
 * through runtime dispatch hooks. The only place a translated fn's entry
 * is hookable is its emitted body in disc1.c (emit guard injects the
 * call at the entry label). Called with the fn id + a0-a3. */
void xenolift_bodycam(uint32_t fn, uint32_t a0, uint32_t a1, uint32_t a2, uint32_t a3)
{
    static uint32_t bc_n;
    if (bc_n < 24u) {
        uint32_t sp0, sp1, sp2;
        memcpy(&sp0, xenolift_mem + XENOLIFT_RAM_SIZE + 0xA0u, 4);
        memcpy(&sp1, xenolift_mem + XENOLIFT_RAM_SIZE + 0xA8u, 4);
        memcpy(&sp2, xenolift_mem + XENOLIFT_RAM_SIZE + 0xB0u, 4);
        bc_n++;
        /* R1053: routed through xenolift_receipt (direct write(2)) - c211
         * receipt: coordinator + 0x801D002C entered (cbreal + crash-kit
         * receipts), bodycam calls compiled in, ZERO prints - r861_out
         * had gone silent (R971 50MB budget, [cd] ack flood) before the
         * module entries landed. Direct writes bypass the budget gate. */
        xenolift_receipt("[bodycam] R1053 #%u FN %08X a0=%08X a1=%08X a2=%08X a3=%08X 4FDF0=%08X spad=[%08X %08X %08X] @t=%lds\n",
                bc_n, fn, a0, a1, a2, a3,
                xenolift_mem_read32(0x8004FDF0u), sp0, sp1, sp2,
                (long)(xl_wall() - g_boot_wall_t0));
        /* R1055 (b8-c215): THUNK DECODE. c215 coordinator bytes decode: the
         * coordinator builds a0=0x800ABD40 (struct @0x800ABxxx, cell
         * 0x800ABE2C feeds a load) and calls jal 0x80097244 (a runtime-written
         * thunk - NOT the module fn). Bodycam: module fns enter with
         * a0=0x8009BD40 (exactly -0x20000 delta) and a1=0xC00D7F50 (the taint
         * = 0x800D7F50 + 0x40000000). The mangle happens INSIDE the thunk,
         * which tail-jumps to the module fn keeping r31=0x80077FC8 (matches
         * every crash receipt). Dump the thunk + the recovery-adjacent code +
         * the caller struct + load cell at module-fn entry - budget-proof
         * direct writes (r861_out is R971-silenced mid-run). */
        if (fn == 0x801D002Cu || fn == 0x801D2FE8u) {
            /* R1103 (b8-c281): MODULE-CONTEXT DUMP AT THE FAULTING DOOR.
             * c281 read-cycle verdict: R1088 (heal-gated context dump) never
             * fired - the R1082 heal is posture-dependent (c281: no coordheal
             * receipts at all; coordinator entries arrived caller=0). The
             * open Area-1 question does NOT need the heal: the module fn
             * itself receives the context in a0 (c255-c278 COORDERA: r4=
             * 0x8009BD40 at the 0x801D002C fault) and faults on near-null
             * reads INSIDE it (addr 0x0/0x4/0x56 class). Dump 16 context
             * cells at EVERY entry of the module fn - the zero cells at the
             * fault offsets name which context field is uninitialized, and
             * the decomp field struct (Noah refs) maps the field to its
             * initializer. Budget 8, independent of any heal path. */
            static int r1103_n;
            if (r1103_n < 8 && a0 >= 0x80010000u && a0 < 0x80200000u) {
                r1103_n++;
                xenolift_receipt("[modctx] R1103 fn=%08X ctx@a0=%08X cells: %08X %08X %08X %08X %08X %08X %08X %08X %08X %08X %08X %08X %08X %08X %08X %08X\n",
                    fn, a0,
                    xenolift_mem_read32(a0), xenolift_mem_read32(a0 + 4),
                    xenolift_mem_read32(a0 + 8), xenolift_mem_read32(a0 + 12),
                    xenolift_mem_read32(a0 + 16), xenolift_mem_read32(a0 + 20),
                    xenolift_mem_read32(a0 + 24), xenolift_mem_read32(a0 + 28),
                    xenolift_mem_read32(a0 + 32), xenolift_mem_read32(a0 + 36),
                    xenolift_mem_read32(a0 + 40), xenolift_mem_read32(a0 + 44),
                    xenolift_mem_read32(a0 + 48), xenolift_mem_read32(a0 + 52));
            }
            static int tk_n;
            if (tk_n < 6) {
                tk_n++;
                static const uint32_t tk_rng[3][2] = {
                    {0x80097244u, 0x800972A4u}, /* the jal-target thunk */
                    {0x800974A0u, 0x80097500u},  /* recovery-adjacent code (cur_fn=800974BC receipt) */
                    {0x800ABD30u, 0x800ABE40u}, /* caller struct + load cell 0x800ABE2C */
                };
                for (int g = 0; g < 3; g++) {
                    for (uint32_t p = tk_rng[g][0]; p < tk_rng[g][1]; p += 16) {
                        xenolift_receipt("[thunkcam] R1055 #%d G%d @%08X %08X %08X %08X %08X\n", tk_n, g, p,
                            xenolift_mem_read32(p), xenolift_mem_read32(p + 4),
                            xenolift_mem_read32(p + 8), xenolift_mem_read32(p + 12));
                    }
                }
            }
        }
    }
}

/* R1137: game's own callback installs, saved by the R1136 camera */
uint32_t r1137_saved_cbsync;   /* CD_cbsync last game install (c320: 0x80040DA0) */
uint32_t r1137_saved_cbready;  /* CD_cbready last game install (c320: 0x80040DC8) */

/* R1137 (b8-c320): CD CALLBACK COMPLETION RESTORE - the HLE analog of
 * the game's own completion path. decomp cdread.c: the archive read
 * NULLs both callbacks around commands (149-150) and the completion
 * reinstalls (132-133 restore / 190 CdReadyCallback(&cb_read)); our
 * HLE services the read so the completion never runs and the cells
 * stay NULL - bios.c's event dispatch (the churn loop 0x80041C68) then
 * finds empty gates forever. Called from the kernel event-post path
 * (R879/R887): if BOTH cells are NULL and the game's own installs are
 * saved, restore them - the values are the game's, receipted installs.
 * Stand-down discipline: never write a cell the game already set. */
static void r1137_cb_restore(const char *why)
{
    static int r1137_n;
    if (xenolift_mem_read32(0x800564A8u) == 0u &&
        xenolift_mem_read32(0x800564ACu) == 0u &&
        r1137_saved_cbsync != 0u && r1137_saved_cbready != 0u) {
        xenolift_mem_write32(0x800564A8u, r1137_saved_cbsync);
        xenolift_mem_write32(0x800564ACu, r1137_saved_cbready);
        if (r1137_n < 8) {
            r1137_n++;
            r861_out("[cdcbheal] R1137 CD callbacks RESTORED at %s: 564A8 <- %08X 564AC <- %08X (game's own installs, c320 [cbsync] receipts; cdread.c:190 contract - the HLE read-completion analog)\n",
                    why, r1137_saved_cbsync, r1137_saved_cbready);
        }
    }
}

/* R1197 (Jos c492): RUN-OBSERVED writers of the R978 handler-table district,
 * ALL STORE WIDTHS incl. overlapping byte/halfword stores - otherwise
 * "no writer observed" would be another coverage-based false conclusion.
 * PHYSICAL MAPPING, GATED: pa = a & 0x1FFFFFFF is valid ONLY in the three
 * mapped segments (KUSEG 0x00000000-0x7FFFFFFF, KSEG0 0x80000000-0x9FFFFFFF,
 * KSEG1 0xA0000000-0xBFFFFFFF); for the watched KSEG0 cells 0x8006A228 and
 * 0x8006A22C the offsets are 0x6A228 and 0x6A22C - the subtraction is NOT
 * generalized to arbitrary guest addresses (KSEG2 a>=0xC0000000 is unmapped:
 * old-value read is skipped and labeled). sw_line is set by the SW macro
 * ONLY: a genuine emitted store line for write32; STALE for write16/write8
 * (SH/SB emit no line capture) - labeled, never inferred. cur_fn is the LAST
 * DISPATCHED function only, not necessarily the store's owner. Overlap test:
 * write window [pa, pa+w) vs cell window [c, c+4) - any partial overlap
 * receipts. TELEMETRY ONLY, cap 8 shared across widths. */
static uint32_t g_r1197_tblw_n;
/* R1197 (Jos c493): COMMITTED-STORE district camera. old captured immediately
 * BEFORE the committing store, receipt immediately AFTER - a suppressed or
 * dropped write above never reaches the commit site, so it can never be
 * receipted as a mutation. Runs at the RAM commit memcpy only (the district is
 * RAM; IO-path writes never land here). Attribution: sw_active/sw_line/sw_width
 * are CALL-SCOPED (SW/SH/SB macros set + restore) - a write with sw_active==0
 * is a direct runtime write, labeled runtime/unknown, never misattributed;
 * sw_line can attribute ONLY macro calls (R1112 receipts it as last-SW, and
 * SH/SB were static-inline fns with NO capture until R1197 made them macros).
 * Overlap on PHYSICAL offsets (the runtime's own xenolift_phys mapping):
 * [off, off+w) x [cell, cell+4) - partial byte/halfword overlap receipts.
 * For the KSEG0 cells the offsets are 0x6A228/0x6A22C; the mapping is the
 * commit-site's own xenolift_phys, never a generalized subtraction. Cap 8. */
static uint32_t g_r1215_trcam_n;
/* R1215 (c40): TRUNCATION-DISTRICT camera. c40 receipts: the stage-2 module
 * install writes TRUNCATED pointers into the module-call gates (gateheal
 * 800593AC 00000884->80100884 "halt jumped through truncated 0x884", gateheal
 * R970 800593B8 000007A0->80100000, skiphook target 000007A0) - the high
 * 0x8010_0000 bits stripped before store. The heals prove the symptom every
 * era; the WRITER of the truncated value is unreceipted. District: the module
 * gate cells 0x800593A0..C8 (593AC/B0/B8 physical 0x593A0-0x593C8) and the
 * module head 0x8006FAE0..B18 (6FAEC/6FAF0/6FAF8 physical). ALL widths, old
 * before / after-after raw, entry-tuple attribution (the R1197 discipline) -
 * receipts the width, value, writer, and line of every truncation-class store.
 * Value-gated: print only when the committed value is TRUNCATION-SHAPED
 * (nonzero, < 0x80000000) or nonzero-new against a zero old - heals and
 * healthy installs print once, zero-fills stay silent. Cap 48. */
static int r1215_trcam_pre(uint32_t off, uint32_t w, uint32_t *old_out)
{
    static const uint32_t r1215_cells[2][2] = { { 0x593A0u, 0x593C8u }, { 0x6FAE0u, 0x6FB18u } }; /* physical [lo,hi] */
    uint32_t i;
    for (i = 0; i < 2u; i++)
        if (off < r1215_cells[i][1] && r1215_cells[i][0] < off + w) {
            if (g_r1215_trcam_n >= 48u) return 0;
            memcpy(old_out, xenolift_mem + off, w);
            return 1; /* count at post - the value gate decides printing */
        }
    return 0;
}
static void r1215_trcam_post(uint32_t a, uint32_t off, uint32_t w, uint32_t v, uint32_t old, int is_macro)
{
    uint32_t vmask = (w == 4u) ? 0xFFFFFFFFu : ((w == 2u) ? 0xFFFFu : 0xFFu);
    uint32_t vm = v & vmask, om = old & vmask;
    int trunc_shaped = (vm != 0u && vm < 0x80000000u);
    if (!trunc_shaped && !(om == 0u && vm != 0u)) return; /* silent unless truncation-shaped or fresh-nonzero */
    g_r1215_trcam_n++;
    if (g_r1215_trcam_n > 48u) return;
    r861_out("[trcam] R1215 w%u ea=0x%08X off=0x%08X old=%08X new=%08X writer_fn=%08X r31=%08X sw_line=%u%s\n",
            w, a, off, om, vm, (uint32_t)xenolift_cur_fn, (uint32_t)r[31], xenolift_sw_line,
            is_macro ? " MACRO-ATTRIBUTED" : " runtime/unknown(entry sw_active==0)");
}
static int r1197_tblw_pre(uint32_t off, uint32_t w, uint32_t *old_out)
{
    static const uint32_t r1197_cells[3] = { 0x6A228u, 0x6A22Cu, 0x6A230u }; /* physical offsets */
    uint32_t i;
    for (i = 0; i < 3u; i++)
        if (off < r1197_cells[i] + 4u && r1197_cells[i] < off + w) {
            if (g_r1197_tblw_n >= 8u) return 0;
            memcpy(old_out, xenolift_mem + off, w);
            g_r1197_tblw_n++;
            return 1;
        }
    return 0;
}
static void r1197_tblw_post(uint32_t a, uint32_t off, uint32_t w, uint32_t v, uint32_t old, int is_macro)
{
    uint32_t vmask = (w == 4u) ? 0xFFFFFFFFu : ((w == 2u) ? 0xFFFFu : 0xFFu);
    uint32_t v_fn = (uint32_t)xenolift_cur_fn; /* snapshot before logging */
    uint32_t v_after = 0xDEAD0001u;
    memcpy(&v_after, xenolift_mem + off, w); /* AFTER bytes raw from the backing store - proves the store landed */
    r861_out("[tblw] R1197 COMMITTED w%u ea=0x%08X off=0x%08X old=%08X arg=%08X after=%08X | store=%s line=%u | cur_fn=%08X(LAST DISPATCHED only) | SOURCE-scan candidates separate via SRC probe\n",
            w, a, off, old & vmask, v & vmask, v_after & vmask,
            is_macro ? "MACRO-ATTRIBUTED (guest SW/SH/SB call site)" : "runtime/unknown (entry sw_active==0: direct or hook-nested runtime write, never auto-labeled a guest store)",
            g_r1197_t_line, v_fn);
}
static void xenolift_mem_write32_inner(uint32_t a, uint32_t v)
{
    /* R1162 (b8-c347): VSYNC-CLEAR CONTRACT GUARD (WARDEN/shared, cross-impact:
     * touches write path shared by all lanes - ATLAS CD cells protected by
     * range check, no other lane's cells inside the drop set). c347
     * receipts: after the deepest state ever (2nd-epoch coordinator
     * dispatch, f14 gate MATCH, linker pass, door knocked @t=174s), a
     * walk returning to startIntrVSync+0x30 (r31=0x8004BF50) poisoned the
     * walker cells (FAEC/92C0/92BC/92D0/F0C/F10 -> 08080808), SB'd into
     * the stage-2 window (0x801EF59F), SB'd val=8 past RAM from
     * 0x80200000 up, and word-wrote 0x801D2D00 (R763, writer_fn=0x8004C01C
     * = memclrIntrVSync). Decomp contract (psyq/libetc/intr_vsync.c:15,
     * symbol_addrs.slus_006.64.txt:844): startIntrVSync clears EXACTLY
     * 8 slots of g_VsyncInterruptCallbacks = 0x80058940..0x80058960,
     * value NULL. Any store returning to 0x8004BF50 outside that array =
     * garbage base (R1024 taint class at a kernel call). Drop + receipt. */
    if (r[31] == 0x8004BF50u && !(a >= 0x80058940u && a < 0x80058960u)) {
        static uint32_t vsw_min, vsw_max; static int vsw_n;
        if (vsw_n == 0) { vsw_min = a; vsw_max = a; }
        if (a < vsw_min) { vsw_min = a; }
        if (a > vsw_max) { vsw_max = a; }
        if (vsw_n < 8) { vsw_n++;
            r861_out("[vswclear] R1162 vsync-clear contract violation: %s 0x%08X val=%08X from startIntrVSync+0x30 DROPPED (decomp intr_vsync.c:15 bounds the clear to g_VsyncInterruptCallbacks[8] @0x80058940; walk bounds %08X..%08X)\n",
                    "write32", (unsigned)a, (unsigned)v, (unsigned)vsw_min, (unsigned)vsw_max);
        }
        return;
    }

    /* R1136 (b8-c319): CD CALLBACK INSTALL CAMERA. decomp source
     * psyq/libcd/sys.c: CdSyncCallback/CdReadyCallback store the
     * handlers into CD_cbsync (0x800564A8) / CD_cbready (0x800564AC);
     * libcd's own read chain installs &cb_read (cdread.c:190) during
     * CdRead paths; bios.c's event dispatch calls CD_cbready on ready
     * interrupts - THE CHURN LOOP (0x80041C68: lbu a0,[s4]; lui a1,
     * 0x8006; addiu a1,0xA218; jalr r2 gated on [0x800564AC]) is that
     * dispatch, and every door dump to date reads both cells ZERO.
     * This camera names the class: (a) install-then-wiped - receipts
     * show a fn pointer write followed by the zeroing writer; (b)
     * never-installed - zero writes reach the cells - our HLE seams
     * service the reads and bypass libcd's installer entirely, and
     * the HLE contract must service the dispatch. Cap 8/run. */
    if (a == 0x800564A8u || a == 0x800564ACu) {
        static int r1136_n;
        if (v != 0u) {
            /* R1137 (b8-c320): SAVE the game's own installs. c320
             * [cbsync] receipts named the whole cycle: the game's libcd
             * installs CD_cbsync=0x80040DA0 / CD_cbready=0x80040DC8
             * (writers 0x80040FB4/0x80040FCC = CdSyncCallback/
             * CdReadyCallback), then the archive read path NULLs both
             * (callers 0x800282D0/0x800282D8 = decomp cdread.c:149-150
             * CdSyncCallback(NULL); CdReadyCallback(NULL)) and the
             * completion that reinstalls &cb_read (cdread.c:190) never
             * runs - our HLE services the read and skips the game's own
             * completion chain. These saved values are the GAME'S OWN,
             * receipted installs - no guessing. */
            if (a == 0x800564A8u) r1137_saved_cbsync = v;
            else r1137_saved_cbready = v;
        }
        /* R1139 (b8-c322): CALLBACK-CELL INVALID-STORE GUARD. c322
         * EXITTAIL receipt: the churn dispatch loop (0x80041C68: lw r2,
         * [0x800564AC]; beq r2,0 skip; lbu a0,[r4]; lui a1,0x8006;
         * addiu a1,0xA218; jalr r2) crashed CALLING THROUGH CD_cbready=6
         * - a tiny int in the cell (the R1133 misdirected-small-store
         * class: decomp vsync.c timeout[] stack-local stores landing in
         * wrong cells). The loop gates on NONZERO, so 6 passes the gate
         * and jalr 6 dies at addr=0x6. Cell semantics per decomp
         * psyq/libcd/sys.c: 0 = no callback, guest code ptr = callback.
         * Any other value is PROVABLY invalid (guest code lives in
         * 0x80010000..0x80200000 incl. overlays/heap-relocated thunks).
         * Redirect invalid stores to 0 - the uninstall value that can
         * never crash a jalr. Valid installs still pass untouched. */
        if (v != 0u && (v < 0x80010000u || v >= 0x80200000u)) {
            static int r1139_n;
            if (r1139_n < 8) {
                r1139_n++;
                xenolift_receipt("[cbguard] R1139 invalid CD callback store BLOCKED: cell %08X <- %08X redirected to 0 (writer_fn=%08X r31=%08X; decomp %s; not-0-not-guest-ptr = provably invalid per sys.c cell semantics; c322 receipt: CD_cbready=6 jalr'd to addr 0x6)\n",
                        a, v, (unsigned)xenolift_cur_fn, (unsigned)r[31],
                        a == 0x800564A8u ? "CD_cbsync" : "CD_cbready");
            }
            v = 0u;
        }
        if (r1136_n < 8) {
            r1136_n++;
            xenolift_receipt("[cbsync] R1136 CD callback cell %08X <- %08X writer_fn=%08X r31=%08X sp=%08X (decomp: %s; 0=uninstall/handoff, fnptr=install; first-writer-decides class)\n",
                    a, v, (unsigned)xenolift_cur_fn, (unsigned)r[31], r[29],
                    a == 0x800564A8u ? "CD_cbsync" : "CD_cbready");
        }
    }

    /* R1054: VALUE-KEYED taint watch. c213 bodycam receipts: module fns
     * 801D002C/801D2FE8 entered with a1=0xC00D7F50 (the standing taint is
     * an ENTRY ARG passed by the coordinator chain, not developed inside),
     * and linker-caller 800320A4 shows the same taint family in a2
     * (BED00002/C6C0CBA5/00CA00A0). Find WHERE the taint is stored: any
     * guest write of the exact value 0xC00D7F50 receipts the target addr.
     * Routed through xenolift_receipt (direct write(2)) - r861_out is
     * budget-silenced mid-run (R971 50MB gate ate six cycles of bodycam
     * receipts before R1053 proved it). */
    if (v == 0xC00D7F50u) {
        static int tw_n;
        if (tw_n < 24) {
            tw_n++;
            xenolift_receipt("[taintw] R1054 #%d TAINT C00D7F50 stored at %08X\n", tw_n, a);
        }
    }
    /* R1131 (b8-c312): LIBCD RESPONSE-MIRROR WRITER WATCH.
     * decomp symbol_addrs: reg0=0x80056770 reg1=..74 reg2=..78
     * reg3=..7C (libcd response mirrors, adjacent to com_delay/_spu/
     * Intr). c310 cdkeep2 receipt: 0x80056770 preserved as ZERO -
     * never written. c312 CD_cw crash code at 0x80041C68: lw r2,
     * [0x80056770]; lbu r2, [r2] - derefs THROUGH reg0's value; tiny
     * fault addrs 0/6/7/8 are consistent with response-byte values
     * deref'd as pointers. Question: does ANY writer ever set the
     * mirrors? (psx-spx: the CD interrupt chain copies the response
     * FIFO 1F801801h-1F801803h into reg0-reg3 on command completion -
     * our no-interrupt model may have dropped the copy.) Receipt any
     * nonzero write + dump mirrors at crashkit entry. */
    /* R1132 (b8-c313): ARCH-CHAIN DEGENERATE-WRITE WATCH. c313 trampctx
     * receipt: at the svc-0x103 trampoline call the archive chain was
     * DEGENERATE - base cell 4FDF0 held 1 (not the healthy 0x80010004
     * receipted by archbase/ftab every cycle), FE14/FE1C zero, and the
     * derived handler was 0x51001 with a0 equal to it - the same
     * derive-from-garbage class as R1061's [stab] decode. archkeep (R1125)
     * preserves the base across RESTORES; this watch catches RUNTIME
     * writes of degenerate values (small ints, not 0, not the healthy
     * base) and names the writer fn. */
    /* R1148 (b8-c331): LIBETC QUEUE-CELL INSTALL CAMERA. c331 receipts:
     * the FIRST crash of the run era was cur_fn=0x8004B55C (Vsync body,
     * symbol map 0x8004B54C=Vsync) faulting at addr=0x0 - BEFORE any
     * crash-kit restore ran (recovery #1), so the R1146 preserve could
     * not have been bypassed by a wipe: the cells 0x8005783C/0x80057840
     * were NULL at first fault. Either the installer (libetc init /
     * EnableVblankController family) never writes them on this
     * trajectory, or something else clears them pre-crash. Receipt-
     * first: watch every write to the three queue cells, name the writer
     * fn + source line + old->new. Silence across a run = the installer
     * never runs = the next decode target (the c330 descw2 receipts show
     * the EnableVblankController at 0x8004BF50 writing the 18088-family
     * queue cells - maybe the 5783C-family is a DIFFERENT install door).
     * No heal until the writer or its absence is receipted. */
    if (a == 0x8005783Cu || a == 0x80057840u || a == 0x80057844u) {
        static int r1148_n;
        if (r1148_n < 24) {
            r1148_n++;
            xenolift_receipt("[lqcam] R1148 #%d libetc queue cell %08X: %08X -> %08X writer_fn=%08X sw_line=%u r31=%08X @t=%lds (c331: Vsync body faulted on NULL cells before ANY restore - name the installer or receipt the never-install)\n",
                    r1148_n, (unsigned)a,
                    xenolift_mem_read32(a), v,
                    (unsigned)xenolift_cur_fn, xenolift_sw_line, r[31],
                    (long)(xl_wall() - g_boot_wall_t0));
        }
    }
    /* R1144 (b8-c327): STATE-CELL STOMP CAMERA. c327 receipts: [exitdiag]
     * R649 @t=59s shows the ENTIRE walk/archive state-cell family stomped
     * with a 0xFFFFFFFF fill - 92C0=FFFFFFFF idx(FAEC)=02020202 req=FFFFFFFF
     * F0C(59F0C)=FFFFFFFF F10(59F10)=FFFFFFFF FE04=FFFFFFFF FDF8=FFFFFFFF
     * FE1C=FFFFFFFF FE20=FFFFFFFF loop28088=FFFFFFFF - alternating with the
     * healthy file#7 posture (F0C=7 F10=00611324 FE04=0001A956) in the same
     * era, during the deepest module execution ever (cur_fn band 0x800ABA04
     * .. 0x800ECCC0, r31=0x80077FC8 helper chain). A -1/0x02 fill write
     * crosses the whole family - this camera names the writer fn + source
     * line at the moment it lands (archw R1132 pattern; receipt-first, no
     * heal until the writer is named). */
    if ((a == 0x800592C0u || a == 0x8005FAECu || a == 0x80018088u
         || a == 0x80059F0Cu || a == 0x80059F10u || a == 0x8005FE04u
         || a == 0x8005FDF8u || a == 0x8005FE1Cu || a == 0x8005FE20u
         || a == 0x80028088u)
        && (v == 0xFFFFFFFFu || v == 0x02020202u)) {
        static int r1144_n;
        if (r1144_n < 16) {
            r1144_n++;
            xenolift_receipt("[stompcam] R1144 #%d STOMP write %08X <- %08X writer_fn=%08X sw_line=%u (the -1/0x02 fill class across the walk/archive state cells; healthy file#7 posture F0C=7 F10=00611324 FE04=0001A956 receipted same era) | guest r29(sp)=%08X r31=%08X r4=%08X r5=%08X r16=%08X\n",
                    r1144_n, (unsigned)a, v, (unsigned)xenolift_cur_fn, xenolift_sw_line,
                    r[29], r[31], r[4], r[5], r[16]);
        }
    }
    if (a == 0x8004FDF0u && v != 0u && v != 0x80010004u) {
        static int r1132_n;
        if (r1132_n < 16) {
            r1132_n++;
            xenolift_receipt("[archw] R1132 #%d DEGENERATE base write 4FDF0 <- %08X writer_fn=%08X sw_line=%u (healthy=80010004; sp was IN-BAND c316 so the store's source LINE names the true writer - cur_fn attribution may mislead) | guest r29(sp)=%08X r31=%08X r4=%08X r5=%08X r16=%08X r28=%08X\n",
                    r1132_n, v, (unsigned)xenolift_cur_fn, xenolift_sw_line,
                    r[29], r[31], r[4], r[5], r[16], r[28]);
        }
    }
    if (a >= 0x80056770u && a <= 0x8005677Cu && v != 0u) {
        static int r1131_n;
        if (r1131_n < 16) {
            r1131_n++;
            xenolift_receipt("[reg0cam] R1131 #%d MIRROR WRITE %08X <- %08X writer_fn=%08X\n",
                    r1131_n, a, v, (unsigned)xenolift_cur_fn);
        }
    }
    /* R755 STACK-BAND WRITE WATCH: c333 resurrected the stale-stack race
     * fault (guest jumped through 0x13B88422, which R696 found sitting in
     * cell 0x801FFF70). R696 said "writer trace next" - this is it: log every
     * NONZERO write into the stack-top band 0x801FFF40-0x801FFF80 with the
     * writer fn (zero writes are the boot BSS clear - skipped so the cap
     * survives to the interesting era). Cap 48. */
    /* R778 BANK WRITE WATCH: the field-cb entry indexes banks at
     * 0x800AA3F0 + (idx<<15); banks 1-3 (0x800B23F0..0x800CA3F0) are ALL
     * ZEROS while bank 0 has real records (c341/c361 receipts) - the
     * missing-initializer fingerprint. Log WHO writes the banks (if
     * anyone); no writer by end of run = the initializer never ran. */
    if (a >= 0x800B23F0u && a <= 0x800CA3FFu && v != 0u) {
        static int bw_n;
        if (bw_n < 24) {
            bw_n++;
            r861_out("[bankw] R778 BANK WRITE %08X <- %08X writer_fn=%08X (%s)\n",
                    a, v, (unsigned)xenolift_cur_fn,
                    (a < 0x800BA3F0u) ? "bank1" : (a < 0x800C23F0u) ? "bank2" : "bank3");
        }
    }
    if (a >= 0x801FFF40u && a <= 0x801FFF80u && v != 0u) {
        static int sbw_n;
        if (sbw_n < 48) {
            sbw_n++;
            r861_out("[stkband] R755 WRITE %08X <- %08X writer_fn=%08X (stale-target hunt: c333 fault target sat in 0x801FFF70)\n",
                    a, v, (unsigned)xenolift_cur_fn);
        }
    }

    /* R1334 SOUND-HEAP HEAD WATCH (c283 receipts): the fault chain
     * is decoded - the menu era (KernelMenuMain -> 80019B00 ->
     * HeapRelocate -> 80032240 -> HeapFree) runs the sound-sample
     * dispatcher (fntrail 800734E8/800734FC alternating) which calls
     * the LZSS core with src = a MASK-TABLE entry value (0x04000000 =
     * cell 0x8004FB80; the band 0x8004FB40-0x8004FB94 is the 32-entry
     * power-of-two table fn 800357C0 writes at menu init) - the
     * dispatcher consumed a garbage sample-source pointer, likely
     * from an EXHAUSTED sound heap (g_SoundHeapHead 0x80059410 was
     * popped to 0 in the c276 receipts). Watch every write to the
     * head + the new R696 stale cells 0x80083964 / 0x800936C0.
     * Cap 72. */
    if (a == 0x80059410u || a == 0x80083964u || a == 0x800936C0u) {
        static unsigned shh_n;
        if (shh_n < 72u) {
            shh_n++;
            r861_out("[shhead] R1334 WRITE %08X <- %08X writer_fn=%08X\n",
                    a, v, (unsigned)xenolift_cur_fn);
        }
    }

    /* R1335 REVERB-BAND WRITE WATCH (c286 receipts): the fault chain
     * is SpuSetReverbModeType -> SpuClearReverbWorkArea -> the
     * work-area list walk (fn 8004CCB8: r5 = LW(r5 + 0x8E08), field
     * reads at +0x1A6), entered with garbage head r5=0x589F8000 -
     * the first +0x1A6 read faulted (0x589F81A6). The mode table
     * lives at 0x80068E70 (per-mode fn pointers) and the list-head
     * cells near 0x80068E08/0x80068E0C. Watch every NONZERO write
     * into 0x80068E00-0x80068EA0 with the writer fn; cap 64. The
     * receipts decide heal-vs-game: the R1139 cbguard blocked a
     * game store '0x800564A8 <- 1' shortly before the fault - if
     * that block skipped the work-area init, the head stays stale. */
    if (a >= 0x80068E00u && a <= 0x80068EA0u && v != 0u) {
        static int rvb_n;
        if (rvb_n < 64) {
            rvb_n++;
            r861_out("[rvbw] R1335 REVERB-BAND WRITE %08X <- %08X writer_fn=%08X\n",
                    a, v, (unsigned)xenolift_cur_fn);
        }
    }

    /* R1338b GPU-BAND WRITE WATCH, RESCOPED (c301 verdict): the 60s
     * run receipted ZERO writes to the pointer cells and ZERO faults -
     * but the window's other cells (callback registration at
     * 0x800569C4-CC, frame counter at 0x800569E8 - written every
     * frame by the Vsync chain) FLOODED the 64 cap in seconds,
     * blinding the camera to any later poison event. RESCOPE: watch
     * ONLY the pointer cells 0x80056990-0x800569C0 (zero legitimate
     * writes - the cap now lasts the whole run). */
    if (a >= 0x80056990u && a <= 0x800569C0u) {
        static int gpw_n;
        if (gpw_n < 64) {
            gpw_n++;
            r861_out("[gpw] R1338b GPU-BAND POINTER WRITE %08X <- %08X writer_fn=%08X\n",
                    a, v, (unsigned)xenolift_cur_fn);
        }
    }

    /* R1333 ARCHIVE-BAND WRITE WATCH (c282 decode): the c276-era death
