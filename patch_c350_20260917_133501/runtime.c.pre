    /* R918: dispatch-boundary release - the guest status-poll path only
     * REQUESTS (R400's call is now a flag); when the anchor reaches a clean
     * seam (depth==0 here), run the release ONCE. Cap receipts at 6. */
    if (g_r918_poll_requested) {
        g_r918_poll_requested = 0;
        { static int r918n; if (r918n < 6) { r918n++;
            r861_out("[boundaryrel] R918/R923 deferred poll release executed at dispatch boundary (NO cd_sched_poll_release frame ever lives inside a guest context - data FIFO + 802/803 polls + FE1C hook all request-only)\n"); } }
        cd_sched_poll_release();
    }
    /* R365 PARK BACKSTOP: if we re-enter on_alarm while a park dump is
     * in flight, a park printer has wedged inside the signal handler
