                 * comparisons use the OLD field LBAs (108979+). The b8-c8
                 * install chain delivers FILE#2 (LBA 108754, 61680B; fldsec
                 * 108755-108779) and decompresses 29048B from staging
                 * 0x800AFC98. DIFF@1 vs the OLD baseline = expected when the
                 * ring holds file#2, NOT a delivery fault. Compare ring+staging
                 * against FILE#2's own disc region (LBA 108754+, 29048B) so
                 * the next digest names whether the new delivery is
                 * byte-faithful. Diagnosis only. */
                uint32_t fd_f2r = 0xFFFFFFFFu, fd_f2s = 0xFFFFFFFFu;
                disc_off = 0u;
                for (uint32_t lba = 108754u; lba <= 108768u && disc_off < 29048u; lba++) {
                    if (disc_read_lba(lba, sbuf) != 0) break;
                    for (uint32_t k = 0; k < 2048u && (disc_off + k) < 29048u; k++) {
                        if (fd_f2r == 0xFFFFFFFFu
                            && xenolift_mem[ring + disc_off + k] != sbuf[k])
