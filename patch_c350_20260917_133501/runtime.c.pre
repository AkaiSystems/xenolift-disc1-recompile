            uint32_t h2k2 = xenolift_mem_read32(0x800564A8u);
            if (h2k2 >= 0x80010000u && h2k2 < 0x80060000u) {
                r[4] = xenolift_mem[0x56788];
                r[5] = 0x8005A210u;
