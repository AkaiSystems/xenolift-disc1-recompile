          g_r1199_ring_i++;
          g_r1199_last_pc = (uint64_t)r1199_pc;
      }
    }
    /* R890 (c485, manager self-fix #4 - THE BLINDING BUG): frz_watch is
     * spawned FROM on_alarm (below this point since R885) - so when the
     * spin holds depth=1 at every alarm, on_alarm returned early forever
     * and the WATCHER THREAD NEVER SPAWNED: mvdoor + near-camera + f5fix
     * + [wd] budget receipts all dead (c482-c485: =WD= empty, every
     * watcher probe silent, near-camera with a SINGLE condition not
     * printing). The crash fix blinded the whole watcher. Thread spawn,
     * boot-clock latch, and budget header are CHEAP and signal-safe -
     * they run BEFORE the depth guard, always. Only the DRAIN machinery
     * stays deferred. */
    { static int r825_spawned; if (!r825_spawned) { r825_spawned = 1;
      /* R876 (c466/467, WARDEN): the frz_watch thread is the SIGALRM heartbeat's
       * delivery point (it sleeps in sleep(1) - always the interruptible
       * thread), and it was spawned with the DEFAULT ~512KB stack. The alarm-
       * time chain (vb_topup + cd_sched_poll_release + f5fix sector delivery
       * + kit dump on signal) exhausts it: canary trips in the deepest fn,
       * blame MOVING run-to-run (cd_sched_poll_release -> crash_dump_mem ->
       * xenolift_trace) on the SAME non-anchor tid. The canary was the
       * messenger, the stack was the bug. Give it 256MB. */
      pthread_t th; pthread_attr_t at;
      pthread_attr_init(&at);
      pthread_attr_setstacksize(&at, (size_t)256 * 1024 * 1024);
      if (pthread_create(&th, &at, r825_frz_watch, NULL) != 0)
          { pthread_t th2; pthread_create(&th2, NULL, r825_frz_watch, NULL); th = th2; }
      pthread_detach(th); } }
    if (g_boot_wall_t0 == 0) g_boot_wall_t0 = time(NULL); /* paranoia: alarm before main? */
    run_now = xl_wall();
    static int run_budget_s = -2; /* R449 FAST-CYCLE KNOB: read xenolift_budget.txt
     * once (written by run.sh; default 210 = full trajectory, unchanged).
     * Quick-verdict cycles set a shorter window so the report lands sooner. */
    if (run_budget_s == -2) {
        FILE *bf = fopen("xenolift_budget.txt", "r");
        int b = 210;
        if (bf) { if (fscanf(bf, "%d", &b) != 1) b = 210; fclose(bf); }
        run_budget_s = (b >= 30) ? b : 210;
    }
    over_budget = ((run_now - g_boot_wall_t0) >= run_budget_s) || g_force_halt /* R415: 205->210 (c172: file 2 6/15 at halt; shell 232, bridge 240) */ /* R413: +10s (c170 pump ran out of clock mid-flow; bridge 240, shell 225, park ~15) */; /* R320: recursion guard can force */
    if (g_force_halt && (run_now - g_boot_wall_t0) < 195)
