    g_r1197_t_line = xenolift_sw_line; g_r1197_t_width = xenolift_sw_width; g_r1197_t_active = xenolift_sw_active;
    xenolift_sw_active = 0;
    xenolift_mem_write8_inner(a, v);
    /* R1239 (Jos c83): CONFIRMED mutations only, post-inner, physical band +
     * freelist heads, cap receipt at exhaustion. */
    { uint32_t pa = a & 0x1FFFFFFFu;
      if ((pa >= 0x77400u && pa < 0x78000u) || pa == 0x59320u || pa == 0x59324u) {
        static int bn8;
        if (bn8 < 96) { bn8++;
            r861_out("[bandhist] R1239 w8 CONFIRMED ea=0x%08X v=%02X landed=%02X fn=0x%08X\n", a, v & 0xFFu, xenolift_mem[pa], xenolift_cur_fn);
        } else if (bn8 == 96) { bn8++;
            r861_out("[bandhist] R1239 w8 camera CAP (96) reached - further band byte writes not logged\n"); }
      }
