                { static int r1195_bt_n;
                  if (r1195_bt_n < 2) { r1195_bt_n++;
                    void *bt[28]; int bn;
                    r861_out("[wedge] R1195 liveness: kick enter=%u exit=%u active=%u | notifier enter=%u exit=%u | read-spin hits r8=%u r16=%u r32=%u\n",
                            g_r1195_kick_enter, g_r1195_kick_exit, g_r1195_kick_active,
                            g_r1195_notif_enter, g_r1195_notif_exit,
                            g_r1195_r8_hits, g_r1195_r16_hits, g_r1195_r32_hits);
                    r861_out("[wedge] R1197 a22c origin guest=%u host=%u | outcome blocked=%u svc-ent=%u svc-ret=%u (origin x outcome INDEPENDENT - guest>0 + blocked>0 = guest reads land hb-blocked; svc-ent!=svc-ret = serviced kick never returned - Jos c489)\n",
                            g_r1196_a22c_guest, g_r1196_a22c_host,
                            g_r1196_a22c_hbblk, g_r1196_a22c_th, g_r1196_svc_ret);
#ifdef __APPLE__
                    r861_out("[wedge] R1195 image load: base=%p slide=0x%lx name=%s\n",
                            (void*)_dyld_get_image_header(0),
                            (unsigned long)_dyld_get_image_vmaddr_slide(0),
                            _dyld_get_image_name(0) ? _dyld_get_image_name(0) : "?");
