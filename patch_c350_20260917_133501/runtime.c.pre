        r861_out("[park] stream cells (R273): FE30=%08X FE34=%08X FE38=%08X FE3C=%08X FE40=%08X FE44=%08X FE48=%08X FE4C=%08X FE50=%08X | idx-head@801E1400=%08X %08X %08X %08X | 77398=%04X 7739C=%04X\n", LW(0x8004FE30u), LW(0x8004FE34u), LW(0x8004FE38u), LW(0x8004FE3Cu), LW(0x8004FE40u), LW(0x8004FE44u), LW(0x8004FE48u), LW(0x8004FE4Cu), LW(0x8004FE50u), LW(0x801E1400u), LW(0x801E1404u), LW(0x801E1408u), LW(0x801E140Cu), LHU(0x80077398u), LHU(0x8007739Cu));
        r861_out("[park] height gate (R272): cell773A0=%08X dispY77024=%08X buf801E6000=%08X %08X %08X %08X | w773A4=%08X h773A8=%08X chk77438=%08X\n", LW(0x800773A0u), LW(0x80077024u), LW(0x801E6000u), LW(0x801E6004u), LW(0x801E6008u), LW(0x801E600Cu), LW(0x800773A4u), LW(0x800773A8u), LW(0x80077438u));
        r861_out("[park] player state (R301: 0x800704E0 = pad+prologue of ReadStressTestScreen@0x800704E8, NOT cfg): 704E0=%08X %08X %08X %08X | 704F0=%08X %08X | gate77194=%02X | 77010=%02X 77012=%02X 7702C=%08X 77030=%08X\n",
                xenolift_mem_read32(0x800704E0u), xenolift_mem_read32(0x800704E4u),
                xenolift_mem_read32(0x800704E8u), xenolift_mem_read32(0x800704ECu),
                xenolift_mem_read32(0x800704F0u), xenolift_mem_read32(0x800704F4u),
                xenolift_mem_read32(0x80077194u) & 0xFFu,
                xenolift_mem_read32(0x80077010u) & 0xFFu, xenolift_mem_read32(0x80077012u) & 0xFFu,
