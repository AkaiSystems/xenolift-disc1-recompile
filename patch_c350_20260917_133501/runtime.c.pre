                uint32_t fd_ctl = 0xFFFFFFFFu;
                if (disc_read_lba(108861u, sbuf) == 0) {
                    for (uint32_t k = 0; k < 16u; k++)
                        if (xenolift_mem[ctl + k] != sbuf[k]) { fd_ctl = k; break; }
                }
