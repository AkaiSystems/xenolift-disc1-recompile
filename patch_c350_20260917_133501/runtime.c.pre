             * consumer's slot expectations. Log-only. */
            r861_out("[f15cont] R605: feed SKIPPED (native owns ring; LBA %u -> 0x%08X observed only)\n", f15_lba, fe08);
            if (0) { uint8_t fbuf[2048];
