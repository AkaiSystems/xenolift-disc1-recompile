    /* R740 [spstub]: who writes the scratchpad? c315's fault is a jr into
     * 0x1F8000B0 with all-zero content - the kernel should park a stub there
     * on real HW. Log every scratchpad write with the writer fn (cap 12). */
    if (a >= 0x1F800000u && a < 0x1F801000u) {
        /* R1043 SCRATCHPAD TAINT WASH (b8-c197, decode lane): c175/c194
         * receipts prove the module helper (fn 0x80076858) writes
         * host-stack values (0xC0737F50, 0xF9FE6280, 0xAC27BDD0, all
         * >= 0x80200000 = out-of-guest-RAM truncated host pointers) into
         * the module jump-table cells 0x1F800000-8; module code later
         * derefs those cells and faults at low-32-of-host-pc addresses
         * (c197: addr 0x4FE21008 == host_pc 0x7FF84FE21008 low-32).
         * WASH: non-guest values written to the scratchpad data cells
         * (0x1F800000-0x1F80000F, NOT the stub home 0x1F8000A0+) are
         * redirected to the receipted healthy stub home 0x1F8000A0
         * (c175: stub copied AC23F9D8 0000800B ... at 0x1F8000A0-B0,
         * spexec serviced jumps there). 0xFFFFFFFF excluded (legit
         * invalid marker). Receipt each wash (cap 8). */
        if (a <= 0x1F80000Fu && v >= 0x80200000u && v != 0xFFFFFFFFu) {
            static uint32_t spw_n;
            spw_n++;
            if (spw_n <= 8u)
                r861_out("[spwash] R1043 SCRATCHPAD TAINT WASH %08X: %08X -> 1F8000A0 (writer fn %08X r31 %08X; c197 host-pc-truncation class)\n",
                        a, (unsigned)v, (unsigned)xenolift_cur_fn, (unsigned)r[31]);
            v = 0x1F8000A0u;
        }
        /* R741: total counter global - the fault block reports it so
         * "no writers" is STATED, never silent (probe-invisibility fix). */
        if (spw_total < 0x7FFFFFFF) spw_total++;
        if (spw_total <= 12) {
            r861_out("[spstub] R740 scratchpad WRITE %08X <- %08X at fn %08X\n",
                    a, v, (unsigned)xenolift_cur_fn);
        }
        /* R1017 (b8-c131): c131 receipts - the module helper (0x80076858)
         * called scratchpad 0x1F8000B0 (wildctx R680, args r6=1F8000A8
         * r7=1F8000B0 r17=1F800000) and the executor found a ZERO WORD at
         * the target (0 instrs serviced, guest continued). The R740 cap (12)
         * exhausted long before t=78s, so the window's late writes were
         * invisible. Always-log the jump-target window so c132 receipts show
         * what the kernel/helper installs there BEFORE the call. */
        if (a >= 0x1F800080u && a < 0x1F800100u) {
            static int spx_n;
            if (spx_n < 32) {
                spx_n++;
                r861_out("[spxw] R1017 sp-window WRITE %08X <- %08X at fn %08X (total %u) @t=%lds\n",
                        a, v, (unsigned)xenolift_cur_fn, spw_total,
                        (long)(xl_wall() - g_boot_wall_t0));
            }
        }
    }

    /* R487: garbage-family WRITE drop. The WDS high-end allocator
     * (fn_80039044) computes a poisoned free-list end (fault addr
     * 0xA106BDD8, r17=0xDF000011 family) and stores a bookkeeping
     * word there. R186 proved route-to-exception is futile (kernel
     * exception exit = blank page in this EXE -> handler returns to
     * the same store -> ping-pong halt). Real HW: bus error, write
     * lands nowhere, driver continues. Match that: DROP, receipt,
     * continue. READS still halt (probe signal). */
    if ((a >= 0x80200000u) || (a < 0x80000000u && a > 0x00100000u
          && !(a >= 0x1F800000u && a <= 0x1FAF0000u)) || (a >= 0xBFC10000u)) {
        /* R910 (b8-c11, manager - STRIPPED-TARGET HEAL, fcbfix precedent,
         * TRAILBLAZER walk lane): c5+c10+c11 receipts - the walk family
         * (r31=80031C2C, r17=0) computes write target 0x0059FAEC - a
         * GARBAGE-derived address with no valid KSEG0 form (0x0059FAEC |
         * 0x80000000 = 0x8059FAEC, outside kernel RAM; the historical
         * "0x80059FAEC" note was a NINE-DIGIT typo artifact, corrected
         * R1171 - the runtime's own walker-idx cell is 0x8005FAEC). The old guard dropped the write -> the walk faulted ->
         * fault-walk console restart x3 -> budget burned, area-1 (walk
         * completes) blocked. Same class as fcbfix (r16 healed 1 ->
         * 800592B8). HEAL: restore the 0x80000000 bit when the healed
         * address lands in valid kernel RAM and let the write LAND - the
         * walk completes. Receipt [wheal] cap 6. */
        if (a < 0x80000000u && a > 0x00100000u
            && (a | 0x80000000u) >= 0x80010000u && (a | 0x80000000u) < 0x801FFFFFu) {
            static int r910_n;
            if (r910_n < 6) { r910_n++;
                r861_out("[wheal] R910 stripped write target healed: %08X -> %08X val=%08X r31=%08X r17=%08X (walk high-bit-strip class; heal completes the walk instead of faulting it)\n",
                        (unsigned)a, (unsigned)(a | 0x80000000u), (unsigned)v,
                        (unsigned)r[31], (unsigned)r[17]);
            }
            a = a | 0x80000000u;
        } else {
        static uint32_t dw_last; static int dw_n; static uint32_t dw_tot;
        if ((a != dw_last || dw_n < 4) && dw_tot < 24u) {
            dw_tot++;
            r861_out("[wdrop] garbage write 0x%08X val=%08X dropped (r31=%08X r17=%08X cur_fn=%08X) — continuing\n",
                    (unsigned)a, (unsigned)v, (unsigned)r[31], (unsigned)r[17], xenolift_cur_fn);
            dw_last = a; dw_n++;
        }
        return;
        }
    }
    /* R517: [mangleguard] — c83/c84 decoded the 0x03-mangle family: guest fn
     * 0x800317E0 (pointer-fixup loop) stores, into kernel cells AND the irq
     * chain (0x80065B10+12), values like 0x0304FE0C/0x03059F1C/0x03065B0C =
     * (real cell address - 0x10) with the MSB turned to 0x03. Every one of
     * them dereferences OUTSIDE guest RAM (0x03xxxxxx < 0x80000000) and the
     * exception-recovery walk of the poisoned chain is what KILLS the run
     * (c83/c84 HALT). Gate: a VALUE in [0x03000000,0x04000000) whose low-24
     * bits land in the guest-RAM mirror window [0x00010000,0x00080000) can
     * never be a usable pointer or a plausible game scalar — drop it (same
     * bus-error semantics as R487), keep the kernel's records whole so the
     * game's own recovery completes. Receipt + 24-line budget. */
    /* R1083 (b8-c252): SLOT-SHIELD, mangleguard precedent. The coordw R1000
     * watcher receipts (c245-c252) name the class: kernel fns 0x80041534 /
     * 0x8004B54C / 0x800381F4 / 0x80042A54 write HOST-TAINT GARBAGE
     * (EBE10222, EEBC0235, DF0EFEEF, 3FFCCCE1 — all outside any plausible
     * guest code word) directly into the coordinator's TRANSLATED PROLOGUE
     * at 0x80077E88..0x80077E97, corrupting the code the dispatcher then
     * jumps into (R682: "zeros = blank-page crash recurs"). LEGITIMATE
     * writers are receipted: the build-time translated prologue (8E020050
     * 3C04800A 2484A3F0 00021303, R682 proof) and the R1005 module
     * expansion (27BDFFC8 3C038001 8C630000 2402FFFF, fldx2 receipts).
     * Whitelist = the two receipted healthy slot shapes; everything else
     * into the 4-word slot = mangle class, dropped + receipted (drop
     * semantics = the R487/R517 bus-error precedent: the kernel's own
     * recovery handles the lost store). Receipt + 12-line budget. */
    /* R1121 (b8-c302, Jos "burn faster" order): WHITELIST CORRECTION.
     * c298-c300 fldcam decode PROVED the expansion shape (27BDFFC8
     * 3C038001 8C630000 2402FFFF = addiu sp,-0x38; lui v1,0x8001; lw;
     * addiu v0,-1) is FieldMain's REAL prologue - executed as retail-
     * correct machine code three cycles running (calls decomp-named
     * FieldPartyAllocateSkinDataBuffers at +0x12C). The 8E020050 shape
     * (lw v0,0x50(s1); no sp adjust) is NOT a prologue - it is the
     * pre-menu snapshot's mid-function content that R681's fault-capture
     * maps over the slot; R682's proof established nonzero-ness, not
     * shape correctness. c302 coordw receipts the two shapes FIGHTING
     * for the slot across restarts - the whitelist admitting both meant
     * the shield was silent while the WRONG body landed on FieldMain's
     * slot in some restarts (c301 coordinator dispatch hit data-as-code).
     * Field era is Day 7's target: whitelist = expansion shape ONLY. */
    if (a >= 0x80077E88u && a < 0x80077E98u
        && !(v == 0x27BDFFC8u || v == 0x3C038001u || v == 0x8C630000u || v == 0x2402FFFFu)) {
        static uint32_t mg2_last; static int mg2_n; static uint32_t mg2_tot;
        if ((a != mg2_last || mg2_n < 2) && mg2_tot < 12u) {
            mg2_tot++;
            r861_out("[mangleguard] R1083 coordinator-slot mangle a=%08X val=%08X dropped (r31=%08X) — translated prologue preserved (whitelist = R682 build-time + R1005 expansion slot words)\n",
                    (unsigned)a, (unsigned)v, (unsigned)r[31]);
            mg2_last = a; mg2_n++;
        }
        return; /* drop the store - xenolift_mem_write32 is void (c253 fix: the sandbox cc took 'return v' as a warning, the Mac clang errored and run.sh refused the stale binary - one dead cycle, my miss) */
    }
    /* R1217 (c43): GUEST-STORE-ONLY SCOPE. c43 receipts caught this guard
     * eating the PRISTINE IMAGE RESTORES: the door-region raw dump shows the
     * R722/R962 restore writing the captured exe image back (taintw #4-16 =
     * the image's first header words at 80010004..80010080, r31=0 register-wiped
     * context) and THIS GUARD dropping the image's own .data words mid-restore
     * (800104F8 <- 030401BA, 80012B4C <- 03019C00, 8004FD08 <- 03030303 ...
     * all "chain preserved" = the storm-era value preserved, the table data
     * discarded). Every restore re-entered with HOLES: the game's state/file
     * tables at 80010xxx-80016xxx stayed blasted (6A6A6A6A-era), and the
     * receipts chain it straight into the storm: state cells quarantined ->
     * req18088=6A6A6A6A -> SIGILL poll death at 80042420 -> TRUE DEATH.
     * The guard's c83/c84 targets were all GUEST stores (misdirected chain
     * writes); runtime restores were never its target. Scope: quarantine only
     * when the store is a guest macro store (g_r1197_t_active, the R1198
     * attribution flag) - every original quarantine keeps firing identically,
     * the R722/R962/R846 restore family completes unfiltered. */
    if (v >= 0x03000000u && v < 0x04000000u
        && (v & 0x00FFFFFFu) >= 0x00010000u && (v & 0x00FFFFFFu) < 0x00080000u
        && a >= 0x80010000u && a < 0x80200000u
        && g_r1197_t_active) {
        static uint32_t mg_last; static int mg_n; static uint32_t mg_tot;
        if ((a != mg_last || mg_n < 4) && mg_tot < 24u) {
            mg_tot++;
            r861_out("[mangleguard] R517 mangled-pointer store a=%08X val=%08X dropped (r31=%08X) — chain preserved\n",
                    (unsigned)a, (unsigned)v, (unsigned)r[31]);
            mg_last = a; mg_n++;
        }
        return;
    }
    /* R435: THE CELL IS 0x80059394 — (int16_t)0x9394 is NEGATIVE (-0x6C6C); lui 0x8006 -> 0x80060000 + signext(0x9394) = 0x80059394. 0x80069394 was a PHANTOM cell for ~10 cycles (sign-extension misread). R430 CTXW hook, repointed: c187
     * verdict: journey provably executes the install store (straight-line,
     * no branches; ResetGlyphBatch called from 0x80037838 = 1 instr later),
     * unloader never ran, no second journey, watcher has 239 spare lines
     * yet the cell reads 0 at the very next dispatch. Either the store
     * never reaches this path (Mac emitted/guarded code differs) or its
     * value differs - this hook names which. */
        if (a == 0x801EF590u) { /* R436 batch-ptr field (ctx+0x38) — THE fault's LW source. Who writes it, when, with what? */
        static int s_btw_n;
        long bw_el = (g_boot_wall_t0 ? (long)(xl_wall() - g_boot_wall_t0) : 0);
        if (s_btw_n < 24)
            r861_out("[btw] SW 0x801EF590 val=%08X @t=%lds r31=%08X r16=%08X\n",
                    (unsigned)v, bw_el, (unsigned)r[31], (unsigned)r[16]);
        s_btw_n++;
    }
    if (a >= 0x801EF558u && a < 0x801EF660u) { /* R437 FRCLASH: font-record page guard — record sits inside the field pump's ring span (0x801EABD8-0x801EFBD8); log any post-boot writer */
        static int s_frc_n;
        long fc_el = (g_boot_wall_t0 ? (long)(xl_wall() - g_boot_wall_t0) : 0);
        if (fc_el >= 2 && s_frc_n < 24)
            r861_out("[frclash] W32 0x%08X val=%08X @t=%lds r31=%08X r16=%08X\n",
                    (unsigned)a, (unsigned)v, fc_el, (unsigned)r[31], (unsigned)r[16]);
        s_frc_n++;
    }
    if (a == 0x801EF5A4u) { /* R434 mid-block tripwire (SW +0x4C, middle's 5th store) */
        static int s_midw_n;
        long mw_el = (g_boot_wall_t0 ? (long)(xl_wall() - g_boot_wall_t0) : 0);
        if (s_midw_n < 8)
            r861_out("[midw] SW 0x801EF5A4 val=%08X @t=%lds r31=%08X r16=%08X\n",
                    (unsigned)v, mw_el, (unsigned)r[31], (unsigned)r[16]);
        s_midw_n++;
    }
    /* R1211 (c32): WILD-VALUE PROVENANCE - the c27/c28 first fault consumed
     * input ptr 0x05000000 from stale staging cells (R696: 0x801F3230/32D4
     * contain the target) but NO writer camera watches that band (the R696
     * "writer trace next" promise was implemented as R755 = stack-top band
     * only). Watch by VALUE, not address: every guest write of the literal
     * 0x05000000 into RAM names where the wild pointer is BORN. Cap 16. */
    if (v == 0x05000000u && (a & 0x1FFFFFFFu) < XENOLIFT_RAM_SIZE) {
        static int r1211w_n;
        if (r1211w_n < 16) { r1211w_n++;
            r861_out("[wv50] R1211 WILD VALUE 0x05000000 written to %08X writer_fn=%08X r31=%08X sw_line=%u r4=%08X r5=%08X\n",
