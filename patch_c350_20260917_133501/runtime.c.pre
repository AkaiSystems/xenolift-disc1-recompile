                      for (r1199_i = 0; r1199_i < 8; r1199_i++)
                          r861_out("  [%d] %llx\n", r1199_i, (unsigned long long)g_r1199_ring[r1199_i]); }
                    r861_out("[wedge] R1195 host backtrace n=%d (anchor thread; symbolize vs xenogears_boot):\n", bn);
                    for (int i = 0; i < bn && i < 24; i++)
                        r861_out("  #%d %p\n", i, bt[i]);
