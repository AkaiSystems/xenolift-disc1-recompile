     * plain stores only; uc layout per the crash kit's R247 extraction). */
    { uintptr_t r1199_pc = 0;
#if defined(__APPLE__) && defined(__arm64__)
      if (uc) r1199_pc = (uintptr_t)((const ucontext_t *)uc)->uc_mcontext->__ss.__pc;
#elif defined(__APPLE__) && defined(__x86_64__)
      if (uc) r1199_pc = (uintptr_t)((const ucontext_t *)uc)->uc_mcontext->__ss.__rip;
#endif
      g_r1199_intr_pc = (uint64_t)r1199_pc;
