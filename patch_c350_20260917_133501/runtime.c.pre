                if (!r1179_forge_blocked("L18395")) { g_guest_depth++, xenolift_dispatch(h2k2), g_guest_depth--; }
            }
            memcpy(r, ksr, sizeof r); hi = kshi; lo = kslo;
            }
        }
        r861_out("[cd] wait-loop tick: pending=%u last_cmd=0x%02X arm1=%u\n",
                cd_pending, cd_last_cmd, cd_arm_int1_pending);
        { uint32_t ksr[32]; uint32_t kshi, kslo; /* R199: full ctx */
        memcpy(ksr, r, sizeof r); kshi = hi; kslo = lo;
        for (int i = 0; i < 8; i++) {
            /* R1183 (c375): when the getintr dispatch is gated, r[2] is a STALE register, not slot bits -
             * c371/c375 read "slot=100" (0x64, bit2 set) and dispatched the ready callback before ReadN
             * was ever issued -> state machine walked 0x0A/GetStat/GetTN/Pause, read abandoned (2660 owed). */
            if (r1179_forge_blocked("L18405") && !g_r1351_genuine_answer) break; /* R1355 (c334) + R1356 (c337) + R1357 (c338): genuine-answer exemption; the c337 pend term REVERTED (pend=3 is near-universal, it over-fired in the boot era); the flag now persists while a pending answer is outstanding, cleared in the slots-drain exit only when no pending remains */
            g_guest_depth++, xenolift_dispatch(0x800415B4u), g_guest_depth--;
            uint32_t slots = r[2];
            if (slots == 0u) {
                if (g_r1351_genuine_answer) { if (cd_pending == 0u && xenolift_mem_read32(0x8004FE1Cu) == 0u) { g_r1351_genuine_answer = 0u; r861_out("[wgen] R1358 genuine-answer collector pass complete (slots drained, idle, no pending outstanding)\n"); } else { static int r1358h_n; if (r1358h_n++ < 12u) r861_out("[wgen] R1358 genuine-answer collector holding (pending=%u FE1C=%08X)\n", (unsigned)cd_pending, xenolift_mem_read32(0x8004FE1Cu)); } } /* R1355 + R1357 + R1358 */
                break;
            }
