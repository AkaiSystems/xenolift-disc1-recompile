            {   /* R729 [wildscan]: c300 - the R728 scan never printed despite the
             * wildcode dump firing in the same fault (placement suspect).
             * Fused rewrite: scan RAM for cells holding the crash-site
             * address (the poisoned table entry that points BELOW the
             * stage-2 base) and for the real base 0x801D3000 (the module's
             * healthy pointer table, for contrast). One fprintf per line,
             * no sub-gates, cap 8 hits each, single r729n shot counter. */
            { static int r729n;
              if (r729n < 2) {
                r729n++;
                { int hits = 0; char line[256]; int ln = 0;
                  ln = snprintf(line, sizeof line, "[wildscan] R729 cells holding crash-site %08X:", pc);
                  for (uint32_t off = 0; off < 0x200000u && hits < 8; off += 4u) {
                    uint32_t w; memcpy(&w, xenolift_mem + off, 4);
                    if (w == pc || w == (pc & 0x00FFFFFFu)) { ln += snprintf(line+ln, sizeof line - (size_t)ln, " @%08X(=%08X)", 0x80000000u + off, w); hits++; }
                  }
                  snprintf(line+ln, sizeof line - (size_t)ln, "%s\n", hits ? "" : " (none - computed, not stored)");
                  r861_out("%s", line);
                }
                { int hits = 0; char line[256]; int ln = 0;
                  ln = snprintf(line, sizeof line, "[wildscan] R729 cells holding stage-2 base 801D3000:");
                  for (uint32_t off = 0; off < 0x200000u && hits < 8; off += 4u) {
