            r861_out("[getstat7] R1267 GetStat ack primed at FE1C poll (stuck-confirmed 64 polls: FE1C=%u sched=%u pend=0 FE04=0 FDF8=0 resp_n<3) - 3-byte ack family, INT1 armed, budget=%d\n",
                     fe1c_d, cd_scheduled, r1266_budget);
            }
        } else {
            r1267_stuck = 0; /* posture left - healthy transit, no answer */
        }
    }
    /* R411 FIELD PUMP RE-ARM (c168): the R408 arm STARTED the field
     * data pump — 6 sectors flowed natively (LBA 108933-108938, FDF8
     * 125304->115064, DMA into the field dest ring) — then the queue
     * stepper stopped mid-read: the [fldpump] timeline froze solid at
     * sector 7 (t=60s..195s, EVERY cell identical) with the drive
     * side perfect (act=1 loaded=1 data=0/2060 pend=0 sched=0) —
     * the stepper consumed the first data-ready bell, advanced its
     * batch, and now waits for the NEXT sector's bell. Hardware
     * truth (psx-spx): the drive raises INT1 PER DELIVERED SECTOR
     * under ReadN, not once per request. The FE1C RAM-poll is the one
     * context proven live in this era (R402 deliveries landed here,
     * budgeted logs). While the mid-read stall signature holds, ring
     * the next bell: identical R96/R408 arming bits (cd_pending=1 +
     * g_cd_irq_force=1), zero guest dispatch (R350) — the guest's own
     * queue does the consuming. BOOT-STRICT band: seek 108900-109150
     * excludes every healthy boot read (239317, 109158+); the c166
     * lesson — an extra bell in a healthy flow desyncs it — is why
     * pend/sched must both be idle AND the band is narrow. FDF8 gate
     * 1..125304 = strictly mid-field-read. */
    if (a == 0x8004FE1Cu && cd_scheduled == 0u && cd_pending == 0u
        && cd_read_active && cd_data_loaded
        && (cd_last_cmd == 0x06u || cd_last_cmd == 0x09u)
        && cd_seek_lba >= 108900u && cd_seek_lba < 109150u
        && xenolift_mem_read32(0x8004FE04u) == cd_seek_lba) {
        uint32_t r411_fdf8 = xenolift_mem_read32(0x8004FDF8u);
        /* R412: strictly MID-read — the initial FDF8==125304 state is the
         * R408 arm's job; c169 showed a double-bell there made the guest
         * restart the whole request once (two re-arm passes 108933-108939). */
        if (r411_fdf8 != 0u && r411_fdf8 < 125304u) {
            cd_pending = 1;
            g_cd_irq_force = 1;
            /* R415: budget 24->96 — c172: the budget exhausted at sector
             * 16 of file 1 and the native path took over at a SLOWER pace
             * (pump ran out of clock with file 2 at 6/15 sectors). The
             * assisted bell path is the faster one; 96 covers file 1 (62
             * sectors) + file 2 (~15) end to end. Flow unchanged — budget
             * only; c171 lesson respected (no gate changes to working
             * flow). */
            {   static int r411_n;
                if (r411_n++ < 96u)
                    r861_out("[fld-rearm] sector bell re-armed at FE1C poll (seek=%u FDF8=%u pend=%u)\n",
                            cd_seek_lba, r411_fdf8, cd_pending);
            }
        }
    }
    {   /* R403 fld-data camera: RAM-cell polls during the data-stage wait */
        static uint32_t ram_seen;
        if ((a == 0x800578A6u || a == 0x8004FE1Cu || a == 0x8004FDF8u)
            && fld_n < 96u && !(ram_seen & (1u << ((a >> 2) & 31u)))
            && fld_data_sig()) {
            ram_seen |= 1u << ((a >> 2) & 31u);
            r861_out("[cd] fld-data RAM-poll 0x%08X val=0x%08X\n",
                    a, *(uint32_t *)(xenolift_mem + (a & 0x7FFFFFu)));
            fld_n++;
        }
    }
    {   /* R406 HOT-READ CENSUS (c163): the field data-stage wait reads
         * NOTHING we watch — one 803-idx1 ack, zero MMIO after, zero
         * probes of FDF8/FE1C/578A6, and the vblank counter only crawls
         * a few frames per run => the wait is a pure RAM spin on an
         * UNNAMED cell. Stop guessing: while the field signature holds,
         * count reads per 256-byte block over the whole low RAM window
         * (0x80010000-0x801FFFFF) and report the hottest blocks every
         * 1M reads (counters reset each report = per-window hot spots).
         * Recursion-safe: fld_data_sig guards itself (R404), so the
         * sig's own FE04/FDF8 reads don't count. */
        static uint32_t fh_n;
        static uint16_t fh[0x1F0];
        if (fld_data_sig()) {
            /* R868 (c457) THE THREE-DAY KILLER: the gate allowed a up to
             * 0x80200000 -> block index up to 0x1FF00, but fh[] holds only
             * 0x1F0 entries - every guest read above 0x8002F000 incremented
             * 16-bit counters PAST the array into adjacent globals (guest-
             * address-driven wild write; smashed cur_fn/register file, caused
             * every canary abort in the c435-c457 saga: the symbolized .ips
             * nailed it - xenolift_mem_read32's own frame, called from
             * xenolift_trace). Gate now EXACTLY matches the array bounds. */
            if (a >= 0x80010000u && a < (0x80010000u + (0x1F0u << 8)))
                fh[(a - 0x80010000u) >> 8]++;
            if (++fh_n >= 1048576u) {
                fh_n = 0;
                uint32_t top_i[4] = {0, 0, 0, 0};
                for (uint32_t i = 0; i < 0x1F0u; i++) {
                    for (int k = 3; k >= 0; k--) {
                        if (fh[i] > fh[top_i[k]]) {
                            if (k < 3) top_i[k + 1] = top_i[k];
                            top_i[k] = i;
                        } else break;
                    }
                }
                r861_out("[fld-hot] 1M reads: %08X=%u %08X=%u %08X=%u %08X=%u\n",
                        0x80010000u + (top_i[0] << 8), fh[top_i[0]],
                        0x80010000u + (top_i[1] << 8), fh[top_i[1]],
                        0x80010000u + (top_i[2] << 8), fh[top_i[2]],
                        0x80010000u + (top_i[3] << 8), fh[top_i[3]]);
                for (uint32_t i = 0; i < 0x1F0u; i++) fh[i] = 0;
            }
        }
    }
    if (lzss_fake_zero_addr && a == lzss_fake_zero_addr) {
        /* R202: HLE-exit one-shot. The core's entry reads LW(src) as the
         * expanded size; after our native decode we feed 0 so its math
         * lands r15 = 0 + r5 == r5 = the final position -> immediate
         * exit at the first group check. No memory cell borrowed (the
         * cycle-35 read-struct cell got a CD header DMA'd into it
         * mid-flight = timing-dependent garbage). Self-clearing. */
        lzss_fake_zero_addr = 0;
        return 0;
    }
    /* R193: lzss-guard reads — the cycle-26 fault moved to a READ walk
     * (0x802408CF, LZSS back-reference history past RAM). Suppress and
     * return zero so the walk logs instead of halting. */
    if (lzss_armed && lzss_in_end && a >= lzss_in_end && a < 0x80200000u) { /* R1169v2: armed at core entry, NEVER retired (lifetime deferred per Jos c356); hits attributable via the [fencelife] arm chain; DIAGNOSTIC-ONLY - log-only, never suppresses a read */
        /* R195: input-overrun — token byte read PAST the stream's declared end.
         * LOG-ONLY (no behavior change): names the runaway's fuel source. */
        if (!g_in_park && (lzss_fence_hits < 8u || (lzss_fence_hits % 16777216u) == 0u)) r861_out("[lzss-fence] R1169 hit @0x%08X above fence 0x%08X (op#%u src=0x%08X word0=0x%08X, %lds since arm; hits=%u under R1277 run-lifetime throttle first-8-then-1-per-16M; fence = src + EXPANDED size - NOT a validated compressed-input boundary; this hit is a SUSPICION, never a proven input overrun; never retired - the fence stays armed for the rest of the run; hits attribute to the LAST armed op via the [fencelife] arm chain; diagnostic-only, this warning never suppresses the read)\n", a, lzss_in_end, (unsigned)lzss_op_seq, (unsigned)lzss_fence_src, (unsigned)lzss_fence_w0, (long)(lzss_fence_t ? (xl_wall() - lzss_fence_t) : 0), lzss_fence_hits); /* R367: park-time host reads must not fire decode hooks; R1277: c169 receipts - the never-retired fence taxes EVERY read above 0x8005064A (the whole game executes above it): 2.12B hits over 135s = 15.7M/sec; 1-per-4096 still printed 3.8k lines/sec (262MB raw, budget eaten, boot receipts buried). 1-per-16M = ~1 print/sec = the storm signature (rate + addresses) preserved, the log restored. */
        lzss_inpast_n++;
        lzss_fence_hits++; /* R1276: run-lifetime counter - never reset */
    }
    if (lzss_armed && a >= 0x80200000u) {
        if (lzss_over_n < 8) {
            r861_out("[lzss-guard-r] suppressed read @0x%08X -> 0\n", a);
        }
        lzss_over_n++;
        g_lzss_overrun_reads++; /* R926: fuel for the translated loop's clean abort */
        /* R1161: adaptive print backoff - first 100 lines every 4096
         * ops (a real overrun still reads clearly), then 1-per-million
         * (c346: 32K lines at 131M ops = 95MB log, park wedged again -
         * same class as the c343 fault-storm flood). Recovery check
         * below runs at the same reduced cadence; threshold margin is
         * one extra million ops worst case. */
        if (((lzss_over_n & 0xFFF) == 0 && lzss_over_n < 409600u) ||
            (lzss_over_n % 1048576u) == 0u) {
            r861_out("[lzss-runaway] %d ops suppressed, read frontier 0x%08X cur_fn=%08X aborts=%u\n", lzss_over_n, a, xenolift_cur_fn, g_lzss_abort_fired);
            /* R1151 (b8-c335): MODULE-WINDOW RUNAWAY -> RECOVERY. c335
             * receipts: the stage-2 module's own LZSS (cur_fn=0x801D2FE8,
             * translated overlay code with NO injected guard) ran away past
             * 35 MILLION suppressed reads - aborts=0 forever, because the
             * R926 "translated-loop abort" fuel only ignites inside the
             * emitted guard of KERNEL fn 0x80032EB4; module-window code
             * never had it injected. The runaway burned 143s of runtime to
             * a fuse SIGKILL (137). The receipts name the context: the
             * module reached its pre-movie loop (park census t=112-142s:
             * 801D3070/801D3190/801D2FE8 + exe-side 8002675C/800269CC),
             * polls for file#7 (seek=108886) that never arrives (A22C=0,
             * ARCH-REQ cells all zero), then decompresses a garbage
             * buffer whose source pointer walks off RAM. Receipt-first
             * conversion: past 1M suppressed reads inside a module
             * window, fire the recovery ONCE via the receipt-proven R854
             * thread-safety pattern (anchor thread + armed -> longjmp to
             * the churn anchor like every crash-kit door; non-anchor or
             * disarmed -> honest _exit(99) named death). No flow change
             * below 1M reads - kernel-LZSS behavior identical. */
            /* R1161 (b8-c346): DE-WINDOWED RUNAWAY RECOVERY. c346
             * receipts: a KERNEL-context runaway (cur_fn=0x800404D4 =
             * EnterCriticalSection, decomp-named) ran 131 MILLION
             * suppressed reads with aborts=0 - the R1151 recovery
             * condition was windowed to module cur_fn ranges written
             * for the c335 module class, so kernel-context runaways
             * suppressed forever, burned the whole run budget, and the
             * flood wedged the park printer (exit 77). Same guard-hole
             * class as R1151's original: a range condition written for
             * one class silently misses the other. Recovery now fires
             * at 1M suppressed reads in ANY context - same receipt-proven
             * R854 anchor pattern, same one-shot accounting. */
            if (lzss_over_n >= 1000000u) {
                g_lzss_abort_fired++;
                r861_out("[lzrwatch] R1151 module-window LZSS runaway confirmed: %d suppressed reads cur_fn=%08X - converting to crash-kit recovery (R926 fuel never ignites in module code: its abort guard is emitted ONLY into kernel fn 0x80032EB4; c335: 35M+ ops, aborts=0, 143s to fuse-kill; the movie data (seek=108886=file#7) never arrives via the archive door)\n", lzss_over_n, xenolift_cur_fn);
                extern jmp_buf xenolift_churn_jmp; extern int xenolift_churn_armed; extern pthread_t xenolift_churn_tid;
                if (pthread_equal(pthread_self(), xenolift_churn_tid) && xenolift_churn_armed) {
                    g_guest_depth = 0;
                    if (g_firstfault_stop) r1177_door_stop("longjmp-site-L3884"); /* R1178: ANY re-entry via the churn anchor is a restart; under first-fault-stop stop with the dossier instead */
                    longjmp(xenolift_churn_jmp, 1);
                }
                _exit(99);
            }
        }
        return 0;
    }
    /* Kernel system-time cell 0x80058960: on real hardware the timer
     * IRQ handler increments it and fn_8004B694 sleeps by polling it
     * ("wait until time >= target"). No timer IRQs exist here, so each
     * read advances the cell by one tick — every bounded sleep then
     * terminates naturally after (target - now) polls. */
    {
        uint32_t __p = xenolift_phys(a);
        if (__p == 0x58960u) {
            uint32_t __v;
            memcpy(&__v, xenolift_mem + __p, 4);
            __v += 1u;
            memcpy(xenolift_mem + __p, &__v, 4);
            static int __told;
            if (!__told) {
                __told = 1;
                r861_out("[time] system-time cell 0x80058960 advancing (simulated timer ticks)\n");
            }
        }
    }
    uint32_t off = xenolift_phys(a);
    uint32_t v, tmp;
    if (off >= XENOLIFT_RAM_SIZE && io_special_read(io_phys(off), &tmp)) {
        io_log(io_phys(off), 0, tmp);
        return tmp;
    }
    memcpy(&v, xenolift_mem + off, 4);
    if (off >= XENOLIFT_RAM_SIZE) {
        io_log(io_phys(off), 0, v);
    }
    /* R1239 (Jos c83 - THE DECISIVE WALK PROBE): the walk body's node loads
     * all route through this fn (LW -> xenolift_mem_read32), so every read
     * of the heap band / freelist head cells is receipted IN ORDER - the
     * actual cursor/next/flags sequence immediately before the null
     * transition, which entry + trap snapshots alone cannot establish
     * (direct C calls never reach the dispatch walkcam). v = the value the
     * load actually returned, not an attempt. */
    if ((off >= 0x77400u && off < 0x78000u) || off == 0x59320u || off == 0x59324u) {
        static int rn;
        if (rn < 160) { rn++;
            r861_out("[walkread] R1239 ea=0x%08X v=0x%08X cur_fn=0x%08X\n", a, v, xenolift_cur_fn);
        } else if (rn == 160) { rn++;
            r861_out("[walkread] R1239 camera CAP (160) reached - further band reads not logged\n"); }
    }
    return v;
}

/* R1123 (b8-c304): libcd loop-state preserve across pristine restores.
 * DECODE (source-proven, refs/xenogears-decomp/src/slus_006.64/psyq/libcd/bios.c):
 * the churn loop is CD_sync(0,0) (bios.c:312) - spins until Intr.sync becomes
 * 2 or 5 (bios.c:326-331) or the alarm matures (set_alarm bios.c:153:
 * Alarm.unk0 = Vsync(-1) + 0x3C0; get_alarm bios.c:159 returns -1 at timeout,
 * letting the game's own retry logic take over). Intr = 0x80056788 (size 3,
 * symbol_addrs.slus_006.64.txt:820), Alarm = 0x8005A228 (size 0xC, :993) -
 * BOTH inside the pristine-restore range (0x80010000..0x8006F000), so every
 * fault-walk restart reset the 960-frame alarm clock and zeroed the
 * interrupt state: the churn was SELF-SEALING (R1014 "wiped by every
 * restore" class; c301 root decode; c304 CD_sync source decode). Preserve
 * both across the three restore doors. Guards: Intr's 3 status bytes must
 * each be < 8 (sync/ready/c are tiny enumerations per bios.c Intr_t);
 * Alarm.unk0 must be 0 or a plausible frame count (< 0x02000000) so
 * host-taint garbage is NOT preserved. Receipt once per run. */
static void xenolift_libcd_save(uint32_t sv[4])
{
    sv[0] = xenolift_mem_read32(0x80056788u); /* Intr.sync/.ready/.c + pad */
    sv[1] = xenolift_mem_read32(0x8005A228u); /* Alarm.unk0 = Vsync(-1)+0x3C0 */
    sv[2] = xenolift_mem_read32(0x8005A22Cu); /* Alarm.unk4 = iteration cap */
    sv[3] = xenolift_mem_read32(0x8005A230u); /* Alarm.unk8 = name ptr */
}

/* R1125 (b8-c306): ARCHIVE CHAIN PRESERVE - same R1123 pattern for the
 * libarchive runtime-set cells the pristine restore wipes (R1100 receipts
 * the 4FDF0 wipe EVERY cycle: "runtime-set healthy then wiped - pristine
 * restore class R1014/R1067"). c306 receipts show the downstream damage:
 * a garbage ftab decode "file#=3 off=0 entry=0x80010012 -> LBA=825
 * size=9063680" - the CD_sync field chain (ArchiveGetMember class at
 * 0x80028774, crash code reads cells FDF0/FE14) decoding from wiped
 * cells mid-flight. Cells per the R1099 door dump: 4FDF0=archive base
 * (healthy 0x80010004), FDF8/FDFC/FE14/FE1C = chain members. Guards:
 * each value must be 0 or a guest-RAM pointer (0x80000000..0x80200000)
 * so host taint is never preserved. Receipt once per run. */
static void xenolift_arch_save(uint32_t av[5])
{
    av[0] = xenolift_mem_read32(0x8004FDF0u); /* archive base */
    av[1] = xenolift_mem_read32(0x8005FDF8u); /* chain member */
    av[2] = xenolift_mem_read32(0x8005FDFCu); /* chain member */
    av[3] = xenolift_mem_read32(0x8005FE14u); /* member offset */
    av[4] = xenolift_mem_read32(0x8005FE1Cu); /* member */
}
static void xenolift_arch_reapply(const uint32_t av[5])
{
    static int r1125_n;
    /* R1146: PER-CELL guards (was all-or-nothing; c329 receipts: stale
     * FE1C=9 vetoed the healthy base reapply -> garbage ftab decode). */
    int n_ok = 0;
    if (av[0] == 0u || (av[0] >= 0x80000000u && av[0] < 0x80200000u)) { xenolift_mem_write32(0x8004FDF0u, av[0]); n_ok++; }
    if (av[1] == 0u || (av[1] >= 0x80000000u && av[1] < 0x80200000u)) { xenolift_mem_write32(0x8005FDF8u, av[1]); n_ok++; }
    if (av[2] == 0u || (av[2] >= 0x80000000u && av[2] < 0x80200000u)) { xenolift_mem_write32(0x8005FDFCu, av[2]); n_ok++; }
    if (av[3] == 0u || (av[3] >= 0x80000000u && av[3] < 0x80200000u)) { xenolift_mem_write32(0x8005FE14u, av[3]); n_ok++; }
    if (av[4] == 0u || (av[4] >= 0x80000000u && av[4] < 0x80200000u)) { xenolift_mem_write32(0x8005FE1Cu, av[4]); n_ok++; }
    {
        if (r1125_n < 4) {
            r1125_n++;
            r861_out("[archkeep] R1125 archive chain preserved across restore: base=%08X FDF8=%08X FDFC=%08X FE14=%08X FE1C=%08X (per-cell; %d/5 applied - stale smalls no longer veto)\n",
                    av[0], av[1], av[2], av[3], av[4], n_ok);
        }
    }
}
static void xenolift_libcd_reapply(const uint32_t sv[4])
{
    static int r1123_n;
    if ((sv[0] & 0x00F8F8F8u) == 0u
        && (sv[1] == 0u || (sv[1] & 0xFE000000u) == 0u)) {
        xenolift_mem_write32(0x80056788u, sv[0]);
        xenolift_mem_write32(0x8005A228u, sv[1]);
        xenolift_mem_write32(0x8005A22Cu, sv[2]);
        xenolift_mem_write32(0x8005A230u, sv[3]);
        if (r1123_n < 6) {
            r1123_n++;
            r861_out("[cdkeep] R1123 libcd loop state preserved across restore: Intr=%08X Alarm.unk0=%08X unk4=%08X (churn clock NOT reset - CD_sync can time out per bios.c:159)\n",
                    sv[0], sv[1], sv[2]);
        }
    }
}


/* R1143 (b8-c326): WALK-CELL PRESERVE across the CRASH-KIT recovery
 * door. c326 receipts name a NEW death class - HANG (exit 77 park
 * backstop at stage 6, not a crash): the run reached FILE #7 loading
 * (deepest archive progress ever; ftab file#=7 LBA 108886), then crash
 * recovery #0F restored the pristine exe, WIPING the in-flight archive
 * request cells - [exitdiag] R649 @t=58s shows the healthy in-flight
 * posture F0C(59F0C)=7 F10(59F10)=00611324 FE04=0001A956 (=108886 =
 * file#7's LBA), but [fldfrz2] R825 @t=70s/85s shows ALL walker cells
 * zero with seek=108886 sectors=146 frozen - the game's main loop (its
 * own state past the re-walk gate) waits for a file#7 delivery that no
 * longer exists in the wiped coordinator cells -> deadlock -> park.
 * Preserve-and-reapply, R1123/R1125/R1128 pattern, per-cell guards =
 * each cell's receipted healthy domain (idx/counter smalls, disc offsets
 * < 0x800000; 92C0's healthy is 0 or -1 per R814 proceed posture). */
__attribute__((no_sanitize("address"))) static void crash_puts(const char *s); /* R1143: forward decl - walkcell_reapply (signal context) receipts before the definition below */
static void crash_puth(uint32_t v);
static void xenolift_walkcell_save(uint32_t wcv[9])
{
    wcv[0] = xenolift_mem_read32(0x8005FAECu); /* walk idx */
    wcv[1] = xenolift_mem_read32(0x800592C0u); /* walk cur (0/-1) */
    wcv[2] = xenolift_mem_read32(0x80018088u); /* walk req */
    wcv[3] = xenolift_mem_read32(0x80059F0Cu); /* archive file idx (F0C) */
    wcv[4] = xenolift_mem_read32(0x80059F10u); /* archive offset (F10) */
    wcv[5] = xenolift_mem_read32(0x8005FE04u); /* archive seek LBA (FE04) */
    /* R1146 (b8-c329): LIBETC VSYNC-QUEUE POINTERS. c329 receipts name the
     * churn's terminal fault: cur_fn=0x8004B55C (Vsync body, symbol map:
     * 0x8004B54C=Vsync, psyq libetc) faulting at addr=0x0 - the emitted
     * body does r16=LW([0x8005783C]) / r2=LW([0x80057840]) / r3=LW
     * (0x80057844 fixed cell) and the CALLER passes a0=-1 intentionally
     * (2404FFFF before jal at 0x80041BA8 - Vsync(-1), the libetc contract).
     * Cells 0x8005783C/7840 are runtime-set by libetc init, live in the
     * pristine range, and are wiped to NULL by every R962 crash-kit
     * restore - the next Vsync derefs NULL. Same class/door as the walk
     * cells. Guard: 0 or guest-RAM pointer each. */
    wcv[6] = xenolift_mem_read32(0x8005783Cu); /* libetc vsync queue ptr */
    wcv[7] = xenolift_mem_read32(0x80057840u); /* libetc vsync counter ptr */
    wcv[8] = xenolift_mem_read32(0x80057844u); /* libetc vsync target cell */
}
static void xenolift_walkcell_reapply(const uint32_t wcv[9])
{
    static int r1143_n;
    /* R1146: PER-CELL guards (was all-or-nothing). c329 receipts: the
     * receipted stale marker FE1C=00000009 (exitdiag c326/c327) made the
     * arch reapply's all-or-nothing flag fail, blocking the healthy base
     * reapply entirely - the garbage ftab decode (file#=3 off=0 entry=
     * 0x80010012 LBA=825 size=9063680, the R1061 class) receipted in
     * c329 with FE14=0. Per-cell: apply each cell whose own guard
     * passes; one stale small never vetoes the healthy rest. */
    if (wcv[0] < 0x10u) xenolift_mem_write32(0x8005FAECu, wcv[0]);
    if (wcv[1] == 0u || wcv[1] == 0xFFFFFFFFu) xenolift_mem_write32(0x800592C0u, wcv[1]);
    if (wcv[2] < 0x10u) xenolift_mem_write32(0x80018088u, wcv[2]);
    if (wcv[3] < 0x40u) xenolift_mem_write32(0x80059F0Cu, wcv[3]);
    if (wcv[4] < 0x800000u) xenolift_mem_write32(0x80059F10u, wcv[4]);
    if (wcv[5] < 0x800000u) xenolift_mem_write32(0x8005FE04u, wcv[5]);
    /* R1149 (b8-c333): lqcam receipts CORRECT my own R1146 guard. The
     * healthy values of the libetc cells are NOT guest-RAM pointers -
     * they are POINTERS TO MMIO REGISTERS: [lqcam] receipts show
     * 0x8005783C = 0x1F801814 (D2/GPU DMA MADR) and 0x80057840 =
     * 0x1F801110, rewritten by the CD-wait loop (0x8002B084, r31
     * 0x80041CA0) and the bank writer (0x80031C58); 0x80057844 is a
     * small counter the writers themselves zero each pass (receipts #4,
     * #8 - legit pattern). The emitted Vsync body (0x8004B55C) loads
     * r16=LW([0x8005783C]) - i.e. reads the live GPU DMA counter
     * THROUGH the pointer - so when R962's pristine restore wipes the
     * cell to 0, the body derefs NULL. My R1146 guard required 0 or
     * 0x80000000-0x80200000, which REJECTED the healthy MMIO values
     * (0x1F801814 is outside) - the reapply silently skipped the very
     * cells it was built to restore (my own R1010 marker-class mistake
     * repeated: assumption without a receipt). Guard now: 0, guest-RAM
     * pointer, OR hardware-map value (scratchpad/IO 0x1F800000-0x1F802000
     * per psx-spx memory map). */
    if (wcv[6] == 0u || (wcv[6] >= 0x80000000u && wcv[6] < 0x80200000u) || (wcv[6] >= 0x1F800000u && wcv[6] < 0x1F802000u)) xenolift_mem_write32(0x8005783Cu, wcv[6]);
    if (wcv[7] == 0u || (wcv[7] >= 0x80000000u && wcv[7] < 0x80200000u) || (wcv[7] >= 0x1F800000u && wcv[7] < 0x1F802000u)) xenolift_mem_write32(0x80057840u, wcv[7]);
    if (wcv[8] == 0u || (wcv[8] >= 0x80000000u && wcv[8] < 0x80200000u) || (wcv[8] >= 0x1F800000u && wcv[8] < 0x1F802000u)) xenolift_mem_write32(0x80057844u, wcv[8]);
    {
        if (r1143_n < 4) {
            r1143_n++;
            /* sigsafe printer only - this reapply runs INSIDE the crash-kit
             * signal handler (c326 receipt: "park printer wedged in signal
             * context" = the r861-out-in-handler class; R856 precedent). */
            crash_puts("[walkkeep] R1143 walk cells preserved across crash-kit recovery: FAEC="); crash_puth(wcv[0]);
            crash_puts(" 92C0="); crash_puth(wcv[1]);
            crash_puts(" req="); crash_puth(wcv[2]);
            crash_puts(" F0C="); crash_puth(wcv[3]);
            crash_puts(" F10="); crash_puth(wcv[4]);
            crash_puts(" FE04="); crash_puth(wcv[5]);
            crash_puts(" FQ=");
            crash_puth(wcv[6]);
            crash_puts(" FC=");
            crash_puth(wcv[7]);
            crash_puts(" FT=");
            crash_puth(wcv[8]);
            crash_puts(" (c326 hang: archive request wiped; c329: Vsync(0x8004B55C) NULL-deref via libetc queue cells 5783C/57840 wiped)\n");
        }
    }
}

/* R1128 (b8-c309): CD-WAIT CELL PRESERVE. c309 receipts: the churn
 * family is the CD_cw/Vsync wait loop (56 crits, ~27 kit restarts) and
 * the crash code dump at 0x80041BB0 names its own operands: a
 * "wait N Vsyncs" loop polling frames @0x8006A228 against 0x3C (60) with
 * scratch @0x8006A22C - BOTH inside the pristine-restore range, wiped on
 * every restart, so the 1-second CD timeout can never mature. The same
 * function's earlier decode (c306 @0x80041C78) adds libcd cells
 * 0x80056770/0x800564AC/0x800564A8. Cells named by the crash dump's own
 * load/store instructions - not guessed. Guards: counters/status only -
 * each value must be 0 or < 0x02000000 (plausible frame/iteration count;
 * host taint and pointers are never preserved). */
static void xenolift_cdwait_save(uint32_t wv[5])
{
    wv[0] = xenolift_mem_read32(0x8006A228u); /* CD_cw wait frames (vs 0x3C=60) */
    wv[1] = xenolift_mem_read32(0x8006A22Cu); /* CD_cw wait scratch */
    wv[2] = xenolift_mem_read32(0x80056770u); /* libcd status (c306 decode) */
    wv[3] = xenolift_mem_read32(0x800564ACu); /* libcd cell */
    wv[4] = xenolift_mem_read32(0x800564A8u); /* libcd cell */
}
static void xenolift_cdwait_reapply(const uint32_t wv[5])
{
    static int r1128_n;
    int i, ok = 1;
    for (i = 0; i < 5; i++) {
        if (wv[i] != 0u && wv[i] >= 0x02000000u) ok = 0;
    }
    if (ok) {
        xenolift_mem_write32(0x8006A228u, wv[0]);
        xenolift_mem_write32(0x8006A22Cu, wv[1]);
        xenolift_mem_write32(0x80056770u, wv[2]);
        xenolift_mem_write32(0x800564ACu, wv[3]);
        xenolift_mem_write32(0x800564A8u, wv[4]);
        if (r1128_n < 4) {
            r1128_n++;
            r861_out("[cdkeep2] R1128 CD-wait cells preserved across restore: A228=%08X A22C=%08X 56770=%08X 564AC=%08X 564A8=%08X (CD_cw 60-frame timeout no longer reset by the restore)\n",
                    wv[0], wv[1], wv[2], wv[3], wv[4]);
        }
    }
}

/* ---- BIOS event system (B0 gates 07h/08h/0Ch/0Dh) ----
 * The game registers event callbacks via OpenEvent/EnableEvent; the
 * kernel delivers them when hardware events fire (VBlank F0000001,
 * GPU F0000002, CD F0000009, SIO/periodic F200000x, ...). Previously
 * these gates were capture-only stubs returning handle 0 — the game's
 * boot registrations were silently dropped. Real table now; handles
 * are 1..MAX_EVENTS (never 0). */
#define MAX_EVENTS 64
static struct {
    uint32_t cls, spec, mode, handler;
    uint8_t in_use, enabled, fired;
} evt_tab[MAX_EVENTS];

static uint32_t evt_open(uint32_t cls, uint32_t spec, uint32_t mode, uint32_t handler)
{
    for (int i = 0; i < MAX_EVENTS; i++) {
        if (!evt_tab[i].in_use) {
            evt_tab[i].cls = cls; evt_tab[i].spec = spec;
            evt_tab[i].mode = mode; evt_tab[i].handler = handler;
            evt_tab[i].enabled = 0; evt_tab[i].in_use = 1; evt_tab[i].fired = 0;
            return (uint32_t)i + 1;
        }
    }
    return 0;
}

/* deliver to every ENABLED event of this class (any spec) */
static void evt_deliver_class(uint32_t cls, uint32_t spec)
{
    for (int i = 0; i < MAX_EVENTS; i++) {
        if (evt_tab[i].in_use && evt_tab[i].enabled && evt_tab[i].cls == cls) {
            evt_tab[i].fired = 1; /* events with null handlers wake waiters only */
            if (evt_tab[i].handler >= 0x80010000u && evt_tab[i].handler < 0x80060000u) {
                { static uint32_t dlvr_n; /* R1271: 8 sound delivers/round flood the tail - first 60 + every 200th. */
                  if (++dlvr_n <= 60u || (dlvr_n % 200u) == 0u)
                    r861_out("[evt] DELIVER class=0x%08X spec=0x%08X -> handler 0x%08X\n",
                        cls, spec, evt_tab[i].handler); }
                /* R196: full register-file + hi/lo save/restore — the
                 * cycle-27/28 runaway root cause. The sound driver's
                 * event handler (0x8003C020) ran mid-decompression and
                 * trampled the LZSS core's live t7 (r15 = the exit
                 * target dst+expanded), t8/t9/t6 — the decompressor's
                 * end-of-output compare could never fire again, so it
                 * produced forever (watchdog, linear byte march past
                 * the RAM ceiling). On real HW this handler runs as a
                 * full interrupt with complete context save. */
                uint32_t sr[32]; uint32_t shi, slo;
                memcpy(sr, r, sizeof r); shi = hi; slo = lo;
                r[4] = cls; r[5] = spec;
                g_guest_depth++, xenolift_dispatch(evt_tab[i].handler), g_guest_depth--;
                memcpy(r, sr, sizeof r); hi = shi; lo = slo;
            }
        }
    }
}

/* Synthetic recurring-hardware heartbeat. The game polls its task
 * queue busy flag at 0x8006957C (bit 4, fn 0x8003BDFC) in a tight
 * loop; on real hardware the queue is processed from periodic event
 * callbacks (VBlank / SIO classes) at ~60 Hz. After many polls we
 * deliver one synthetic round to all enabled F0000001/F2000002
 * handlers — the spin reloads every register each iteration, so
 * resuming mid-loop after the handler dispatch is safe. The handlers
 * themselves carry re-entrancy guards (busy bit 0x40). */
static uint32_t g_vb_polls;
/* Queue snapshot: the task queue is a circular buffer of 20-byte
 * nodes in a table pointed to by cell 0x80059458; head index (u16)
 * at 0x80059510, tail (u16) at 0x800594F4, state flags (u16) at
 * 0x8005957C (bit 4 = busy), frame counter (u32) at 0x80059504.
 * Photograph once per heartbeat round: shows whether the queue
 * advances and names the head node's callback = the stuck task. */
static void vb_topup_60hz(void); /* R316: fwd decl (defined below the kick helpers) */
static void heartbeat_diag(void)
{
    /* R205: VBLANK COUNTER. The kernel's WaitForVerticalRetrace
     * (fn_8004B54C, called from LegacyCdDataWait fn_8004299C) does NOT
     * poll GPUSTAT — it waits for the kernel's vblank counter cell
     * 0x80057848 to ADVANCE. On real HW the BIOS vblank IRQ (RC3/IRQ0,
     * the ChangeClearRCnt(rc=3) channel — the R145 audit's #1 risk,
     * now confirmed) increments it once per frame. Our HLE never did,
     * so VSync(-1)/VSync(N) spins forever (cycle-38 Mac park). Each
     * heartbeat round = one emulated frame: increment the cell. */
    {
        static int vb_logged;
        uint32_t vb = xenolift_mem_read32(0x80057848u);
        xenolift_mem_write32(0x80057848u, vb + 1u);
        if (vb_logged < 3 || ((vb & 0x3FFu) == 0x3FFu)) {
            r861_out("[vsync] vblank counter 0x80057848: %u -> %u (frame emulated)\n", vb, vb + 1u);
            vb_logged++;
        }
    }
    vb_topup_60hz(); /* R316 */
    {   /* R855 (c443, AREA-1 / WAVE): SPU TRANSFER COMPLETION HLE.
         * Static decode (Lessons 104-105 + c443 park): the guest sound
         * driver sets busy bit 0x10 at 0x8006957C, then WaitOrQuerySound-
         * Transfer spins until the bit clears. The ONLY clearer on real HW
         * is the SPU-DMA-IRQ-driven CompleteSoundTransferCommand chain
         * (fn_8003BB64 - ZERO static callers = IRQ-vector only), which our
         * HLE never fires - so the coordinator parks forever (R845 re-force
         * re-parked 3x in c443). HLE fix: after 2 heartbeat rounds (~2
         * emulated frames - real SPU DMA of a few KB completes in us),
         * clear busy + set the processed bit 0x4 that the completion path
         * sets. Pure guest-RAM write from heartbeat context = R350-safe. */
        static int r855_rounds, r855n;
        uint16_t r855st;
        memcpy(&r855st, xenolift_mem + 0x5957Cu, 2);
        if (r855st & 0x10u) {
            if (r855_rounds++ >= 2) {
                uint16_t r855new = (uint16_t)((r855st & ~0x10u) | 0x4u);
                memcpy(xenolift_mem + 0x5957Cu, &r855new, 2);
                if (r855n < 8) { r855n++;
                    r861_out("[spudone] R855 SPU transfer completed: 0x8006957C %04X -> %04X (busy cleared, processed set) t=%lds\n",
                            r855st, r855new, (long)(xl_wall() - g_boot_wall_t0)); }
                r855_rounds = 0;
            }
        } else {
            r855_rounds = 0;
        }
    }
    static long rn = 0;
    long n = ++rn;
    if (n <= 2 || n % 4096 == 0) { /* R854: crash-site print cap - c442 abort chain = heartbeat_diag fprintf canary; guest kicks run this millions of times; every print is a lottery ticket. [qn] node dump removed below. */
        uint16_t st, h, t; uint32_t fr, tbl, cb = 0, n4 = 0;
        memcpy(&st, xenolift_mem + 0x5957Cu, 2);
        memcpy(&h,  xenolift_mem + 0x59510u, 2);
        memcpy(&t,  xenolift_mem + 0x594F4u, 2);
        memcpy(&fr, xenolift_mem + 0x59504u, 4);
        memcpy(&tbl, xenolift_mem + 0x59458u, 4);
        if (h < 64u && tbl >= 0x80000000u && tbl < 0x80200000u) {
            uint32_t p = (tbl - 0x80000000u) + (uint32_t)h * 20u;
            if (p + 8u < XENOLIFT_RAM_SIZE) {
                memcpy(&cb, xenolift_mem + p, 4);
                memcpy(&n4, xenolift_mem + p + 4u, 4);
            }
        }
        r861_out("[q] #%ld fr=%u st=%04X h=%u t=%u node_cb=0x%08X node4=0x%08X\n",
                n, fr, st, h, t, cb, n4);
    } /* R854: [qn] node dump removed - crash-site print elimination */
    /* CD-driver state timeline: log only when the tuple changes, so the
     * digest shows exactly when the CDFS exchange stalled and in what
     * state (sync cell FE1C, remaining FDF8, expected LBA FE04, plus
     * the runtime's pending-response bookkeeping). */
    {
        uint32_t fe1c, fdf8, fe04;
        memcpy(&fe1c, xenolift_mem + 0x4FE1Cu, 4);
        memcpy(&fdf8, xenolift_mem + 0x4FDF8u, 4);
        memcpy(&fe04, xenolift_mem + 0x4FE04u, 4);
        static uint32_t s_fe1c, s_fdf8, s_fe04;
        static int s_init;
        if (!s_init || fe1c != s_fe1c || fdf8 != s_fdf8 || fe04 != s_fe04) {
            s_init = 1; s_fe1c = fe1c; s_fdf8 = fdf8; s_fe04 = fe04;
            r861_out("[cdst] #%ld FE1C=%u FDF8=%u FE04=%u pend=%u cmd=0x%02X arm1=%u\n",
                    n, fe1c, fdf8, fe04, cd_pending, cd_last_cmd, cd_arm_int1_pending);
        }
    }
}

static int hb_active; /* kernel code dispatched from the heartbeat/kick may
     * itself poll the spin cell -> recursive read16 hook -> guard */

/* R78: the IRQ-context driver body. Called by the VBlank heartbeat
 * (paced by spin-cell reads) and by xenolift_park_tick (paced by
 * self-jump park iterations). Caller manages the hb_active guard. */
/* R85: THE 0x90C BOOT GATE = CONTROLLER CONNECTED.
 * fn_80040828 (from fn_80036288, boot main) calls the B0(0x12) stub with
 * (buf1, 34, buf2, 34) — the BIOS pad-buffer pair at 0x800625FC (34B
 * each, the "+34-stride device table" from earlier decodes). fn_8003569C
 * reads entry: byte0 must be 0 (ok), byte1 high nibble in {0x40 digital,
 * 0x50 analog, 0x70 mouse}, returns ~(bytes2..3) — 0x41/0x5A (digital
 * id+sync) gives nonzero "present". The walker was gated forever
 * (=WALK= gate=00 state 0000 -> 0000). Our B0(0x12) HLE is a no-op so
 * nothing ever clears the buffers; fill once at init + refresh per kick. */
static int g_movie_live;       /* R295: tentative decl — real def at R254 site (file-scope merge) */
static uint32_t g_park_fills;  /* R295 */
static uint32_t g_mv_poll_n; /* R312: movie-loop poll iteration counter (watchdog liveness) */
/* R320: C-recursion guard. Cycle-67/68 proof: the now-ALIVE CD state machine
 * (state 11 dispatching per R319) churns via DISPATCH tail-calls that NEVER
 * RETURN — each state hop nests another host C frame. The machine cycles at
 * ~100K hops/sec; after ~15s the 2048MB thread stack (R261) is exhausted and
 * macOS SIGKILLs the process (cycle-68 "Killed: 9", zero [wd] evidence).
 * Measure actual stack depth at the state-11 probe (address of a local vs the
 * base captured at kernel entry 0x80019524); near the limit, force the
 * graceful budget halt (park + exit) instead of the OOM kill. */
uintptr_t g_stack_base; int g_force_halt;
/* R323 CHURN TRAMPOLINE (cycle-71: R322 dispatcher-level trampoline bypassed —
 * the state machine also hops via DIRECT emitted calls (e.g. xenolift_fn_8002AC08),
 * which never touch xenolift_dispatch; the watchdog caught the machine inside the
 * h4 retry tail at 1.25GB depth with zero dispatcher bounces). NEW CHOKEPOINT:
 * xenolift_trace() sees EVERY guest function entry via XTRACE, direct or dispatched.
 * The permanent anchor lives at the guest thread base (xenolift_real_main entry —
 * setjmp there never dies); any family fn (0x8002A600-B400) entered >8MB deep
 * longjmps back to the anchor and re-dispatches at fresh stack. The abandoned
 * frames are the eternal churn chain — its enclosing poller context is already
 * permanently stuck (the churn never returns), so nothing live is lost. */

/* R829 (c414): abort() INTERCEPTOR - the deep-trajectory abort class (c409/c414:
 * exit 134, no abortmsg, no segvdie, NO abrtrec = the R824 signal-level recovery
 * never fired: SIGABRT got re-armed to default between our install and the abort,
 * most likely by the guest's own exception setup). Signals can be re-armed; the
 * LINKER cannot be cheated: translated guest code links against THIS runtime, so
 * defining abort() here catches every abort() the translated game code can make.
 * Hardware-faithful: the console's answer to a fatal kernel fault is a shell
 * restart, not console death -> churn-anchor re-dispatch, capped with the same
 * R765 restart budget (12). */
/* R840 (c422/423/425): CANARY CATCHER - the .ips named the killer at last:
 * "asi": ["stack buffer overflow"], frame chain __abort <- __stack_chk_fail.
 * A host-side stack canary tripped in a function that called time() and the
 * process died 134 with ZERO in-house receipts (libsystem-internal abort
 * bypasses our abort() interposition - two-level namespace). The smash is
 * most likely inside EMITTED guest code (disc1.c compiles with Apple
 * clang's default -fstack-protector-strong; a guest fn with an array and a
 * wild index trips its canary). Defining the symbol here makes the linker
 * bind OUR definition: every canary trip now prints a receipt naming the
 * live guest fn and converts to the hardware-faithful console restart
 * (same posture as R804/R807/R824) instead of silent process death. */
extern int xenolift_churn_armed;   /* file-scope decl later in this TU */
extern jmp_buf xenolift_churn_jmp; /* same TU, defined at the anchor */
extern pthread_t xenolift_churn_tid; /* R854: anchor thread id (thread-aware conversion) */
/* R984: forward decls - the sigsafe receipt helpers are defined near the
 * sigdiag block (line ~17022) but the canaryrec path below uses them first. */
static void xenolift_sigput(char* p, int* n, const char* s2);
static void xenolift_sighex(char* p, int* n, uint32_t v);
static void xenolift_sigdec(char* p, int* n, int v);
void __stack_chk_fail(void);
__attribute__((no_sanitize("address"))) void __stack_chk_fail(void)
{
    static int r840_n;
    /* R842: name the SMASHED HOST fn - the return address at canary-trip time
     * points INTO the function whose epilogue failed (the one with the overrun
     * buffer). backtrace_symbols_fd gives us its name from the Mac's own symbol
     * table - cur_fn only names the GUEST context, not the smashed host fn. */
    /* R984 (b8-c95, WARDEN - HANDLER vprintf SWEEP, the R856 class's last
     * doors): five cycles of identical deaths (fprintf->printf->fputc->HLE
     * fprintf->kit snprintf, now vsnprintf in r861_out) prove the printf
     * frames are the DETECTOR, not the smasher - and =CANARYREC=/=ABRTREC=
     * =SEGVDIE= stay empty because these very receipts print via r861_out
     * (vsnprintf) INSIDE handler context and die mid-print. Convert every
     * handler-context print to the R856 async-safe helpers (sigput/sighex/
     * sigdec + one raw write(2)) so the death receipts finally SURVIVE and
     * name the smasher. */
    { char _b[256]; int _n = 0;
      xenolift_sigput(_b, &_n, "[canaryrec] R840 HOST STACK CANARY TRIPPED (canary-handler ctx; cur_fn=");
      xenolift_sighex(_b, &_n, (uint32_t)xenolift_cur_fn);
      xenolift_sigput(_b, &_n, ") - converting to console restart #");
      xenolift_sigdec(_b, &_n, r840_n);
      xenolift_sigput(_b, &_n, "\n");
      xenolift_sigput(_b, &_n, "[canaryrec] R842 smashed-host-fn return address: 0x");
      { uintptr_t _ra = (uintptr_t)__builtin_return_address(0);
        static const char _hx[] = "0123456789ABCDEF";
        for (int _i = (int)(sizeof(uintptr_t) * 2) - 1; _i >= 0; _i--)
            _b[_n++] = _hx[(_ra >> (_i * 4)) & 0xFu]; }
      xenolift_sigput(_b, &_n, "\n");
      (void)!write(2, _b, (size_t)_n); }
    {   /* R909 (b8-c10, manager - CANARY THREAD/DEPTH CONTEXT, WARDEN lane):
         * c5+c10 canaries fired at cur_fn=80031FF8 with the smash on
         * THREAD 1 (macreport: faultingThread=1 __vfprintf) while the
         * guest walk oscillated 4B54C<->4B55C. r861_out uses vsnprintf
         * (bounds-safe) so the smasher is an UNKNOWN host fn; name the
         * THREAD (watcher vs main) and C-recursion depth at trip time so
         * the next digest pins the site. Async-safe: raw write, no libc
         * print machinery between the smash and this receipt. */
        /* R983.1 (b8-c93, WARDEN - CANARY RECORDER vprintf-FREE): the
         * =CANARYREC= digest section has been EMPTY every cycle - the
         * recorder's own snprintf runs inside the __stack_chk_fail context
         * (the most signal-unsafe place in the process) and dies before
         * the write, so the smashed host fn was never named. Same R983
         * fix as the kit ctx line: manual decimal formatting + ONE raw
         * write(2), no libc print machinery anywhere in the canary path. */
        char _t[96]; unsigned _p = 0;
        unsigned long _tid = (unsigned long)((uintptr_t)pthread_self() & 0xFFFFFFu);
        unsigned _dep = (unsigned)g_guest_depth;
        int _main = pthread_equal(pthread_self(), g_main_tid) ? 1 : 0;
        static const char _h1[] = "[canaryrec] R909 ctx tid=";
        for (unsigned q = 0; _h1[q]; q++) _t[_p++] = _h1[q];
        { char _d[12]; int _n = 0;
          if (!_tid) _d[_n++] = '0';
          while (_tid && _n < 10) { _d[_n++] = (char)('0' + (_tid % 10)); _tid /= 10; }
          while (_n > 0) _t[_p++] = _d[--_n]; }
        static const char _h2[] = " depth=";
        for (unsigned q = 0; _h2[q]; q++) _t[_p++] = _h2[q];
        { char _d[12]; int _n = 0;
          if (!_dep) _d[_n++] = '0';
          while (_dep && _n < 10) { _d[_n++] = (char)('0' + (_dep % 10)); _dep /= 10; }
          while (_n > 0) _t[_p++] = _d[--_n]; }
        static const char _h3[] = " main=";
        for (unsigned q = 0; _h3[q]; q++) _t[_p++] = _h3[q];
        _t[_p++] = (char)('0' + (_main ? 1 : 0));
        _t[_p++] = '\n';
        (void)!write(2, _t, _p);
    }
    fflush(stderr);
    {   /* R853 (c441): backtrace() dies post-smash (0 frames in c441) but
         * dladdr needs NO unwind - it maps the raw return address to the
         * nearest symbol in the live image. Our emitted fns have full
         * descriptive names (1228-symbol map), so this prints the NAME of
         * the exact function whose stack buffer overran = the killer's home.
         * Runs on the Mac at catch time, against the running binary. */
        Dl_info r853di;
