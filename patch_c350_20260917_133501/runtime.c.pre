    /* R767 MODULE GARBAGE-JUMP CLEAN-RETURN SERVICE (the final routing gap).
     * c346 proof: the field module is now FULLY translated (fresh emit, 77s
     * recompile), yet [fhelpsum] shows services=0 misses=0 - because the 0x5
     * garbage jump faults at cur_fn=0x801D2D6C (stage-2 module window, just
     * below the 0x801D3000 base) and routes through xenolift_unknown, NOT
     * xenolift_io_fault - the R764 guard (window-0 only, io_fault only)
     * never sees it. Both module windows get the service here: a garbage
     * jump (or unknown instruction) whose fault site sits in a translated
     * module window returns CLEANLY - xenolift_unknown returning unwinds
     * the translated caller's DISPATCH() tail-jump exactly like a function
     * return, and the walk continues past the broken step (same pattern
     * as spexec/R764; c342's verdict: the module constructor never ran,
     * so its helper computes garbage from zero state). Cap 24, loud, with
     * miss-context so any guard failure is diagnosable. */
    {
        int cf_w0 = xenolift_cur_fn >= 0x8006F000u && xenolift_cur_fn < 0x80090000u;   /* window-0 field module */
        int cf_s2 = xenolift_cur_fn >= 0x801D3000u && xenolift_cur_fn < 0x801F4000u;   /* stage-2 f15 module */
        int cf_crashsite = xenolift_cur_fn >= 0x801D2000u && xenolift_cur_fn < 0x801D3000u; /* instance band below stage-2 base */
        if (cf_w0 || cf_s2 || cf_crashsite) {
            /* R768: c347 proof - the serviced walk's NEXT step computed a jump
             * to 0 (garbage sequence: 5, then 0, ...). The module walks on its
             * never-initialized instance region (constructor never ran), so
             * EACH step computes garbage. Service the whole SEQUENCE - each
             * receipt's target+cur_fn fingerprints one more cell the missing
             * initializer should have set (TRAILBLAZER's decode list). The
             * word==0 case is safe ONLY because the guard requires cur_fn in
             * a translated module window - no legitimate guest code jumps to
             * 0 from inside the module. */
            g_r765_services++;
            if (g_r765_services <= 24) {
                r861_out("[fhelp] R768 module garbage jump SERVICED as clean return #%d: target=0x%08X cur_fn=0x%08X r31=0x%08X (walk continues; target+site fingerprint the missing-init cell)\n",
                        g_r765_services, word, (unsigned)xenolift_cur_fn, r[31]);
                /* R773 [fhsite]: c352 proof - the module's own INIT code ran
                 * natively (0x800739A0: writes its config cells 0x80077120-2C8,
                 * calls helper 0x800439E0) and computed jump 0x8009A2F8 past
                 * module bounds - but SERVICED faults gave no decode material
                 * (the crashkit's wildcode dump only fires on unserviced ones).
                 * Snapshot the fault site with every service: regs + 16 words
                 * at cur_fn + 8 words at the r31 caller = TRAILBLAZER's
                 * decode material per fingerprint. */
                r861_out("[fhsite] R773 svc #%d regs r2=%08X r4=%08X r5=%08X r6=%08X r16=%08X r17=%08X r28=%08X\n",
                        g_r765_services, r[2], r[4], r[5], r[6], r[16], r[17], r[28]);
                r861_out("[fhsite] R773 svc #%d code@%08X:", g_r765_services, (unsigned)xenolift_cur_fn);
                for (int i = 0; i < 16; i++)
                    r861_out(" %08X", ((uint32_t)xenolift_cur_fn + 4u*(uint32_t)i < 0x80000000u + XENOLIFT_RAM_SIZE) ? xenolift_mem_read32((uint32_t)xenolift_cur_fn + 4u*(uint32_t)i) : 0u);
                r861_out("\n");
                r861_out("[fhsite] R773 svc #%d caller@%08X:", g_r765_services, r[31]);
                for (int i = 0; i < 8; i++)
                    r861_out(" %08X", (r[31] + 4u*(uint32_t)i < 0x80000000u + XENOLIFT_RAM_SIZE) ? xenolift_mem_read32(r[31] + 4u*(uint32_t)i) : 0u);
                r861_out("\n");
