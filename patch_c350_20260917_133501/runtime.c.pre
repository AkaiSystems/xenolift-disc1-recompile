    "ExceptionHandler", "InstallExceptionHandlers", "SysInitMemory",
    "SysInitKernelVariables", "ChangeClearRCnt", "SystemError",
    "InitDefInt", "SetIrqAutoAck", "return0",
    "return0", "return0", "return0",
    "tty_cdevinput", "tty_cdevscan", "tty_circgetc",
    "tty_circputc", "ioabort", "set_card_find_mode",
    "KernelRedirect", "AdjustA0Table", "get_card_find_mode",
    };
    static const char *SYS_names[] = {
    "NoFunction", "EnterCriticalSection", "ExitCriticalSection",
    "ChangeThreadSubFunction", "DeliverEvent",
    };

/* ---- synthetic BIOS module ----
 * Xenogears (like Metal Gear Solid and Legacy of Kain) calls
 * B0(0x57) GetB0Table, then reads entry 0x5B of the returned table
 * (the ChangeClearPad handler pointer, at offset 0x16C) and uses fixed
 * offsets from it (+0x884, +0x894) as entry points into the REAL
 * BIOS's internal pad driver. We have no real BIOS ROM, so we hand it
 * a synthetic table in scratch RAM whose entry 0x5B points at our own
 * module; the kernel computes hook addresses X+0x884/X+0x894 and later
 * jumps to them. xenolift_unknown recognizes those and services them. */
#define XENOLIFT_BIOS_T 0x80102000u /* synthetic A0/B0/C0 "table" base */
#define XENOLIFT_BIOS_X 0x80100000u /* synthetic BIOS module base      */
#define XENOLIFT_HOOK_A (XENOLIFT_BIOS_X + 0x884u)
#define XENOLIFT_HOOK_B (XENOLIFT_BIOS_X + 0x894u)

static void bios_module_setup(void)
{
    /* "B0 table" entry 0x5B (= offset 0x16C) points at our module */
    xenolift_mem_write32(XENOLIFT_BIOS_T + 0x16Cu, XENOLIFT_BIOS_X);
    /* R82 FIX — THE 0x8F5A0014 FAULT, SOLVED: fn_8004B4AC (kernel init)
     * does v0=*(C0_table+24), then copies 15 words of the kernel's
     * EXCEPTION HANDLER template (file 0x8004B514-0x8004B54C: lw k0,8(sp);
     * sw ra,4(k0); mtc0 v0,Cause; ...) to [v0..v0+60]. On real HW the C0
     * table's +24 = the exception vector base 0x80000080. Ours was 0, so
     * the handler got installed over the kernel low-variable table at
     * 0x80000000 — and cell 0x8000000C = `lw k0, 8(sp)` (0x8F5A0008) was
     * later read as a pointer -> io-fault at 0x8F5A0014. Point it home. */
    xenolift_mem_write32(XENOLIFT_BIOS_T + 0x18u, 0x80000080u);
    r861_out("[bios] synthetic module at 0x%08X, hooks 0x%08X / 0x%08X\n",
            XENOLIFT_BIOS_X, XENOLIFT_HOOK_A, XENOLIFT_HOOK_B);
}

/* returns 1 if the target is inside the synthetic BIOS module
 * (and was serviced). The kernel installs hooks at module offsets
 * (+0x884, +0x894, +0x7A0, ... more will come — card driver, SIO, etc.)
 * by storing them from GetB0Table-derived pointers, then calls them.
 * Any jump into the module range is a hook call: service it generically. */
static uint32_t g_hook_calls;
/* R933 (b8-c39, seam guard - CD CALLBACK SLOTS): the libcd event pump
 * (80041C68 family, 10 dispatch sites in disc1.c) calls guest function
 * pointers loaded from the ready-callback slot 0x800564AC and the
 * data-callback slot 0x800564A8. c39: the slot held garbage (wild call
 * target 0x0C789675 -> SIGSEGV -> 11 kit recoveries -> host abort 134).
 * CONTRACT (PsyQ libcd / psx-spx): before the kernel registers its real
 * handlers via CdReadyCallback/CdDataCallback, the slots are NULL and the
 * pump SKIPS the call. A garbage value = state the real hardware never
 * has. Heal: garbage (non-null, outside guest code RAM) -> 0 (the
 * pre-registration posture), capped receipt, real registrations pass
 * through untouched. */
/* R934 (b8-c40, seam guard - FREELIST HEAD NULL HEAL): the allocator's
 * band-walk door (L_80031C4C in disc1.c) loads the freelist head from
 * heap+0x1B0; c40 exitdiag: the cell was NULL -> r10 = -8 -> the 80031C58
 * walk dereferenced 0xFFFFFFF8 -> SIGSEGV at t=46s. CONTRACT (decomp
 * memory.c HeapInit, same source R928 cites): an unpopulated band head
 * points at the END sentinel node 0x801FBFF8 (pNext=0x801FC000,
 * flags=0x00200000) and the walk terminates on it computing free-size 0
 * = clean out-of-band result. Heal: NULL -> sentinel pointer, capped
 * receipt. Legitimately-populated heads pass through untouched. */
/* R936 (b8-c42, camera - DRAWPRIM CONTEXT): c42's new wall IS THE PIXELS
 * DOOR: the kernel's boot code calls DrawPrim (0x80044B70,
 * SubmitGpuPrimitive___PsyQ_libgpu) with a real primitive (stack buffer,
 * tag 0x04000000 = POLY_F3 triangle) and crashes dispatching through the
 * GPU env method slot: env_ptr = [0x800568C8], target = [env_ptr+0x3C]
 * (stale - our heals seeded the env pointer, but the real ResetGraph init
 * that fills the method slots never ran). Camera prints the env slot
 * values + the primitive head so the contract value comes from source
 * (decomp libgpu / psx-spx) next cycle. Cap 4/run. */
uint32_t g_splash_env; /* R948: splash drawEnv (SetDefDrawEnv, GameShowSplashScreen) */
uint32_t g_splash_live; /* R950: splash era reached - suppress AREA-1 walk-era door forces */

void xenolift_drawprim_cam(uint32_t prim)
{
    /* R942 [primsub] (PIXEL lane, b8-c48): env+3C (0x80046DB4) is the
     * WORKING GP0 word submitter (proven: boot fill word 02000000 -> census
     * fill executed, caller 0x80044628) - but DrawPrim (0x80044B70) NEVER
     * submits through it: the fade SPRT prim (code 0x64, words captured by
     * drawcam) reaches DrawPrim yet no sprite-class command EVER executes
     * (census poly=0/rect=0 in the healthy era, several cycles). The native
     * submit inside translated DrawPrim is a dead link. Bypass per the
     * results-first directive: submit the prim's own words straight into
     * the proven-healthy interpreter at the drawcam door. Idempotence: if
     * the native path ever recovers, the same words paint twice = harmless.
     * Tag top byte = word count (PsyQ P_TAG contract, 0x04000000 = 4). */
    /* R948 [tpagefix] (PIXEL lane, b8-c54): the splash's PutDrawEnv
     * (main_loop.c:190) is another translated dead link - the 0xE1 tpage
     * word it should install never fires, so g_texpage stays 0 and the
     * fade SPRT samples the empty page (cycle-54 first-pixels verdict:
     * texture+CLUT physically in VRAM via splashup, but region A=0).
     * Hardware-true re-delivery: at the splash DrawPrim (caller r31=
     * 80019E78 inside GameShowSplashScreen), install the drawEnv's own
     * tpage field (+0x14, psyq/libgpu.h DRAWENV) via the proven 0xE1
     * contract - the same word the real PutDrawEnv would have sent.
     * psx-spx TP register: bits0-3 x>>6 (640>>6=10), bit4 y>>8, 5-6 ABR,
     * 7-8 color mode. Expected ~0x0A. */
    if (r[31] == 0x80019E78u && g_splash_env >= 0x80010000u &&
        g_splash_env < 0x80200000u) {
        static uint32_t tpage_n;
        uint32_t tp = xenolift_mem_read32(g_splash_env + 0x14u) & 0xFFFFu;
        if (tpage_n < 32u) {
            tpage_n++;
            if (tp != 0u && tp <= 0x1FFu)
                gpu_gp0_write(0xE1000000u | tp);
            if (tpage_n <= 6u)
                r861_out("[tpagefix] R948 splash DrawPrim #%u: tpage@env+14=%04X %s\n",
                        tpage_n, tp,
                        (tp != 0u && tp <= 0x1FFu) ? "-> 0xE1 installed" : "NOT fed (capture suspect)");
        }
    }
    {
        static uint32_t primsub_n;
        if (primsub_n < 8u && prim >= 0x80010000u && prim < 0x80200000u) {
            uint32_t tag = xenolift_mem_read32(prim);
            uint32_t len = (tag >> 24) & 0xFFu;
            if (len >= 1u && len <= 16u) {
                uint32_t w[16]; uint32_t got = 0;
                for (uint32_t i = 0; i < len; i++) {
                    w[i] = xenolift_mem_read32(prim + 4u + 4u * i);
                    got++;
                }
                primsub_n++;
                r861_out("[primsub] R942 HLE submit #%u prim=%08X tag=%08X len=%u words:", primsub_n, prim, tag, len);
                for (uint32_t i = 0; i < got; i++) {
                    r861_out(" %08X", w[i]);
                    gpu_gp0_write(w[i]); /* feed the proven interpreter */
                }
                r861_out("\n");
            }
        }
    }
    static int r936_n;
    if (r936_n >= 4) return;
    r936_n++;
    uint32_t env = xenolift_mem_read32(0x800568C8u);
    r861_out("[drawcam] R936 DrawPrim ctx: prim=%08X tag=%08X w1=%08X w2=%08X w3=%08X w4=%08X | env@568C8=%08X env+14=%08X env+3C=%08X cur_fn=%08X r31=%08X\n",
            prim, xenolift_mem_read32(prim), xenolift_mem_read32(prim + 4),
            xenolift_mem_read32(prim + 8), xenolift_mem_read32(prim + 12),
            xenolift_mem_read32(prim + 16), env,
            xenolift_mem_read32(env + 0x14u), xenolift_mem_read32(env + 0x3Cu),
            (unsigned)xenolift_cur_fn, (unsigned)r[31]);
}

uint32_t xenolift_freelist_head_heal(uint32_t heap)
{
    uint32_t v = xenolift_mem_read32(heap + 0x1B0u);
    if (v == 0u) {
        static int r934_n;
        if (r934_n < 8) {
            r934_n++;
            r861_out("[flhead] R934 freelist head NULL at heap %08X +1B0 -> healed to END sentinel 801FBFF8 (HeapInit contract; walk terminates cleanly) cur_fn=%08X\n",
                    heap, (unsigned)xenolift_cur_fn);
        }
        xenolift_mem_write32(heap + 0x1B0u, 0x801FBFF8u);
        v = 0x801FBFF8u;
    }
    return v;
}

uint32_t xenolift_cdcb_slot(uint32_t addr)
{
    uint32_t v = xenolift_mem_read32(addr);
    if (v != 0u && (v < 0x80010000u || v >= 0x80200000u)) {
        static int r933_n;
        if (r933_n < 6) {
            r933_n++;
            r861_out("[cdcb] R933 CD callback slot %08X held garbage %08X -> healed to 0 (pre-registration posture; kernel's real CdReady/CdData handler registers through the normal init) cur_fn=%08X\n",
                    addr, v, (unsigned)xenolift_cur_fn);
        }
        xenolift_mem_write32(addr, 0u);
        v = 0u;
    }
    return v;
}

static int bios_hook(uint32_t target)
{
    if (target < XENOLIFT_BIOS_X || target >= XENOLIFT_BIOS_X + 0x1000u) {
        return 0;
    }
    static uint8_t seen[0x1000 / 4];
    uint32_t off = (target - XENOLIFT_BIOS_X) / 4;
    if (off / 4 < sizeof(seen) && !seen[off / 4]) {
        seen[off / 4] = 1;
        r861_out("[bios] synthetic hook +0x%03X (0x%08X) called — serviced\n",
                target - XENOLIFT_BIOS_X, target);
    }
    g_hook_calls++;
    if (g_hook_calls % 500 == 0) {
        r861_out("[bios] synthetic hooks: %u calls so far\n", g_hook_calls);
    }
    r[2] = 0;
    return 1;
}

static const char *bios_name(uint32_t gate, uint32_t fn)
{
    const char *const *tab = NULL;
    uint32_t n = 0;
    fn &= 0xFFu;
    switch (gate) {
    case 0xA0: tab = A_names; n = sizeof(A_names) / sizeof(A_names[0]); break;
    case 0xB0: tab = B_names; n = sizeof(B_names) / sizeof(B_names[0]); break;
    case 0xC0: tab = C_names; n = sizeof(C_names) / sizeof(C_names[0]); break;
    }
    if (tab != NULL && fn < n) {
        return tab[fn];
    }
    return "?";
}

static void bios_log(uint32_t gate, uint32_t fn, const char *what)
{
    static uint8_t seen[3][256];
    uint32_t g = (gate - 0xA0u) / 0x10u; /* 0xA0->0, 0xB0->1, 0xC0->2 */
    fn &= 0xFFu;
    if (seen[g][fn]) {
        return;
    }
    seen[g][fn] = 1;
    r861_out("[bios] %c0(0x%02X) %-28s %s\n",
            (char)('A' + g), fn, bios_name(gate, fn), what);
}

/* safe C-string read from RAM (for printf-style logging) */
static void bios_read_str(uint32_t a, char *buf, uint32_t n)
{
    uint32_t i;
    for (i = 0; i < n - 1; i++) {
        uint32_t p = (a + i) & 0x1FFFFFFFu;
        if (p >= XENOLIFT_RAM_SIZE) {
            break; /* not RAM — stop rather than fault */
        }
        uint8_t c = xenolift_mem[p];
        if (c == 0) {
            break;
        }
        buf[i] = (char)c;
    }
    buf[i] = 0;
}


/* diagnostic: dump words at a RAM pointer, and follow it one level
 * (kernel structures often store name pointers inside) */
int zsr_pending = 0; /* R293 zero-size-read sync-complete arming */
static uint32_t fin_r20_saved = 0; /* R304: finale cleanup handle (captured at fn_80073B28 entry) */
static void bios_inspect(const char *label, uint32_t a)
{
    uint32_t p = a & 0x1FFFFFFFu;
    if (p + 32 > XENOLIFT_RAM_SIZE) {
        return; /* not RAM */
    }
    r861_out("[bios]     %s 0x%08X:", label, a);
    for (int i = 0; i < 8; i++) {
        uint32_t w;
        memcpy(&w, xenolift_mem + p + i * 4, 4);
        r861_out(" %08X", w);
    }
    r861_out("\n");
    uint32_t pv;
    memcpy(&pv, xenolift_mem + p, 4);
    if ((pv & 0x1FFFFFFFu) + 1 < XENOLIFT_RAM_SIZE && pv != 0) {
        char b2[128];
        bios_read_str(pv, b2, sizeof b2);
        if (b2[0] != 0) {
            r861_out("[bios]     *%s -> 0x%08X \"%s\"\n", label, pv, b2);
        }
    }
}

/* R145 (BIOS_THUNK_AUDIT.md top-5 implementation): gate-side state
 * for the pad, exception-exit, and root-counter-clear thunks. */
static uint8_t g_pad_active;          /* StartPAD() called */
static uint32_t g_pad_buf1, g_pad_buf2; /* InitPAD(buf1,len1,buf2,len2) */
static uint32_t g_custom_exception_exit; /* SetCustomExitFromException */
static uint8_t g_rc_clear[3];         /* ChangeClearRCnt flags RC0-2 */
void xenolift_bios_gate(uint32_t gate, uint32_t fn)
{
    /* R1193 (c482): wedge-attribution camera. c482 receipts: the guest
     * wedged with cur_fn=0x800404B4 (the DisableEvent BIOS thunk) for
     * 100s+ after spu-dma #36 + the pending-notifier CALL, but the thunk
     * body is 3 stores + DISPATCH(0xB0) and the B0 0x0D handler is
     * instant - the spin's true site is NOT yet receipted. Record every
     * gate call so the R967 wedge print names the LAST gate+fn; if the
     * wedge window shows a gate call with NO matching return-progress,
     * the spin is in that handler; if gate_n is frozen at the wedge,
     * the spin is BEFORE the gate (emit-side thunk order suspicion: the
     * fresh R1192 emit may have moved the r9=0x0D delay-slot store
     * relative to DISPATCH - probe reads the fresh body on the Mac). */
    g_r1193_last_gate = gate; g_r1193_last_fn = fn; g_r1193_gate_n++;
    if (gate == 0xB0u && fn == 0x0Du && g_r1193_dis_n < 8u) {
        g_r1193_dis_n++;
        r861_out("[gate] R1193 B0 DisableEvent ev=%u (call #%u)\n", r[4], g_r1193_gate_n);
    }
    switch (gate) {
    case 0xA0:
        switch (fn) {
        case 0x44: /* FlushCache: no host cache to flush in static code */
            bios_log(gate, fn, "(nop)");
            r[2] = 0;
            return;
        case 0x48: /* SendGP1Command(gp1cmd) */
            bios_log(gate, fn, "-> GPU GP1");
            xenolift_mem_write32(0x1F801814u, r[4]);
            r[2] = 0;
            return;
        case 0x49: /* GPU_cw(gp0cmd) — send one GP0 command word */
            bios_log(gate, fn, "-> GPU GP0");
            xenolift_mem_write32(0x1F801810u, r[4]);
            r[2] = 0;
            return;
        case 0x4D: /* GetGPUStatus */
            bios_log(gate, fn, "-> 0x10000000");
            r[2] = 0x10000000u;
            return;
        case 0x4E: /* gpu_sync */
            bios_log(gate, fn, "(nop)");
            r[2] = 0;
            return;
        case 0x19: { /* strcpy(dst, src) */
            bios_log(gate, fn, "(real)");
            uint32_t d = r[4], sc = r[5], i = 0;
            uint8_t c;
            do {
                c = xenolift_mem_read8(sc + i);
                xenolift_mem_write8(d + i, c);
                i++;
            } while (c != 0);
            r[2] = d;
            return;
        }
        case 0x1B: { /* strlen(s) */
            bios_log(gate, fn, "(real)");
            uint32_t i = 0;
            while (xenolift_mem_read8(r[4] + i) != 0) {
                i++;
            }
            r[2] = i;
            return;
        }
        case 0x28: { /* bcopy(src, dst, len) */
            bios_log(gate, fn, "(real)");
            uint32_t i;
            for (i = 0; i < r[6]; i++) {
                xenolift_mem_write8(r[5] + i, xenolift_mem_read8(r[4] + i));
            }
            r[2] = 0;
            return;
        }
        case 0x2A: { /* memcpy(dst, src, len) */
            bios_log(gate, fn, "(real)");
            uint32_t i;
            for (i = 0; i < r[6]; i++) {
                xenolift_mem_write8(r[4] + i, xenolift_mem_read8(r[5] + i));
            }
            r[2] = r[4];
            return;
        }
        case 0x2B: { /* memset(dst, fill, len) */
            bios_log(gate, fn, "(real)");
            uint32_t i;
            for (i = 0; i < r[6]; i++) {
                xenolift_mem_write8(r[4] + i, r[5] & 0xFFu);
            }
            r[2] = r[4];
            return;
        }
        case 0x00: { /* FileOpen(filename, access) -> fd or -1 */
            char buf[128];
            uint32_t lba, size;
            bios_read_str(r[4], buf, sizeof buf);
            if (buf[0] == 0) {
                /* this kernel may pass the name in a1 instead: try it */
                char b5[128];
                bios_read_str(r[5], b5, sizeof b5);
                if (b5[0] != 0) {
                    r861_out("[bios]     (filename seen in a1, not a0)\n");
                    memcpy(buf, b5, sizeof buf);
                }
            }
            r861_out("[bios]     args: a0=0x%08X a1=0x%08X a2=0x%08X\n",
                    r[4], r[5], r[6]);
            if (g_disc != NULL && iso_resolve(buf, &lba, &size) == 0) {
                bios_log(gate, fn, "(REAL — from disc)");
                r861_out("[bios]     file \"%s\" at LBA %u, %u bytes\n",
                        buf, lba, size);
                int fd = -1;
                for (int i = 0; i < 16; i++) {
                    if (!g_files[i].in_use) {
                        fd = i;
                        break;
                    }
                }
                if (fd < 0) {
                    r[2] = (uint32_t)-1;
                } else {
                    g_files[fd].lba = lba;
                    g_files[fd].size = size;
                    g_files[fd].pos = 0;
                    g_files[fd].in_use = 1;
                    r[2] = (uint32_t)fd;
                }
            } else {
                bios_log(gate, fn, "(file not found, v0=-1)");
                r861_out("[bios]     wants file: \"%s\" (access %u)\n", buf, r[5]);
                bios_inspect("a1", r[5]);
                bios_inspect("a2", r[6]);
                r[2] = (uint32_t)-1;
            }
            return;
        }
        case 0x01: { /* FileSeek(fd=r4, offset=r5, seektype=r6) */
            bios_log(gate, fn, "(REAL)");
            int fd = (int)r[4];
            if (fd >= 0 && fd < 16 && g_files[fd].in_use) {
                uint32_t base = (r[6] == 0u) ? 0u :
                                (r[6] == 1u) ? g_files[fd].pos : g_files[fd].size;
                g_files[fd].pos = base + r[5];
            }
            r[2] = 0;
            return;
        }
        case 0x02: { /* FileRead(fd=r4, dst=r5, len=r6) -> bytes read */
            bios_log(gate, fn, "(REAL)");
            r[2] = (uint32_t)disc_file_read((int)r[4], r[5], r[6]);
            return;
        }
        case 0x04: { /* FileClose(fd=r4) */
            bios_log(gate, fn, "(REAL)");
            int fd = (int)r[4];
            if (fd >= 0 && fd < 16) {
                g_files[fd].in_use = 0;
            }
            r[2] = 1;
            return;
        }
        case 0x3C: /* std_out_putchar(char) */
            bios_log(gate, fn, "(-> console)");
            /* R980 (b8-c89, WARDEN - RAW-WRITE CONSOLE, kills the
             * fprintf-door crash class): c89's fresh host crash
             * (faultingThread, age 4s = this run) shows __stack_chk_fail
             * via __xvprintf <- vfprintf_l <- fprintf <- real_main - a
             * printf-family call NOT through r861_out (R977's guard
             * cannot see it). The bios gate's std_out_putchar used
             * fputc(stderr) - same FILE/vprintf internals that die on
             * the canary when a signal re-enters mid-write (the exact
             * class R977 killed at r861_out's door; this is the second
             * door). Mechanical fix, no behavior change to the guest:
             * raw write(2) - async-signal-safe, no FILE machinery, no
             * canary, same byte lands on stderr. */
            { char r980_c = (char)(r[4] & 0xFFu);
              if (r980_c) (void)!write(2, &r980_c, 1); }
            r[2] = r[4];
            return;
        case 0x3F: { /* printf(fmt, ...) — show the format string */
            char buf[128];
            bios_read_str(r[4], buf, sizeof buf);
            bios_log(gate, fn, "(printf)");
            r861_out("[game] \"%s\"\n", buf);
            r[2] = 0;
            return;
        }
        }
        break;
    case 0xB0:
        switch (fn) {
        case 0x5B: /* R83: called by the driver-object init chain
             * (fn_80040828/fn_800408C4 both do B0(0x5B)(0)). Logged so
             * the digest shows the kernel's args; returns 0. */
            bios_log(gate, fn, "(logged)");
            r861_out("[gate5B] a0=%u a1=%u a2=%u\n", r[4], r[5], r[6]);
            r[2] = 0;
            return;
        case 0x56: /* GetC0Table */
        case 0x57: /* GetB0Table */
            bios_log(gate, fn, "(REAL — synthetic table)");
            r[2] = XENOLIFT_BIOS_T;
            return;
        case 0x08: /* OpenEvent(class, spec, mode, handler) */
            bios_log(gate, fn, "(REAL — event table)");
            r[2] = evt_open(r[4], r[5], r[6], r[7]);
            r861_out("[evt] OpenEvent class=0x%08X spec=0x%08X mode=0x%08X handler=0x%08X -> ev=%u\n",
                    r[4], r[5], r[6], r[7], r[2]);
            return;
        case 0x09: /* CloseEvent(ev) */
            bios_log(gate, fn, "(REAL — event table)");
            if (r[4] >= 1u && r[4] <= MAX_EVENTS && evt_tab[r[4]-1].in_use)
                evt_tab[r[4]-1].in_use = 0;
            r[2] = 1;
            return;
        case 0x0A: /* WaitEvent(ev) — real HW blocks the thread until the
         * event is delivered. Static recomp can't block: the load's
         * chunk loop paces on this. We fire CD events from the
         * heartbeat, and reads are synchronous, so report delivered
         * and consume the flag. */
            bios_log(gate, fn, "(REAL — event table)");
            if (r[4] >= 1u && r[4] <= MAX_EVENTS && evt_tab[r[4]-1].in_use) {
                { static uint32_t wepr_n; /* R1271: one per pump round - first 60 + every 200th. */
                  if (++wepr_n <= 60u || (wepr_n % 200u) == 0u)
                    r861_out("[evt] WaitEvent ev=%u class=0x%08X fired=%u\n",
                        r[4], evt_tab[r[4]-1].cls, evt_tab[r[4]-1].fired); }
                evt_tab[r[4]-1].fired = 0;
            }
            r[2] = 1; /* delivered */
            return;
        case 0x0B: /* TestEvent(ev) — non-blocking probe */
            r[2] = 0;
            if (r[4] >= 1u && r[4] <= MAX_EVENTS && evt_tab[r[4]-1].in_use)
                r[2] = evt_tab[r[4]-1].fired;
            return;
        case 0x0C: /* EnableEvent(ev) */
            bios_log(gate, fn, "(REAL — event table)");
            r[2] = r[4];
            if (r[4] >= 1u && r[4] <= MAX_EVENTS && evt_tab[r[4]-1].in_use) {
                evt_tab[r[4]-1].enabled = 1;
                r861_out("[evt] EnableEvent ev=%u class=0x%08X handler=0x%08X\n",
                        r[4], evt_tab[r[4]-1].cls, evt_tab[r[4]-1].handler);
            } else {
                r861_out("[evt] EnableEvent BAD ev=%u\n", r[4]);
            }
            return;
        case 0x0D: /* DisableEvent(ev) */
            bios_log(gate, fn, "(REAL — event table)");
            if (r[4] >= 1u && r[4] <= MAX_EVENTS && evt_tab[r[4]-1].in_use)
                evt_tab[r[4]-1].enabled = 0;
            r[2] = r[4];
            return;
        case 0x07: /* DeliverEvent(class, spec) */
            bios_log(gate, fn, "(REAL — event table)");
            r861_out("[evt] DeliverEvent class=0x%08X spec=0x%08X\n", r[4], r[5]);
            evt_deliver_class(r[4], r[5]);
            r[2] = 0;
            return;
        case 0x12: /* InitPAD(buf1, len1, buf2, len2) — R145
             * (BIOS_THUNK_AUDIT.md #5): the kernel registers its dual
             * controller buffers (Xenogears pair at 0x800625FC /
             * 0x8006261E, 34B each). Record the pointers; the proven
             * pad-feed mechanism keeps driving the settled handshake
             * (do-not-poison: never rewrite the buffers here). */
            g_pad_buf1 = r[4]; g_pad_buf2 = r[6];
            bios_log(gate, fn, "(pad buffers registered)");
            r861_out("[bpad] InitPAD buf1=%08X len1=%u buf2=%08X len2=%u\n",
                    r[4], r[5], r[6], r[7]);
            r[2] = 1;
            return;
        case 0x13: /* StartPAD() — R145 (audit #4): acknowledge pad
             * background polling ON. The existing pad-feed continues
             * to service the buffers. */
            g_pad_active = 1;
            bios_log(gate, fn, "(pad active)");
            r861_out("[bpad] StartPAD — pad background polling ACTIVE\n");
            r[2] = 1;
            return;
        case 0x17: /* ReturnFromException — R145 (audit #2): our HLE
             * never raises CPU exceptions, so this should NEVER fire.
             * If it does, the kernel is in its exception-recovery
             * path — name it loudly so the digest catches the class. */
            bios_log(gate, fn, "(*** EXCEPTION RETURN — HLE never traps! ***)");
            r861_out("[bxcep] ReturnFromException r31=0x%08X custom_exit=0x%08X r4=0x%08X r5=0x%08X\n",
                    r[31], g_custom_exception_exit, r[4], r[5]);
            r[2] = 0;
            return;
        case 0x19: /* SetCustomExitFromException(addr) — R145 (audit
             * #3): record the kernel's exception-recovery hook and
             * return the previous one (BIOS semantics). */
            bios_log(gate, fn, "(custom exit registered)");
            r861_out("[bxcep] SetCustomExitFromException addr=0x%08X (prev=0x%08X)\n",
                    r[4], g_custom_exception_exit);
            r[2] = g_custom_exception_exit;
            g_custom_exception_exit = r[4];
            return;
        }
        break;
    case 0xC0:
        switch (fn) {
        case 0x0A: { /* ChangeClearRCnt(rcnt, flag) — R145 (audit #1):
             * root-counter auto-clear config. Store the flag, return
             * the PREVIOUS flag (BIOS semantics). Deliberately NOT
             * writing the RC mode MMIO (0x1F801104/114/124): the
             * display/VSync flow is proven and the kernel configures
             * RC modes itself via the register district; the R144
             * park digest decides whether RC mode emulation is the
             * missing slot-event source before we touch live counters. */
            uint32_t prev = 0;
            if (r[4] < 3u) {
                prev = g_rc_clear[r[4]];
                g_rc_clear[r[4]] = r[5] ? 1u : 0u;
            }
            bios_log(gate, fn, "(rc clear flag stored)");
            r861_out("[rcntc] ChangeClearRCnt rc=%u flag=%u -> prev=%u\n",
                    r[4], r[5], prev);
            r[2] = prev;
            return; }
        case 0x02: { /* SysEnqIntRP(priority, struct): REAL chain insert.
             * The unregister walk (fn_80039144, from completion cb
             * fn_80038B4C) compares chain links against (struct-16) and
             * spins forever when the entry was never inserted — the old
             * "captured" stub caused exactly that. Entry base = r5-16;
             * +12 = next link (pre-zeroed by the struct creator). */
            uint32_t ent = (r[5] - 16u) & ~15u, q, nx;
            bios_log(gate, fn, "(REAL insert)");
            memcpy(&q, xenolift_mem + 0x59410, 4);
            { /* R100: dump the registered struct to identify the kernel CD IRQ handlers */
            r861_out("[enqstruct] 0x8005A1F0: %08X %08X %08X %08X | 0x8005A200: %08X %08X %08X %08X\n",
                    *(uint32_t*)(void*)(xenolift_mem + 0x5A1F0u), *(uint32_t*)(void*)(xenolift_mem + 0x5A1F4u),
                    *(uint32_t*)(void*)(xenolift_mem + 0x5A1F8u), *(uint32_t*)(void*)(xenolift_mem + 0x5A1FCu),
                    *(uint32_t*)(void*)(xenolift_mem + 0x5A200u), *(uint32_t*)(void*)(xenolift_mem + 0x5A204u),
                    *(uint32_t*)(void*)(xenolift_mem + 0x5A208u), *(uint32_t*)(void*)(xenolift_mem + 0x5A20Cu));
        }
r861_out("[enq] SysEnqIntRP prio=%u struct=0x%08X entry=0x%08X head=0x%08X\n",
                    r[4], r[5], ent, q);
            bios_inspect("irq-struct", r[5]);
            /* R84: the BIOS SysEnqIntRP list is SEPARATE from the
             * kernel's own chain at 0x80059410 (the kernel's list init
             * overwrites the head later — inserting there orphans entries).
             * Keep a BIOS-side shadow for logging; kernel list untouched. */
            if (ent >= 0x80000000u && ent < 0x80200000u) {
                uint32_t z = 0, shadow = XENOLIFT_BIOS_T + 0x300u;
                memcpy(xenolift_mem + (shadow - 0x80000000u) + 12, &ent, 4);
                (void)z; (void)q; (void)nx;
            }
            r[2] = 0;
            return;
        }
        case 0x03: { /* SysDeqIntRP(priority, struct): LOG-ONLY (R92).
             * REVERT of the R83 unlink: 0x80059410 is NOT an IRQ event
             * chain — fn_80038F18 walks it as a first-fit BLOCK FREE-LIST
             * (size = next - data; the fd module allocates 0x850-byte CD
             * sector buffers from it). Our unlink rewired +12 links of
             * REAL heap blocks and created the cycle the allocator now
             * spins in. No writes, ever. */
            uint32_t ent = (r[5] - 16u) & ~15u, q;
            bios_log(gate, fn, "(log-only)");
            memcpy(&q, xenolift_mem + 0x59410, 4);
            r861_out("[deq] SysDeqIntRP prio=%u struct=0x%08X entry=0x%08X flhead=0x%08X\n",
                    r[4], r[5], ent, q);
            r[2] = 0;
            return;
        }
        }
        break;
    }

    /* R1018 (b8-c132): CARD-INIT GATE FAMILY. c132 receipts: the card chain
     * (fn 0x8004E850, sequential trampolines "li t1,0x4A/0x4B/0x4C; jr gate")
     * faulted dereferencing host-heap addrs (0x6AA934xx class) after B0(0x4A)
     * InitCARD / B0(0x4B) StartCARD / A0(0x70) _bu_init / A0(0x72) all hit the
     * stub fallthrough (v0=0, [gatemiss] hits 3-8) with NO card contract.
     * Per the decomp's own psyq headers (include/psyq/libapi.h:110-112):
     * InitCARD(long)/StartCARD(void)/_bu_init(void) are void-semantics init
     * calls - v0 is INERT for the init pair. Service with v0=1 (card-ready
     * posture) + receipt; the follow-on status-poll flow ([0x8005E894]&0x80
     * family) gets named by next cycle's receipts if it still stalls. */
    if ((gate == 0xB0u && (fn == 0x4Au || fn == 0x4Bu))
     || (gate == 0xA0u && (fn == 0x70u || fn == 0x72u))) {
        static int cg_n;
        if (cg_n < 8) {
            cg_n++;
            r861_out("[cardgate] R1018 card gate serviced: %c0(0x%02X) v0=1 a0=%08X a1=%08X a2=%08X (psyq libapi.h:110 card-init family; c132 gatemiss receipts) @t=%lds\n",
                    (gate == 0xB0u) ? 'B' : 'A', (unsigned)(fn & 0xFFu),
                    (unsigned)r[4], (unsigned)r[5], (unsigned)r[6],
                    (long)(xl_wall() - g_boot_wall_t0));
        }
        r[2] = 1;
        return;
    }
    /* R1019 (b8-c133): B0(0x35) write(fd, buf, count) - the game's OWN
     * console output. c111's TRUE-DEATH door was this gate (fd=-1, src=0,
     * len=3, death words "li t1,0x35; jr 0xB0") and c133 receipts show it
     * called for real: fd=1 (stdout), buf=0x801FFF30 (guest stack), len=1,
     * hits 1-8. psyq stdio contract: write returns the count on success.
     * Service it: v0=count (success), and the bytes become VISIBLE - the
     * kernel's own debug text is project gold (the game's debug menu is
     * "XENOGEARS Kernel MENU"). Bounds-checked guest read, receipt-safe
     * output, no libc print machinery, cap 24. */
    if (gate == 0xB0u && (fn & 0xFFu) == 0x35u) {
        unsigned fw_fd = (unsigned)r[4];
        unsigned fw_buf = (unsigned)r[5];
        unsigned fw_len = (unsigned)r[6];
        static int fw_n;
        if (fw_n < 24) {
            unsigned char fw_b[8];
            unsigned fw_i, fw_got = 0;
            for (fw_i = 0; fw_i < 8u; fw_i++) fw_b[fw_i] = 0;
            if (fw_buf >= 0x80000000u && fw_buf < 0x80200000u && fw_len <= 0x40u) {
                for (fw_i = 0; fw_i < fw_len && fw_i < 8u; fw_i++) {
                    if (fw_buf + fw_i >= 0x80000000u && fw_buf + fw_i < 0x80200000u) {
                        memcpy(&fw_b[fw_i], xenolift_mem + (fw_buf + fw_i - 0x80000000u), 1);
                        fw_got++;
                    }
                }
            }
            r861_out("[filewrite] R1019 B0(0x35) write fd=%u buf=%08X len=%u got=%u bytes=%02X%02X%02X%02X '%c%c%c%c' -> v0=len (psyq stdio write contract; c111 death-door class; c133 hits 1-8)\n",
                    fw_fd, fw_buf, fw_len, fw_got,
                    fw_b[0], fw_b[1], fw_b[2], fw_b[3],
                    (fw_b[0] >= 32 && fw_b[0] < 127) ? fw_b[0] : '.',
                    (fw_b[1] >= 32 && fw_b[1] < 127) ? fw_b[1] : '.',
                    (fw_b[2] >= 32 && fw_b[2] < 127) ? fw_b[2] : '.',
                    (fw_b[3] >= 32 && fw_b[3] < 127) ? fw_b[3] : '.');
            fw_n++;
        }
        r[2] = (fw_len <= 0x10000u) ? fw_len : 0x10000u;
        return;
    }
    /* everything else: stubbed for now */
    bios_log(gate, fn, "(stubbed, v0=0)");
    r[2] = 0;
    /* R999 (b8-c111, WARDEN): every handled gate path returns directly; any
     * fallthrough reaching here is an UNHANDLED BIOS function - and c111
     * proved they pass SILENTLY: B0(0x35) FileWrite(fd=0xFFFFFFFF, src=0,
     * len=3) died at the TRUE-DEATH door with death-site guest words
     * "li t1,0x35; jr 0xB0" (R964 @0x80040554) and NO log of the call
     * anywhere. Unknown fns now name themselves with args; v0 stays
     * UNTOUCHED - no semantic guesses without the psx-spx reference.
     * Next digest shows which unknown fns the kernel actually calls and
     * how often; then they get real HLE per spec. */
    {
        static uint32_t r999_hits[3][256];
        uint32_t g = (gate >= 0xA0u && gate <= 0xC0u) ? ((gate - 0xA0u) / 0x10u) : 3u;
        uint32_t f = fn & 0xFFu;
        if (g < 3u) {
            r999_hits[g][f]++;
            if (r999_hits[g][f] <= 8u || (r999_hits[g][f] % 1000u) == 0u)
                r861_out("[gatemiss] R999 %c0(0x%02X) UNHANDLED %s a0=%08X a1=%08X a2=%08X (v0 UNTOUCHED, hit %u)\n",
                        (char)('A' + g), f, bios_name(gate, f), r[4], r[5], r[6], r999_hits[g][f]);
        }
    }

}

static long g_trace_lines = 0;

/* R79: last-24 dispatch ring — printed on any fault so the exact call
 * path into the crash is on the record. */
uint32_t xenolift_ring[64]; int xenolift_ring_n;
int xenolift_spfix_n = 0; /* R233 sp-poison strip counter */
volatile uint32_t xenolift_cur_fn = 0; /* R227: live current-function for the crash report */

/* R117: overlay capture helper — dump a clamped window of RAM to
 * overlay_dump_N.bin. R116 bug: the guard `dest < 0x1E0000` skipped
 * the module region entirely (the module lives at 0x801F34B4 etc. =
 * the LAST 128KB of 2MB RAM → empty files, Jos md5 d41d8...x8).
 * Clamp to the RAM end instead of skipping. */
static int xenolift_ovl_dump(uint32_t vaddr, const char *tag)
{
    static int n = 0;
    if (n >= 8) return -1;
    if (vaddr < 0x80000000u || vaddr >= 0x80200000u) return -1;
    uint32_t dest = vaddr & 0x1FFFFFFFu; /* kseg0 -> phys */
    uint32_t avail = 0x200000u - dest;   /* clamp: never past RAM end */
    if (avail > 0x20000u) avail = 0x20000u;
    if (avail < 0x100u) return -1;
    char path[64];
    snprintf(path, sizeof path, "overlay_dump_%d.bin", n);
    FILE *f = fopen(path, "wb");
    if (!f) return -1;
    fwrite(xenolift_mem + dest, 1, avail, f);
    fclose(f);
    r861_out("[ovl] captured %s @0x%08X (%u bytes) -> %s\n",
            tag, vaddr, avail, path);
    return n++;
}

uint32_t g_splash_buf; /* R947: GameShowSplashScreen logo buffer (6209B LZSS decompress) */


static void xenolift_psyqptr_heal(const char *site)
{
    /* R1075 (b8-c242, WARDEN/ATLAS): decomp symbols name the null cells
     * behind the 60+-cycle CD_sync fault class - config/symbol_addrs:
     * g_pGPUSTAT=0x8005783C, g_pTMR_HRETRACE_VAL=0x80057840,
     * g_pTMR_HRETRACE_MODE=0x80058964 - and psyq libetc uses them as
     * POINTERS (vsync.c:14 *g_pGPUSTAT; :15 *g_pTMR_HRETRACE_VAL;
     * intr_vsync.c:12 *g_pTMR_HRETRACE_MODE=0x107). The pointer INIT
     * lives in untranslated libgpu ResetGraph assembly (INCLUDE_ASM), and
     * the c174-era watcher verdict holds: nobody writes them (proven by
     * the persistent fault at 8004B54C/8004B55C: lw r2,[0x8005783C] ->
     * deref NULL -> addr=0 crash, every run since c174). Hardware-faithful
     * values per psx-spx: GPUSTAT=0x1F801810, RCNT2 count=0x1F801120,
     * RCNT2 mode=0x1F801124 (the 0x107 mode write in intr_vsync.c:12 =
     * RCNT2 hblank-source class, matching hretrace semantics). Zero-check
     * only: the kernel's own init, when it runs, overwrites with the same
     * values; reads through them become live register reads (GPUSTAT/RCNT
     * emulation already services these addresses). */
    static int r1075_n;
    /* R1076 (b8-c243): c243 receipt explains why R1075's zero-check never
     * fired - the CD_sync fault moved from addr=0 (c242) to addr=4 (c243):
     * the cell is not NULL at fault time, it holds the literal 4 from the
     * pristine exe image, and every fault-walk restore puts it back. The
     * consumers (vsync.c:14 *g_pGPUSTAT) deref pointer-4 -> SIGSEGV at
     * addr=4. New gate: heal whenever the cell is NOT a register-district
     * pointer [0x1F800000, 0x1F802000) - catches NULL, the literal 4, and
     * any other garbage class, while a legit kernel init (a district
     * pointer) always passes. Receipt names the old value. */
    uint32_t r1076_v;
    r1076_v = xenolift_mem_read32(0x8005783Cu);
    if (r1076_v != 0x1F801810u && (r1076_v < 0x1F800000u || r1076_v >= 0x1F802000u)) {
        xenolift_mem_write32(0x8005783Cu, 0x1F801810u);
        if (r1075_n < 12) { r1075_n++;
            r861_out("[psyqheal] R1076 g_pGPUSTAT healed: %08X -> 1F801810 (GPUSTAT reg; not a district pointer = uninit/garbage class, c243 addr=4 receipt) @ %s\n", r1076_v, site); }
    }
    r1076_v = xenolift_mem_read32(0x80057840u);
    if (r1076_v != 0x1F801120u && (r1076_v < 0x1F800000u || r1076_v >= 0x1F802000u)) {
        xenolift_mem_write32(0x80057840u, 0x1F801120u);
        if (r1075_n < 12) { r1075_n++;
            r861_out("[psyqheal] R1076 g_pTMR_HRETRACE_VAL healed: %08X -> 1F801120 (RCNT2 count; vsync.c:15 reads it live) @ %s\n", r1076_v, site); }
    }
    r1076_v = xenolift_mem_read32(0x80058964u);
    if (r1076_v != 0x1F801124u && (r1076_v < 0x1F800000u || r1076_v >= 0x1F802000u)) {
        xenolift_mem_write32(0x80058964u, 0x1F801124u);
        if (r1075_n < 12) { r1075_n++;
            r861_out("[psyqheal] R1076 g_pTMR_HRETRACE_MODE healed: %08X -> 1F801124 (RCNT2 mode; intr_vsync.c:12 writes 0x107 through it) @ %s\n", r1076_v, site); }
    }
    /* R1078 (b8-c245, WARDEN): the crash family walked two cells deeper
     * this cycle - c245 death trail runs the CD poll loop at
     * 0x80041C64/0x80041BB0, whose own R1008 code dump reads counters
     * 0x8006A228/A22C (fine - flag cells the CD-event chain posts,
     * runtime line ~692) and dereferences: lw r2,[0x80056770]; lbu r2,[r2]
     * and lw r5,[0x8006A230]; lw r3,[r5+idx]. Same never-installed-cell
     * class (crash addr=0xB86EC598 = deref of garbage). Healthy values for
     * these cells are guest-RAM pointers (status/table addresses) that we
     * do not have receipts for - heal to the zero scratchpad tail instead:
     * reads return 0 = the standby/empty posture, polls stay alive without
     * faulting, and a healthy late install (guest-RAM pointer) always
     * passes the gate. Guest-RAM-range check: only fire on non-guest,
     * non-scratchpad garbage; the 0x1F8000C0 heal target is idempotent
     * (already in-district). Receipt names the garbage value. */
    r1076_v = xenolift_mem_read32(0x80056770u);
    if ((r1076_v < 0x80010000u || r1076_v >= 0x80200000u) &&
        (r1076_v < 0x1F800000u || r1076_v >= 0x1F802000u)) {
        xenolift_mem_write32(0x80056770u, 0x1F8000C0u);
        if (r1075_n < 12) { r1075_n++;
            r861_out("[psyqheal] R1078 CD-status ptr 80056770 healed: %08X -> 1F8000C0 (lbu reads 0 = standby posture; c245 crash trail receipt; healthy install passes) @ %s\n", r1076_v, site); }
    }
    r1076_v = xenolift_mem_read32(0x8006A230u);
    if ((r1076_v < 0x80010000u || r1076_v >= 0x80200000u) &&
        (r1076_v < 0x1F800000u || r1076_v >= 0x1F802000u)) {
        xenolift_mem_write32(0x8006A230u, 0x1F8000C0u);
        if (r1075_n < 12) { r1075_n++;
            r861_out("[psyqheal] R1078 CD-table ptr 8006A230 healed: %08X -> 1F8000C0 (lw through table reads 0 = empty posture; c245 R1008 dump receipt; healthy install passes) @ %s\n", r1076_v, site); }
    }
}

void xenolift_trace(uint32_t a)
{
    xenolift_cur_fn = a;
    {   /* R941 [primx] (b8-c47): the pixels hunt decoded the fade prim to a
         * SPRT 1x1 (code 0x64, rgb ramping 00/08/10/18 at (32,88)) reaching
         * DrawPrim (0x80044B70) - but its words NEVER reach GP0 (poly=0,
         * rect census = boot clears only). The submitter is env+3C =
         * 0x80046DB4 (libgpu prim->GP0 converter); env+14 = 0x8004659C is
         * the second env method. If these NEVER enter, the indirect call
         * out of DrawPrim is the dead link (translated-call seam class) and
         * the fix is an HLE prim-submit at the drawcam door. One-shot
         * receipts name the verdict. */
        /* R1095 (b8-c266): VTABLE-DISPATCH WATCH. c266 fldreloc2 receipt:
         * second module expanded into stage-2 100%% (180422/180422 words),
         * slot now holds the REAL vtable trio 00000005 80072878 80072898
         * 800728D8 (the c344-era vtable family). The unproven link in the
         * module install chain: does ANY code ever call the installed
         * vtable fns? No crash receipts name them (no fault = invisible).
         * This census makes execution visible: one-shot receipt per trio
         * fn + a stage-2 region liveness counter. If the trio stays silent
         * across runs, the coordinator never reaches the installed module's
         * dispatch table - and the era block moves to the vtable linkage. */
        static uint32_t r1095_n, r1095_stage2;
