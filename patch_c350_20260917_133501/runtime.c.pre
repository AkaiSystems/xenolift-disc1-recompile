#ifndef _GNU_SOURCE
#define _GNU_SOURCE
#endif /* R853: dladdr/Dl_info visibility (glibc guards it; macOS unguarded) */
/* xenolift runtime — phase 2
 * The "fake console": everything the recompiled code expects to exist.
 * RAM, registers, and stub functions for anything not yet translated
 * (BIOS calls, GTE math). Stubs report and halt so we can see exactly
 * where the run gets to — that's the smoke test.
 */
#include <string.h>
#include <time.h>
#include <setjmp.h>
#include "xenolift_runtime.h"
/* R722/R723: pristine exe-image snapshot for console-faithful shell re-boots
 * (captured at boot-1 entry, restored at every relay). Hoisted here because
 * the bootentry camera at ~line 9463 uses it BEFORE the old (too-late) decl. */
static uint32_t g_r722_img[0x5F000u >> 2];

static uint32_t g_r722_len;

unsigned xenolift_errc_count; /* R143: fn_80019ACC per-cycle spike counter */
int g_field_era; /* R348: set when state-1 (field) entered — movie->field handoff done */
#include <signal.h>
#include <pthread.h>
#ifdef __APPLE__
#include <mach-o/dyld.h> /* R1195 c484: image load base/slide for stack symbolization */
#endif
#include <execinfo.h> /* R424: moved up - fault kit (line ~3560) backtrace needs it before the R365-era copy at 3681 */
#include <stdio.h>
#include "receipt_xprintf.h" /* R985: vprintf-free receipt printer */
#include <dlfcn.h>  /* R853: dladdr for canary-smash symbol resolution */
#include <stdlib.h>
#include <unistd.h>
#include <fcntl.h>
#include <stdarg.h>
/* R134: HLE hardware modules delivered by the sub-agent program.
 * SPU + MDEC + memcard compile in and are wired below; GTE is held
 * out until its RTPS math passes verification. */
#include "../hle/hle_gpu.h"
#include "../hle/hle_gte.h"
#include "../hle/hle_spu.h"
#include "../hle/hle_mdec.h"
#include "../hle/hle_memcard.h"

/* R861 (c449): lock-free guest-context printer. Abort class evidence:
 * every death lands in __xvprintf's canary (vfprintf internals) while a
 * print runs inside MAIN-thread guest execution (c449: frame below the
 * dead print = 0x8004B4FC, the vertical-retrace region; c446: our canary
 * caught the smash at xenolift_trace+0x12630 with cur_fn=8004B54C).
 * vfprintf is not async-re-enter safe; write(2) is (R856 crash-kit
 * precedent). All prints on the two hottest guest-context paths
 * (io_log [dev] + xenolift_trace) now bypass the FILE* machinery: no
 * __xvprintf frame, no FILE lock, no libc print canary to smash. */
volatile int g_crash_dumping = 0; /* R961: crash-kit dump window flag - r861_out holds off so kit receipts never interleave */

static volatile sig_atomic_t g_r977_in; /* R977: receipt-printer reentrancy guard */
static volatile sig_atomic_t g_r861_n = 0; /* R1213: receipt-flow counter - the park backstop's liveness signal */
static volatile sig_atomic_t r861_quiet; /* R1189 (c471): hook-kick print suppression - set while the hook-serviced kick runs; R859 rule = no print inside kick context nested under live guest execution */
/* R1286 (c186, Jos direction): LATCH-PRIORITY RECEIPT CHANNEL. The c185
 * run exhausted the R971 50MB receipt budget at ~t=50s - the storm ate
 * every print after that, INCLUDING the latch/verdict receipts that
 * decode the 0x82 fault-verdict loop (43 calls, latch=0 at every
 * verdict moment). Jos: keep the failure visible - preserve latch
 * writes, verdict checks, and their order BEYOND 50 seconds. These
 * prefixes bypass the budget gate entirely (neither counted nor
 * gated - they are capped by their own per-camera limits): [latchw]
 * (verdict moment), [latchfix] (R502 re-arm), [latchhw] (the R1286
 * write-watcher on 0x80059330, 24-line cap), [boot] fn_80019ACC (the
 * dispatcher/verdict entry prints, <=40+1/1000 cap). Print policy
 * ONLY - no emulation behavior, no forcing the latch, no skipping
 * the verdict (per Jos: that could hide an actual loading failure). */
static int r1286_prio(const char *f) /* R1287: also [idxw] - the step-walker trail rides the priority channel with the latch/verdict family */
{
    return (f[0] == '[' && f[1] == 'l' && f[2] == 'a' && f[3] == 't'
            && f[4] == 'c' && f[5] == 'h')
        || (f[0] == '[' && f[1] == 'b' && f[2] == 'o' && f[3] == 'o'
            && f[4] == 't' && f[5] == ']' && f[6] == ' '
            && f[7] == 'f' && f[8] == 'n')
        || (f[0] == '[' && f[1] == 'i' && f[2] == 'd' && f[3] == 'x'
            && f[4] == 'w');
}

static void r861_out(const char *fmt, ...)
{
    g_r861_n++; /* R1213: every receipt counts - a frozen counter across an alarm window is the true wedge signal */

    /* R961 (b8-c70, WARDEN - SINGLE-WRITER DISCIPLINE): c70's macreport
     * names the receipt printer's own death: __stack_chk_fail inside
     * _vsnprintf on THREAD 1 while the crash-kit's [crash] dump ran on
     * the other thread — two writers into one log fd + static buffers =
     * interleaved/garbled EXITTAIL evidence (visible in c70's digest:
     * [rcntc]/[bootmain] lines interleaved INTO the crash trail) and a
     * host stack smash. Fix: (a) r861_out takes a pthread mutex (single
     * writer into the log at a time), (b) it yields the window while the
     * crash-kit dump is in progress (g_crash_dumping), so the kit's
     * write() receipts are never torn. Bounded wait: if the kit died
     * mid-dump the flag could stick, so cap at 250ms and proceed. */
    char b[2048];
    /* R977 (b8-c86, WARDEN - REENTRANCY GUARD, kills the torn-writer
     * death class): c84/85/86 all died the same way - canary inside
     * vfprintf with faultingThread=1 and r861_out in the frame, plus
     * TORN/interleaved receipts in the tail (c84: "trail 80019790[crash]
     * trail 80019794[crash]..."; c86: "[crash] h[rungasp]"). Mechanism
     * (receipt-consistent): a second signal (guest fault -> crash-kit,
     * or alarm) arrives WHILE r861_out's vfprintf is mid-print on the
     * same thread; the handler prints via r861_out again -> nested
     * vfprintf frames on one stack -> __stack_chk_fail. The R961 mutex
     * cannot fix same-thread signal reentrancy (signal context). Fix:
     * a plain reentrancy flag - if r861_out is already active on this
     * thread, nested calls become no-ops. The OUTER receipt always
     * survives intact; no mutex, no deadlock possible. The crash-kit's
     * raw write() path is untouched. */
    /* single-flight flag: set for the duration of THIS call; nested
     * (same-thread signal context) calls see it set and drop. Cleared
     * on normal exit so the next independent receipt prints fine. If
     * the worst happens mid-print (process dies), the flag is moot. */
    if (r861_quiet) return; /* R1189: kick-context print suppression (R859 rule) */
    if (g_r977_in) return; /* nested same-thread print (signal context) - drop, outer survives */
    g_r977_in = 1;
    va_list ap;
    int n;
    /* R971 (b8-c80, WARDEN - GLOBAL LOG BYTE-BUDGET): c80's log exploded
     * to 187MB (was ~700KB) during the 16M-dispatch interrupt era -
     * some receipt looped uncapped (the digest itself is capped, so
     * WHICH receipt looped is not receivable; the fault-ring print is
     * already bounded to 64). Mechanical defense, no guessing: a global
     * byte-budget on the receipt printer itself. After 50MB written,
     * print ONE notice and become a no-op for the rest of the run -
     * no receipt storm of any kind can churn the Mac's disk again, and
     * the digest capper never sees a 187MB wall. The kit's raw write()
     * receipts (crash dump) are NOT affected - this gates r861_out
     * only. */
    /* R1287 (c187, Jos direction - use the byte census to limit the noisy
     * tags while preserving latch writes, verdict checks, and their order
     * beyond 50s): the c186 census NAMED the storm - every top tag is 1-2
     * lines PER ITERATION of the 0x82 fault-verdict loop ([arena] 95939,
     * [gdisp] 95937, [heapinit] 47983, [vprobe] 47971, [clrh] 47970,
     * [restart] 47969, [ins] 47968, [latchw]+[latchfix] 47964 each) - 52.4MB
     * raw for one 120s run. PER-TAG PRINT GOVERNOR: first 2048 lines of any
     * tag stay free (the early window is complete), then 1 line per 4096
     * keeps the late-run cadence, one notice per tag at the crossover.
     * PRINT POLICY ONLY - no emulation behavior; when the loop dies the
     * storm dies with it. The latch/idx/verdict family is ALSO exempt from
     * the budget via r1286_prio. */
    { static unsigned long r1287_cnt[512]; static unsigned char r1287_noted[512];
      unsigned long r1287_h = 2166136261u; int r1287_i;
      for (r1287_i = 0; r1287_i < 8 && fmt[r1287_i]; r1287_i++)
          r1287_h = (r1287_h ^ (unsigned char)fmt[r1287_i]) * 16777619u;
      r1287_h &= 511u;
      r1287_cnt[r1287_h]++;
      if (r1287_cnt[r1287_h] > 2048u) {
          if (!r1287_noted[r1287_h]) { r1287_noted[r1287_h] = 1;
          { static const char r1287_msg[] = "[tagcap] R1287 per-tag print governor: this tag past its 2048-line early window - now 1 line per 4096 (c186 census: the 0x82 loop storm, 52.4MB/120s)\n";
            write(2, r1287_msg, sizeof r1287_msg - 1); } }
          else if ((r1287_cnt[r1287_h] & 4095u) != 0u) { g_r977_in = 0; return; }
      }
    }
    { static unsigned long r971_bytes; static int r971_noted;
      if (r1286_prio(fmt) == 0) { /* R1286: the latch/verdict receipts bypass the budget - the c185 storm silenced exactly the evidence that decodes the 0x82 loop; the failure stays visible to the fuse */
      if (r971_bytes > 50ul * 1024ul * 1024ul) {
          if (!r971_noted) { r971_noted = 1;
          { static const char r971_msg[] = "[logbudget] R971 50MB receipt budget EXHAUSTED - r861_out now silent for the rest of the run (EXCEPT the R1286 latch-priority channel) (c80's 187MB log-storm defense)\n";
            write(2, r971_msg, sizeof r971_msg - 1); } }
          g_r977_in = 0;
          return;
      }
      r971_bytes += 96; /* conservative per-line estimate */ } }
    { int w;
      for (w = 0; w < 250 && g_crash_dumping; w++) usleep(1000); }
    va_start(ap, fmt);
    n = xl_format(b, (int)sizeof b, fmt, ap); /* R985: NO vsnprintf - the
     * crash class dies in vsnprintf internals (8 cycles of identical
     * frames); the receipt path now never enters libc print machinery.
     * The smasher (still unnamed) now has no canary to trip here. */
    va_end(ap);
    if (n > 0) {
        if ((size_t)n >= sizeof b) n = (int)sizeof b - 1;
        if (write(2, b, (size_t)n) != (ssize_t)n) { /* drop on short write - never block the guest */ }
    }
    g_r977_in = 0;
}

void xenolift_receipt(const char *fmt, ...)
{   /* R988 (b8-c99, WARDEN/MANAGER - THE FPRINTF KILL): c99's =EMITAUDIT= named the
     * 10-cycle exit-134 killer - TWO fprintf(stderr,...) calls in the R758 field-cb
     * splice (patches/r750_ins.c) injected into disc1.c, running INSIDE translated
     * guest code (crash frames attribute them to real_main; macreport shows
     * __stack_chk_fail <- __xvprintf <- vfprintf_l <- "fprintf"). r861_out is
     * static so the splice can't call it; THIS non-static wrapper is the disc1.c-
     * visible door: xl_format + write(2), NO libc print machinery reachable
     * from the guest binary. The class loses its last entry point. */
    char b[2048]; va_list ap; int n;
    va_start(ap, fmt);
    n = xl_format(b, (int)sizeof b, fmt, ap);
    va_end(ap);
    if (n > 0) {
        if ((size_t)n >= sizeof b) n = (int)sizeof b - 1;
        if (write(2, b, (size_t)n) != (ssize_t)n) { }
    }
}

static unsigned xl_spu_writes, xl_mdec_writes, xl_spu_dma_bytes, xl_gpu_writes, xl_gte_cmds;
static uint32_t spu_wr_pos; /* R138: file-scope so the halt dump can report the upload map */

uint8_t xenolift_mem[XENOLIFT_RAM_SIZE + XENOLIFT_IO_SIZE];
uint32_t g_sectors_loaded = 0; /* R221: stream-alive signal for the watchdog */
uint32_t r[32];
volatile int g_guest_depth = 0;
/* R918 (b8-c22, WARDEN - GUEST-CONTEXT RELEASE DEFERRAL, canary-named):
 * c22's canary receipts: MAIN-thread canary tripped at depth=1 with the
 * smashed fn RESOLVED to cd_sched_poll_release+0x0 - its frame was live
 * INSIDE a guest step (called from the 0x1F801800 status-poll path,
 * R400) when the step above it ran on torn/interleaved state and the
 * frame canary died. R350 banked this class: never run host machinery
 * with big frames + dispatch chains from INSIDE a guest step. Fix
 * structurally: the status-poll path only REQUESTS the release; the
 * dispatch boundary (depth back to 0, anchor at a clean seam) executes
 * it. The alarm drain already runs there - same boundary, same cadence. */
uint32_t g_r1246_fetch = 0; /* R1246 c103: >0 while the LegacyCdSectorFetch
 * command-sequence camera is armed (set at 80042AA8 dispatch, decays after
 * its print budget) */
uint32_t g_r1246_wprints = 0; /* R1246: register-write prints consumed */
uint32_t g_r1194_wedge_streak = 0; /* R1194 c483: exported R967 wedge streak (set in on_alarm) so the read hook can camera the wedge spin */
uint32_t g_r1350_conv_refill = 0; /* R1350 (c326): >0 = the watcher serve asks the
 * tick's stuck-INT conversion block to refill its budget. The c325 receipts:
 * the conversion ran on the STALE 1-byte FIFO era until the static 100000
 * budget died (~L25092), the serve then primed the CORRECT 3-byte answer -
 * which never got its conversion pass. One refill unit set per serve fire. */
uint32_t g_r1351_genuine_answer = 0; /* R1351 (c328): set by the serve after priming a
 * REAL ISO answer + arming INT3. The c327 receipts: under firstfault-stop every
 * pair dispatch site is forge-blocked, so a genuine armed answer is undeliverable
 * by design - the BIOS-style pair on a REAL armed response is the native
 * IRQ-context mechanism, not a forged completion. One-shot, cleared after use. */

/* R1195 (c484, Jos spec): PUMP LIVENESS COUNTERS - absent prints are NOT
 * absent execution (the [task] kick prints are cadence-gated: n<=3 ||
 * rv-changed || n%20000 - so "4 log matches" was never 4 executions and
 * "no more prints" was never "no more kicks"). Every counter below is a
 * plain increment at the exact entry/exit sites, independent of all
 * print gates; the R967 wedge print reports them so an outstanding
 * notifier call or a recursive kick is RECEIPTED, not inferred. */
uint32_t g_r1195_kick_enter=0, g_r1195_kick_exit=0, g_r1195_kick_active=0;
uint32_t g_r1195_notif_enter=0, g_r1195_notif_exit=0;
volatile uint64_t g_r1199_intr_pc = 0; /* R1199 c497: PC the SIGALRM interrupted (uc_mcontext, async-safe plain store). Distinguishes handler execution (on_alarm) from the code the alarm interrupted - Jos c497: the c490 backtrace resolving to on_alarm+main is the camera's own chain, not the interrupted context. */
volatile uint32_t g_r1199_intr_n = 0;
volatile uint64_t g_r1199_ring[8] = {0}; /* last 8 DISTINCT interrupted PCs */
volatile uint32_t g_r1199_ring_i = 0;
volatile uint32_t g_r1199_on_anchor = 0; /* R1200: 1 = the alarm interrupted the anchor (guest big-stack thread); 0 = some other thread (e.g. the true main parked in pthread_join) - Jos: a PC in pthread_join locates the interrupted thread only; identity must ride with the receipt */
static uint64_t g_r1199_last_pc = 0;
uint32_t g_r1195_r8_hits=0, g_r1195_r16_hits=0, g_r1195_r32_hits=0; /* hook-hit counts, BEFORE any early return, separate from printed samples */
uint32_t g_r1195_host_read=0; /* R1196: >0 while a HOST camera is making its own mem_read calls - wedgespin receipts and the pollkick are gated on this so camera self-noise can never masquerade as the spin's poll reads (c485: the R967/fldfrz2/R633 cameras read the very cells the camera watches; the 0x77448 receipt was the R967 camera's own read of that offset) */
uint32_t g_r1196_a22c_guest=0, g_r1196_a22c_host=0, g_r1196_a22c_hbblk=0, g_r1196_a22c_th=0; /* R1197 (Jos c489, supersedes c488 form): A22C counters are ORIGIN x OUTCOME, counted INDEPENDENTLY - a guest read can also be hb_active-blocked, so guest=0 alone must never be read as "the spin avoids A22C". ORIGIN: guest(host_read==0) / host-camera. OUTCOME: blocked(hb_active at read) / svc-entry(threshold crossed, kick entered) / svc-return(kick returned, registers restored). r32 hit counters WRAP at 2^32 - use wrap-aware deltas, never raw magnitudes. TELEMETRY ONLY - never gates behavior. */
uint32_t g_r1196_svc_ret=0; /* R1197: pollkick service RETURN count (entry is g_r1196_a22c_th; entry!=return receipts a serviced kick that never came back - the c486 outstanding-kick shape at the pollkick level) */
static uint8_t g_r1210_movie_done = 0; /* R1210: set at the R958 movie-complete receipt - post-movie era marker; gates the wl h2 fallback (c25 receipts) */
volatile int g_r918_poll_requested = 0; /* R885: >0 = the anchor is INSIDE a xenolift_dispatch guest step. on_alarm must not run its drain/dispatch machinery re-entrantly in that window (c480: alarm drain at pending=3 interrupted a CD register read mid-step -> torn state -> host SIGSEGV 0x09370D90 + wild writes; the R350 lesson class, finally enforced structurally). */
/* R1258 (Jos c115 direction): saved LZSS entry args. Live registers inside
 * the decode loop no longer hold the original arguments; the sub-arena
 * store catcher prints these SAVED values + the authorized-range test
 * (ownership: store inside [dst, dst+expanded) = payload the decompress
 * owned; outside = wild write). */
uint32_t xenolift_r1258_lz_r4, xenolift_r1258_lz_r5, xenolift_r1258_lz_ep0;
uint32_t xenolift_r1258_lz_epoch;
/* R1259 (Jos c117 #5): ring of recent [hand] allocations (block v0 + want)
 * - the store-band ownership test checks the allocation that AUTHORIZED the
 * output range, not mere header-range membership. */
uint32_t xenolift_r1259_hand_blk[16]; uint32_t xenolift_r1259_hand_want[16];
uint32_t xenolift_r1259_hand_i;
pthread_t g_main_tid; /* R880: the anchor thread id - guest dispatches may only run here (def early, set at real_main entry) */
uint32_t hi, lo;

/* ---- the fake hardware district ----
 * Writes are stored and read back; the first touch of each register is
 * logged so the trace shows which chips the game talks to. A few
 * registers get real behavior so polls don't hang: timers tick, the
 * GPU reports "ready", the interrupt controller reports "nothing pending". */

static uint32_t g_tick = 0;
static uint32_t g_poll_imask = 0, g_poll_t2 = 0, g_poll_gpu = 0, g_poll_sio = 0, g_poll_istat = 0;
static long g_sio_acc_menu; /* R377: SIO (controller port) accesses since last menu frame — decisive direct-poll test */


static void io_log(uint32_t p, int is_write, uint32_t v)
{
    /* CDROM + SIO: log EVERY access. The device protocol dialogs (card
     * detect, pad poll, CD commands) are what we need to see now, and
     * the first-touch dedup hides them after the first SPU flood. */
    if (p >= 0x1F801040u && p <= 0x1F801054u)
        g_sio_acc_menu++; /* R377: count every controller-port access */
    if ((p >= 0x1F801040u && p <= 0x1F801054u) || (p >= 0x1F801800u && p <= 0x1F801803u)) {
        /* R357/L15: per-access loggers MUST be capped — cycle 105's WaitForCdData
         * poll loop wrote 20MB+ and the SIGALRM watchdog never parked (deadlock
         * class: storm fprintf vs signal-unsafe park). First 24, then sparse. */
        static long dn = 0;
        long n = ++dn;
        if (n <= 24 || (n % 50000) == 0) {
            r861_out(is_write ? "[dev] write 0x%08X = 0x%08X\n"
                                     : "[dev] read  0x%08X = 0x%08X (n=%ld)\n", p, v, n);
        }
        return;
    }
    /* SPU: throttled always-log. The game's sound task runs from the
     * periodic callback ~60 times/sec; we want the init dialogue AND
     * the steady-state register the stuck task polls, without flooding
     * the digest: first 60 accesses, then every 20000th. */
    if (p >= 0x1F801C00u && p <= 0x1F801DFFu) {
        static long sn = 0;
        long n = ++sn;
        if (n <= 60 || n % 20000 == 0) {
            r861_out(is_write ? "[spu] #%ld write 0x%08X = 0x%08X\n"
                                     : "[spu] #%ld read  0x%08X = 0x%08X\n", n, p, v);
        }
        return;
    }
    /* R1028 TAINT CAMERA: c176 receipts proved kernel cell 0x800568C8
     * holds the healthy pointer 0x80056888 (boot fn 0x80019524) while a
     * downstream writer TRUNCATES it to 0x00056888 (top byte 0x80 lost)
     * and pushes it to GPU port 0x1F801810 plus into r4 at the
     * 0x800471A4 crash. Same class as 0x0059FAEC (c173). This camera
     * names the truncating guest fn: any GPU-port write whose value has
     * the truncated-pointer shape (top byte zero, >= 0x00010000) gets a
     * receipt with cur_fn. Legit packet words may appear alongside; the
     * caller fn separates them. */
    if (is_write && v >= 0x00010000u && v < 0x01000000u) {
        static int tc_n28;
        if (tc_n28 < 12) {
            tc_n28++;
            extern volatile uint32_t xenolift_cur_fn;
            r861_out("[taintcam] R1028 truncated-pointer write port=%08X val=%08X cur_fn=%08X (%d/12)\n", p, v, xenolift_cur_fn, tc_n28);
        }
    }
    static uint8_t seen[XENOLIFT_IO_SIZE / 4];
    static long n = 0;
    uint32_t i = (p - XENOLIFT_IO_BASE) >> 2;
    if (seen[i]) {
        return;
    }
    seen[i] = 1;
    if (n++ < 80) {
        if (is_write) {
            r861_out("[io] write 0x%08X = 0x%08X\n", p, v);
        } else {
            r861_out("[io] read  0x%08X\n", p);
        }
    } else if (n == 81) {
        r861_out("[io] (further registers not logged)\n");
    }
}

/* ---- GPU model (values from the nocash PSXSPX GPU chapter) ----
 * After GP1(00h) reset the status register reads 14802000h: write FIFO
 * empty (bit 28), ready to receive commands (bit 26), display disabled
 * (bit 23), interlace field (bit 13). GP1(10h) GetGPUInfo latches a
 * response word for the next GPUREAD; sub-selector 07h = "GPU type 2",
 * the retail 208-pin chip. */
static uint32_t gpu_stat = 0x14802000u;
static uint32_t gpu_read_latch = 0;

/* ---- GPU frame capture (R125) ----
 * PS1 VRAM is not CPU-addressable: pixels arrive only as GP0 command
 * streams written to 0x1F801810. Command 0xA0 (DataToVRAM) carries
 * TIM/pixel blits — the loading and title screens. Capture them into
 * a 1024x512x16bpp model; the watchdog dumps it and the host renders
 * screen.png cropped to the GP1 display area. Draw/CLUT/poly packets
 * are counted, not interpreted (first-iteration: blits only). */
/* R694 SINGLE CANVAS: runtime's gpu_vram is now an alias of the HLE
 * interpreter's g_vram. c265 proof: vram_nonzero=0/8192 while the menu's
 * font/draw functions executed — the R135 full GP0 interpreter painted
 * g_vram, but the live viewer + screen sampler photographed the old
 * dual-feed buffer (only the rare 0xA0 image-load path wrote it). The
 * game was drawing all along; we were watching an empty room. */
uint16_t *const gpu_vram = &g_vram[0][0];
static uint32_t gpu_blit_total, gpu_gp0_other, gpu_gp0_state;
extern volatile uint32_t xenolift_cur_fn; /* R696: fault-context site naming */

/* R1238 (c81, Jos corrections - INITIALIZATION HISTORY COVERAGE): absence of
 * word-hook receipts is NOT proof initialization never ran - byte/halfword
 * stores, bulk copies (pristine restores, CD deliveries), aliases and log
 * suppression all evade the 32-bit hook camera. Band audit = the state-6 heap
 * region 0x80077400..0x80078000 (chain words 77450..77468, heap cell 77C5C,
 * plus freelist head cells 59320/59324 in the word-watch list). */
static int g_r1239_init_pending; static uint32_t g_r1239_init_sp; /* R1239: 80031A30 completion latch */
static uint32_t r1238_cell(uint32_t a) { uint32_t v; memcpy(&v, xenolift_mem + (a - 0x80000000u), 4); return v; }
static void r1238_band_bulk(const char *kind)
{
    static int bn;
    if (bn >= 12) { static int ct; if (!ct) { ct = 1;
        r861_out("[bandhist] R1238 bulk camera CAP (12) reached - further bulk band copies not logged\n"); } return; }
    bn++;
    r861_out("[bandhist] R1238 %s | cells: 77450=%08X 77454=%08X 77458=%08X 7745C=%08X 77460=%08X 77464=%08X 77468=%08X 77C5C=%08X head59320=%08X\n",
            kind,
            r1238_cell(0x80077450u), r1238_cell(0x80077454u), r1238_cell(0x80077458u),
            r1238_cell(0x8007745Cu), r1238_cell(0x80077460u), r1238_cell(0x80077464u),
            r1238_cell(0x80077468u), r1238_cell(0x80077C5Cu), r1238_cell(0x80059320u));
}
/* R1189 (c471): forward declarations for the hook-serviced kick - the
 * vblank-counter read hook (xenolift_mem_read32) precedes both the
 * kick's definition and hb_active's definition in this file. */
static void xenolift_kick(void);
static int hb_active; /* tentative definition; the real one lives with the heartbeat block */
uint32_t xenolift_sw_line; /* R1112: last SW caller line in disc1.c (set by the SW macro) */
uint32_t xenolift_sw_width; /* R1197 (Jos c493): call-scoped store width (4=SW,2=SH,1=SB); RESTORED after each macro call */
int xenolift_sw_active; /* R1197: 1 ONLY while inside an SW/SH/SB macro call - a write with sw_active==0 is a DIRECT RUNTIME write: label runtime/unknown, never misattribute */
uint32_t xenolift_sw_line_last; /* R1197 (Jos c494): persistent last store line (R1112 semantics retained outside the call window) */
/* R1197 (Jos c495) ATTRIBUTION TUPLE, per in-flight write: captured at hook ENTRY
 * (line+width+active together, BEFORE any helper or callback can touch them),
 * held in g_r1197_t_* across the whole write, restored on EVERY exit - the
 * write fns are wrapped in entry/exit shims so suppressed-write and early-return
 * paths restore too. A genuine nested guest macro installs its OWN tuple by
 * entering its own wrapper (save/set/clear/call/restore); a direct runtime
 * write stays un-attributed. The commit receipt uses the captured tuple only -
 * mid-flight kicks and nested stores can never taint an outer write's
 * attribution. */
static uint32_t g_r1197_t_line, g_r1197_t_width;
static int g_r1197_t_active;
/* R1197 (Jos c494) NESTED-INHERITANCE RULE: each write hook CAPTURES sw_active at entry into a local and CLEARS the global for its own duration: (a) macro-invoked writes receipt MACRO-ATTRIBUTED from their own call-site metadata; (b) a runtime write NESTED inside a guest write hook enters with sw_active==0 (outer hook cleared it) - labeled runtime/unknown, never auto-labeled a guest store; (c) a GUEST store dispatched inside a kick during hook processing sets sw_active=1 via its own macro and is attributed correctly. */
static uint32_t gpu_dma2_starts;  /* R694: how many GPU DMA sends the game issued */
static uint32_t gpu_blit_x, gpu_blit_y, gpu_blit_w, gpu_blit_h, gpu_blit_left;
static uint16_t gpu_disp_x, gpu_disp_y;         /* GP1(0x05) display area */
static uint16_t gpu_disp_w = 320, gpu_disp_h = 240; /* GP1(0x08) mode */
static uint32_t gpu_draw_ofx, gpu_draw_ofy; /* R1230 (c69, Jos correction): GP0 0xE5
 * drawing offset, SIGNED 11-bit X/Y. 0xE3=draw-area top-left, 0xE4=bottom-
 * right - NOT offsets. e5_seen: zero-init is NOT evidence of a guest command;
 * only a set flag proves the guest issued 0xE5. */
static uint32_t gpu_draw_e5_seen;
static int gpu_blit_log_budget = 24;

static void gpu_gp0(uint32_t v)
{
    switch (gpu_gp0_state) {
    case 1: /* DataToVRAM: X|Y */
        gpu_blit_x = v & 0x3FFu; gpu_blit_y = (v >> 16) & 0x1FFu;
        gpu_gp0_state = 2; return;
    case 2: { /* W|H (W in halfwords; 0 wraps to 1024) */
        gpu_blit_w = v & 0x3FFu; gpu_blit_h = (v >> 16) & 0x1FFu;
        if (!gpu_blit_w) gpu_blit_w = 1024u;
        if (!gpu_blit_h) gpu_blit_h = 512u;
        gpu_blit_left = gpu_blit_w * gpu_blit_h;
        gpu_blit_total++;
        if (gpu_blit_log_budget-- > 0)
            r861_out("[gpu] blit %ux%u @(%u,%u)\n",
                    gpu_blit_w, gpu_blit_h, gpu_blit_x, gpu_blit_y);
        gpu_gp0_state = gpu_blit_left ? 3 : 0;
        return;
    }
    case 3: { /* pixel words: 2 halfwords each, row-major in the rect */
        for (int half = 0; half < 2 && gpu_blit_left > 0; half++, gpu_blit_left--) {
            uint32_t px = half ? (v >> 16) : (v & 0xFFFFu);
            uint32_t done = gpu_blit_w * gpu_blit_h - gpu_blit_left;
            uint32_t dx = gpu_blit_x + done % gpu_blit_w;
            uint32_t dy = gpu_blit_y + done / gpu_blit_w;
            if (dx < 1024u && dy < 512u)
                gpu_vram[dy * 1024u + dx] = (uint16_t)px;
        }
        if (!gpu_blit_left) gpu_gp0_state = 0;
        return;
    }
    default: break;
    }
    uint32_t cmd = v >> 24;
    /* R1230 (c69, Jos correction): GP0 0xE5 = drawing offset (OFX/OFY),
     * SIGNED 11-bit. 0xE3=draw-area top-left, 0xE4=bottom-right (corners,
     * not offsets). Capture is OBSERVATIONAL ONLY - no rendering behavior.
     * This default branch runs only when the state machine is idle, so it
     * fires on ACCEPTED COMMAND HEADERS only, never payload words. Every
     * GP0 path dual-feeds gpu_gp0 (direct port writes at 0x1F801810 and
     * both DMA list walkers), so the guest's 0xE5 is seen regardless of
     * path. 0xE5 words previously fell into gpu_gp0_other (R694 census);
     * they now count as what they are. Note: the GP1(0xE3) QUERY handler
     * returning zero (line ~594) proves nothing either way about decoding -
     * query completeness is independent of command decoding. */
    if (cmd == 0xE5u) {
        gpu_draw_ofx = (v & 0x7FFu) | ((v & 0x400u) ? 0xFFFFF800u : 0u);
        gpu_draw_ofy = ((v >> 11) & 0x7FFu) | ((v & 0x200000u) ? 0xFFFFF800u : 0u);
        gpu_draw_e5_seen = 1u;
    } else if (cmd == 0xA0u) { /* DataToVRAM */
        gpu_gp0_state = 1;
    } else {
        gpu_gp0_other++;
    }
}

static uint32_t gpu_regnz(uint32_t rx, uint32_t ry)
{
    uint32_t n = 0;
    for (uint32_t y = ry; y < ry + 240u; y += 4)
        for (uint32_t x = rx; x < rx + 320u; x += 4)
            if (gpu_vram[y * 1024u + x] != 0u) n++;
    return n;
}
static uint32_t gpu_snap_count; /* R126 live-view counter (hoisted: used below) */

static void gpu_dump_capture(void)
{    { /* R138: full SPU RAM snapshot for memory-map verification.
       * gpu_dump_capture runs at BOTH halt paths, so the snapshot
       * survives any exit. */
        FILE *sf = fopen("spu_ram.bin", "wb");
        if (sf) {
            fwrite(g_spu.ram, 1, sizeof(g_spu.ram), sf);
            fclose(sf);
        }
        r861_out("[hle-spu] ram snapshot %zuB -> spu_ram.bin | dma total %uB last pos 0x%X\n",
                sizeof(g_spu.ram), xl_spu_dma_bytes, spu_wr_pos);
    }

    FILE *vf = fopen("vram.bin", "wb");
    if (vf) { fwrite(gpu_vram, 2, 1024u * 512u, vf); fclose(vf); }
    { /* R905: async-safe meta writer - no FILE* machinery (c446 lesson
       * class; the c504-cycle macreport showed __vfprintf canary smash on
       * thread 1 - eliminate every FILE* print left on hot paths) */
        char _m[96]; int _n = snprintf(_m, sizeof _m, "%u %u %u %u\n",
                gpu_disp_x, gpu_disp_y, gpu_disp_w, gpu_disp_h);
        int _fd = open("vram.meta", O_WRONLY|O_CREAT|O_TRUNC, 0644);
        if (_fd >= 0) { if (write(_fd, _m, (size_t)(_n > 0 ? _n : 0)) < 0) {} close(_fd); }
    }
    r861_out("[gpu] capture: %u blits, %u other cmds, %u live snapshots, display %ux%u @(%u,%u) -> vram.bin\n",
            gpu_blit_total, gpu_gp0_other, gpu_snap_count, gpu_disp_w,
            gpu_disp_h, gpu_disp_x, gpu_disp_y);
}

/* R126: live framebuffer — snapshot the VRAM model at ~4fps (wall
 * clock rate-limited) so the host Terminal viewer (xenoview.py) can
 * render the boot as it happens. Atomic via tmp+rename; the meta file
 * rides along so the viewer crops to the display area. */
static void r1137_cb_restore(const char *why);

/* R996 (b8-c107, WARDEN): victim-removal for the exit-134 abort class.
 * Three macreports (c103/c105/c107) all die at __stack_chk_fail <- time(),
 * with c107's KERN_INVALID_ADDRESS = 0x80019528 — a GUEST code address
 * smashed over libc time()'s canary slot. Our own code is canary-free
 * (-fno-stack-protector), so libc's frame is the only detector; time() sat
 * in the hot-path camera args (hundreds of calls/sec, xenolift_trace ->
 * r861_out). Swap the victim: wall seconds via clock_gettime(CLOCK_REALTIME)
 * (libsystem_kernel syscall shim — no libsystem_c canary frame). VERDICT
 * SHIP, not a claimed root fix: if the abort dies with the victim, the
 * class was the camera/libc collision; if it survives, the next macreport
 * names the next victim frame and the hunt continues with it. */
static time_t xl_wall(void)
{
    struct timespec ts;
    clock_gettime(CLOCK_REALTIME, &ts);
    return (time_t)ts.tv_sec;
}
static void gpu_screen_receipts(void)
{
    /* R1228 (c67): ENTRY COUNTER - the contradiction camera. c67 receipts:
     * [halt] polls t2=32640 gpu=32687 (both sampler rails ran tens of
     * thousands of times), evt heartbeat receipts present, yet SCREEN-CT=1
     * for the whole 55s run. Code-model vs receipts contradict; this
     * entry counter (first 16 + every 1000th, before ANY gate) receipts
     * whether THIS function is called at all. Entries-without-samples =
     * the 4s/12-cap gate is the bug; no-entries = the call sites never
     * reached the function in the shipped build. First print also names
     * the wall-clock so a frozen-clock theory is receipted dead/alive. */
    {
        static uint32_t r1228_n;
        r1228_n++;
        if (r1228_n <= 16u || (r1228_n % 1000u) == 0u) {
            r861_out("[scr] R1228 gpu_screen_receipts entry #%u wall=%lld\n",
                    r1228_n, (long long)xl_wall());
        }
    }
    /* R1225 (c64): EXTRACTED from gpu_snapshot (was the R692 sample block).
     * c64 receipts: the sampler only fired when gpu_snapshot was called,
     * and its callers (GPUSTAT read path; the R1224 kick-heartbeat call)
     * are all ERA-DEPENDENT - the game abandons GPUSTAT reads after boot,
     * and the kick pump stops once the game stops polling A22C - so the
     * c64 log (52s life, no state-6) held ONE screen receipt again. This
     * function is ASYNC-SIGNAL-SAFE (static gpu_vram reads, counter reads,
     * r861_out = write(2); NO fopen/vram_live.bin dump - that stays in
     * gpu_snapshot) so on_alarm can call it on a 4s cadence in EVERY era
     * (boot, menu, movie, field, crash-era). */
        static uint32_t s_r692_n; static time_t s_r693_last;
        time_t s_r693_now = xl_wall();
        if (s_r692_n < 12u && (s_r693_last == 0 || (s_r693_now - s_r693_last) >= 4)) {
            s_r693_last = s_r693_now;
            s_r692_n++;
            gpu_cls_report(); /* R939: periodic GPU command-class census (abort-proof pixels-door camera) */
            uint32_t dx = gpu_disp_x, dy = gpu_disp_y, dw = gpu_disp_w, dh = gpu_disp_h;
            if (dw > 1024u) dw = 1024u; if (dh > 512u) dh = 512u;
            if (dx + dw > 1024u) dx = (1024u - dw) & ~1u;
            if (dy + dh > 512u) dy = (512u - dh) & ~1u;
            uint32_t nonblank = 0, tot = 0;
            { uint32_t _vn = 0;
              for (uint32_t _vy = 0; _vy < 512u; _vy += 8u)
                  for (uint32_t _vx = 0; _vx < 1024u; _vx += 8u)
                      if (gpu_vram[_vy * 1024u + _vx] != 0u) _vn++;
              r861_out("[screen] R693 vram_nonzero=%u/8192 ", _vn);
            }
            {   /* R736 [screen]: c310 sent 6276 drawing lists (first-ever DMA2
                 * activity) but the 4-region sampler saw zero - census ALL VRAM
                 * in 16 row-bands (32 rows each, 1/16 col stride) so the digest
                 * names where the paint landed. */
                r861_out("[screen] R736 band census nz/32rows:");
                for (uint32_t _b = 0; _b < 16u; _b++) {
                    uint32_t _bn = 0;
                    for (uint32_t _vy = _b * 32u; _vy < _b * 32u + 32u; _vy += 2u)
                        for (uint32_t _vx = 0; _vx < 1024u; _vx += 16u)
                            if (gpu_vram[_vy * 1024u + _vx] != 0u) _bn++;
                    r861_out(" %u", _bn);
                }
                r861_out("\n");
            }
            r861_out("[gpu] R694 live: gp0_words=%lu blits=%u other=%u dma2_sends=%u (0 dma2 = the game never sent a drawing list)\n", (unsigned long)xl_gpu_writes, gpu_blit_total, gpu_gp0_other, gpu_dma2_starts);
            {
                /* R695: the game double-buffers; the configured display window is
                 * sometimes the wrong one (c266: pixels exist, disp@(0,240) empty).
                 * Census the 4 classic framebuffer regions so the digest names
                 * where the picture actually lives. */
                static const uint32_t rq[4][2] = {{0,0},{0,240},{320,0},{320,240}};
                uint32_t rr;
                r861_out("[screen] R695 regions A(0,0)=%u B(0,240)=%u C(320,0)=%u D(320,240)=%u (nonzero per 960-stride samples):",
                    gpu_regnz(0,0), gpu_regnz(0,240), gpu_regnz(320,0), gpu_regnz(320,240)); (void)rq; (void)rr;
            }
            r861_out("[screen] R693 snap#%u disp=%ux%u@(%u,%u) grid:",
                s_r692_n, dw, dh, dx, dy);
            for (uint32_t gy = 0; gy < 8u; gy++) {
                r861_out(" |");
                for (uint32_t gx = 0; gx < 8u; gx++) {
                    uint32_t acc = 0, cnt = 0;
                    uint32_t y0 = dy + (dh * gy) / 8u, y1 = dy + (dh * (gy + 1u)) / 8u;
                    uint32_t x0 = dx + (dw * gx) / 8u, x1 = dx + (dw * (gx + 1u)) / 8u;
                    if (y1 <= y0) y1 = y0 + 1u; if (x1 <= x0) x1 = x0 + 1u;
                    for (uint32_t yy = y0; yy < y1; yy += 4u)
                        for (uint32_t xx = x0; xx < x1; xx += 4u) {
                            uint16_t v = gpu_vram[yy * 1024u + xx];
                            uint32_t r = v & 31u, g = (v >> 5) & 31u, b = (v >> 10) & 31u;
                            uint32_t lum = (r + 2u * g + b) >> 2; /* 0..31 */
                            acc += lum; cnt++;
                            if (lum > 1u) nonblank++;
                            tot++;
                        }
                    r861_out("%X", (cnt ? (acc / cnt) >> 1 : 0u)); /* 0..F */
                }
            }
            r861_out("| nonblank=%u%%\n", tot ? (nonblank * 100u) / tot : 0u);
        }
}

static void gpu_snapshot(void)
{
    static uint32_t last_ms;
    struct timespec ts;
    clock_gettime(CLOCK_MONOTONIC, &ts);
    uint32_t ms = (uint32_t)(ts.tv_sec * 1000u + ts.tv_nsec / 1000000u);
    if (ms - last_ms < 250u) return; /* ~4 fps */
    last_ms = ms;
    FILE *f = fopen("vram_live.tmp", "wb");
    if (!f) return;
    fwrite(gpu_vram, 2, 1024u * 512u, f);
    fclose(f);
    rename("vram_live.tmp", "vram_live.bin");
    { /* R905: async-safe live meta writer (c446 lesson class) */
        char _m[96]; int _n = snprintf(_m, sizeof _m, "%u %u %u %u\n",
                gpu_disp_x, gpu_disp_y, gpu_disp_w, gpu_disp_h);
        int _fd = open("vram_live.meta.tmp", O_WRONLY|O_CREAT|O_TRUNC, 0644);
        if (_fd >= 0) { if (write(_fd, _m, (size_t)(_n > 0 ? _n : 0)) < 0) {} close(_fd); }
        rename("vram_live.meta.tmp", "vram_live.meta");
    }
    gpu_snap_count++;
    /* R692 [screen] PLAYTEST EVIDENCE (Jos directive Sep 14: "we aren't testing
     * gameplay" — every digest now ships a coarse picture of what the player
     * sees): every ~5 wall-seconds sample the CONFIGURED DISPLAY AREA, print
     * an 8x8 luminance grid (0=black..F=bright) + nonblank coverage %. This
     * turns each cycle into a visual regression test — menu visible, wipe
     * started, field painted — not just receipts. Capped 6 samples. */
    gpu_screen_receipts(); /* R1225: extracted; on_alarm calls it too */
}

static void gpu_gp1(uint32_t v)
{
    uint32_t cmd = v >> 24;
    uint32_t param = v & 0x00FFFFFFu;
    switch (cmd) {
    case 0x00: /* reset GPU */
        gpu_stat = 0x14802000u;
        break;
    case 0x02: /* acknowledge GPU IRQ */
        gpu_stat &= ~(1u << 24);
        break;
    case 0x03: /* display enable */
        if (param & 1u) {
            gpu_stat |= (1u << 23);
        } else {
            gpu_stat &= ~(1u << 23);
        }
        { /* R1230 (c69): receipt the guest's display commands (Jos c68:
         * don't force the display origin; first receipt what it does) */
            static uint32_t r1230_en_n;
            if (r1230_en_n < 24u) {
                r1230_en_n++;
                /* R1231 (c70): label inversion fixed - psx-spx GP1(03h):
                 * param bit0 0=display ON, 1=OFF (c70 receipted "OFF" for
                 * param=0 while dis-bit cleared = enabled, the bit was the
                 * authoritative field). */
                r861_out("[gpucmd] R1231 GP1(03) display %s dis-bit=%u(1=disabled) disp=(%u,%u %ux%u)\n",
                        (param & 1u) ? "OFF" : "ON", (unsigned)((gpu_stat >> 23) & 1u),
                        gpu_disp_x, gpu_disp_y, gpu_disp_w, gpu_disp_h);
            }
        }
        break;
    case 0x04: /* DMA direction */
        gpu_stat = (gpu_stat & ~(3u << 29)) | ((param & 3u) << 29);
        if (param & 3u) {
            gpu_stat |= (1u << 25); /* DRQ */
        } else {
            gpu_stat &= ~(1u << 25);
        }
        break;
    case 0x05: /* R125: display area start — the visible screen origin */
        gpu_disp_x = param & 0x3FFu;
        gpu_disp_y = (param >> 10) & 0x1FFu;
        { /* R1230 (c69): display-area command receipt */
            static uint32_t r1230_da_n;
            if (r1230_da_n < 24u) {
                r1230_da_n++;
                r861_out("[gpucmd] R1230 GP1(05) disp area -> (%u,%u) %ux%u dis=%u(1=disabled)\n",
                        gpu_disp_x, gpu_disp_y, gpu_disp_w, gpu_disp_h,
                        (unsigned)((gpu_stat >> 23) & 1u));
            }
        }
        break;
    case 0x08: { /* R125: display mode — crop size for screen.png */
        static const uint16_t hres[4] = {256, 320, 512, 640};
        gpu_disp_w = hres[(param >> 4) & 3u];
        gpu_disp_h = (param & 0x04u) ? 480u : 240u;
        break;
    }
    default:
        if (cmd >= 0x10 && cmd <= 0x1F) { /* Get GPU Info */
            switch (param & 0x0Fu) {
            case 0x02: gpu_read_latch = 0; break; /* texture window */
            case 0x03: gpu_read_latch = 0; break; /* draw area top left */
            case 0x04: gpu_read_latch = 0; break; /* draw area bottom right */
            case 0x05: gpu_read_latch = 0; break; /* draw offset */
            case 0x07: gpu_read_latch = 2; break; /* GPU type: retail 208-pin */
            case 0x08: gpu_read_latch = 0; break;
            default: break; /* 00,01,06,09-0Fh: latch unchanged */
            }
        }
        break;
    }
}

/* registers with real behavior */
static void lazy_event_check(void);

static int disc_read_lba(uint32_t lba, void *dst);

static void r1346_serve(void);

/* ---- CDROM controller model (0x1F801800-0x1F801803) ----
 * The kernel dialogs with the disc drive: select register bank via the
 * index (write 0x1F801800), send commands (write 0x1F801801 at index 0:
 * 01h GetStat, 0Ah Init, ...), then poll the interrupt state (index 1,
 * 0x1F801802/803) and pop response bytes (index 1, 0x1F801801) while
 * status bit 5 says "response FIFO not empty". We have the disc image
 * mounted, so eventually raw sector reads can be served here too; for
 * now commands get canned "drive ready" (INT3, status 02h) responses. */
extern int g_rspop_win;
uint32_t g_walk_max = 0; long g_walk_last_t = -100;
static uint32_t g_ack_starve = 0; /* R561: acks since last heartbeat tick — the c129 starve meter (top-of-file: used at line ~695, declared before first use) */
static volatile int g_park_stage = 0; /* R365: park-dump stage counter */
static volatile int g_in_park = 0;   /* R365: park backstop latch */ /* R317: defined next to g_vb_ns */
static int lad2_boot_ok = 60; /* R319: budget for boot ladder cmds (0x13 always dispatches) */
static uint8_t cd_index, cd_pending, cd_resp[16], cd_resp_n, cd_resp_pos;
static void evt_deliver_class(uint32_t cls, uint32_t spec);
unsigned xenolift_spu_dma_count;
static void cd_restore_pend(void); /* R308: fwd — spin-conv sites precede the def */
extern uint32_t xenolift_boot_epoch; /* R1222 fwd (defined at the R693 bump site
 * ~line 5126; needed before r825_frz_watch - the c48 same-TU order lesson) */
static void cd_force_deliver_int1(const char *why); /* R258 fwd (R1219 door call site precedes def) */
static uint8_t cd_scheduled;  /* response scheduled, not yet delivered */
static uint32_t cd_sched_seq;  /* R1291v3: per-response sequence ID for SET/deliver/CLEAR correlation */
static uint32_t cd_x_lba, cd_x_dest, cd_x_len, cd_x_seq; /* R1312/R1314 (c211/c213/c214, Jos transfer-identity order): the ACTIVE READ STREAM record - armed ONLY at ReadN(06)/ReadS(1B) with dest+len stamped at issue, PASSIVE through status commands */
static uint32_t cd_x_gst, cd_x_arm_t; static int cd_x_live; static int cd_x_pr;
static uint32_t cd_pos_lba, cd_pos_t; /* R1314 (c213/c214, Jos three-identity order): POSITIONING INTENT (Setloc) - never a transfer, never serve authority */
