                    r680_n, (long)(xl_wall() - g_boot_wall_t0),
                    xenolift_mem_read32(0x800592C0u), xenolift_mem_read32(0x8005FAECu));
            r[31] = 0; hi = lo = 0;
            {   /* R724: fault-site restarts get the SAME console-faithful
                 * hygiene as the atexit-door relay (c295 proof: bootentry #2
                 * arrived with key(10000)=1 - the old boot's resume key - and
                 * zero image restore, because the R680 path re-entered boot
                 * directly. Route it through the R722 pristine-image restore
                 * + R712 key clear so fault-site boots are as clean as
                 * shell boots). */
                if (g_r722_len == 0x5F000u) {
                    uint32_t __o;
                    if (g_firstfault_stop) r1177_door_stop("restore-site-L19734"); /* R1177: pristine-image restore + re-entry = RESTART; stop with dossier under first-fault-stop */
                    for (__o = 0; __o < g_r722_len; __o += 4u) xenolift_mem_write32(0x80010000u + __o, g_r722_img[__o >> 2]);
                    r861_out("[b2x] R724 exe image restored @fault-site restart (0x80010000..0x8006F000) - fault-site boots get the same clean image as shell re-boots\n");
                }
                xenolift_mem_write32(0x80010000u, 0xFFFFFFFFu);
                r861_out("[mtrans] R724 resume key cleared at fault-site restart (fresh-boot path)\n");
            }
            xenolift_boot_epoch++; g_in_park = 0; g_park_stage = 0; /* R1213: park latch reset at program re-launch (c37 relay-escapee fix) */
            g_menu_seen = 0u; g_menu_press_state = 0u; g_menu_frames = 0u;
            g_r800_idle_done = 0u; /* R800: re-arm idle-menu fallback for the new boot epoch */
            xenolift_region();
        }
    }
    /* R807 UNRESOLVED-JUMP RECOVERY (c391: rungasp named the killer - exit
     * status 134 = SIGABRT from THIS halt; the R680 field-committed restart
     * does not apply when the field is not committed, and the fallthrough
     * killed the process. On hardware a jump to a garbage target is an
     * EXCEPTION at the CPU, caught by the kernel handler - not a shutdown.
     * Route it like one: anchor armed -> receipt -> longjmp to the thread
     * base (the fwrestart path restores the pristine exe image and
     * re-dispatches the boot entry). Capped at 8 per run so a hard fault
     * loop parks instead of spinning. */
    if (xenolift_churn_armed) {
        static int r807_recoveries;
        if (r807_recoveries < 8) {
            r807_recoveries++;
            r861_out("[jumprec] R807 unresolved-jump -> exception-route recovery #%d (garbage target=%08X cur_fn=%08X) - anchor re-dispatch with pristine-image restore\n",
                    r807_recoveries, (unsigned)word, xenolift_cur_fn);
            g_guest_depth = 0; /* R885: kit unwound out of guest step */
        if (g_firstfault_stop) r1177_door_stop("longjmp-site-L19781"); /* R1178: ANY re-entry via the churn anchor is a restart; under first-fault-stop stop with the dossier instead */
        longjmp(xenolift_churn_jmp, 1);
        }
    }
    halt_report("unknown instruction / unresolved indirect jump", word);
}

/* ---- R989 (b8-c100, WARDEN - MACRO GUARD): macOS secure/_stdio.h turns
 * snprintf/sprintf/etc into __builtin___chk MACROS - defining our strong
 * interposers while those macros live = compile error on the Mac
 * ("expected parameter declarator"; the sandbox glibc has no such macro,
 * so the sandbox object check passed while the Mac failed - banked
 * lesson: interposing a public libc symbol REQUIRES #undef first). */
#undef snprintf
#undef vsnprintf
#undef sprintf
#undef vsprintf
#undef printf
#undef fprintf
#undef vfprintf

/* ---- R987 (b8-c98, WARDEN - PRINTF-FAMILY INTERPOSITION) ----
 * c98's FRESH macreport: __stack_chk_fail <- __xvprintf <- vfprintf_l <-
 * fprintf <- "xenolift_real_main", while our sources hold ZERO fprintf
 * calls (the only perror is startup-only in load_exe). Something hidden
 * calls fprintf. We control the link: strong public definitions here
 * override libsystem's for the WHOLE binary. Every call now (a) formats
 * via xl_format - no libc print machinery anywhere, (b) writes via
 * write(2), (c) prints a bounded naming receipt with the raw return
 * address so the digest names the caller. The 10-cycle canary class
 * loses every libc print site; the hidden caller gets photographed. */
static void r987_note(const char *which, const void *ra, const char *fmt)
{
    static int n;
    char sn[25]; int k = 0;
    while (fmt && fmt[k] && k < 24) { sn[k] = fmt[k]; k++; }
    sn[k] = 0;
    if (n < 6) { n++;
        r861_out("[printf-int] R987 %s INTERPOSED call #%d ra=%p fmt=\"%s\" (the c98 macreport named fprintf with our sources holding none - this receipt names the real caller)\n", which, n, ra, sn);
    }
}
int fprintf(FILE *s, const char *fmt, ...)
{
    va_list ap; va_start(ap, fmt);
    char b[2048];
    int n = xl_format(b, (int)sizeof b, fmt, ap);
    va_end(ap);
    r987_note("fprintf", __builtin_return_address(0), fmt);
    int fd = (s == stdout) ? 1 : 2; /* unknown streams -> stderr */
    if (n > 0) { if (n >= (int)sizeof b) n = (int)sizeof b - 1; if (write(fd, b, (size_t)n) < 0) {} }
    return n;
}
int vfprintf(FILE *s, const char *fmt, va_list ap)
{
    char b[2048];
    int n = xl_format(b, (int)sizeof b, fmt, ap);
    r987_note("vfprintf", __builtin_return_address(0), fmt);
    int fd = (s == stdout) ? 1 : 2;
    if (n > 0) { if (n >= (int)sizeof b) n = (int)sizeof b - 1; if (write(fd, b, (size_t)n) < 0) {} }
    return n;
}
int printf(const char *fmt, ...)
{
    va_list ap; va_start(ap, fmt);
    char b[2048];
    int n = xl_format(b, (int)sizeof b, fmt, ap);
    va_end(ap);
    r987_note("printf", __builtin_return_address(0), fmt);
    if (n > 0) { if (n >= (int)sizeof b) n = (int)sizeof b - 1; if (write(1, b, (size_t)n) < 0) {} }
    return n;
}
int snprintf(char *d, size_t sz, const char *fmt, ...)
{
    va_list ap; va_start(ap, fmt);
    int n = xl_format(d, (int)sz, fmt, ap);
    va_end(ap);
    r987_note("snprintf", __builtin_return_address(0), fmt);
    return n;
}
int vsnprintf(char *d, size_t sz, const char *fmt, va_list ap)
{
    r987_note("vsnprintf", __builtin_return_address(0), fmt);
    return xl_format(d, (int)sz, fmt, ap);
}
/* R1044 TAINTED-DESTINATION HOLD (b8-c199 macreport, source-level fix):
 * the c199 crash resolved the RETURNING exit-134 class to THIS
 * interceptor: __stack_chk_fail <- _vsnprintf <- sprintf(runtime.c:17428)
 * <- xenolift_trace <- xenolift_fn_80077E88. Decode: the guest
 * coordinator called sprintf with a TAINTED HOST-STACK pointer as its
 * destination (the c195-decoded truncated-host-pointer taint class) and
 * the old body xl_format(d, 1 << 30, ...) wrote the guest's formatted
 * string STRAIGHT INTO THE HOST STACK - canary smash, abort, exit 134.
 * Retail HW would fault such a write; the HLE contract here: format to a
 * bounded temp; write through ONLY when the destination is guest memory
 * (xenolift_mem model, 0x80000000..0x80200000); otherwise HOLD (no
 * write) + receipt [sphold] and return the length (v0 contract). Our
 * own runtime.c call sites were converted to bounded snprintf (3
 * sites) so they are unaffected. */
static int xl_sprintf_hold(const char *tag, char *d, const char *fmt, va_list ap)
{
    char tmp[2048];
    int n = xl_format(tmp, (int)sizeof tmp, fmt, ap);
    r987_note(tag, __builtin_return_address(0), fmt);
    if (n <= 0) return n;
    {
        uintptr_t dp = (uintptr_t)d;
        if (dp >= 0x80000000u && dp < 0x80200000u) {
            int w = n;
            if (w > (int)sizeof tmp - 1) w = (int)sizeof tmp - 1;
            memcpy(&xenolift_mem[dp - 0x80000000u], tmp, (size_t)w + 1);
            return n;
        }
        {
            static int sph_n;
            if (sph_n < 8) { sph_n++;
                r861_out("[sphold] R1044 sprintf HELD: tainted destination %p (host-stack taint class c195/c199; guest-formatted string NOT written to host memory) fmt@=%08X\n",
                        (void *)d, (unsigned)(uintptr_t)fmt);
            }
        }
        return n;
    }
}
int sprintf(char *d, const char *fmt, ...)
{
    va_list ap; va_start(ap, fmt);
    int n = xl_sprintf_hold("sprintf", d, fmt, ap);
    va_end(ap);
    return n;
}
int vsprintf(char *d, const char *fmt, va_list ap)
{
    return xl_sprintf_hold("vsprintf", d, fmt, ap);
}

/* ---- the "disc": load a PS-X EXE into fake RAM, mirroring the console ---- */

static void load_exe(const char *path)
{
    FILE *f = fopen(path, "rb");
    if (!f) {
        perror(path);
        exit(1);
    }
    fseek(f, 0, SEEK_END);
    long len = ftell(f);
    fseek(f, 0, SEEK_SET);
    uint8_t *buf = malloc((size_t)len);
    if (!buf || fread(buf, 1, (size_t)len, f) != (size_t)len) {
        r861_out("error: cannot read %s\n", path);
        exit(1);
    }
    fclose(f);

    if (len < 0x800 || memcmp(buf, "PS-X EXE", 8) != 0) {
        r861_out("error: not a PS-X EXE image\n");
        exit(1);
    }

    uint32_t pc0 = *(const uint32_t *)(buf + 0x10);
    uint32_t t_addr = *(const uint32_t *)(buf + 0x18);
    uint32_t t_size = *(const uint32_t *)(buf + 0x1C);

    /* copy the program image into fake RAM at the load address.
     * KSEG0 addresses alias the 2MB RAM (mask 0x1FFFFF). */
    uint32_t dst = xenolift_phys(t_addr);
    uint32_t bytes = t_size;
    if (bytes > XENOLIFT_RAM_SIZE) {
        bytes = XENOLIFT_RAM_SIZE; /* guard against corrupt headers */
    }
    memcpy(xenolift_mem + xenolift_phys(t_addr), buf + 0x800, bytes);
    free(buf);

    /* R981 (b8-c89/90, WARDEN - printf DOORS CLOSED): two cycles died
     * identically at host offset 2146139 inside real_main via
     * __xvprintf <- vfprintf_l <- fprintf (macreport R850) - a printf-
     * family call NOT covered by R977's guard (that gates r861_out
     * only). The two remaining printf() calls in real_main's flow are
     * exactly this family: this module-load notice and the region-
     * returned unwind notice (fires on EVERY boot-chain unwind = the
     * recovery churn repeats it, and a signal landing mid-vfprintf
     * smashes the canary). Route both through the guarded, budgeted
     * r861_out (vsnprintf + raw write(2), R977 reentrancy-dropped).
     * Output moves stdout->stderr: cosmetic only, all receipts read
     * stderr. */
    r861_out("[xenolift] loaded %s: entry 0x%08X, text 0x%08X (0x%X bytes)\n",
           path, pc0, t_addr, t_size);
}

/* R227: CRASH CAPTURE — async-signal-safe only. The cycle-12 Mac segfault
 * produced ZERO output: the old handler used backtrace()+fprintf (not
 * signal-safe); the crash landed mid-log-write and the handler died too
 * (crash-in-crash). This one writes with raw write(2), dumps the current
 * function (tracked live at every xenolift_trace entry), key registers,
 * si_addr, and the last 64 entered functions from the trace ring = the call
 * trail at the moment of the crash. */
extern uint32_t xenolift_ring[64];
extern int xenolift_ring_n;
__attribute__((no_sanitize("address"))) static void crash_putc(char c) { (void)!write(2, &c, 1); }
static uint64_t host_stack_lo, host_stack_hi; /* R247 walker bounds */
__attribute__((no_sanitize("address"))) static void crash_puts(const char *s) { while (*s) crash_putc(*s++); }
__attribute__((no_sanitize("address"))) static void crash_puth(uint32_t v)
{
    static const char hx[] = "0123456789ABCDEF";
    for (int i = 7; i >= 0; i--) crash_putc(hx[(v >> (i * 4)) & 0xF]);
}
/* R229: crash memory dumper — the report must be SELF-SUFFICIENT: with the
 * crashing function named (cycle-15: MoviePollSkipInput 0x800769A4, wild
 * deref of 0xB7E7EFF8, module data base r5=0x80077194), the next digest
 * needs the actual MIPS at the crash + the pointer-source cells so the
 * faulting instruction decodes offline. Async-safe: manual byte assembly,
 * bounds-guarded against the RAM window. */
extern uint8_t xenolift_mem[XENOLIFT_RAM_SIZE + XENOLIFT_IO_SIZE];
__attribute__((no_sanitize("address"))) static void crash_dump_mem(const char *tag, uint32_t addr, int words)
{
    int i;
    crash_puts("[crash] "); crash_puts(tag); crash_puts(" @0x"); crash_puth(addr);
    crash_puts(":");
    if (addr < 0x80000000u || addr >= 0x80000000u + XENOLIFT_RAM_SIZE) {
        crash_puts(" OUT-OF-RAM (no dump)\n");
        return;
    }
    for (i = 0; i < words; i++) {
        uint32_t a = addr + (uint32_t)i * 4u;
        uint32_t v = 0;
        int b;
        if (a + 3u >= 0x80000000u + XENOLIFT_RAM_SIZE) { crash_puts(" CUT"); break; }
        for (b = 0; b < 4; b++)
            v |= (uint32_t)xenolift_mem[(a - 0x80000000u) + (uint32_t)b] << (8 * b);
        crash_puts(i % 4 == 0 ? "\n[crash]   " : " ");
        crash_puth(v);
    }
    crash_puts("\n");
}
__attribute__((no_sanitize("address"))) static void segv_handler(int sig, siginfo_t *si, void *uc)
{
    /* R983 (b8-c93, WARDEN - KIT RE-ENTRY BAIL, kills the nested-vfprintf
     * canary class): four cycles (c89/90/92/93) died identically in
     * __xvprintf <- vfprintf_l with the PC attributed to real_main while
     * rt.o/HLE objects hold ZERO fprintf/printf imports. The remaining
     * vprintf-family call in the fault path is THIS handler's own
     * snprintf ("ctx tid" line below) - and the handler had NO re-entry
     * bail, so a second guest fault landing mid-dump (fault-walk restarts
     # nest the handler every cycle) re-enters vfprintf INSIDE vfprintf ->
     * canary smash -> SIGABRT (exit 134). Mechanical fix: if a dump is
     * already in flight, RETURN - the first handler owns the recovery
     * longjmp; a nested dump is what smashed us. Same single-flight
     * discipline as R977 (r861_out) and R982 (hle_out). */
    if (g_crash_dumping) return;

    /* R233: HOST PC capture. Cycles 15-19 show cur_fn can be STALE for the
     * fault site (crash regs r4=1/r5=0x80077194 match no state
     * MoviePollSkipInput can produce; the trail's newest entry is the VSync
     * pair, not cur_fn) — the fault is inside a function whose hook context
     * we can't trust. The HOST fault PC resolves through atos against the
     * compiled binary -> names the EXACT emitted C line = the exact
     * translated MIPS instruction. Prints host_pc (fault) + host_base
     * (runtime addr of a static symbol) so run.sh computes the ASLR slide
     * via nm and resolves statically. */
    uintptr_t host_pc = 0, host_base = 0;
#if defined(__APPLE__)
    ucontext_t *UC = (ucontext_t *)uc;
# if defined(__x86_64__)
    host_pc = (uintptr_t)UC->uc_mcontext->__ss.__rip;
# elif defined(__arm64__)
    host_pc = (uintptr_t)UC->uc_mcontext->__ss.__pc;
# endif
    host_base = (uintptr_t)&xenolift_ring;
#else
    /* Linux sandbox builds: REG_RIP lives in sys/ucontext.h with glibc-
     * specific layout; the crash class we need is Mac-host-only, so the
     * non-Apple path reports 0 (the resolver in run.sh no-ops on 0). */
    host_pc = 0; host_base = 0;
#endif
    crash_puts("[crash] host_pc=0x"); crash_puth((uint32_t)((uint64_t)host_pc >> 32)); crash_puth((uint32_t)host_pc);
    crash_puts(" host_base=0x"); crash_puth((uint32_t)((uint64_t)host_base >> 32)); crash_puth((uint32_t)host_base);
    crash_puts(" ring_n="); crash_puth((uint32_t)xenolift_ring_n);
    crash_puts("\n");
    /* R245: HOST BACKTRACE = the translated-C call chain that faulted —
     * cycle-30's fault addr lands in libc territory (wild pointer passed to
     * a copy routine), so the faulting PC alone names nothing; the frame
     * list names the exact emitted function. atos resolves offline. */
    { void *bt[16]; int n = 0; (void)bt;
      /* R877 (c469, WARDEN): backtrace() REMOVED from the signal path.
       * Apple's backtrace is NOT async-signal-safe - the libsystem
       * unwinder allocates + takes dyld locks mid-signal; c469's fresh
       * .ips shows the abort INSIDE libsystem_c (stack buffer overflow)
       * on the anchor thread seconds after the kit report + recovery.
       * R866 removed symbols_fd for the same reason but kept backtrace()
       * itself - the last async-unsafe call in the kit path. The R247
       * manual rbp-chain walk below (memcpy-only, hard-capped) is the
       * async-safe evidence path; raw ra list dies with this note. */
      crash_puts("[crash] host backtrace:\n");
      /* R866 (c455): backtrace_symbols_fd REMOVED from the signal path -
       * ASan named the killer class: stack-use-after-scope in segv_handler
       * (c455 death block; every canary abort lands seconds after a kit
       * recovery). backtrace_symbols_fd calls malloc/dladdr internally =
       * NOT async-signal-safe: it locks and touches heap state mid-crash
       * while other threads hold those locks, and reads dead frames.
       * Raw addresses are async-safe (write only); atos resolves them
       * offline (R850 pipeline). Also: the array is static so the handler
       * never holds a pointer to a scoped stack slot (use-after-scope class
       * dies with it). */
      { static void *sbt[16]; int i;
        if (n > 16) n = 16;
        for (i = 0; i < n; i++) sbt[i] = bt[i];
        for (i = 0; i < n; i++) {
          crash_puts("  #"); crash_puth((uint32_t)i);
          crash_puts(" ra=0x"); crash_puth((uint32_t)((uint64_t)(uintptr_t)sbt[i] >> 32)); crash_puth((uint32_t)(uintptr_t)sbt[i]);
          crash_puts("\n");
        }
      }
      if (n > 0) crash_puts("[crash] (R866: raw ra list - resolve offline with atos; symbols_fd is not signal-safe)\n");
      if (1) {
        /* R246 + R877: backtrace() is async-unsafe (see above); the manual
         * x86_64 frame-pointer chain walk from the signal ucontext is
         * async-signal-safe (memcpy only) and DOES work. */
#if defined(__APPLE__) && defined(__x86_64__)
        uint64_t fp = (uint64_t)((const ucontext_t *)uc)->uc_mcontext->__ss.__rbp;
        int i;
        crash_puts("[crash] rbp chain (fp=0x"); crash_puth((uint32_t)(fp >> 32)); crash_puth((uint32_t)fp);
        crash_puts(")\n");
        for (i = 0; i < 12 && fp; i++) {
          uint64_t ra, nfp;
          /* R247 HARD CAP: fp must live inside the real host stack (and
           * leave room for the 8-byte ra slot) before we touch it. */
          if (fp & 7 || fp < 0x1000) break;
          if (fp < host_stack_lo || fp + 16 > host_stack_hi) {
            crash_puts("[crash] frame walk stopped: fp outside host stack\n");
            break;
          }
          memcpy(&ra, (const void *)(uintptr_t)(fp + 8), 8);
          memcpy(&nfp, (const void *)(uintptr_t)fp, 8);
          crash_puts("[crash] frame #"); crash_puth(i);
          crash_puts(" ra=0x"); crash_puth((uint32_t)(ra >> 32)); crash_puth((uint32_t)ra); crash_puts("\n");
          if (nfp <= fp) break;
          fp = nfp;
        }
#endif
      } }
    {   /* R227.1: ATOMIC critical line — one prebuilt buffer, ONE write(),
         * so the identity of the crash (sig, fault addr, current function,
         * return addr, sp, args) can never be lost to a partial fault. */
        static char cb[512];
        unsigned p = 0;
        const uint32_t crit[11] = {
            (uint32_t)sig, (uint32_t)(si ? (uintptr_t)si->si_addr : 0),
            xenolift_cur_fn, r[31], r[29], r[4], r[5], r[6],
            xenolift_mem_read32(0x8004FDF8u), xenolift_mem_read32(0x8004FE04u),
            (r[6] >= 0x80000000u && r[6] < 0x80800000u) ? xenolift_mem_read32(r[6]) : 0u
        };
        static const char *lab[11] = {
            " sig=", " addr=", " cur_fn=", " r31=", " sp=", " r4=", " r5=", " r6=",
            " FDF8=", " FE04=", " S[r6]="
        };
        static const char hx[] = "0123456789ABCDEF";
        const char *head = "\n[crash] CRITICAL";
        /* R905: faulting-thread context - the c504 macreport showed the
         * __vfprintf canary smash on THREAD 1 (watcher) while the guest
         * oscillated 4B54C<->4B55C; name the thread + C-recursion depth at
         * every kit fire so the next digest pins the smash site. */
        { g_crash_dumping = 1; /* R961: dump window open - r861_out holds off */
          /* R983: snprintf removed from the signal path - manual decimal
           * formatting + one raw write(2) (the regs32 buffer's pattern,
           * async-signal-safe end to end). Nested-fault smash starves. */
          char _t[96]; unsigned _p = 0;
          unsigned long _tid = (unsigned long)((uintptr_t)pthread_self() & 0xFFFFFFu);
          unsigned _dep = (unsigned)g_guest_depth;
          static const char _hd[] = "[crash] ctx tid="; 
          for (unsigned q = 0; _hd[q]; q++) _t[_p++] = _hd[q];
          { char _d[12]; int _n = 0;
            if (!_tid) _d[_n++] = '0';
            while (_tid && _n < 10) { _d[_n++] = (char)('0' + (_tid % 10)); _tid /= 10; }
            while (_n > 0) _t[_p++] = _d[--_n]; }
          static const char _dd[] = " depth=";
          for (unsigned q = 0; _dd[q]; q++) _t[_p++] = _dd[q];
          { char _d[12]; int _n = 0;
            if (!_dep) _d[_n++] = '0';
            while (_dep && _n < 10) { _d[_n++] = (char)('0' + (_dep % 10)); _dep /= 10; }
            while (_n > 0) _t[_p++] = _d[--_n]; }
          _t[_p++] = '\n';
          (void)!write(2, _t, _p); }
        for (unsigned h = 0; head[h]; h++) cb[p++] = head[h];
        for (int k = 0; k < 11; k++) {
            for (unsigned q = 0; lab[k][q]; q++) cb[p++] = lab[k][q];
            cb[p++] = '0'; cb[p++] = 'x';
            for (int d = 0; d < 8; d++) cb[p++] = hx[(crit[k] >> (28 - 4 * d)) & 0xF];
        }
        cb[p++] = '\n';
        (void)!write(2, cb, p);
    }
    crash_dump_mem("code @cur_fn", xenolift_cur_fn, 96);
    /* R1253 (c111): the LZSS wild-pointer crash needs the decompressor's
     * own state - the state block at 0x800566F8 (r6 at every lzsscam
     * receipt, S[r6]=3 at crash) holds the cursor/window/input pointers.
     * Dump it at LZSS-class crashes so the next digest reads the exact
     * input offset the decompressor was reading vs the delivered frontier
     * (c111 receipts: core invoked at exactly 0x10000 delivered bytes of
     * file#14 and on an all-zero buffer for the file#18 staging - the
     * frontier race is the named suspect; buffer fidelity decides the fix:
     * faithful-then-frontier-accounting vs holes-then-delivery-gap). */
    if (xenolift_cur_fn == 0x80032E88u || xenolift_cur_fn == 0x80032EB4u) {
        crash_dump_mem("lzss state @800566F8", 0x800566F8u, 128);
    }
    /* R1166 (b8-c352): TAINTSCAN - c352's new crash family: MainLoop
     * (r31=0x80019B98 = +0xCC inside MainLoop 0x80019ACC, decomp map)
     * calls func_80032F54 (the INCLUDE_ASM system-init fn directly before
     * ResolveArchiveEntryPointers 0x8003342C, system.c:15) and SIGBUSes
     * dereferencing a HOST-tainted pointer (addr=0x85AA8F50/0x0A82B000;
     * same class as R1060's c222 fn_800392EC addr=0xB85BF8B0 host-addr
     * taint and c351's AllocateSoundHeapBlock block=0xA106BDE0). The
     * faulting value was loaded from (or computed via) a guest cell -
     * NAME every cell in guest RAM holding the fault address (exact
     * match) plus any cell in the same 64K host-page band (base-pointer
     * class: fault at base+offset means the cell holds the BASE). Next
     * cycle's write-watch then has a receipted target - the first
     * incorrect writer - instead of a guessed one. Word-aligned scan of
     * the 2MB guest span; sigsafe manual hex (R983/R1080 pattern);
     * cap 12 exact + 8 band hits per crash. */
    {
        const uint32_t fa = (uint32_t)(si ? (uintptr_t)si->si_addr : 0);
        if (fa != 0u && (fa < 0x80000000u || fa >= 0x80200000u)) {
            char _t[768]; int _p = 0; unsigned _hx = 0, _hb = 0;
            static const char _h3[] = "[taintscan] R1166 fault addr ";
            for (unsigned q = 0; q < sizeof(_h3) - 1; q++) _t[_p++] = _h3[q];
            xenolift_sighex(_t, &_p, fa);
            static const char _h4[] = " exact:";
            for (unsigned q = 0; q < sizeof(_h4) - 1; q++) _t[_p++] = _h4[q];
            for (uint32_t off = 0; off < 0x200000u && _hx < 12u; off += 4u) {
                uint32_t v;
                memcpy(&v, xenolift_mem + off, 4);
                if (v == fa) {
                    _t[_p++] = ' ';
                    xenolift_sighex(_t, &_p, 0x80000000u + off);
                    _hx++;
                }
            }
            static const char _h5[] = " band64k:";
            for (unsigned q = 0; q < sizeof(_h5) - 1; q++) _t[_p++] = _h5[q];
            for (uint32_t off = 0; off < 0x200000u && _hb < 8u; off += 4u) {
                uint32_t v;
                memcpy(&v, xenolift_mem + off, 4);
                if (v != fa && (v & 0xFFFF0000u) == (fa & 0xFFFF0000u)
                    && (v & 0xFFFF0000u) != 0u && (v >> 16) >= 0x100u) {
                    _t[_p++] = ' ';
                    xenolift_sighex(_t, &_p, 0x80000000u + off);
                    _t[_p++] = '=';
                    xenolift_sighex(_t, &_p, v);
                    _hb++;
                }
            }
            if (!_hx && !_hb) {
                static const char _h6[] = " NONE (fault addr not present in guest RAM - computed, not loaded)";
                for (unsigned q = 0; q < sizeof(_h6) - 1; q++) _t[_p++] = _h6[q];
            }
            _t[_p++] = '\n';
            (void)!write(2, _t, (size_t)_p);
        }
    }
    /* R1167 (b8-c353, Jos directive): FIRSTFAULT STOP - grouped crash output
     * cannot establish first-fault chronology, and every recovery dispatch
     * damages state (R962 pristine wipes). With XENOLIFT_FIRSTFAULT_STOP=1
     * the FIRST critical fault dumps its full dossier (CRITICAL line +
     * regs + code@cur_fn + data@r4 + backtrace + taintscan above) and the
     * process EXITS 99 - no recovery, so the diagnosis is the fault itself,
     * not the recovery loop's echo. _exit is async-signal-safe. */
    if (g_firstfault_stop) {
        static const char _ff[] = "[firstfault] R1167 STOP at first critical fault (env XENOLIFT_FIRSTFAULT_STOP; no recovery - chronology preserved; run ends here by design)\n";
        (void)!write(2, _ff, sizeof(_ff) - 1);
        _exit(99);
    }
    /* R1080 (b8-c249, TRAILBLAZER): R1079's hchain camera gated on the
     * segvdie DEATH site (cur_fn==0x80076858) and never fired - c249's
     * final death had a host-taint cur_fn (0x615F7472, r964_ok=0) while
     * the helper faulted SIX times mid-run, once with perfectly healthy
     * args (a0=1, a1=1F8000A0, a2=1F8000A8) dying at addr=6 - a near-null
     * base+6 deref inside its own struct walk. Move the chain receipt HERE
     * (the crash curator fires on EVERY critical fault): when the fault
     * is in the helper (0x80076858) or the coordinator (0x80077E88),
     * receipt the module descriptor chain - the healed door descriptor
     * 0x800592B8, [+0x4C], [+0xF4] (the helper's own static-decoded read
     * path: lw r2,[r16+0x4C]; lh r3,[r2+0xF4]) - so the struct decode has
     * chain values regardless of where the run finally dies. */
    if (xenolift_cur_fn == 0x80076858u || xenolift_cur_fn == 0x80077E88u) {
        uint32_t r1080_d = xenolift_mem_read32(0x800592B8u);
        uint32_t r1080_l1 = 0u, r1080_l2 = 0u;
        if (r1080_d >= 0x80010000u && r1080_d < 0x80200000u) {
            r1080_l1 = xenolift_mem_read32(r1080_d + 0x4Cu);
            if (r1080_l1 >= 0x80010000u && r1080_l1 < 0x80200000u)
                r1080_l2 = xenolift_mem_read32(r1080_l1 + 0xF4u);
        }
        { char _t[320]; int _p = 0; /* R984 sigsafe: manual hex, no libc print */
          static const char _h2[] = "[hchain] R1080 desc chain r16desc=";
          for (unsigned q = 0; q < sizeof(_h2) - 1; q++) _t[_p++] = _h2[q];
          xenolift_sighex(_t, &_p, r1080_d);
          _t[_p++] = ' '; _t[_p++] = 'l';
          xenolift_sighex(_t, &_p, r1080_l1);
          _t[_p++] = ' '; _t[_p++] = 'l';
          xenolift_sighex(_t, &_p, r1080_l2);
          _t[_p++] = ' '; _t[_p++] = 's';
          xenolift_sighex(_t, &_p, xenolift_mem_read32(0x1F8000A0u));
          _t[_p++] = ' ';
          xenolift_sighex(_t, &_p, xenolift_mem_read32(0x1F8000A8u));
          _t[_p++] = ' ';
          xenolift_sighex(_t, &_p, xenolift_mem_read32(0x1F8000B0u));
          _t[_p++] = '\n';
          (void)!write(2, _t, (unsigned)_p); }
    }
    /* R1008 (b8-c122): the c121/c122 death family (16 recoveries ->
     * TRUE DEATH, cur_fn=0x800465EC SPU/GPU band, r4=0x8005A238 empty
     * GPU packet list, r5=0x02000000 SPU data addr) faults DEEPER than
     * the anchor: the trail names the callee chain (80047178 800471A4
     * 80046C58 80046EFC ...) but the kit dumps code only @cur_fn. Dump
     * 32 words at r31 (the direct caller) and at the LAST unique trail
     * entry (the deepest executed frame) so the next decode has the
     * faulting function's own code. Receipt-only: no guard, no guess -
     * the no-source-reference rule holds (Noah stubs SpuSetTransferMode
     * as MissingCode, the decomp map has no names in this band). */
    {
        static const uint32_t trail_tail[] = { 0 };
        (void)trail_tail;
        crash_dump_mem("R1008 code @r31 caller", r[31], 32);
        uint32_t deepest = 0;
        for (int ti = (int)xenolift_ring_n - 1; ti >= 0 && ti >= (int)xenolift_ring_n - 24; ti--) {
            uint32_t tw = xenolift_ring[ti & 63u];
            if (tw >= 0x80010000u && tw < 0x80000000u + XENOLIFT_RAM_SIZE && tw != xenolift_cur_fn) { deepest = tw; break; }
        }
        if (deepest)
            crash_dump_mem("R1008 code @deepest-trail", deepest, 32);
    }
    /* R246: r4 = the caller's data struct (cycle-31: movie render struct
     * @0x80077180 whose fields feed the GPU dispatch + transfer size) —
     * the kit dumped r5 which was just a size (0x8000). r4 first, 16 words. */
    crash_dump_mem("data @r4", r[4], 16);
    crash_dump_mem("data @r5", r[5], 8);
    crash_dump_mem("stack @r31-16", r[31] >= 16u ? r[31] - 16u : r[31], 8);
    /* R484: full 32-register dump at host crash (async-safe manual write).
     * c47/c48 host segv landed in a system lib called from
     * xenolift_trace+1967 (probe dispatcher) via fn_800286CC; the kit only
     * dumped r4/r5/r6. Full register file at death -> the deref's source
     * register becomes visible next crash. */
    {
        static const char hxx[] = "0123456789ABCDEF";
        char rb[1024]; unsigned q = 0;
        const char *rh = "\n[crash] regs32:";
        for (unsigned u = 0; rh[u]; u++) rb[q++] = rh[u];
        for (int k = 0; k < 32; k++) {
            if ((k % 4) == 0) rb[q++] = '\n';
            rb[q++] = 'r';
            rb[q++] = (k < 10) ? (char)('0' + k) : (char)('A' + k - 10);
            rb[q++] = '=';
            for (int d = 0; d < 8; d++) rb[q++] = hxx[(r[k] >> (28 - 4 * d)) & 0xF];
            rb[q++] = ' ';
        }
        rb[q++] = '\n';
        (void)!write(2, rb, q);
    }
    /* R961: scratchpad-words camera — c70's field-band fault carried
     * r6=1F8000A8 (the stub region) with addr=FFFF0208; dump the stub
     * state at the fault so the instruction + the stub words name the
     * opcode-53 class connection in one receipt. */
    if (r[6] >= 0x1F800000u && r[6] < 0x1F801000u)
        crash_dump_mem("spad @r6", r[6], 8);
    crash_puts("\n[crash] SEGFAULT sig="); crash_puth((uint32_t)sig);
    crash_puts(" addr="); crash_puth((uint32_t)(si ? (uintptr_t)si->si_addr : 0));
    crash_puts(" cur_fn="); crash_puth(xenolift_cur_fn);
    crash_puts(" r31="); crash_puth(r[31]);
    crash_puts(" sp="); crash_puth(r[29]);
    crash_puts(" r4="); crash_puth(r[4]);
    crash_puts(" r5="); crash_puth(r[5]);
    crash_puts(" r6="); crash_puth(r[6]);
    crash_puts("\n[crash] trail (newest last, 8/line):\n");
    {   /* snapshot the ring safely; ring may be mid-write. R233: compact —
         * the 32 one-per-line form exceeded the =CRASH= digest budget and
         * the NEWEST entries (the crash context!) got truncated away. */
        uint32_t n = (uint32_t)xenolift_ring_n;
        for (int i = 31; i >= 0; i--) {
            uint32_t idx = (n - 1u - (uint32_t)i) & 63u;
            crash_puts("[crash] trail "); crash_puth(xenolift_ring[idx]);
            if ((i & 7) == 0) crash_puts("\n");
        }
    }
    crash_puts("[crash] END OF REPORT\n");
    g_crash_dumping = 0; /* R961: dump window closed */
    /* R805 RECOVERY IN THE HANDLER THAT ACTUALLY FIRES (c389): the R804
     * recovery lived in xenolift_exitdiag_sig - but THIS crashkit handler
     * owns SIGSEGV, so the R804 path never ran (=SEGvREC= empty while the
     * kit printed and died; run burned at 31s). c389's fault: the guest
     * jumped through a NULL method-table cell (0x800568C8 = 0; the boot
     * trampolines' jalr landed at host_pc=0) - a CATCH-AND-RECOVER class
     * on hardware. Recover HERE: anchor armed -> print receipt -> longjmp
     * to the thread base (the R765 fwrestart path restores the pristine
     * exe image and re-dispatches boot entry; the abandoned frames are the
     * faulting context). Capped at 8 per run; handler re-entry = real death.
     * The receipt uses the crashkit's async-safe printer, NOT fprintf. */
    if (xenolift_churn_armed) {
        static int r805_recoveries;
        /* R872 (c461/462): cap 8->32. The churn-era fault rate (sound-error
         * chain -> boot entry wild read) needs ~8-12 recoveries per walk
         * attempt; c460 PROVED a 5-recovery walk escapes to the pre-movie
         * era and lives to the fuse. Recoveries are cheap anchor
         * re-dispatches; the run fuse bounds total cost. A cap that kills
         * a healthy-but-churning walk is a cap doing the killer's job. */
        if (r805_recoveries < 32) {
            r805_recoveries++;
            r805_mirror = r805_recoveries;
            crash_puts("[segvrec] R805 crash-kit recovery #");
            crash_puth((uint32_t)r805_recoveries);
            crash_puts(" (anchor re-dispatch; cur_fn=");
            crash_puth(xenolift_cur_fn);
            crash_puts(")\n");
            { /* R1132 (b8-c313): the churn crashes flow through THIS door
             * (segvrec R805), not the crashkit poison-HALT door - the R1131
             * crash-ctx camera sat at the wrong door and never fired. Here:
             * dump the CD register-pointer table (reg0-reg3 = pointers to
             * 1F801800-803, initialized by fns 8002B084/80031C58 per reg0cam
             * receipts; the CD command writer at 0x80042750 stores THROUGH
             * them - clobbered-to-small-values = the tiny fault addrs) and
             * the arch chain (4FDF0/FE14/FE1C) at the actual crash instant.
             * Sigsafe printers only. First 4 CD_cw-family recoveries. */
                static int r1132_k;
                if (r1132_k < 4 && xenolift_cur_fn >= 0x80041BA0u && xenolift_cur_fn <= 0x80041D00u) {
                    r1132_k++;
                    crash_puts("[reg0cam] R1132 CD_cw crash-door: reg0=");
                    crash_puth(xenolift_mem_read32(0x80056770u));
                    crash_puts(" reg1="); crash_puth(xenolift_mem_read32(0x80056774u));
                    crash_puts(" reg2="); crash_puth(xenolift_mem_read32(0x80056778u));
                    crash_puts(" reg3="); crash_puth(xenolift_mem_read32(0x8005677Cu));
                    crash_puts(" | arch: base="); crash_puth(xenolift_mem_read32(0x8004FDF0u));
                    crash_puts(" FE14="); crash_puth(xenolift_mem_read32(0x8005FE14u));
                    crash_puts(" FE1C="); crash_puth(xenolift_mem_read32(0x8005FE1Cu));
                    crash_puts("\n");
                }
            }
            { /* R1086 (b8-c255): the module-helper faulted at addr=0xDEAD0010
             * (c255 COORDERA receipt, cur_fn=0x80076858) - it dereferenced a
             * DEAD-shaped base. DEAD00xx values exist in runtime.c only as
             * CAMERA FILLERS (receipt labels), never as guest writes (grep
             * receipted: no xenolift_mem_write32 with DEAD). So either a guest
             * cell holds a DEAD-shaped value (how?) or a guest register does.
             * Scan at the recovery door (sigsafe: crash_puts/crash_puth only),
             * first 3 recoveries only: receipt the first 12 guest RAM cells
             * holding values in [0xDEAD0000,0xDEAD0100). Empty scan = the
             * DEAD reached the helper through a register path, also receipted. */
                static int r1086_n; int r1086_found = 0;
                if (r1086_n < 3) {
                    r1086_n++;
                    for (uint32_t ca = 0x80010000u; ca < 0x80200000u && r1086_found < 12; ca += 4u) {
                        uint32_t cv = xenolift_mem_read32(ca);
                        if (cv >= 0xDEAD0000u && cv < 0xDEAD0100u) {
                            r1086_found++;
                            crash_puts("[deadscan] R1086 DEAD-shaped guest cell @");
                            crash_puth(ca);
                            crash_puts(" = ");
                            crash_puth(cv);
                            crash_puts("\n");
                        }
                    }
                    if (!r1086_found) {
                        crash_puts("[deadscan] R1086 scan complete: 0 DEAD-shaped cells in guest RAM - DEAD base reached the helper via register path\n");
                    }
                }
            }
            g_guest_depth = 0; /* R885: kit unwind out of guest step R1086 marker */
            /* R962 (b8-c71) + R965 (b8-c74, WARDEN - WIPE SURGICALLY
             * NARROWED): c71's storm receipts proved the IMAGE restore +
             * fresh sp + resume-key clear + boot-entry pend fix the smashed
             * stack class (27 recoveries -> 3). But c74 proved the FULL
             * register wipe (the R692 atexit-door pattern) is WRONG for
             * MID-ERA crash recovery: the re-dispatched boot chain calls
             * the allocator (80031C58) with the walk's live args GONE —
             * crash regs showed all 32 regs zeroed, a0=0/src=NULL, fault at
             * NULL+0x48, plus a 175MB churn-log explosion and a host
             * fprintf stack-smash. The wipe belongs to the full shell
             * restart door only; mid-era recovery keeps the era's live
             * registers. Kept: image restore, sp reset (fresh stack at
             * top of RAM — the stack CELLS were the smash vector, not the
             * registers), resume-key clear, known-good pend. Removed: the
             * 32-register wipe + r31=0. */
            r[29] = 0x801FFF00u;
            {   /* R1143 (b8-c326): preserve in-flight state across THIS door -
                 * the R1123/R1125/R1128 patterns were wired to the halt/fault-walk
                 * doors but NOT the crash-kit recovery door; c326 hang receipts
                 * (file#7 in-flight request wiped here -> stage-6 park deadlock). */
                uint32_t r1143_sv[4]; uint32_t r1143_av[5]; uint32_t r1143_wv[5]; uint32_t r1143_wcv[9]; /* R1146: +3 libetc vsync-queue cells */
                xenolift_libcd_save(r1143_sv);
                xenolift_arch_save(r1143_av);
                xenolift_cdwait_save(r1143_wv);
                xenolift_walkcell_save(r1143_wcv);
            if (g_r722_len == 0x5F000u) { /* R770 pattern: pristine image relay */
                uint32_t __o;
                if (g_firstfault_stop) r1177_door_stop("restore-site-L20436"); /* R1177: pristine-image restore + re-entry = RESTART; stop with dossier under first-fault-stop */
                for (__o = 0; __o < g_r722_len; __o += 4u)
                    xenolift_mem_write32(0x80010000u + __o, g_r722_img[__o >> 2]);
                crash_puts("[segvrec] R962 pristine exe image restored @recovery\n");
            }
                xenolift_libcd_reapply(r1143_sv);
                xenolift_arch_reapply(r1143_av);
                xenolift_cdwait_reapply(r1143_wv);
                xenolift_walkcell_reapply(r1143_wcv);
            }
            /* R1014 (b8-c128): SOUND HEAP RE-SEED POST-RESTORE. c128 receipts:
             * SoundHeapInitialize IS called with the exact static contract args
             * (start=0x80065B0C size=0x6300, [sndinit] R1012 @t=8s) but by the
             * next SoundInitialize entry the head is 0 again ([sndinit] @t=31s:
             * head(9410)=00000000) - the cells 0x80059410/951C/95E4 live in the
             * pristine range whose initial exe value is 0, so every restore
             * wipes the kernel's own init. RE-SEED = faithful replica of the
             * decomp's SoundHeapInitialize (sound.c:649, struct from
             * include/system/sound.h:56-63): aligned head, size -0x10 when
             * start unaligned, header unk0=0x8000, pPrev=block+sizeof(header),
             * pNext=NULL. Only fires when the head is NULL (the kernel's own
             * init would rewrite these same values; zero-stomp impossible). */
            if (xenolift_mem_read32(0x80059410u) == 0u) {
                /* startAddress 0x80065B0C is 4-mod-16 unaligned: head aligns up
                 * to 0x80065B10 and nAlignedSize = (0x6300 & ~0xF) - 0x10 */
                xenolift_mem_write32(0x800595E4u, 0x8006BE00u); /* g_SoundHeapEnd = 0x80065B10 + 0x62F0 */
                xenolift_mem_write32(0x80059410u, 0x80065B10u); /* g_SoundHeapHead */
                xenolift_mem_write32(0x8005951Cu, 0x000062F0u); /* g_SoundHeapSize */
                xenolift_mem_write32(0x80065B10u, (xenolift_mem_read32(0x80065B10u) & 0xFFFF0000u) | 0x00008000u); /* unk0 = 0x8000 (u16) */
                xenolift_mem_write32(0x80065B12u, xenolift_mem_read32(0x80065B12u) & 0xFFFF0000u); /* unk2 = 0 (u16) */
                xenolift_mem_write32(0x80065B14u, 0u); /* unk4 = 0 */
                xenolift_mem_write32(0x80065B18u, 0x80065B20u); /* pPrev = block + 0x10 */
                xenolift_mem_write32(0x80065B1Cu, 0u); /* pNext = NULL */
                crash_puts("[sndheal] R1014 sound-heap re-seeded post-restore: head=80065B10 size=62F0 end=8006BE00 (replica of decomp SoundHeapInitialize(80065B0C,6300); c128 receipts: init called but wiped by every restore)\n");
            }
            /* R1109 (b8-c287): ARCHIVE-TABLE RE-SEED POST-RESTORE. c287
             * receipts + source decode (archive.c ArchiveDecodeSizeAbsolute,
             * libarchive.c:273): pArchiveEntry = nOffset + g_ArchiveTable
             * (cell 0x8004FDF0); with the cell wiped to 0 by this very
             * restore (pristine image initial value = 0; runtime-set
             * healthy by the game's own archive install, [archbase] R1100
             * receipts "runtime-set healthy then wiped" every cycle), the
             * decode reads NULL+nOffset -> crash addrs 0x4/0x5/0x6/0x8/0xB
             * receipted across start/CD_sync/Vsync/CheckCallback/coordinator
             * this era. Healthy value 0x80010004 = the game's own install
             * value ([ftab]/[stab]/[archbase] base receipt every cycle;
             * R1061: real table 0x80010004). Only fires when the cell is
             * NULL - the game's install writes the same value; zero-stomp
             * impossible (same class/pattern as R1014 above). */
            if (xenolift_mem_read32(0x8004FDF0u) == 0u) {
                xenolift_mem_write32(0x8004FDF0u, 0x80010004u);
                crash_puts("[archseed] R1109 g_ArchiveTable(4FDF0) re-seeded 0 -> 80010004 post-restore (game's own install value; ArchiveDecodeSizeAbsolute NULL-deref class; c287 receipts)\n");
            }
            xenolift_psyqptr_heal("crash-recovery");
            xenolift_mem_write32(0x80010000u, 0xFFFFFFFFu); /* R712: resume key clear */
            xenolift_churn_pend = 0x80019524u; /* known-good boot entry */
        if (g_firstfault_stop) r1177_door_stop("longjmp-site-L20511"); /* R1178: ANY re-entry via the churn anchor is a restart; under first-fault-stop stop with the dossier instead */
        longjmp(xenolift_churn_jmp, 1);
        }
    }
    /* R820: name the death site on kit exit - the c404 deep run died on
     * handler RE-ENTRY after 4 healthy recoveries, silently; the 5th
     * crash's cur_fn tells us which door to decode next. Async-safe. */
    crash_puts("[segvdie] R820 kit exit @ cur_fn=");
    crash_puth(xenolift_cur_fn);
    crash_puts(" recoveries=");
    crash_puth((uint32_t)(r805_mirror));
    crash_puts("\n");
    _exit(99);
}

static int xenolift_real_main(int argc, char **argv);
#define XENOLIFT_GUEST_STACK (2048ull << 20) /* R261: 2GB guest thread stack */
struct xl_main_args { int argc; char **argv; int rc; };
static void *xl_main_thread(void *p)
{
    /* R1208 (Jos c24 review, coverage check): the ANCHOR thread executes all
     * guest code and receives the guest-fault signals - it must install its
     * OWN altstack + SA_ONSTACK dispositions ON ITSELF before any guest
     * dispatch (sigaltstack is per-thread; true main's install covers only
     * true main, and the c18 abort landed on faultingThread=0). The watcher
     * thread covers itself via its R831 tick re-assert. */
    xenolift_install_kit_handler(SIGSEGV);
    xenolift_install_kit_handler(SIGBUS);
    xenolift_install_kit_handler(SIGABRT);
    xenolift_install_kit_handler(SIGFPE);
    xenolift_install_kit_handler(SIGILL);
    struct xl_main_args *a = (struct xl_main_args *)p;
    a->rc = xenolift_real_main(a->argc, a->argv);
    return NULL;
}
/* R649 [exitdiag]: c219 — the run DIED at t=15s mid-file-15-install with no
 * crash-kit output ("host_pc/host_base missing"). Any early death must now
 * self-report the mount/install posture so the next digest names the state
 * at exit. Handlers are diag-only: fprintf + _exit, no guest dispatch. */
static void xenolift_exitdiag(const char *why)
{
    long age = (long)(xl_wall() - g_boot_wall_t0);
    /* R714: EPOCH EXIT CAMERA. c284-285: boot 2's era died with ZERO
     * receipts — the R713 b2exit receipt (after region() returns in the
     * R692 loop) never fired because the process ENDED INSIDE the era
     * (guest exit() from within region() re-enters exit -> never
     * returns to the loop), and every exitdiag one-shot print was spent
     * by boot 1. This entry receipt sits at BOTH exit doors (clean +
     * signal), gated epoch>=1, cap 8: every exit-path ENTRY speaks,
     * naming boot 2's death posture (which door, which fn, which file
     * counter, how many bytes were left). */
    {
        static int r714_n;
        if (xenolift_boot_epoch >= 1u && r714_n < 8) {
            r714_n++;
            r861_out("[b2x] R714 exit-door entry #%d kind=%s epoch=%u @t=%lds cur_fn=%08X F0C=%08X FDF8=%08X 92C0=%08X FAEC=%08X req18088=%08X latch92BC=%08X\n",
                    r714_n, why, xenolift_boot_epoch, age, xenolift_cur_fn,
                    xenolift_mem_read32(0x80059F0Cu), xenolift_mem_read32(0x8004FDF8u),
                    xenolift_mem_read32(0x800592C0u), xenolift_mem_read32(0x8005FAECu),
                    xenolift_mem_read32(0x80018088u), xenolift_mem_read32(0x800592BCu));
        }
    }
    r861_out("[exitdiag] exit path: %s\n", g_exit_why);
    if (g_vsync_cap_fires) r861_out("[vsynccap] R929 Vsync recursion-cap fired %u times (Vsync<->CheckCallback loop bounded; contract returns kept the unwinding sane)\n", g_vsync_cap_fires);
    r861_out("[fhelpsum] R765 module-helper services fired: %d (guard-misses: %d, fault-walk restarts: %d)\n",
            g_r765_services, g_r765_misses, g_r765_fw_restarts);
    r861_out("[exitdiag] R649 %s @t=%lds: 92C0=%08X idx(FAEC)=%08X req=%08X F0C(59F0C)=%08X F10(59F10)=%08X FE04=%08X FDF8=%08X FE1C=%08X FE20=%08X seek=%u loop28088=%08X\n",
            why, age,
            xenolift_mem_read32(0x800592C0u), xenolift_mem_read32(0x8005FAECu),
            xenolift_mem_read32(0x80018088u), xenolift_mem_read32(0x80059F0Cu),
            xenolift_mem_read32(0x80059F10u), xenolift_mem_read32(0x8004FE04u),
            xenolift_mem_read32(0x8004FDF8u), xenolift_mem_read32(0x8004FE1Cu),
            xenolift_mem_read32(0x8004FE20u), cd_seek_lba, xenolift_mem_read32(0x80028088u));
    /* R937 (b8-c43, evidence - GPU FINAL STATE AS DEATH EVIDENCE): c43 was
     * the first exit(0) run ever, and the kernel submitted real fade
     * triangles via DrawPrim ([drawcam] env+3C=80046DB4 healthy). But the
     * =SCREEN=/=GPU= digest sections live mid-digest and the R865 cap cut
     * them - the "did VRAM move" question went unanswered. Print the GPU
     * final state INSIDE exitdiag so every exit path (clean, kit door,
     * crash-kit, fault-walk) carries it as death evidence that always
     * survives the cap. */
    {
        uint64_t _vn = 0u;
        for (uint32_t _vy = 0; _vy < 512u; _vy++)
            for (uint32_t _vx = 0; _vx < 1024u; _vx += 4u)
                if (gpu_vram[_vy * 1024u + _vx] != 0u) _vn++;
        r861_out("[gpufin] R937 GPU final: gp0_words=%lu blits=%u other=%u dma2_sends=%u | VRAM nonblank regions A(0,0)=%u B(0,240)=%u C(320,0)=%u D(320,240)=%u | stride4 nonzero=%llu (pixels moved = >0)\n",
                (unsigned long)xl_gpu_writes, gpu_blit_total, gpu_gp0_other, gpu_dma2_starts,
                gpu_regnz(0, 0u), gpu_regnz(0, 240u), gpu_regnz(320, 0u), gpu_regnz(320, 240u),
                (unsigned long long)_vn);
    }
    /* R949 [asciiart] (PIXEL lane, b8-c55): player-visible evidence IN
     * THE DIGEST - render the splash sprite region (32,88)-(288,136)
     * per main_loop.c setXY0(0x20,0x58)/setWH(0x100,0x30) and a coarse
     * full-screen map as ASCII brightness. The logo becomes text. */
    {
        static const char lv[] = " .:-=coCO@";
        r861_out("[asciiart] R949 sprite region (32,88)-(288,136) 8x8 sampling:\n");
        for (uint32_t yy = 88u; yy < 136u; yy += 8u) {
            r861_out("[asciiart] |");
            for (uint32_t xx = 32u; xx < 288u; xx += 8u) {
                uint32_t acc = 0;
                for (uint32_t sy = 0; sy < 8u && yy + sy < 240u; sy++)
                    for (uint32_t sx = 0; sx < 8u; sx++) {
                        uint16_t px = gpu_vram[(yy + sy) * 1024u + xx + sx];
                        acc += (px & 0x1Fu) + ((px >> 5) & 0x1Fu) + ((px >> 10) & 0x1Fu);
                    }
                uint32_t avg = acc / 192u;
                r861_out("%c", lv[avg > 45u ? 9u : avg * 10u / 46u]);
            }
            r861_out("|\n");
        }
        r861_out("[asciiart] full screen 64x16 sampling (disp 0,0 320x240):\n");
        for (uint32_t yy = 0u; yy < 240u; yy += 15u) {
            r861_out("[asciiart] |");
            for (uint32_t xx = 0u; xx < 320u; xx += 5u) {
                uint16_t px = gpu_vram[yy * 1024u + xx];
                uint32_t b = (px & 0x1Fu) + ((px >> 5) & 0x1Fu) + ((px >> 10) & 0x1Fu);
                r861_out("%c", lv[b > 45u ? 9u : b * 10u / 46u]);
            }
            r861_out("|\n");
        }
    }
    gpu_cls_report(); /* R939: executed/dropped command census as death evidence */
}
/* R718: EXIT() OVERRIDE — the one door that cannot be bypassed.
 * c285-289: boot 2's era ends the process with NO atexit entry, NO signal
 * handler firing (SIGSEGV/BUS/ABRT/FPE/ILL/TRAP/SYS/PIPE all registered) and
 * no return from the R692 loop. The remaining silent route is libc exit()
 * called RE-ENTRANTLY from inside our atexit handler (guest shutdown from
 * within region()): glibc re-walks the already-consumed handler list and
 * _exit()s without touching any door. Defining exit() here overrides libc's
 * for the whole binary: every caller — guest path, kernel error path, or
 * the re-entry — prints its posture first, then _exit(99). */
static void xenolift_exitdiag_clean(void); /* R719 forward: the atexit door */
/* R719 INSTRUMENT-FIX (c290 lesson: an instrument must OBSERVE the door,
 * not replace it). R718's override caught boot 1's fault-exit and _exit(99)'d
 * BEFORE the atexit chain could run the R692 shell restart -> the two-boot
 * trajectory was killed by the camera itself (c290: no bootentry #2, run ended
 * t=15s). New contract: FIRST entry into exit() prints the receipt and then
 * runs the atexit door by hand (the only registered handler) — identical to
 * libc's exit() minus the recursion risk. RE-ENTRY from inside that handler
 * (the boot-2 silent-death theory: guest shutdown from within region())
 * hits the r719_in guard: print the receipt, _exit(99) — the silent death
 * finally speaks, and it CANNOT take the trajectory with it because the
 * trajectory already lives inside the handler. */
/* R720: REBOOT-REQUEST RELAY. c291 CAUGHT boot 2's killer: a re-entrant
 * exit(0) from inside the shell-restart loop, cur_fn=800392EC (sound heap
 * clear), with ALL kernel state wiped to zero (F0C=0 FDF8=0 92C0=0 FAEC=0
 * req18088=0). That posture is not a crash - it is the console's own
 * "wipe state, return to shell" reboot request. On hardware the shell
 * re-launches the program. Relay it: longjmp back to the R692 loop so a
 * third boot launches instead of the process dying. */
static jmp_buf g_r720_jb;
/* R722: pristine exe image (0x80010000..0x8006F000) captured at boot-1
 * entry; every shell-relay restores it - a real console re-loads the exe. */
static int g_r720_armed;
static volatile int g_r720_reboot;
void exit(int s)
{
    static int r718_n;
    static int r719_in;
    if (r718_n < 8) {
        r718_n++;
        r861_out("[b2x] R718/R719 exit() OVERRIDE #%d status=%d epoch=%u reentry=%d @t=%lds cur_fn=%08X F0C=%08X FDF8=%08X 92C0=%08X FAEC=%08X req18088=%08X\n",
                r718_n, s, xenolift_boot_epoch, r719_in,
                (long)(xl_wall() - g_boot_wall_t0), xenolift_cur_fn,
                xenolift_mem_read32(0x80059F0Cu), xenolift_mem_read32(0x8004FDF8u),
                xenolift_mem_read32(0x800592C0u), xenolift_mem_read32(0x8005FAECu),
                xenolift_mem_read32(0x80018088u));
        fflush(stderr);
    }
    if (r719_in) { /* re-entry from inside the door = the caught reboot request */
        if (g_r720_armed) {
            {   /* R725: HARD RELAY CAP. c296 proof: the relay longjmp can
                 * return to the shell loop WITHOUT counting toward any boot
                 * cap (halt-scan postures zero the loop's state cells, so the
                 * R692 condition lives only on g_r720_reboot) - a crashing
                 * boot ping-ponged boot->crash->relay for the FULL 204s fuse
                 * window, the log stormed past the 20MB guard, and the bridge
                 * died mid-digest with an EMPTY report. Count relays here and
                 * end the process hard after 6 - _exit skips atexit so no
                 * further recursion; run.sh parks and the digest generates. */
                static uint32_t r725_n;
                if (++r725_n > 6u) {
                    r861_out("[b2x] R725 relay cap reached (%u) - ending run cleanly so the digest generates\n", r725_n);
                    fflush(stderr);
                    _exit(0);
                }
            }
            g_r720_reboot = 1;
            {   /* R1214 (c39): CONSOLE-FAITHFUL RE-ENTRY HYGIENE. c39 receipts:
             * post-restart the game ran the state-1 FIELD machinery with the
             * file#14 module FULLY staged+expanded (fldx2: 62 sectors, LZSS
             * 260862/260862) - and then the c34-class storm killed it at the
             * boundary: fldcb callback a0=FFFFFFFF, dispatch faults at
             * 8002A68C/80041BA8, relay cells EMPTY at coordinator entry
             * (92BC=0 92C4=0 92C8=0 18098=0 vs healthy 92BC=801EF300 era).
             * Root receipted c35: this relay re-enters with "registers reset,
             * memory kept" and the R721 wipe INVERTS the kernel design - it
             * zeroes the pick cells (92C0/FAEC) while keeping stale walk state
             * (mtrans: walk mid-flight F0C=12). A real console shell RE-LOADS
             * THE EXE: pristine image restore (R846 pattern; the R698 heap-chain
             * heals live at 0x800B3xxx/0x801Fxxxx OUTSIDE the image, so their
             * persistence contract survives) + the kernel's pick cells
             * (92C0/FAEC - the committed phase) preserved across the restore +
             * resume key cleared. Post-restart boots then run the picked phase
             * on clean cells instead of the stale-state roulette. */
                uint32_t r1214_pick92c0 = xenolift_mem_read32(0x800592C0u);
                uint32_t r1214_pickfaec = xenolift_mem_read32(0x8005FAECu);
                if (g_r722_len == 0x5F000u) {
                    uint32_t r1214_o;
                    if (g_firstfault_stop) r1177_door_stop("restore-site-R1214");
                    for (r1214_o = 0; r1214_o < g_r722_len; r1214_o += 4u)
                        xenolift_mem_write32(0x80010000u + r1214_o, g_r722_img[r1214_o >> 2]);
                }
                xenolift_mem_write32(0x80010000u, 0xFFFFFFFFu); /* resume key cleared, R846 pattern */
                xenolift_mem_write32(0x800592C0u, r1214_pick92c0);
                xenolift_mem_write32(0x8005FAECu, r1214_pickfaec);
                r861_out("[b2x] R1214 re-entry hygiene: pristine image restored (0x5F000), pick preserved 92C0=%08X FAEC=%08X\n",
                        r1214_pick92c0, r1214_pickfaec);
            }
            {   /* R721 [asciiwipe]: c292 — boot 1 died in the FORMATTER era
                 * (fault target "0004" @ 80040A4C IsVSync) and its digit text
                 * ("0000"/"000i" packs) stayed in global cells after the relay:
                 * heap-top terminator 0x801FBFF0..FF, stack-top 0x801FFF28/2C,
                 * CD install cells (FDF8 read 0x30303030 = 808MB remaining).
                 * Boots 2-5 ping-ponged: enter, see text-as-numbers, exit(0)
                 * instantly at 8004B748. A real console reboot re-initializes
                 * this RAM; wipe the formatter's PROVEN write-set at the relay
                 * and re-arm the R707 heap terminator posture. */
                static const uint32_t wipe_cells[] = {
                    0x801FFF28u, 0x801FFF2Cu,
                    0x801FBFF0u, 0x801FBFF4u,
                    0x8004FDF8u, 0x8004FDFCu, 0x8004FE04u,
                    0x80018088u,
                    0x800592D0u, 0x800592BCu, 0x800592E8u, /* R1214: picks 5FAEC/92C0 removed - preserved above */
                };
                int r721_i;
                for (r721_i = 0; r721_i < (int)(sizeof(wipe_cells)/sizeof(wipe_cells[0])); r721_i++) {
                    uint32_t v = xenolift_mem_read32(wipe_cells[r721_i]);
                    if (v != 0u) {
                        xenolift_mem_write32(wipe_cells[r721_i], 0u);
                        if (r721_i < 4)
                            r861_out("[b2x] R721 relay wipe cell %08X: %08X -> 00000000 (formatter text purged)\n", wipe_cells[r721_i], v);
                    }
                }
                xenolift_mem_write32(0x801FBFF8u, 0x801FC000u);
                xenolift_mem_write32(0x801FBFFCu, 0x00200000u);
                r861_out("[b2x] R721 relay wipe done: terminator re-armed at heap-top\n");
            }
            r861_out("[b2x] R720 relayed: guest reboot request longjmp back to shell loop (boot %u next)\n", xenolift_boot_epoch + 1u);
            longjmp(g_r720_jb, 1);
        }
        /* R846 (c434): EXITDIAG DOOR CONVERSION. c434 proof: the coordinator
         * door ran ~11s of real era work (queue-init cells written by fn
         * 8003363C, heal applied), faulted at the arena walk (8003342C),
         * the crash kit recovered (segvrec R804) - and then the NEXT
         * fault-walk exit reached THIS door and _exit(99)'d at t=42s,
         * killing the window after only 2 bypass attempts. Every other
         * exit door (R765 fault-walk, R777 poison-HALT, R770 halt) converts
         * to a churn-anchor restart; this was the last door that still
         * kills. Convert: pristine image + resume-key clear + longjmp to
         * the churn anchor, cap 8/run (beyond cap, the honest _exit). */
        {
            static int r846_convs;
            if (xenolift_churn_armed && r846_convs < 8) {
                r846_convs++;
                if (g_r722_len == 0x5F000u) {
                    uint32_t __o;
                    if (g_firstfault_stop) r1177_door_stop("restore-site-L20718"); /* R1177: pristine-image restore + re-entry = RESTART; stop with dossier under first-fault-stop */
                    for (__o = 0; __o < g_r722_len; __o += 4u) xenolift_mem_write32(0x80010000u + __o, g_r722_img[__o >> 2]);
                }
                xenolift_mem_write32(0x80010000u, 0xFFFFFFFFu);
                r861_out("[bypassrec] R846 EXITDIAG RESTART CONVERSION #%d (fault-walk exit -> churn anchor restart; window keeps working)\n", r846_convs);
                fflush(stderr);
                xenolift_churn_pend = 0x80019524u;
                g_guest_depth = 0; /* R885: kit unwound out of guest step */
        if (g_firstfault_stop) r1177_door_stop("longjmp-site-L20746"); /* R1178: ANY re-entry via the churn anchor is a restart; under first-fault-stop stop with the dossier instead */
        longjmp(xenolift_churn_jmp, 1);
            }
        }
        _exit(99);
    }
    r719_in = 1;
    xenolift_exitdiag_clean(); /* the atexit door, by hand — R692 restart lives here */
    _exit(s);
}

static void xenolift_exitdiag_clean(void) {
    xenolift_exitdiag("atexit-clean-return");
    /* R692: SHELL RESTART AT THE ATEXIT DOOR. c263 proof: the kernel menu
     * era ends with a clean main-return MID-WALK (F0C=15, f15 install
     * FDF8=0x13014 in flight, FE04=109041, field committed) — on hardware
     * the console shell re-enters the program and the mount walk continues
     * on the next boot. R678's restart catches only the tail of
     * xenolift_real_main; the guest's exit() reaches THIS door first and
     * the process died with the walk unfinished (c243 + c263 identical).
     * Emulate the shell here: re-enter the boot chain, loop while the walk
     * still has field work in flight, cap 4 boots, and never start a fresh
     * boot inside the last 25s of the fuse window. */
    {
        static uint32_t r692_n;
        /* R1176 (c364 dossier): under XENOLIFT_FIRSTFAULT_STOP the budget alarm's exit is TERMINAL - no shell reboot.
         * c364 proof: boot 1 ran the full 150s budget with ZERO guest faults; the only stop fired INSIDE this door
         * (on_alarm -> exit -> exitdiag_clean -> xenolift_fn_80019590 boot-2 entry -> fault @01A0000C). A reboot at
         * the run-end alarm is restart scaffolding, not game behavior, and it forged a "first fault" that the game never had. */
        while (!g_firstfault_stop &&
               r692_n < 4u &&
               ((long)(xl_wall() - g_boot_wall_t0)) < 180 &&
               (xenolift_mem_read32(0x800592C0u) == 1u ||
                xenolift_mem_read32(0x8005FAECu) >= 1u ||
                g_r720_reboot ||
                /* R771/R774: c350 - the kernel's own WATCHDOG-ALARM exit (kind
                 * g_exit_why=="watchdog-alarm") arrives with the walk flags
                 * ZEROED (92C0=0 FAEC=0) even mid-walk (F0C=7). On hardware
                 * the alarm reboot = the shell re-enters the program.
                 * R774 fix: the epoch>=1 guard from c350 is WRONG - the
                 * fault-walk restart door does NOT bump xenolift_boot_epoch,
                 * so a post-restart alarm exit still reads epoch=0 and the
                 * run died at 39s (c353). The alarm is a reboot request on
                 * ANY boot (Lesson 81: never condition a restart door on a
                 * counter that other restart doors don't maintain). Same
                 * cap 4 and 180s fuse guard as the field-work restarts. */
                (g_exit_why && g_exit_why[0] == 'w'))) {
            r692_n++;
            /* R1221 (c53): CONSUME THE ALARM REASON - one restart per exit
             * reason. c53 receipts: the R692 loop fired RESTART #1 and #2
             * back-to-back at the same atexit instant (t=55s), because the
             * watchdog-alarm loop condition (g_exit_why[0]=='w') is STICKY:
             * g_exit_why is set at the alarm site and never cleared, so when
             * restart #1's fresh-boot chain bailed instantly (b2exit
             * era-returned, loader block zeroed) the loop re-evaluated,
             * matched the SAME alarm again (restart #2's own receipt shows
             * the all-zeroed posture F0C=FDF8=FE04=0 - no other condition
             * could have matched), and re-ran the full reboot+wipe chain
             * (event-table install, 800358BC global wipe, baserase R1212 of
             * the archive base cell, loader-block zero) - DESTROYING the
             * state table restart #1's chain had just populated (statetbl
             * R1104: 7 pFnMain states incl. KernelMenuMain, active state 0).
             * The era that then runs on #2's half-state dies 30s later in
             * CheckCallback with the zeroed callback infra (cb=0, r4=-1).
             * Consume the reason HERE, at fire time: a single alarm exit
             * causes exactly ONE shell restart; a genuinely NEW watchdog
             * alarm exit re-sets g_exit_why at the alarm site and earns its
             * own restart (per-alarm semantics, not per-evaluation). The
             * posture conditions (92C0/FAEC/r720) are unaffected - they
             * change with the boot itself. */
            g_exit_why = NULL;
            r861_out("[mtrans] R692 shell RESTART #%u at atexit door @t=%lds (walk mid-flight: F0C=%08X FDF8=%08X FE04=%08X) - console shell re-enters the program\n",
                    r692_n, (long)(xl_wall() - g_boot_wall_t0),
                    xenolift_mem_read32(0x80059F0Cu), xenolift_mem_read32(0x8004FDF8u),
                    xenolift_mem_read32(0x8004FE04u));
            { uint32_t _qi; for (_qi = 0; _qi < 32; _qi++) r[_qi] = 0; }
            r[31] = 0; hi = lo = 0;
            /* R711: THE MISSING STACK. c282's bootentry receipt proved boot 2
             * genuinely enters the exe entry (epoch=1 t=15s) - and then dies
             * wordlessly: this register wipe also destroyed sp, so the entry
             * stub's first stack push wrote to ~address zero. The console
             * shell re-enters the exe with a FRESH STACK at the top of RAM.
             * Restore it: r[29] = 0x801FFF00 (the 0x801FFF60-family frames
             * the spguard has observed all run). */
            r[29] = 0x801FFF00u;
            /* R712: CLEAR THE RESUME KEY. c283: even with the stack restored,
             * boot 2 enters the exe (bootentry #2 epoch=1) and still returns
             * wordlessly within 1s - the key cell 0x80010000 (=1, stamped by
             * R637 during boot 1's era) routes the entry down a resume path
             * that exits immediately. The console shell leaves RAM intact,
             * but the ONE path we have never observed is the FRESH boot:
             * clear the key so boot 2 re-runs the full chain (BSS clear,
             * init, menu era, virtual player confirm, transition) where
             * every probe is already watching. */
            xenolift_mem_write32(0x80010000u, 0xFFFFFFFFu);
            r861_out("[mtrans] R712 resume key cleared at restart (boot %u takes the FRESH boot path)\n", xenolift_boot_epoch + 1u);
            /* R1216 (c40, Jos directive): PICK PRESERVATION + POST-RESTORE MARKER at
             * the ACTUAL R692 atexit door. The R722 restore below wipes the kernel's
             * committed pick cells (92C0/FAEC both inside 0x80010000..0x8006F000), but
             * this branch's own restart condition and the c246-251 kernel design treat
             * the pick as what the re-entry continues from. Save both picks before the
             * restore; write them back after; the marker receipts restart-time F0C
             * AFTER the restore (the pre-restore R692 print was never staleness
             * evidence by construction). c40 receipts: the R1214 attempt landed on the
             * R720 relay branch which never fires - an APPLIED receipt alone cannot
             * validate placement; this block sits inside the observed door's loop body. */
            uint32_t r1216_pick92c0 = xenolift_mem_read32(0x800592C0u);
            uint32_t r1216_pickfaec = xenolift_mem_read32(0x8005FAECu);
            if (g_r722_len == 0x5F000u) { /* R722: console-faithful shell re-boot -
             * c293 proof: relayed boots 3+ insta-died on a NULL task jump
             * (wildctx: unresolved jump 0x00000000 in the 8004B748 scheduler)
             * and the [disc] SLUS LOAD LINE was missing on re-boots - the shell
             * re-enters WITHOUT re-loading the exe image, so .data holds the
             * old boot's state and the scheduler dispatches a dead callback.
             * Real hardware re-loads the whole exe: restore the pristine
             * image captured at boot-1 entry before the next launch. */
                uint32_t __o;
                if (g_firstfault_stop) r1177_door_stop("restore-site-L20806"); /* R1177: pristine-image restore + re-entry = RESTART; stop with dossier under first-fault-stop */
                for (__o = 0; __o < g_r722_len; __o += 4u) xenolift_mem_write32(0x80010000u + __o, g_r722_img[__o >> 2]);
                xenolift_mem_write32(0x80010000u, 0xFFFFFFFFu); /* re-clear the resume key after restore */
                r861_out("[b2x] R722 exe image restored @relay (0x80010000..0x8006F000) + key re-cleared - console-faithful re-boot\n");
            }
            xenolift_mem_write32(0x800592C0u, r1216_pick92c0); /* R1216: picks restored after the image restore */
            xenolift_mem_write32(0x8005FAECu, r1216_pickfaec);
            r861_out("[b2x] R1216 re-entry hygiene EXECUTED @R692 door: picks preserved 92C0=%08X FAEC=%08X | post-restore F0C=%08X FDF8=%08X FE04=%08X\n",
                    r1216_pick92c0, r1216_pickfaec,
                    xenolift_mem_read32(0x80059F0Cu), xenolift_mem_read32(0x8004FDF8u),
                    xenolift_mem_read32(0x8004FE04u));
            xenolift_boot_epoch++; g_in_park = 0; g_park_stage = 0; /* R1213: park latch reset at program re-launch (c37 relay-escapee fix) */
            g_menu_seen = 0u; g_menu_press_state = 0u; g_menu_frames = 0u;
            r861_out("[mtrans] R693 boot-epoch %u: virtual player re-armed (menu confirm + CHANNEL F one-shots reset for the new boot)\n", xenolift_boot_epoch);
            {   /* R707 [boot2]: heartbeat after the shell restart - where does
                 * boot 2 go, what does it execute, what stops it? 1s cadence, 8 max. */
                static time_t b2_t0; static int b2_n;
                if (b2_n == 0) b2_t0 = xl_wall();
                if (b2_n < 8 && (long)(xl_wall() - b2_t0) >= b2_n) {
                    r861_out("[boot2] R707 heartbeat #%d @+%lds: cur_fn=%08X 92C0=%08X FAEC=%08X 18088=%08X F0C=%08X 92D0=%08X\n",
                            b2_n, (long)(xl_wall() - b2_t0), xenolift_cur_fn,
                            xenolift_mem_read32(0x800592C0u), xenolift_mem_read32(0x8005FAECu),
                            xenolift_mem_read32(0x80018088u), xenolift_mem_read32(0x80059F0Cu),
                            xenolift_mem_read32(0x800592D0u));
                    b2_n++;
                }
            }

            {   /* R720: arm the relay so a guest exit(0) becomes boot N+1 */
                g_r720_reboot = 0;
                g_r720_armed = 1;
                if (setjmp(g_r720_jb) == 0) xenolift_region();
                g_r720_armed = 0;
            }
            /* R713 [b2exit]: boot 2's era returned - its exit receipts were
             * cap-silenced (exitdiag/R649 statics spent by boot 1), so its
             * final posture was a black box. Dump it HERE, every restart. */
            r861_out("[b2exit] R713 epoch=%u era-returned @t=%lds: last cur_fn=%08X F0C=%08X FDF8=%08X 92C0=%08X FAEC=%08X req(8088)=%08X latch(92BC)=%08X 92D0=%08X key(10000)=%08X\n",
                    xenolift_boot_epoch,
