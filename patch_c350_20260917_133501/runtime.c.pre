                for (int r1118_i = 0; r1118_i < 11; r1118_i++) {
                    uint32_t r1118_w;
                    memcpy(&r1118_w, &xenolift_mem[(0x80077FA0u + 4u * r1118_i) & 0x1FFFFFFu], 4u);
                    r861_out("[fldcam] R1118 %08X: %08X\n", 0x80077FA0u + 4u * r1118_i, r1118_w);
                }
                /* R1119 (b8-c299): complete the decode chain. c299 fldcam
                 * decode: FieldMain+0x12C jal FieldPartyAllocateSkinDataBuffers
                 * (0x80077C88, decomp-matched), +0x134 lw v1,0x800C268C (module
                 * global = dispatch-table base candidate), +0x140 lui at,0x800B
                 * = indirect-dispatch prep; the following call lands in
                 * FieldMain itself AND in decoded-data-as-code (cur_fn
                 * 0x800B109C executing data words, r31=0x80077FC8, c299
                 * CRITADDR receipts) = the unrebased-pointer class with a
                 * receipted table address. Dump the rest of the dispatch
                 * sequence (0x80077FCC..0x80077FF0) and the candidate table
                 * head at 0x800C268C..0x800C26AC so the rebasing fix ships
                 * with source-proven cells, not guesses. */
                for (int r1119_i = 0; r1119_i < 10; r1119_i++) {
                    uint32_t r1119_w;
                    memcpy(&r1119_w, &xenolift_mem[(0x80077FCCu + 4u * r1119_i) & 0x1FFFFFFu], 4u);
                    r861_out("[fldcam] R1119 %08X: %08X\n", 0x80077FCCu + 4u * r1119_i, r1119_w);
                }
                for (int r1119_j = 0; r1119_j < 11; r1119_j++) {
                    uint32_t r1119_w;
                    memcpy(&r1119_w, &xenolift_mem[(0x800C268Cu + 4u * r1119_j) & 0x1FFFFFFu], 4u);
                    r861_out("[fldcam] R1119 tbl %08X: %08X\n", 0x800C268Cu + 4u * r1119_j, r1119_w);
                }
                /* R1120 (b8-c300): PARTY SKIN BUFFER RECEIPT. c300 decode:
                 * FieldMain+0x12C jal 0x80077C88 = FieldPartyAllocateSkinDataBuffers
                 * (decomp main.c:47-49): g_PartyDataBuffers[0..2] = HeapAlloc
                 * (0x14000, 0) each from HEAP_USER_YOSI, at 0x8005A414..0x8005A41C
                 * (decomp symbol map). The c299/c300 crash class (jr into
                 * heap+small offsets, e.g. 0x801400B8, with stale r31) runs
                 * through uninitialized heap memory; the field loaders never
                 * call the entry-pointer walker (decomp grep: field module
                 * uses plain ArchiveReadFileToBuffer, misc8.c:147) - so the
                 * crash targets are NOT unrebased-walker blobs. Photograph the
                 * three buffer cells at FieldMain entry: null = HeapAlloc
                 * failed, pointer = alloc healthy (then the population path
                 * becomes the decode). */
                {
                    uint32_t r1120_b[3]; int r1120_k;
                    for (r1120_k = 0; r1120_k < 3; r1120_k++)
                        memcpy(&r1120_b[r1120_k], &xenolift_mem[(0x8005A414u + 4u * r1120_k) & 0x1FFFFFFu], 4u);
                    r861_out("[fldcam] R1120 party bufs 8005A414: %08X %08X %08X\n", r1120_b[0], r1120_b[1], r1120_b[2]);
                }
            }
        }
