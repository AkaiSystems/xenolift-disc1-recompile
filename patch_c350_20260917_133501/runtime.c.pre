    static uint32_t last_park; static int defers;
    /* R314: GLOBAL RUN BUDGET — the bridge kills the run at 240s (SIGKILL, no
     * park, mangled evidence; cycles 61-62). No liveness defer may extend the
     * run past ~205s: we always want OUR graceful HALT + park, never the kill. */
    {   /* R801 [bwalk] BOOT-FILE REQUEST STAMP (c384): boot 2's fresh
         * install chain derailed at file 7 - the kernel's file-cb walk set
         * F0C=7 but the request cells stayed PRISTINE (FDF8=0, FE04=4 = the
         * R722 exe-restore value), no read ever armed, the game's OWN
         * watchdog alarm fired at t=93s and the shell exited. Same class
         * as the R648 f15 stamp: when a boot-family file request stalls
         * with empty cells, stamp FE04 (LBA) + FDF8 (size) from the FAT we
         * decoded (ATLAS receipts) so the kernel can arm its read. Guarded:
         * F0C in the boot family 2..15, FDF8==0, FE04 pristine (<1000),
         * stall seen on 3 consecutive wd ticks (~6s) to avoid racing the
         * walk's own arming. */
        static uint32_t r801_ticks;
        static const uint32_t r801_lba[16] = {0,0,108754u,108785u,108861u,108873u,108884u,108886u,0,0,0,0,108893u,0,108933u,108995u};
        static const uint32_t r801_sz[16]  = {0,0,61680u,155120u,23744u,21984u,2660u,13768u,0,0,0,0,80284u,0,125304u,92180u};
        uint32_t f0c = xenolift_mem_read32(0x80059F0Cu);
        uint32_t fdf8 = xenolift_mem_read32(0x8004FDF8u /* R1175: was 0x80059FDF8u (nine-digit typo, faulting class) */);
        uint32_t fe04 = xenolift_mem_read32(0x8004FE04u);
        if (f0c >= 2u && f0c <= 15u && r801_lba[f0c] != 0u
            && fdf8 == 0u && fe04 < 1000u) {
            if (++r801_ticks >= 3u) {
                xenolift_mem_write32(0x8004FE04u, r801_lba[f0c]);
                xenolift_mem_write32(0x80059FDF8u, r801_sz[f0c]);
                r861_out("[bwalk] R801 BOOT-FILE STAMP: file %u request stalled with pristine cells (FDF8=0 FE04=%u) - stamped LBA=%u size=%u from the decoded FAT; kernel can arm its read\n",
                        f0c, fe04, r801_lba[f0c], r801_sz[f0c]);
                r801_ticks = 0u;
            }
        } else r801_ticks = 0u;
    }
    {   /* R800 [mpad] IDLE-MENU FALLBACK (c383): the boot race can leave the
         * kernel sitting in its own debug menu (92C0=1) with ZERO disc
         * activity and NO header render - the R371 virtual player waits for
         * a FontVPrintf(0x800182C0) that never comes, so the run idles the
         * whole window (c383: 175s, no disc reads, no mount cells, no field
         * era; c382 the same boot reached the file-18 era = pure race). Press
         * CONFIRM anyway: jump straight to the held-press state 2 (the
         * dispatch-level hold rewrites the X bytes every dispatch; a real
         * menu render later advances the 12-frame release normally). Guarded
         * against healthy boots: t>=30s + zero fd ticks (healthy boots read
         * discs by t=8s) + header never seen + press state 0. */
        if (!g_r800_idle_done && !g_menu_seen && g_menu_press_state == 0u
            && xenolift_mem_read32(0x800592C0u) == 1u
            && g_fd_ticks_global == 0u
            && (run_now - g_boot_wall_t0) >= 30) {
            g_r800_idle_done = 1u;
            g_menu_seen = 1u;
            g_menu_press_state = 2u;
            g_menu_frames = 2u;
            r861_out("[mpad] R800 IDLE-MENU FALLBACK fired @t=%lds: kernel idle at menu state 1, zero disc activity, no header render - virtual player pressing CONFIRM\n",
                    (long)(run_now - g_boot_wall_t0));
        }
    }
    {   /* R709 [boot2b]: watchdog-tick heartbeat - boot 2's whole era runs
         * inside ONE restart-loop pass, so the in-loop R707 heartbeat only
         * ever printed #0. Observe from the wd tick instead: every 1s while
         * a boot epoch >= 1 is live, 12 lines max. */
        static int r709_n; static time_t r709_t0;
        if (xenolift_boot_epoch >= 1u) {
            if (r709_n == 0) { r709_t0 = xl_wall(); }
            if (r709_n < 24 && (long)(xl_wall() - r709_t0) >= r709_n) {
                r861_out("[boot2b] R709 epoch=%u #b%d @+%lds: cur_fn=%08X 92C0=%08X FAEC=%08X 18088=%08X F0C=%08X FDF8=%08X 92D0=%08X latch92BC=%08X\n",
                        xenolift_boot_epoch, r709_n, (long)(xl_wall() - r709_t0), xenolift_cur_fn,
                        xenolift_mem_read32(0x800592C0u), xenolift_mem_read32(0x8005FAECu),
                        xenolift_mem_read32(0x80018088u), xenolift_mem_read32(0x80059F0Cu),
