                 * lui/addiu pairs). One-shot: dump the module's arg structs
                 * (constants from the caller code - their content is real
                 * hardware state via the fingerprint-folded capture) and scan
                 * below our map base for the module's true expected range.
                 * The 0x801D2xxx values inside the structs give the exact
                 * stage-2 base to shift the fldreloc2 expansion to. */
                {
                    static int r788_done;
                    if (!r788_done) {
                        r788_done = 1;
                        r861_out("[stage2p] R788 struct@800AC808:");
                        for (int i = 0; i < 16; i++)
                            r861_out(" %08X", xenolift_mem_read32(0x800AC808u + 4u*(uint32_t)i));
                        r861_out("\n");
                        r861_out("[stage2p] R788 struct@800ABD38:");
                        for (int i = 0; i < 16; i++)
                            r861_out(" %08X", xenolift_mem_read32(0x800ABD38u + 4u*(uint32_t)i));
                        r861_out("\n");
                        r861_out("[stage2p] R788 below-map 801D2D00-801D3000:");
                        for (int i = 0; i < 16; i++)
                            r861_out(" %08X", xenolift_mem_read32(0x801D2D00u + 8u*(uint32_t)i));
                        r861_out("\n");
                        r861_out("[stage2p] R788 map-head 801D3000:");
                        for (int i = 0; i < 16; i++)
                            r861_out(" %08X", xenolift_mem_read32(0x801D3000u + 4u*(uint32_t)i));
                        r861_out("\n");
                    }
                }
            }
