                    case 18u: { /* COP2: MFC2(0)/CFC2(2)/MTC2(4)/CTC2(6)/GTE cmd */
                        uint32_t c2rs = (w >> 21) & 31u;
                        if (c2rs == 0u) r[rt] = hle_gte_read_data((int)rd);
                        else if (c2rs == 2u) r[rt] = hle_gte_read_ctrl((int)rd);
                        else if (c2rs == 4u) hle_gte_write_data((int)rd, r[rt]);
                        else if (c2rs == 6u) hle_gte_write_ctrl((int)rd, r[rt]);
                        else hle_gte_execute(w);
                        break;
                    }
                    default:
                        r861_out("[spexec] R759 UNSUPPORTED op=%u @%08X word=%08X (executing %d instrs)\n", op, pc, w, n);
                        ok = 0;
                        break;
                    }
                    if (!ok) break;
                    if (r[0] != 0u) r[0] = 0u;
                    if (taken) {
                        /* delay slot: execute ONE simple (non-branch) instr */
                        uint32_t wd; memcpy(&wd, xenolift_mem + XENOLIFT_RAM_SIZE + (pc + 4u - splo), 4);
                        int wd_ok = 1;
                        uint32_t dop = wd >> 26, drs = (wd >> 21) & 31u, drt = (wd >> 16) & 31u;
                        int32_t dimm = (int16_t)wd;
                        if (wd == 0u) { /* nop */ }
                        else if (dop == 8u || dop == 9u) r[drt] = r[drs] + (uint32_t)dimm;
                        else if (dop == 15u) r[drt] = ((uint16_t)wd) << 16;
                        else if (dop == 13u) r[drt] = r[drs] | (uint32_t)((uint16_t)wd);
                        else if (dop == 12u) r[drt] = r[drs] & (uint32_t)((uint16_t)wd);
                        else if (dop == 35u) { uint32_t da = r[drs] + (uint32_t)dimm, dv = 0; if (da >= 0x1F800000u && da < 0x1F801000u) memcpy(&dv, xenolift_mem + XENOLIFT_RAM_SIZE + (da - 0x1F800000u), 4); else if (da >= 0x80000000u && da < 0x80000000u + XENOLIFT_RAM_SIZE) memcpy(&dv, xenolift_mem + (da & 0x1FFFFFFFu), 4); else dv = xenolift_mem_read32(da); r[drt] = dv; }
                        else { r861_out("[spexec] R759 branch delay-slot op=%u unsupported @%08X - skipping slot\n", dop, pc + 4u); wd_ok = 0; }
                        (void)wd_ok;
                        if (r[0] != 0u) r[0] = 0u;
                        pc = branch_t;
                    } else pc += 4u;
                }
                if (n >= 64) r861_out("[spexec] R759 cap 64 reached at pc=%08X - stopping (service-as-return)\n", pc);
                r861_out("[spexec] R759 SERVICE: scratchpad jump serviced (stub executed %d instrs; guest continues)\n", n);
                return; /* R759: SERVICE — continue execution like bios_hook */
            }
                /* R743: the stub TEMPLATE table (0x800AA3F0, inside file#4's
                 * loaded image 0x800A49E8+0x5A08) - the entry copies from
                 * here; photo names the source bytes. */
                r861_out("[spstub] R743 template table @800AA3F0..800AA440:");
                for (int i = 0; i < 20; i++)
