                  for (uint32_t a2 = 0x80019BE0u; a2 < 0x80019C40u; a2 += 4u)
                    r861_out(" %08X@%08X", xenolift_mem_read32(a2), a2);
                  r861_out("\n[wildhdr] R730 module head @801D3000..801D3080:");
                  for (uint32_t a2 = 0x801D3000u; a2 < 0x801D3080u; a2 += 4u)
                    r861_out(" %08X", xenolift_mem_read32(a2));
                  r861_out("\n[wildhdr] R730 crash-site ctx @801D2D2C..801D2DAC:");
                  for (uint32_t a2 = 0x801D2D2Cu; a2 < 0x801D2DACu; a2 += 4u)
                    r861_out(" %08X", xenolift_mem_read32(a2));
                  r861_out("\n[wildhdr] R730 near-miss cells (801D2D00-801D2DFF):");
                  { int hits = 0;
                    for (uint32_t off = 0; off < 0x200000u && hits < 8; off += 4u) {
                      uint32_t w; memcpy(&w, xenolift_mem + off, 4);
                      if (w >= 0x801D2D00u && w <= 0x801D2DFFu) { r861_out(" @%08X=%08X", 0x80000000u + off, w); hits++; }
                    }
                    r861_out("%s\n", hits ? "" : " (none)");
                  }
                  /* R731 [wildhdr2]: c303 decode - caller chain PROVEN:
                   * 80019BFC lw r2,[r17] (r17=0x8001809C queue cb-cell) then
                   * 80019C04 jalr r2, return 80019C0C = fault's r31 EXACTLY.
                   * Two theories left: (A) [0x8001809C] held the bad pointer at
                   * the jalr and got rewritten by the t=15s relay restore before
                   * the scan ran (descw2 #9-14 r31=0 = relay writes); (B) the
                   * jalr went to the coordinator and the WILD jump is the disc
