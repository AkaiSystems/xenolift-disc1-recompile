                if (!spin_kick_busy) {
                uint32_t sr[32]; uint32_t shi, slo;
                spin_kick_busy = 1;
                memcpy(sr, r, sizeof r); shi = hi; slo = lo;
                /* R160: full register-file + hi/lo save/restore, same
                 * mid-read crash class as the spin-conv. */
                if (cd_data_pos < cd_data_n) {
                    r861_out("[cd] spin-kick: discarding stale FIFO leftover (%u bytes, request done)\n",
                            cd_data_n - cd_data_pos);
                    cd_data_pos = cd_data_n = 0;
                cd_data_loaded = 0; /* R167: flag stuck 1 = starved demand */
                    cd_arm_int1_pending = 0;
                    cd_pending = 0;
                }
                r861_out("[cd] spin-kick: queued request FE04=0x%08X unserved (seek=%u) — dispatching h2\n",
                        fe04_spin, cd_seek_lba);
                if (!r1179_forge_blocked("L5425")) { g_guest_depth++, xenolift_dispatch(0x800415B4u), g_guest_depth--; }
                {
                    uint32_t h2 = xenolift_mem_read32(0x800564A8u);
                    if (h2 < 0x80010000u || h2 >= 0x80060000u) {
                        h2 = 0x8002A68Cu; /* R164: known h2 fallback */
                        r861_out("[cd] spin-kick: slot cell blank — using known h2 0x8002A68C\n");
                    }
                    {
                        r[4] = xenolift_mem[0x56788];
                        r[5] = 0x8005A210u;
                        if (midstream_stall) {
                    uint32_t h4 = xenolift_mem_read32(0x800564ACu);
                    uint32_t save4 = r[4], save5 = r[5];
                    if (h4 < 0x80010000u || h4 >= 0x80060000u) {
                        h4 = 0x8002B084u; /* R168: known h4 fallback */
                        r861_out("[cd] spin-drain: h4 cell blank — using known 0x8002B084\n");
                    }
                    r[4] = xenolift_mem[0x56789];
                    r[5] = 0x8005A218u;
                    r861_out("[cd] spin-drain: mid-stream stall (LBA %u, FDF8 %u, fifo %u/%u) — dispatching h4 0x%08X\n",
                            cd_seek_lba, xenolift_mem_read32(0x8004FDF8u),
                            cd_data_pos, cd_data_n, h4);
                    if (!r1179_forge_blocked("spin-L5476")) { g_guest_depth++, xenolift_dispatch(h4), g_guest_depth--; }
                    r[4] = save4; r[5] = save5; /* restore h2's args */
                }
                r861_out("[cd] spin-kick: dispatch h2 0x%08X (a0=%u)\n", h2, r[4]);
                        r861_out("[cd] spin-kick: pre-h2: FE14=%08X FE08=%08X FE38=%08X gate48=%08X struct=%08X node0=%08X\n",
                                xenolift_mem_read32(0x8004FE14u), xenolift_mem_read32(0x8004FE08u),
                                xenolift_mem_read32(0x8004FE38u), xenolift_mem_read32(0x8004FE48u),
                                xenolift_mem_read32(0x80059EF8u), xenolift_mem_read32(0x80059F10u));
                        if (!r1179_forge_blocked("spin-L5484")) { g_guest_depth++, xenolift_dispatch(h2), g_guest_depth--; }
                    }
                }
                memcpy(r, sr, sizeof r); hi = shi; lo = slo;
                spin_kick_busy = 0;
                }
            }
        }
        }
    }

    /* VBlank heartbeat: the game polls the task-queue busy flag at
     * 0x8006957C in a tight loop (fn 0x8003BDFC, bit 4). On real
     * hardware its task processor runs from a 60 Hz VBlank callback.
     * Deliver a synthetic VBlank (class F0000001) to all enabled
     * events after many polls. The spin loop reloads every register
     * each iteration, so resuming mid-loop after the handler is safe. */
    /* NOTE: fn_8003BDFC polls the busy flag via lui 0x8006 + lhu with
     * SIGNED imm 0x957C = -0x6A84 -> actual address 0x8005957C (not
     * 0x8006957C). Hook both spellings. */
    /* R1194 (c483) WEDGE-SPIN READ CAMERA: c483 receipts froze the wedge
     * at cur_fn=0x800404B4 with gate-calls=727 (no gate activity), and the
     * decoded notifier chain (0x8003BB64 -> entry callback -> DIRECT call to
     * ProcessSoundTransferCommand 0x8003BE68 - no dispatch, so cur_fn never
     * updates) puts the spin INSIDE the SPU-transfer-queue advance. What the
     * spin actually polls is unreceipted; this camera names it. When the R967
     * streak >= 5 (10s wedged in one fn), log the next 16 reads this hook
     * serves - the spin reloads its poll cells every iteration, so the
     * camera catches the loop's exact targets. Cap 16, one wedge per run. */
    if (g_r1194_wedge_streak >= 5u) {
        static uint32_t r1194_n; static uint32_t r1194_wedge_id;
        if (r1194_wedge_id != g_r1194_wedge_streak / 5u) { r1194_wedge_id = g_r1194_wedge_streak / 5u; r1194_n = 0; }
        if (r1194_n < 16u) {
            r1194_n++;
            r861_out("[wedgespin] R1194 read16 off=0x%06X (cur_fn 0x%08X depth=%d streak=%u)\n",
                    off, (unsigned)xenolift_cur_fn, g_guest_depth, g_r1194_wedge_streak);
        }
    }
    if (off == 0x6957Cu || off == 0x5957Cu)
        xenolift_vblank_heartbeat();
    if (off >= XENOLIFT_RAM_SIZE && io_special_read(io_phys(off), &tmp)) {
        io_log(io_phys(off), 0, tmp);
        return tmp & 0xFFFFu;
    }
    memcpy(&v, xenolift_mem + off, 2);
    if (off >= XENOLIFT_RAM_SIZE) {
        io_log(io_phys(off), 0, v);
    }
    return v;
}

uint32_t xenolift_mem_read8(uint32_t a)
{
    g_r1195_r8_hits++; /* R1195: total hook hits BEFORE any early return */
    if (g_r1194_wedge_streak >= 5u) {
        static uint32_t seen[16]; static uint32_t sn;
        uint32_t dup = 0;
        for (uint32_t i = 0; i < sn; i++) if (seen[i] == a) { dup = 1; break; }
        if (!dup && sn < 16u) { seen[sn++] = a;
            r861_out("[wedgespin] R1195 read8 a=0x%08X (cur_fn 0x%08X depth=%d streak=%u hits=%u)\n",
                    a, (unsigned)xenolift_cur_fn, g_guest_depth, g_r1194_wedge_streak, g_r1195_r8_hits);
