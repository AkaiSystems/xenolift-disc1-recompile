             * (cd_pending cleared) before we run the pair — on real HW
             * the IRQ handler reads the flag WHILE SET, then acks. Re-
             * assert it for the handler; its own code acks when done. */
            cd_pending = 1;
            r861_out("[cd] CD IRQ handler pair dispatch (INT1 re-asserted, LBA %u)\n", cd_seek_lba);
            uint32_t sr[32]; uint32_t shi, slo;
            memcpy(sr, r, sizeof r); shi = hi; slo = lo;
            if (!r1179_forge_blocked("L18519")) { g_guest_depth++, xenolift_dispatch(0x800409E4u), g_guest_depth--; }
            if (!r1179_forge_blocked("L18520")) { g_guest_depth++, xenolift_dispatch(0x80040A4Cu), g_guest_depth--; }
            memcpy(r, sr, sizeof r); hi = shi; lo = slo;
        }
        cd_index = saved_bank; /* pump restores the bank after collecting */
        /* Request-complete exit: the notify chain (fn 0x8002A394) set the
         * CDFS state cell FE1C=5 ("read finished, result pending for the
         * file layer"). In the synchronous-read path the file layer is
         * blocked in fn 0x80028A60, which only returns when FE1C==0 —
         * on real hardware the kernel's thread switcher (the event walk
         * in fn 0x8003A68C) wakes the waiter. We can't switch stacks, so
         * give it the same nudge the Setmode cycle gets: only when the
         * whole request drained (FDF8==0) and the completion state is
         * pending, release the wait so the file layer picks up its
         * result struct (filled at 0x80059F10 by the notify). */
        if (xenolift_mem_read32(0x8004FE1Cu) == 5u
            && xenolift_mem_read32(0x8004FDF8u) == 0u) {
            uint32_t zero = 0;
            memcpy(xenolift_mem + (0x8004FE1Cu & 0x1FFFFFFFu), &zero, 4);
            r861_out("[cd] read complete: FE1C 5 -> 0, releasing the file layer's wait\n");
        }
        cd_tick_busy = 0; /* R111 */
    }
    /* Second async-wait cell: FDFC (0x8004FDFC) = "async command in
     * flight". Setloc and friends complete in interrupt context on real
     * hardware; without IRQs the wait loop (fn 0x800286CC) polls it
     * forever BEFORE any delivery trigger (cdsync etc.) can run, since
     * the FDFC check short-circuits the loop. Force-complete the wait on
     * loop entry when a scheduled response never got a delivery trigger:
     * deliver it now (flag for the next pump pass to consume) and clear
     * FDFC so the kernel's own flow proceeds. */
    if (a == 0x800286CCu && cd_scheduled && cd_pending == 0u
        && !(cd_read_active && xenolift_mem_read32(0x8004FDF8u) != 0u
             && cd_last_cmd != 0x02u)) { /* R97: Setloc acks are safe mid-stream */
        uint32_t fdfc;
        memcpy(&fdfc, xenolift_mem + (0x8004FDFCu & 0x1FFFFFFFu), 4);
        if (fdfc != 0u) {
            cd_scheduled = 0;
                        { static int sdw_21506; if (sdw_21506 < 2) { sdw_21506++; r861_out("[schdw] R1291 CLEAR site L21506 ran (seq=%u t=%u): pend=%u act=%u sched=0 FDF8=%u FE04=%08X fe1c=%u last_cmd=%02X resp=%u/%u (popped/armed = guest-ack vs runtime-only)\n", cd_sched_seq, xl_wall(), (unsigned)cd_pending, cd_read_active ? 1u : 0u, xenolift_mem_read32(0x8004FDF8u), xenolift_mem_read32(0x8004FE04u), xenolift_mem_read32(0x8004FE1Cu), (unsigned)cd_last_cmd, (unsigned)cd_resp_pos, (unsigned)cd_resp_n); } } /* R1291v3 schdw tracer */
            cd_pending = 3; cd_pending_stamp(3u, 7u);
            uint16_t one = 1;
            memcpy(xenolift_mem + (0x800578A6u & 0x1FFFFFFFu), &one, 2);
            uint32_t zero = 0;
            memcpy(xenolift_mem + (0x8004FDFCu & 0x1FFFFFFFu), &zero, 4);
            r861_out("[cd] FDFC=%08X with scheduled cmd 0x%02X: delivered, FDFC forced 0\n",
                    fdfc, cd_last_cmd);
        }
    }
    /* breakpoint-style probes for the CD detect chain (gdb unavailable) */
    if (a == 0x80042088u)
        r861_out("[bp] probe(a0=%d a1=%d) slot=%d flag=%d type=%d "
                        "devcnt=%d tbl=%08X\n",
                r[4], r[5], xenolift_mem[0x56788],
                *(uint16_t *)(xenolift_mem + 0x578A6), xenolift_mem[0x564C9],
                (int)(int32_t)xenolift_mem_read32(0x800564B4u),
                xenolift_mem_read32(0x800566F0u + (r[4] & 0xFF) * 4));
    else if (a == 0x80041B3Cu) {
        if (cd_pending) g_pend_pumps++;
        r861_out("[bp] pump(a0=%d a1=%d) slot=%d flag=%d h2=%08X h4=%08X\n",
                r[4], r[5], xenolift_mem[0x56788],
                *(uint16_t *)(xenolift_mem + 0x578A6),
                *(uint32_t *)(xenolift_mem + 0x564A8),
                *(uint32_t *)(xenolift_mem + 0x564AC));
    }
    else if (a == 0x80042750u)
        r861_out("[bp] detect(a0=%d) slot=%d\n", r[4], xenolift_mem[0x56788]);
    else if (a == 0x8004247Cu) { /* R954 [archx] (ATLAS lane, b8-c62): c62
        archreq named this fn as the ONLY arrival-flag incrementer
        (A22C 0->1->2) in the movie era - the data-settle path. One-shot
        entry receipt with args + caller + request cells so the digest
        shows the copy path's shape (who calls it, what buffer, FDFC). */
        static uint32_t archx_n;
        if (archx_n < 12u) {
            archx_n++;
            r861_out("[archx] R954 settle-fn 0x8004247C entry #%u a0=%08X a1=%08X a2=%08X a3=%08X r31=%08X FDF8=%08X FDFC=%08X A22C=%08X\n",
                    archx_n, r[4], r[5], r[6], r[7], r[31],
                    xenolift_mem_read32(0x8005FDF8u),
                    xenolift_mem_read32(0x8005FDFCu),
                    xenolift_mem_read32(0x8006A22Cu));
        }
    }
    else if (a == 0x8002B084u)
        r861_out("[bp] DATA HANDLER enter a0=%08X a1=%08X slot=%d | FE34=%08X FE08=%08X FDF8=%08X FE04=%08X FE38=%08X FDFC=%08X A22C=%08X dstw0=%08X\n",
                r[4], r[5], xenolift_mem[0x56788],
                *(uint32_t *)(xenolift_mem + 0x4FE34),
                *(uint32_t *)(xenolift_mem + 0x4FE08),
                *(uint32_t *)(xenolift_mem + 0x4FDF8),
                *(uint32_t *)(xenolift_mem + 0x4FE04),
                *(uint32_t *)(xenolift_mem + 0x4FE38),
                xenolift_mem_read32(0x8005FDFCu),
                xenolift_mem_read32(0x8006A22Cu),
                (r[4] >= 0x80010000u && r[4] < 0x80200000u) ? xenolift_mem_read32(r[4]) : 0u);
    if (g_trace_lines >= 400) {
        if (g_trace_lines == 400) {
            r861_out("[trace] (trace capped at 400 lines)\n");
            g_trace_lines++;
        }
        return;
    }
    /* at most the first 3 entries per function: a hot wait loop
     * alternates between two addresses and would otherwise eat the
     * entire 400-line budget before anything interesting happens */
    if (a >= 0x80010000u && a < 0x80059800u) {
        static uint8_t per[76000];
        uint32_t i = (a - 0x80010000u) >> 2;
        if (i < sizeof per) {
            if (per[i] >= 3) {
                return;
            }
            per[i]++;
        }
    }
    r861_out("[trace] enter 0x%08X\n", a);
    g_trace_lines++;
}

void xenolift_syscall(void)
{
    /* the kernel also reaches BIOS services through the `syscall`
     * INSTRUCTION — same convention as the jump gates: gate in r10 (t2),
     * function number in r9 (t1). The handler does its work and
     * execution continues right after the syscall. */
    /* SYS functions: the number is in r4 (a0) — per the spec. The kernel's
     * BIOS gate calls NEVER come through the syscall instruction: those
     * are real jalr jumps to 0xA0/0xB0/0xC0, handled by xenolift_dispatch.
     * (Reading r9/r10 here once produced "ghost" BIOS log lines — those
     * registers just held leftovers from an earlier gate call.) */
    static uint8_t seen[256];
    uint32_t fn = r[4] & 0xFFu;
    switch (fn) {
    case 0: /* NoFunction */
        r[2] = 0;
        return;
    case 1: /* EnterCriticalSection: 0 = "interrupts were already disabled",
             * permanently true in our no-interrupt model */
        r[2] = 0;
        return;
    case 2: /* ExitCriticalSection */
        r[2] = 0;
        return;
    case 3: /* ChangeThreadSubFunction(addr in r5) — the thread switcher */
        if (!seen[fn]) {
            seen[fn] = 1;
            r861_out("[sys] ChangeThreadSubFunction(0x%08X) — stubbed\n", r[5]);
        }
        r[2] = 0;
        return;
    default: /* SYS(04h..FFFFFFFFh): DeliverEvent(F0000010h,4000h) */
        if (!seen[4]) {
            seen[4] = 1;
            r861_out("[sys] DeliverEvent-class syscall (0x%08X) — stubbed\n", r[4]);
        }
        r[2] = 0;
        return;
    }
}

void xenolift_break(uint32_t code)
{
    /* R90: break = the kernel's SOFTWARE-INTERRUPT GATE. The 0x8004C3xx
     * farm (svc codes 0x101-0x107) is a break-stub syscall table: each
     * stub shifts args up one slot (BIOS-gate convention: the service
     * receives original (a0,a1,a2) as (a1,a2,a3)), executes `break
     * <code>`, then interprets v0/v1: v0==0 -> return v1, else -1.
     * Service 0x103 (fn_8004C318, called from the CD module fn_800287xx
     * with a descriptor-table handler in a1) = INDIRECT CALL TRAMPOLINE:
     * call the handler with (a2, a3); the handler's v0/v1 flow back. */
    /* R1135 (b8-c318): libsn host-file family, honest-failure class.
     * Unhandled codes in this farm = halt_report = the run dies at the
     * guest's own syscall (c318: the crash trail PCopen->PCseek->PCclose
     * ended cur_fn=8004C348 - the unhandled 0x104 PCclose halt).
     * decomp names: 0x101=PCinit (void return), 0x102=PCcreate,
     * 0x104=PCclose. v0!=0 -> the stub's own converter hands the
     * caller -1 (R90 contract, receipted c318). Receipts capped 12. */
    if (code == 0x101u || code == 0x102u || code == 0x104u) {
        static int r1135_fam;
        if (r1135_fam < 12) {
            r1135_fam++;
            r861_out("[libsn] R1135 svc 0x%X serviced HONEST-FAILURE (v0!=0 -> stub converts to -1; no host fs) a1=%08X a2=%08X a3=%08X\n",
                    code, r[5], r[6], r[7]);
        }
        r[2] = 1;
        return;
    }
    if (code == 0x103u) {
        uint32_t fn = r[5];
        uint32_t a2 = r[6], a3 = r[7];
        r861_out("[brk] svc 0x103 trampoline call fn=%08X arg=%08X %08X\n",
                fn, a2, a3);
        /* R1129 (b8-c310): TRAMPOLINE HANDLER ORIGIN CONTEXT.
         * c308 receipt: handler=0x51002 garbage (unresolved pointer
         * class), args (0, 0x40000000 taint) - skiphook serviced it, but
         * the handler's absence starves every downstream CD wait: the
         * 60-frame counter 0x8006A228 that CD_cw polls has NO writer in
         * ANY receipt ever taken (c310 cdkeep2 preserved all-zeros -
         * the cells were never set, not wiped). The handler that should
         * update the CD state cells is this unresolved trampoline target.
         * Decode need: WHICH cell fed a1. Dump the caller body around
         * r31 (the trampoline stub is called from the CD module chain
         * 0x800287xx whose code reads arch cells 4FDF0/FE14/FDF8) +
         * the arch chain + the starving counter cells at the moment of
         * the call. Max 2 dumps/run. */
        {
            static int r1129_n;
            if (r1129_n < 2) {
                int i;
                r1129_n++;
                r861_out("[trampctx] R1129 #%d pre-shift a0=%08X a1(fn)=%08X a2=%08X a3=%08X r31=%08X | caller words:",
                        r1129_n, r[4], r[5], r[6], r[7], (unsigned)r[31]);
                /* R1134 (b8-c316): widened backward to -26: c316 verdict -
                 * base cell healed healthy (80010004) at the door yet the
                 * handler was STILL 0x51001, so the handler's source is an
                 * earlier load in the caller, not the arch chain. */
                for (i = -26; i <= 2; i++) {
                    uint32_t pa = (uint32_t)((int32_t)r[31] + 4 * i);
                    if (pa >= 0x80010000u && pa < 0x80200000u)
                        r861_out(" %08X", xenolift_mem_read32(pa));
                }
                /* R1135: base now read from the REAL archive block 0x8005FDF0
                 * (this binary's lui 0x8005 install, disc1.c L_80028338;
                 * the 0x8004Fxxx cells are the decomp-map block - dead in
                 * this binary). FE48 (g_ArchiveDebugTable, the gate for the
                 * MeasureArchivePayload path) added; dead cell kept for one
                 * cycle of comparison. */
                r861_out("\n[trampctx] arch(real 5-blk): 5FDF0=%08X FE14=%08X FE1C=%08X 5FDF8=%08X 5FDFC=%08X FE48(dbgtbl)=%08X | dead4FDF0=%08X | cdwait: 6A228=%08X 6A22C=%08X 68960=%08X | gdesc: 6FAEC=%08X AF5E4=%08X\n",
                        xenolift_mem_read32(0x8005FDF0u),
                        xenolift_mem_read32(0x8005FE14u),
                        xenolift_mem_read32(0x8005FE1Cu),
                        xenolift_mem_read32(0x8005FDF8u),
                        xenolift_mem_read32(0x8005FDFCu),
                        xenolift_mem_read32(0x8005FE48u),
                        xenolift_mem_read32(0x8004FDF0u),
                        xenolift_mem_read32(0x8006A228u),
                        xenolift_mem_read32(0x8006A22Cu),
                        xenolift_mem_read32(0x80068960u),
                        xenolift_mem_read32(0x8006FAECu),
                        xenolift_mem_read32(0x800AF5E4u));
            }
        }
        /* R1135 (b8-c318): THE 0x103 MISDECODE IS SETTLED. decomp symbol
         * names (ingested, authoritative): fn_8004C318 = OpenHostFile =
         * PCopen (psyq libsn), fn_8004C348 = SeekHostFile = PCseek,
         * fn_8004C338 = PCclose, fn_8004C38C = PCinit, fn_8004C36C =
         * PCcreate. The c318 local-source decode (disc1.c L_80028738 =
         * MeasureArchivePayload): with g_ArchiveDebugTable != 0 the game
         * builds a member path, PCopen(path,0,0)s it, PCseeks to END for
         * the size, and checks size>0 -> host-success else the FAT
         * fallback route (L_8002879C reads the REAL archive block
         * 0x8005FE14/0x8005FDF0, installed by the game's own
         * ArchiveInit - disc1.c L_80028338 stores use lui 0x8005; the
         * 0x8004Fxxx cells our cameras/heals watched are the DECOMP-MAP
         * block, NOT this binary's). This was NOT an indirect-call
         * trampoline: a1 is the MODE arg post-shift (R90 stub contract:
         * each stub shifts (a0,a1,a2)->(a1,a2,a3) then break, and
         * POST-PROCESSES v0: v0==0 -> caller gets v1, nonzero -> -1).
         * The receipted 'handler 0x51001' = the path pointer with its
         * top half lost - garbage, correctly never dispatched. FIX:
         * honest failure - no host filesystem exists (retail posture;
         * psx-spx libsn: PCopen returns -1 on error). v0 nonzero ->
         * the stub converts to -1 -> the caller takes its own FAT
         * fallback (the retail route). The R1129 trampctx evidence
         * dump above stays; the dispatch goes. */
        {
            static int r1135_n;
            if (r1135_n < 12) {
                r1135_n++;
                r861_out("[libsn] R1135 PCopen serviced HONEST-FAILURE (v0!=0 -> stub converts to -1; no host fs - retail posture; caller MeasureArchivePayload takes its own FAT fallback) a1(path)=%08X a2=%08X a3=%08X\n",
                        r[5], r[6], r[7]);
            }
        }
        r[2] = 1;
        return;
    }
    if (code == 0x107u) {
        /* R1127 (b8-c308): the 0x8004C3xx break-stub farm's service 0x107
         * was UNHANDLED -> halt_report -> the run ended at the guest's
         * own halt door ("exit path: halt-scan", TRUE DEATH sig=4, c308
         * EXITTAIL: break 0x107 a0=2 a1=2 a2=0 a3=2 fired right after
         * the svc-0x103 trampoline skip, with the run otherwise the
         * deepest ever - SPU DMA moving sample data, archive directory
         * selection live). Under the farm's arg-shift convention (R90:
         * service receives original (a0,a1,a2) as (a1,a2,a3)) this reads
         * as a three-arg file-family service on descriptor 2 - HYPOTHESIS
         * (exact semantics unnamed in decomp): lseek/close class. The
         * halt was OUR choice, not the game's: service it like the other
         * farm codes (v0=0), LOUD receipt each time, cap 8 - if 0x107 is
         * really an abort-class break, the cap reverts to halt and the
         * receipts prove which class it is. */
        static int r1127_n;
        r1127_n++;
        r861_out("[brk107] R1127 svc 0x107 (decomp name: SeekHostFile=PCseek, psyq libsn) a1=%08X a2=%08X a3=%08X occurrence %d\n",
                r[5], r[6], r[7], r1127_n);
        if (r1127_n <= 32) {
            /* R1135: v0 was 0 - but the STUB post-processes v0 (R90
             * contract, settled c318): v0==0 -> caller receives V1 =
             * garbage -> MeasureArchivePayload's size>0 check took the
             * WRONG (host-success) branch with a garbage size. v0!=0 ->
             * stub converts to -1 -> caller sees honest seek-failure ->
             * FAT fallback (retail route). */
            r[2] = 1;
            return;
        }
        /* fall through to halt: abort-loop class proven by 32 receipts */
    }
    r861_out("[brk] unhandled break code 0x%X a0=%08X a1=%08X a2=%08X a3=%08X\n",
            code, r[4], r[5], r[6], r[7]);
    halt_report("break instruction", 0);
}

/* R185: shared COP0 register-file mirror (indexing matches COP0 rd
 * numbers: 8=BadVAddr, 12=SR, 13=Cause, 14=EPC, 15=PRID). The kernel's
 * exception handler reads these via MFC0 — with REAL fault context the
 * kernel's own recovery works the way it does on hardware. */
uint32_t xenolift_cop0_regs[32];
void xenolift_cop0_exception(uint32_t bad_vaddr, uint32_t fault_pc_approx)
{
    uint32_t sr_prev = xenolift_cop0_regs[12];
    xenolift_cop0_regs[12] = (sr_prev & ~0x2u) | 0x2u | 0x1000u; /* SR: EXL set, IE off while handling */
    xenolift_cop0_regs[8]  = bad_vaddr;       /* BadVAddr */
    xenolift_cop0_regs[13] = (0x05u << 2);    /* Cause: ExcCode 5 = AdES (computed-store fault) */
    xenolift_cop0_regs[14] = fault_pc_approx; /* EPC (function-granular) */
    r861_out("[bxcep] EXCEPTION CONTEXT set: BadVAddr=0x%08X Cause=0x%08X EPC=0x%08X SR=0x%08X\n",
            xenolift_cop0_regs[8], xenolift_cop0_regs[13],
            xenolift_cop0_regs[14], xenolift_cop0_regs[12]);
    /* R1211 (c32): the faulting dispatch chain + live args at the exception.
     * c27's [fkhbt] printed "(0 frames)" - host unwind failed - so the guest
     * fntrail is the only caller evidence. r4/r5 name the faulting access's
     * argument registers (for the LZSS loop: r4 = the wild input ptr). */
    r861_out("[bxcep] R1211 chain r4=%08X r5=%08X r31=%08X cur_fn=%08X fntrail:",
            (unsigned)r[4], (unsigned)r[5], (unsigned)r[31], (unsigned)xenolift_cur_fn);
    {
        int ti;
        for (ti = 16; ti >= 1; ti--)
            r861_out(" %08X", xenolift_fntrail[(xenolift_fntrail_n - ti) & 15u]);
    }
    r861_out("\n");
}

void xenolift_cop_stub(uint32_t word)
{
    uint32_t op = (word >> 26) & 0x3Fu;
    uint32_t rs = (word >> 21) & 0x1Fu;
    uint32_t rt = (word >> 16) & 0x1Fu;
    uint32_t rd = (word >> 11) & 0x1Fu;

    if (op == 0x10) {
        /* COP0 — the CPU's own control registers (status, cause, TLB).
         * R185: register file now lives in the shared mirror array so the
         * exception-context path can write REAL fault state (EPC/Cause/
         * BadVAddr/SR) that the kernel's exception handler reads via MFC0. */
        if (!xenolift_cop0_regs[15]) xenolift_cop0_regs[15] = 0x02u; /* PRID */
        if (rs == 0) { /* MFC0 rt, rd */
            r[rt] = xenolift_cop0_regs[rd];
            return;
        }
        if (rs == 4) { /* MTC0 rt, rd */
            xenolift_cop0_regs[rd] = r[rt];
            return;
        }
        if (word & 0x02000000u) {
            /* CO form: RFE and the TLB ops. Our model has flat memory
             * (no TLB) and interrupts are effectively always disabled,
             * so every one of these is a no-op. */
            return;
        }
        /* BC0 branches (rs == 8): no pending exceptions exist in our
         * model, so "not taken" is the faithful answer; log once. */
        {
            static uint8_t logged[256];
            if (!logged[word & 0xFFu]) {
                logged[word & 0xFFu] = 1;
                r861_out("[cop0] branch word 0x%08X treated as not-taken\n", word);
            }
            return;
        }
    }

    if (op == 0x11) {
        /* COP1: the PS1 has NO floating-point coprocessor — this word
         * is junk (data decoded as code). No-op it and keep going. */
        static uint8_t logged[256];
        if (!logged[word & 0xFFu]) {
            logged[word & 0xFFu] = 1;
            r861_out("[cop1] junk word 0x%08X no-op'd\n", word);
        }
        return;
    }

    /* ---- COP2: the GTE, the PS1's 3D math chip ----
     * 64 data registers (cop2r) and 32 control registers (cop2c).
     * Register MOVES are implemented now; the math commands (RTPS,
     * MVMVA, NCLIP, ...) still halt, by name, until that milestone. */
    /* R136: the local register file is gone — hle_gte owns GTE state.
     * Moves/transfers route through it so math commands see everything. */

    if (op == 0x12 && (word & 0x02000000u) == 0) {
        /* rs-form: register moves */
        static const char *kind[8] = {
            "MFC2", NULL, "CFC2", NULL, "MTC2", NULL, "CTC2", NULL
        };
        static uint8_t seen[8];
        if (rs < 8 && kind[rs] && !seen[rs]) {
            seen[rs] = 1;
            r861_out("[gte] %s register moves online (data+ctrl file)\n", kind[rs]);
        }
        switch (rs) {
        case 0: /* MFC2 rt, rd */
            r[rt] = hle_gte_read_data(rd);
            return;
        case 2: /* CFC2 rt, rd */
            r[rt] = hle_gte_read_ctrl(rd);
            return;
        case 4: /* MTC2 rt, rd */
            hle_gte_write_data(rd, r[rt]);
            return;
        case 6: /* CTC2 rt, rd */
            hle_gte_write_ctrl(rd, r[rt]);
            return;
        default:
            return; /* BC2 branches: no GTE exceptions exist in our model */
        }
    }

    if (op == 0x32 || op == 0x3A) { /* LWC2 / SWC2: GTE <-> RAM */
        uint32_t base = r[(word >> 21) & 0x1Fu];
        int32_t imm = (int16_t)(word & 0xFFFFu);
        uint32_t idx = (word >> 16) & 0x1Fu;
        uint32_t ea = (base + (uint32_t)imm) & 0xFFFFFFFFu;
        static uint8_t logged;
        if (!logged) {
            logged = 1;
            r861_out("[gte] %s data transfers online\n",
                    op == 0x32 ? "LWC2" : "SWC2");
        }
        if (op == 0x32) {
            hle_gte_write_data(idx, xenolift_mem_read32(ea));
        } else {
            xenolift_mem_write32(ea, hle_gte_read_data(idx));
        }
        return;
    }

    if (op == 0x12) {
        /* CO form: an actual GTE math command. Name it and halt. */
        static const char *cmds[64] = {
            NULL, "RTPS", NULL, NULL, NULL, NULL, "NCLIP", NULL,
            NULL, NULL, NULL, NULL, "OP", NULL, NULL, NULL,
            "DPCS", "INTPL", "MVMVA", "NCDS", "CDP", NULL, "NCDT", NULL,
            NULL, NULL, "NCCS", "CC", NULL, "NCS", NULL, NULL,
            "NCT", NULL, NULL, NULL, NULL, NULL, NULL, NULL,
            "SQR", "DCPL", "DPCT", NULL, NULL, NULL, NULL, NULL,
            NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL,
            NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL,
            NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL
        };
        /* index: 0x28 SQR, 0x29 DCPL, 0x2A DPCT, 0x2D AVSZ3, 0x2E AVSZ4,
         * 0x30 RTPT, 0x3D GPF, 0x3E GPL, 0x3F NCCT */
        const char *name = NULL;
        uint32_t fn = word & 0x3Fu;
        if (cmds[fn] != NULL) {
            name = cmds[fn];
        } else {
            switch (fn) {
            case 0x28: name = "SQR"; break;
            case 0x29: name = "DCPL"; break;
            case 0x2A: name = "DPCT"; break;
            case 0x2D: name = "AVSZ3"; break;
            case 0x2E: name = "AVSZ4"; break;
            case 0x30: name = "RTPT"; break;
            case 0x3D: name = "GPF"; break;
            case 0x3E: name = "GPL"; break;
            case 0x3F: name = "NCCT"; break;
            default: name = "?"; break;
            }
        }
        /* R136: GTE math EXECUTES now (hle_gte verified 8/8 — RTPS
         * sf-inversion + disasm table fixed by the GTE agent). The
         * halt-class is retired; the kernel can draw 3D through us. */
        hle_gte_execute(word);
        if (++xl_gte_cmds <= 4u)
            r861_out("[gte] MATH command: %s (0x%02X) -> hle_gte #%u\n",
                    name, fn, xl_gte_cmds);
        return;
    }

    halt_report("unhandled coprocessor word", word);
}


/* R70: fn_800320E8(NULL) is the kernel TRAP: records caller (ra-8) into
 * gp+464 (0x80059340), latches error at gp+0x1C0 (0x80059330), then calls
 * fn_80019ACC(0x83) -> SystemError. Called from emitted dispatch. */
static int trap_n = 0;
void xenolift_trap_hook(uint32_t ra, uint32_t gp)
{
    (void)gp;
    uint32_t latch;
    memcpy(&latch, xenolift_mem + (0x80059330u-0x80000000u), 4);
    trap_n++;
    if (trap_n <= 40 || trap_n % 1000 == 0)
        r861_out("[err] NULL-trap #%d caller 0x%08X latch 0x%08X\n", trap_n, ra - 8u, latch);
    if (trap_n <= 3) { /* R303: full forensics at the movie-finale release fault —
        * dump ALL registers + the module descriptor neighborhood (0x80077440-70:
        * 77454=flag, 77458=stage2base, 7745C/60 = UNDUMPED candidates for the
        * cfg-buffer handle the finale passes to ReleaseHeapBlock) + block headers
        * (0x80077C40-70). Cycle-51: a0@fn_80073B28 was VALID (0x8004FE44) — only
        * the release handle r20=0 traps. Find which cell lost it. */
        r861_out("[trap3] regs: r4=%08X r5=%08X r16=%08X r17=%08X r18=%08X r20=%08X r21=%08X r28=%08X r29=%08X r31=%08X\n",
                r[4], r[5], r[16], r[17], r[18], r[20], r[21], r[28], r[29], r[31]);
        r861_out("[trap3] desc 77440-77470: %08X %08X %08X %08X | %08X %08X %08X %08X | %08X %08X %08X %08X\n",
                xenolift_mem_read32(0x80077440u), xenolift_mem_read32(0x80077444u),
                xenolift_mem_read32(0x80077448u), xenolift_mem_read32(0x8007744Cu),
                xenolift_mem_read32(0x80077450u), xenolift_mem_read32(0x80077454u),
                xenolift_mem_read32(0x80077458u), xenolift_mem_read32(0x8007745Cu),
                xenolift_mem_read32(0x80077460u), xenolift_mem_read32(0x80077464u),
                xenolift_mem_read32(0x80077468u), xenolift_mem_read32(0x8007746Cu));
        r861_out("[trap3] hdr 77C40-77C70: %08X %08X %08X %08X | %08X %08X %08X %08X | %08X %08X %08X %08X\n",
                xenolift_mem_read32(0x80077C40u), xenolift_mem_read32(0x80077C44u),
                xenolift_mem_read32(0x80077C48u), xenolift_mem_read32(0x80077C4Cu),
                xenolift_mem_read32(0x80077C50u), xenolift_mem_read32(0x80077C54u),
                xenolift_mem_read32(0x80077C58u), xenolift_mem_read32(0x80077C5Cu),
                xenolift_mem_read32(0x80077C60u), xenolift_mem_read32(0x80077C64u),
                xenolift_mem_read32(0x80077C68u), xenolift_mem_read32(0x80077C6Cu));
    }
}

/* R70: boot state machine entry trace: fn_80019ACC(code) — 0x83 = error
 * trap from walker, 0 = process current table entry. */
static int bs_n = 0;
void xenolift_boot_trace(uint32_t code)
{
    uint32_t idx; uint32_t idxw = 0xDEADBEEFu; /* R1286: the working-cell mirror - R1232 proved the dispatcher reads 0x80028088 (scaled idx*16), while this camera printed only the old no-op mirror 0x18088; idx_work settles whether the 43-call 0x82 loop actually walks the table */
    memcpy(&idx, xenolift_mem + (0x80018088u-0x80000000u), 4);
    memcpy(&idxw, xenolift_mem + (0x80028088u-0x80000000u), 4);
    bs_n++;
    if (bs_n <= 40 || bs_n % 1000 == 0)
        r861_out("[boot] fn_80019ACC(%u) idx=%u idx_work=%u r31=0x%08X\n", code, idx, idxw, r[31]);
    /* R1288 (c188, THE FIRST-FAULT FIX - R502 RETRACTED): the static
     * decode + the c186/c187 receipts killed the R502 model. The
     * decompilation NAMES fn_80019ACC: RunResidentGameLoop___game_core.
     * The L_80031DA8 branch reads gp+0x1C0 (0x80059330): latch==0 ->
     * the NORMAL, DESIGNED call RunResidentGameLoop(0x82) - the game
     * resident main loop with its real mode argument; latch!=0 ->
     * fn_80031F58, a 4-line iterator advance (r29 list node walk).
     * R502 inverted this: at every 0x82 call it FORCED the latch
     * nonzero (sending the next pass down the iterator branch) AND
     * rewrote the game argument r4 0x82 -> 0 (so the resident loop
     * NEVER RAN IN ITS OWN MODE - arg 0 is the early-boot dispatch
     * mode that reads idx_work, which the c187 trail receipts as 0
     * at every loop-era call). The 47,964-call 400/sec loop is R502
     * manufacturing an error pass every iteration. RETRACTED: this
     * block is now a PASSIVE CAMERA - it prints the latch at the
     * 0x82 call and TOUCHES NOTHING: no arm, no arg rewrite, the
     * game protocol runs exactly as designed (Jos: no forcing, no
     * skipping, no heal scaffolding). If the game then arms the latch
     * itself and takes a real fault path, the receipts will SHOW it
     * and the next fix targets that data fault, not the protocol. */
    if (code == 0x82u) {
        uint32_t r1288_latch;
        static unsigned long r1288_n;
        memcpy(&r1288_latch, xenolift_mem + 0x59330u, 4);
        r1288_n++;
        if (r1288_n <= 64 || r1288_n % 4096 == 0)
            r861_out("[rlgl] R1288 resident-loop call #%lu: latch 0x80059330=%08X idx_work=%u r31=0x%08X (passive - R502 retracted, game protocol restored)\n",
                    r1288_n, r1288_latch, idxw, r[31]);
    }
    /* R347: field-era marker — one-shot, lets the digest slice everything after the movie->field handoff */
    if (idx == 1 && code == 0) {
        static int fld_marked = 0;
        if (!fld_marked) {
            fld_marked = 1;
            g_field_era = 1;
            r861_out("[fld] FIELD ERA START (movie finished, state-1 entered) r31=0x%08X FE04=0x%08X FDF8=%u\n",
                    r[31], xenolift_mem_read32(0x8004FE04u), xenolift_mem_read32(0x8004FDF8u));
        }
    }
}


void xenolift_unknown(uint32_t word)
{
    if (bios_hook(word)) {
        return; /* synthetic BIOS hook serviced — continue execution */
    }
    /* R1058 (b8-c219): INVALID-DISPATCH SKIP GUARD. c219 TRUE DEATH:
     * callback-invoker thunks (cur_fn=0x8004B748/0x8004B7A8 family, one per
     * stack slot 4/8/0xC/0x10/0x14/0x18) jalr through uninitialized slots to
     * host-tainted targets (addr=0x00B47D88/0x4FE2xxxx/0x81660F00 class);
     * dispatch has no case -> xenolift_unknown -> 8 churn recoveries ->
     * halt_report kills the run. The R1037/R1038-era heal proved the
     * contract at ONE invoker ([sp+4] heal to jr-ra stub 0x80040B9C, c191
     * crash sites went quiet): a garbage callback is SKIPPED, the caller
     * continues. This generalizes that receipted contract to the dispatch
     * chokepoint: any target outside guest code RAM [0x80010000,0x80200000)
     * and outside the scratchpad window is skipped + receipted. BIOS hooks
     * already returned above; module windows (0x8006F000..) stay in-range. */
    /* R1072 (b8-c237) [zerotgt]: c237 receipts - the coordinator thunk
     * (r31=0x80077FC8) dispatched 0x80102108, an in-RAM target whose code
     * reads ALL ZEROS (crash dump: 16 zero words @0x80102148) - the
     * unrebased-module-pointer class (c180 decode) executing blank memory.
     * xenolift_unknown is only reached for targets with NO dispatch case
     * (untranslated), so a zero first word here = blank memory, never a
     * function. The R759 scratchpad executor set this exact contract
     * ("stop @ zero word (end of stub); guest continues") and R1037/R1058
     * generalized it. Extending the skip to in-RAM ZERO-CONTENT targets:
     * receipt + return, the caller continues. Nonzero targets (bank data
     * like c237's 0x800B1ED4) keep the R1002 camera + recovery path -
     * that class still needs its receipts. */
    if (word >= 0x80010000u && word < 0x80200000u
        && xenolift_mem_read32(word) == 0u) {
        static int r1072_n;
        if (r1072_n < 16) {
            r1072_n++;
            xenolift_receipt("[zerotgt] R1072 #%d zero-content dispatch target %08X skipped (cur_fn %08X r31 %08X) - blank memory is never a fn; caller continues (R759 stub semantics; c237: coordinator thunk -> 80102108 zeros = unrebased module ptr class) ", r1072_n, word, (unsigned)xenolift_cur_fn, (unsigned)r[31]);
            /* R1126 (b8-c307): UNREBASED-POINTER ORIGIN CONTEXT. c307
             * receipts: dispatch targets 0x80100400 / 0x80102104 land in
             * zero RAM - the module calling through a pointer table that
             * never got ResolveArchiveEntryPointers treatment (decomp
             * system.c:17: header word0=N, then N offsets += header
             * base). To name WHICH table is unresolved, dump the CALLER
             * body + the words around the caller's jump site - the
             * load-address of the bad pointer is visible in the
             * caller's own code (lw reg, off(base)). Max 4 dumps/run. */
            if (r1072_n <= 4) {
                int i;
                xenolift_receipt(" | caller body @%08X:", (unsigned)r[31]);
                for (i = -8; i <= 4; i++) {
                    uint32_t pa = (uint32_t)((int32_t)r[31] + 4 * i);
                    if (pa >= 0x80010000u && pa < 0x80200000u)
                        xenolift_receipt(" %08X", xenolift_mem_read32(pa));
                }
                xenolift_receipt(" | gdesc ctx 8001A4B4-cell=%08X AF5E4=%08X AF990=%08X B0704w0=%08X 801D9724w0=%08X\n",
                        xenolift_mem_read32(0x8006FAECu),
                        xenolift_mem_read32(0x800AF5E4u),
                        xenolift_mem_read32(0x800AF990u),
                        xenolift_mem_read32(0x800B0704u),
                        xenolift_mem_read32(0x801D9724u));
            } else {
                xenolift_receipt("\n");
            }
        }
        return;
    }
    /* R1059 (b8-c220) FIX: c220 skiphook receipts #2/#3/#4 - target
     * 0x1F8000B0 from cur_fn 0x80076858 (coordinator helper) got SKIPPED,
     * killing the scratchpad executor entry - a PROVEN guest path (c47-era
     * scratchpad stub dispatch). My c219 predicate checked guest-code RAM
     * but never implemented the scratchpad exclusion its own comment
     * promised. The new-wall class, caught by receipts. Fix: scratchpad
     * [0x1F800000,0x1F900000) is an allowed dispatch target. */
    int r1059_spad = (word >= 0x1F800000u && word < 0x1F900000u);
    if (!r1059_spad && (word < 0x80010000u || word >= 0x80200000u)) {
        static int r1058_n;
        if (r1058_n < 16) {
            r1058_n++;
            xenolift_receipt("[skiphook] R1058 #%d invalid dispatch target %08X skipped (cur_fn %08X r31 %08X) - garbage callback, caller continues (R1037 c191 contract generalized) ", r1058_n, word, (unsigned)xenolift_cur_fn, (unsigned)r[31]);
        }
        return;
    }
    /* R1090 (b8-c260): ZERO-CONTENT DISPATCH SKIP - the R1058 contract
     * extended to in-RAM targets. Receipted wild-dispatch class across
     * c254-c260: targets 0x80102108, 0x80130000, 0x800BC158, 0x800C2C70,
     * 0x800ECCC0, 0x801C6638, 0x801D3190 all land in guest RAM whose first
     * words are ZERO (crash code dumps show all-zero regions) - the
     * dispatch executes empty RAM and faults at the first dereference,
     * burning fault-recovery churn every cycle. A real MIPS fn entry is
     * never two zero words (prologue receipts across every crash dump);
     * zero first words = empty RAM = garbage dispatch. Skip + caller
     * continues, same proven-safe contract as R1058/R1037 (c191/c433).
     * Scratchpad stays allowed (R1059). Budget 12 receipts. */
    if (word >= 0x80010000u && word < 0x80200000u
        && xenolift_mem_read32(word) == 0u && xenolift_mem_read32(word + 4u) == 0u) {
        static int r1090_n;
        if (r1090_n < 12) {
            r1090_n++;
            xenolift_receipt("[zerotgt] R1090 #%d empty-region dispatch target %08X skipped (cur_fn %08X r31 %08X) - first two words zero = empty RAM, c254-c260 wild-dispatch class; caller continues (R1058 contract extended to in-RAM zero-content targets)\n",
                    r1090_n, word, (unsigned)xenolift_cur_fn, (unsigned)r[31]);
        }
        return;
    }
    /* R1002 (b8-c116, AREA 1): c116 proof chain — the coordinator was
     * dispatched (crash cur_fn=0x80077E88, r31=0x8001979C) but the
     * coordent camera at the same address NEVER fired: no native fn
     * exists there, so dispatch fell to xenolift_unknown and the guest
     * executed compressed RAM words into the fault. Name every
     * window-0 module dispatch that has no native code, with the staged
     * f14 slot header (the R703 expansion gate input) alongside - the
     * digest shows whether the fldreloc expansion should have fired
     * and why its gates declined. */
    if (word >= 0x8006F000u && word < 0x80090000u) {
        static int mm_n;
        if (mm_n < 8) {
            mm_n++;
            r861_out("[modmiss] R1002 window-0 module dispatch NO NATIVE CODE: target=0x%08X cur_fn=0x%08X r31=0x%08X staged@801D9724=%08X (want 00xxxxFAFE) f15slot@801F8724=%08X coordslot=%08X @t=%lds\n",
                    word, (unsigned)xenolift_cur_fn, (unsigned)r[31],
                    xenolift_mem_read32(0x801D9724u), xenolift_mem_read32(0x801F8724u),
                    xenolift_mem_read32(0x80077E88u),
                    (long)(xl_wall() - g_boot_wall_t0));
        }
    }
    /* R225: STAGE-2 CAPTURE. The movie module (now executing post-R224) reads
     * an 88,604B second-stage payload from the disc into 0x801D3000 (its own
     * allocation, 132,256B) and calls 0x801D3538 inside the FIRST sector while
     * the stream is still mid-flight — legal on real HW, but the region has no
     * compiled code yet. Before halting (by design: tells us what to build
     * next), complete the pending read directly from the disc image and dump
     * the region so the next cycle's emitter can map it. */
    if (word >= 0x801D3000u && word < 0x801F1000u) {
        uint32_t lba = xenolift_mem_read32(0x8004FE04u);
        uint32_t rem = xenolift_mem_read32(0x8004FDF8u);
        uint32_t base = 0x801D3000u, nsec = (rem + 2047u) / 2048u;
        r861_out("[stage2] unresolved jump 0x%08X into loading region — completing read LBA=%u rem=%u (%u sectors)\n",
                word, lba, rem, nsec);
        if (lba >= 150u && nsec > 0u && nsec < 256u) {
            for (uint32_t i = 0; i < nsec; i++)
                disc_read_lba(lba + i, xenolift_mem + (base - 0x80000000u) + i * 2048u);
            r861_out("[stage2] region 0x801D3000 filled: LBA %u..%u (%u bytes)\n",
                    lba, lba + nsec - 1u, nsec * 2048u);
        }
        { /* release the file layer the same way the read-complete path does */
            uint32_t zero = 0;
            memcpy(xenolift_mem + (0x8004FDF8u & 0x1FFFFFFFu), &zero, 4);
            memcpy(xenolift_mem + (0x8004FE1Cu & 0x1FFFFFFFu), &zero, 4);
            memcpy(xenolift_mem + (0x8004FE04u & 0x1FFFFFFFu), &zero, 4);
        }
        { /* dump 0x801D3000-0x801F4000 for the emitter */
            FILE *sf = fopen("stage2_region.bin", "wb");
            if (sf) {
                fwrite(xenolift_mem + (base - 0x80000000u), 1, 0x21000u, sf);
                fclose(sf);
                r861_out("[stage2] capture: 0x801D3000-0x801F4000 (135,168 bytes) -> stage2_region.bin — next cycle the emitter maps this window\n");
            }
        }
        { /* log the first words at the call target so the next decode has context */
            uint32_t t = word & ~3u;
            r861_out("[stage2] target 0x%08X first16:", t);
            for (int i = 0; i < 16; i++)
                r861_out(" %08X", xenolift_mem_read32(t + 4u * (uint32_t)i));
            r861_out("\n");
        }
    }
    {   /* R680: WHO computed the wild target? c251: halt-scan named the killer
         * (target 0xF00E1220, NOT in RAM = in-register computed) but printed no
         * site context. Dump the fault site BEFORE the halt machinery: caller
         * (r31), live fn, arg regs, the field-commit cells, and the guest stack
         * top (8 words at sp = the return-address chain). */
        r861_out("[wildctx] R680 unresolved jump 0x%08X @t=%lds: cur_fn=0x%08X r31=0x%08X r4=%08X r5=%08X r6=%08X r7=%08X r16=%08X r17=%08X r29sp=%08X | 92C0=%08X FAEC=%08X F0C=%08X FE04=%08X\n",
                word, (long)(xl_wall() - g_boot_wall_t0),
                (unsigned)xenolift_cur_fn, r[31], r[4], r[5], r[6], r[7], r[16], r[17], r[29],
                xenolift_mem_read32(0x800592C0u), xenolift_mem_read32(0x8005FAECu),
                xenolift_mem_read32(0x80059F0Cu), xenolift_mem_read32(0x8004FE04u));
        r861_out("[wildctx] R737 regs2: r2=%08X r3=%08X r8=%08X r9=%08X r10=%08X r25=%08X node(18090)=%08X\n",
                r[2], r[3], r[8], r[9], r[10], r[25], xenolift_mem_read32(0x80018090u));
        {   /* R740 [spstub]: c315 - the real translated field module tail-calls
             * THROUGH the scratchpad (jr r7 with r7=0x1F8000B0; the entry copied
             * sp[0..0x14] -> sp[0xA0..0xB2] first, so the stub SOURCE is the
             * scratchpad head). Our scratchpad is all-zeros = nobody ever wrote
             * it. Dump both regions at the fault: the stub evidence TRAILBLAZER
             * needs to decode what the kernel should park there. */
            if (word >= 0x1F800000u && word < 0x1F801000u) {
                /* R743: direct storage reads (phys offset = RAM_SIZE + sp-off)
                 * - mem_read32 routes 0x1F80xxxx through the hw-register
                 * intercept and c318's dump died on the first read. */
                r861_out("[spstub] R743 jump into SCRATCHPAD target %08X: copied[0xA0..0xC0] (THE STUB):", word);
                for (int i = 0; i < 10; i++) {
                    uint32_t off = 0x1F8000A0u + 4u*(uint32_t)i;
                    uint32_t v; memcpy(&v, xenolift_mem + XENOLIFT_RAM_SIZE + (off - 0x1F800000u), 4);
                    r861_out(" %08X", v);
                }
                r861_out(" | head[0..0x20]:");
                for (int i = 0; i < 8; i++) {
                    uint32_t off = 0x1F800000u + 4u*(uint32_t)i;
                    /* R760 FIX: (off - 0x1F800000u) - the old "+ off" read
                     * xenolift_mem + RAM_SIZE + 0x1F800000 = ~522MB out of
                     * bounds = HOST SIGSEGV inside the probe (crashkit's
                     * "runtime.c:12917" since c315; every "jump into
                     * SCRATCHPAD" fault died HERE, before halt_report or
                     * any executor could run). Probe reads use PHYSICAL
                     * offsets - the stub loop got it right, the head loop
                     * did not. */
                    uint32_t v; memcpy(&v, xenolift_mem + XENOLIFT_RAM_SIZE + (off - 0x1F800000u), 4);
                    r861_out(" %08X", v);
                }
                r861_out(" | sp-writes-total: %u\n", spw_total);
            /* R759 SCRATCHPAD EXECUTOR: c337 proof — with the R758 real-entry
             * era live, fn_80077E88 installs its stub (sp[0xA0..0xB4]) and
             * tail-jumps to 0x1F8000B0. Static translation has no function
             * there; the old path hard-halted the run at 63s. Execute the
             * stub natively (bounded, 64 instrs, delay-slot aware), routing
             * LWC2/SWC2/COP2 into the hle_gte regfile; then SERVICE the
             * jump (return = continue execution) so the run survives
             * whatever the stub does. Unsupported opcode = LOUD receipt +
             * service-as-return. */
            {
                uint32_t pc = word, splo = 0x1F800000u;
                int n, ok = 1;
                r861_out("[spexec] R759 scratchpad executor ENTER target=%08X\n", word);        { /* R932 (b8-c38, TRAILBLAZER evidence - STUB SOURCE CONTEXT at the jump):
             * c38/c36 receipt: op=53 D40AC80C @1F8000B0 - op 53 (0x35) does not
             * exist on the R3000A, and the stub halfwords the coordinator wrote
             * (38000EE8 000006C4 D40AC80C ...) look like GPU-packet bitfields,
             * not code. Verdict hinges on WHERE the jump target came from: dump
             * the jump caller (r31), live fn, the register that held the target,
             * and the guest stack top 8 words (the copy source per R743). One
             * receipt per run (static cap 4). */
            static int r932_dumps;
            if (r932_dumps < 4) {
                r932_dumps++;
                r861_out("[spctx] R932 jump ctx: target=%08X cur_fn=%08X r31=%08X r7=%08X r29sp=%08X | sp top 8 words:",
                        word, (unsigned)xenolift_cur_fn, (unsigned)r[31], (unsigned)r[7], (unsigned)r[29]);
                for (int i = 0; i < 8; i++) {
                    uint32_t sv = 0; uint32_t sa = r[29] + (uint32_t)(4 * i);
                    if (sa >= 0x80000000u && sa < 0x80000000u + XENOLIFT_RAM_SIZE) memcpy(&sv, xenolift_mem + (sa & 0x1FFFFFFFu), 4);
                    r861_out(" %08X", sv);
                }
                r861_out("\n[spctx] R932 scratchpad 0x1F8000A0..0x1F800120 (16 words):");
                for (int i = 0; i < 16; i++) {
                    uint32_t sv; memcpy(&sv, xenolift_mem + XENOLIFT_RAM_SIZE + (0xA0u + (uint32_t)(4 * i)), 4);
                    r861_out(" %08X", sv);
                }
                r861_out("\n");
            }
        }
                for (n = 0; n < 64 && ok; n++) {
                    if (pc < 0x1F800000u || pc >= 0x1F801000u) {
                        r861_out("[spexec] R760 pc left scratchpad -> %08X after %d instrs (RAM jump: service-as-return; guest re-dispatch would need the outer engine)\n", pc, n);
                        break;
                    }
                    uint32_t w; memcpy(&w, xenolift_mem + XENOLIFT_RAM_SIZE + (pc - splo), 4);
                    if (w == 0u) { r861_out("[spexec] R759 stop @%08X: zero word (end of stub) after %d instrs\n", pc, n); break; }
                    if (w == 0x03E00008u) { r861_out("[spexec] R759 stop @%08X: jr r31 (stub returns) after %d instrs\n", pc, n); break; }
                    uint32_t op = w >> 26, rs = (w >> 21) & 31u, rt = (w >> 16) & 31u,
                             rd = (w >> 11) & 31u, funct = w & 63u;
                    int32_t imm = (int16_t)w;
                    uint32_t branch_t = 0; int taken = 0;
                    switch (op) {
                    case 0u: /* SPECIAL */
                        if (funct == 8u) { branch_t = r[rs]; taken = 1; } /* JR */
                        else if (funct == 9u) { r[31] = pc + 8u; branch_t = r[rs]; taken = 1; } /* JALR */
                        else if (funct == 0u) r[rt] = r[rs] << (w >> 6 & 31u);           /* SLL */
                        else if (funct == 2u) r[rt] = r[rs] >> (w >> 6 & 31u);           /* SRL */
                        else if (funct == 3u) r[rt] = (uint32_t)((int32_t)r[rs] >> (w >> 6 & 31u)); /* SRA */
                        else if (funct == 33u) { uint64_t m = (int64_t)(int32_t)r[rs] * (int32_t)r[rt]; lo = (uint32_t)m; hi = (uint32_t)(m >> 32); } /* MULT */
                        else if (funct == 35u) { uint64_t m = (uint32_t)r[rs] * (uint64_t)r[rt]; lo = (uint32_t)m; hi = (uint32_t)(m >> 32); } /* MULTU */
                        else if (funct == 24u) { uint32_t a = r[rs] ? r[rs] : 1u, b = r[rt]; lo = b / a; hi = b % a; } /* DIV (guard) */
                        else if (funct == 25u) { uint32_t a = r[rt] ? r[rt] : 1u, b = r[rs]; lo = b / a; hi = b % a; } /* DIVU (guard) */
                        else if (funct == 16u) r[rd] = hi;
                        else if (funct == 18u) r[rd] = lo;
                        else if (funct == 17u) hi = r[rs];
                        else if (funct == 19u) lo = r[rs];
                        else if (funct == 32u || funct == 33u) r[rd] = r[rs] + r[rt];   /* ADD/ADDU */
                        else if (funct == 34u || funct == 35u) r[rd] = r[rs] - r[rt];   /* SUB/SUBU */
                        else if (funct == 36u) r[rd] = r[rs] & r[rt];
                        else if (funct == 37u) r[rd] = r[rs] | r[rt];
                        else if (funct == 38u) r[rd] = r[rs] ^ r[rt];
                        else if (funct == 39u) r[rd] = ~(r[rs] | r[rt]);
                        else if (funct == 42u) r[rd] = ((int32_t)r[rs] < (int32_t)r[rt]) ? 1u : 0u;
                        else if (funct == 43u) r[rd] = (r[rs] < r[rt]) ? 1u : 0u;
                        else { r861_out("[spexec] R759 UNSUPPORTED SPECIAL funct=%u @%08X word=%08X\n", funct, pc, w); ok = 0; break; }
                        if (rd == 0u) r[0] = 0u;
                        break;
                    case 1u: /* REGIMM: BLTZ(0)/BGEZ(1) */
                        if (rt == 0u) { taken = (int32_t)r[rs] < 0; branch_t = pc + 4 + (imm << 2); }
                        else if (rt == 1u) { taken = (int32_t)r[rs] >= 0; branch_t = pc + 4 + (imm << 2); }
                        else { r861_out("[spexec] R759 UNSUPPORTED REGIMM rt=%u @%08X\n", rt, pc); ok = 0; }
                        break;
                    case 2u: branch_t = 0x80000000u | ((w & 0x3FFFFFFu) << 2); taken = 1; break; /* J */
                    case 3u: r[31] = pc + 8u; branch_t = 0x80000000u | ((w & 0x3FFFFFFu) << 2); taken = 1; break; /* JAL */
                    case 4u: taken = (r[rs] == r[rt]); branch_t = pc + 4 + (imm << 2); break; /* BEQ */
                    case 5u: taken = (r[rs] != r[rt]); branch_t = pc + 4 + (imm << 2); break; /* BNE */
                    case 6u: taken = ((int32_t)r[rs] <= 0); branch_t = pc + 4 + (imm << 2); break; /* BLEZ */
                    case 7u: taken = ((int32_t)r[rs] > 0); branch_t = pc + 4 + (imm << 2); break; /* BGTZ */
                    case 8u: r[rt] = r[rs] + (uint32_t)imm; break; /* ADDIU */
                    case 9u: r[rt] = r[rs] + (uint32_t)imm; break; /* ADDI (no trap model) */
                    case 10u: r[rt] = ((int32_t)r[rs] < imm) ? 1u : 0u; break;
                    case 11u: r[rt] = (r[rs] < (uint32_t)imm) ? 1u : 0u; break;
                    case 12u: r[rt] = r[rs] & (uint32_t)((uint16_t)w); break;
                    case 13u: r[rt] = r[rs] | (uint32_t)((uint16_t)w); break;
                    case 14u: r[rt] = r[rs] ^ (uint32_t)((uint16_t)w); break;
                    case 15u: r[rt] = ((uint16_t)w) << 16; break; /* LUI */
                    case 28u: { r861_out("[spexec] R759 UNSUPPORTED SPECIAL2 @%08X word=%08X\n", pc, w); ok = 0; break; }
                    case 32u: case 33u: case 35u: case 36u: case 37u: { /* LB/LH/LW/LBU/LHU */
                        uint32_t a = r[rs] + (uint32_t)imm, v = 0;
                        if (a >= 0x1F800000u && a < 0x1F801000u) memcpy(&v, xenolift_mem + XENOLIFT_RAM_SIZE + (a - 0x1F800000u), 4);
                        else if (a >= 0x80000000u && a < 0x80000000u + XENOLIFT_RAM_SIZE) memcpy(&v, xenolift_mem + (a & 0x1FFFFFFFu), 4);
                        else { v = xenolift_mem_read32(a); } /* MMIO via intercept */
                        if (op == 32u) r[rt] = (uint32_t)(int32_t)(int8_t)v;
                        else if (op == 33u) r[rt] = (uint32_t)(int32_t)(int16_t)v;
                        else if (op == 35u) r[rt] = v;
                        else if (op == 36u) r[rt] = v & 0xFFu;
                        else r[rt] = v & 0xFFFFu;
                        break;
                    }
                    case 40u: case 41u: case 43u: { /* SB/SH/SW */
                        uint32_t a = r[rs] + (uint32_t)imm;
                        if (a >= 0x1F800000u && a < 0x1F801000u) {
                            uint8_t *p = xenolift_mem + XENOLIFT_RAM_SIZE + (a - 0x1F800000u);
                            if (op == 43u) memcpy(p, &r[rt], 4);
                            else if (op == 41u) { uint16_t h = (uint16_t)r[rt]; memcpy(p, &h, 2); }
                            else *p = (uint8_t)r[rt];
                        } else if (a >= 0x80000000u && a < 0x80000000u + XENOLIFT_RAM_SIZE) {
                            uint8_t *p = xenolift_mem + (a & 0x1FFFFFFFu);
                            if (op == 43u) memcpy(p, &r[rt], 4);
                            else if (op == 41u) { uint16_t h = (uint16_t)r[rt]; memcpy(p, &h, 2); }
                            else *p = (uint8_t)r[rt];
                        } else if (op == 43u) xenolift_mem_write32(a, r[rt]);
                        else { r861_out("[spexec] R759 non-word MMIO store dropped @%08X\n", a); }
                        break;
                    }
                    case 50u: case 58u: { /* LWC2(50) / SWC2(58): GTE regfile.
                        * R761 FIX: opcode labels were BACKWARDS (48=LWC1 FPU,
                        * not LWC2; c339 receipt: stub's first word EAB80478 =
                        * op 58 = SWC2 "store GTE reg 24 to 0x478(r21)" - the
                        * missing case starved the executor on instr 1). psx-spx
                        * verified: scratchpad = 1KB 1F800000-1F8003FF, no
                        * mirrors; 1F800400-1F80FFFF = bus-error gap (our IO
                        * district models it as flat storage = host-safe). */
                        uint32_t a = r[rs] + (uint32_t)imm, v = 0;
                        if (a >= 0x1F800000u && a < 0x1F801000u) memcpy(&v, xenolift_mem + XENOLIFT_RAM_SIZE + (a - 0x1F800000u), 4);
                        else if (a >= 0x80000000u && a < 0x80000000u + XENOLIFT_RAM_SIZE) memcpy(&v, xenolift_mem + (a & 0x1FFFFFFFu), 4);
                        else v = xenolift_mem_read32(a);
                        if (op == 50u) hle_gte_write_data((int)rt, v); /* LWC2: load -> GTE */
                        else {
                            /* SWC2 needs a valid source address; a scratchpad/
                             * RAM target stores, MMIO stores dropped loudly */
                            uint32_t d = hle_gte_read_data((int)rt);
                            if (a >= 0x1F800000u && a < 0x1F801000u) memcpy(xenolift_mem + XENOLIFT_RAM_SIZE + (a - 0x1F800000u), &d, 4);
                            else if (a >= 0x80000000u && a < 0x80000000u + XENOLIFT_RAM_SIZE) memcpy(xenolift_mem + (a & 0x1FFFFFFFu), &d, 4);
                            else r861_out("[spexec] R759 SWC2 to MMIO %08X dropped\n", a);
                        }
