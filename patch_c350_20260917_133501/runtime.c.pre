}

int xenolift_spuerr_stub(void)
{
    /* R873 (c463, AREA-1 / WAVE): SOUND-ERROR BODY STUB. The reporter's body
     * (fn 0x8003F6B0) walks 80038428 -> 8003F614 -> 8003F684 -> 800404B4 ->
     * 800404A4 -> 8003BDFC and finally jal @0x8003F710 re-dispatches the boot
     * entry, which deterministically faults on a computed-wild read (c461-
     * c463: identical regs r4=0x10 r5=0 r6=0x101, addr 0x039C1361/0x0C706361
     * varying). 32 recoveries (R872) prove the loop is DETERMINISTIC - it
     * never self-resolves. Our HLE SPU cannot produce REAL transfer errors,
     * so the entire body is artifact fuel. disc1.c R873 patch: XTRACE (the
     * [spuerr] receipt) still fires, then this gate returns 1 and the
     * emitted fn body is skipped - control returns to the caller's label
     * (e.g. L_80037BA8) and the kernel continues its boot walk normally. */
    return 1;
}

