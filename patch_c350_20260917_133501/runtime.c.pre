                uint32_t fd_stg = 0xFFFFFFFFu;
                disc_off = 0u;
                for (uint32_t lba = 108979u; lba <= 108994u && disc_off < 29048u; lba++) {
                    if (disc_read_lba(lba, sbuf) != 0) break;
                    for (uint32_t k = 0; k < 2048u && (disc_off + k) < 29048u; k++) {
