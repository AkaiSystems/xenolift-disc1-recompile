                          }
                        }
                        if (fp2_idx >= 45u) { static uint32_t fp2_done; if (fp2_done == 0u) { fp2_done = 1u;
                                r861_out("[f15pump] R578: FILE-15 COMPLETE - all 45 sectors stored (fe08=%08X)\n", fp2_fe08); } }
                        if (fp2_fe08 == 0x8007EAF8u && (cd_seek_lba == 0u || cd_seek_lba == 1u)) fp2_saw15 = 0u;
                        if (cd_seek_lba == 108995u) fp2_saw15 = 1u;
                        if (fp2_hold > 0u) fp2_hold--;
                        if ((fp2_fe1c == 10u || fp2_fe1c == 6u || fp2_fe1c == 0u)
                            && cd_pending == 0u && fp2_hold == 0u && fp2_idx < 45u
                            && (fp2_idx > 0u || fp2_saw15 == 1u)) {
                            uint32_t fp2_lba = 108995u + fp2_idx;
                            fp2_hold = 1u;
                            cd_seek_lba = fp2_lba;
                            cd_data_load();
                            cd_pending = 1;
                            { static uint32_t fp2_log;
                              if (fp2_log < 90u) { fp2_log++;
                                if (fp2_rt > 0u) {
                                    r861_out("[f15pump] R577: RETRY arm idx=%u LBA=%u dest=%08X pend=1\n",
                                            fp2_idx, fp2_lba, fp2_fe08);
                                    fp2_rt = 0u;
                                } else {
                                    r861_out("[f15pump] R577: armed file-15 sector idx=%u LBA=%u dest=%08X pend=1\n",
                                            fp2_idx, fp2_lba, fp2_fe08);
                                }
                              } }
                        } else if (fp2_hold == 0u && cd_pending == 0u
                                   && (fp2_fe1c == 10u || fp2_fe1c == 6u || fp2_fe1c == 0u)) {
                            fp2_rt++;
                        }
                    }
                }
                                if ((fp_fe1c == 6u || fp_fe1c == 0u)
                    && fp_fe08 >= 0x801D9724u && fp_fe08 < (0x801D9724u + 125304u)
                    && cd_seek_lba >= 108900u && cd_seek_lba < 108996u
                    && cd_pending == 0) {
                    static uint32_t fp_idx; static uint32_t fp_epoch; static uint32_t fp_last_fe04;
                    uint32_t fp_fe04 = xenolift_mem_read32(0x8004FE04u);
                    if (fp_epoch == 0u || (fp_fe04 != 0u && fp_last_fe04 == 0u)) fp_idx = 0u;
                    fp_epoch = 1u; fp_last_fe04 = fp_fe04;
                    static uint32_t fp_cooldown;
                    if (fp_cooldown > 0u) fp_cooldown--;
                    if (fp_cooldown == 0u && fp_idx < 62u) {
                        uint32_t fp_lba = 108933u + fp_idx;
                        if (fp_lba < 108995u) {
                            fp_cooldown = 3u;
                            cd_seek_lba = fp_lba;
                            cd_data_load();
                            cd_pending = 1;   /* hook conversion delivers when guest polls 800415B4 */
                            { static uint32_t fp_log;
                              if (fp_log < 80u) { fp_log++;
                                r861_out("[f14pump] R559: armed sector idx=%u LBA=%u dest=%08X pend=1\n",
                                        fp_idx, fp_lba, fp_fe08);

                /* R560 [f14land]: c128 — seek walked +28 (108933->108961, standard
                 * path served sectors!) but the landing zone head still reads ZERO
                 * and the game parks in an ack loop. Camera: per tick, era-gated,
                 * log any CHANGE in the dest head (first 8 bytes at 801D9724) and
                 * the batch cells — who (if anyone) ever writes the landing zone? */
                {
                    static uint32_t fl_last; static uint32_t fl_n;
                    uint32_t fl_head = xenolift_mem_read32(0x801D9724u);
                    uint32_t fl_fe08 = xenolift_mem_read32(0x8004FE08u);
                    uint32_t fl_fdf8 = xenolift_mem_read32(0x8004FDF8u);
                    if ((fl_head != fl_last || fl_n == 0u) && fl_n < 20u
                        && cd_seek_lba >= 108933u && cd_seek_lba < 108996u) {
                        fl_n++;
                        r861_out("[f14land] R560 #%u: dest-head=%08X FE08=%08X FDF8=%u seek=%u pend=%u cmd=%02X\n",
                                fl_n, fl_head, fl_fe08, fl_fdf8, cd_seek_lba, cd_pending, cd_last_cmd);
                        fl_last = fl_head;
                    }
                }
                              }
                            }
                            fp_idx++;
                        }
                    }
                }
            }

    /* R1236 (c80): CONFIG-READ CAMERA - the state-6 module's first init
     * aborted (game code 131, "config render path never loaded", absorbed by
     * the R709 restart step; the run continued in state 6 the full budget)
     * with a pending read at LBA 109176 - PAST file#18's end (109165), no
     * file-table entry, FDF8=0 (never armed), pend=1, one sector (2060B) in
     * the FIFO. The config load can never complete un-serviced. Cameras only
     * (c354 discipline): receipt the stall posture each tick AND dump what
     * the DISC actually holds at the 109166..109178 band (host scratch
     * buffer, never guest RAM) - if the band holds an LZSS/module header
     * (word0 = compressed length), the arm/door size designs itself from the
     * game's own data. */
    {
        static uint32_t cfg_n; static uint32_t cfg_disc_dumped;
        uint32_t cfg_lba = xenolift_mem_read32(0x8004FE04u);
        if (cfg_n < 24u && cfg_lba >= 109166u && cfg_lba <= 109220u) {
            uint32_t cfg_dst = xenolift_mem_read32(0x8004FE08u);
            uint32_t cfg_fdf8 = xenolift_mem_read32(0x8004FDF8u);
            uint32_t cfg_fe1c = xenolift_mem_read32(0x8004FE1Cu);
            cfg_n++;
            r861_out("[cfgcam] R1236 #%u config-read posture: FE04=%u FE08=%08X FDF8=%u FE1C=%u drive=%u pend=%u | dst-first-words:",
                    (unsigned)cfg_n, (unsigned)cfg_lba, cfg_dst, cfg_fdf8, cfg_fe1c,
                    (unsigned)cd_seek_lba, (unsigned)cd_pending);
            if (cfg_dst >= 0x80010000u && cfg_dst < 0x80200000u) {
                for (int i = 0; i < 4; i++)
                    r861_out(" %08X", xenolift_mem_read32(cfg_dst + 4u * (uint32_t)i));
            } else r861_out(" dst-invalid");
            r861_out("\n");
            if (cfg_disc_dumped < 2u) {
                static uint8_t cfg_scratch[4096];
                cfg_disc_dumped++;
                disc_read_lba(109176u, cfg_scratch);
                disc_read_lba(109177u, cfg_scratch + 2048);
                r861_out("[cfgcam] R1236 DISC DUMP @109176+2048*1: ");
                for (int i = 0; i < 8; i++)
                    r861_out(" %08X", ((uint32_t)cfg_scratch[4*i] | ((uint32_t)cfg_scratch[4*i+1] << 8)
                        | ((uint32_t)cfg_scratch[4*i+2] << 16) | ((uint32_t)cfg_scratch[4*i+3] << 24)));
                r861_out(" | @109177: ");
                for (int i = 0; i < 4; i++)
                    r861_out(" %08X", ((uint32_t)cfg_scratch[2048+4*i] | ((uint32_t)cfg_scratch[2048+4*i+1] << 8)
                        | ((uint32_t)cfg_scratch[2048+4*i+2] << 16) | ((uint32_t)cfg_scratch[2048+4*i+3] << 24)));
                r861_out("\n");
            }
        }
    }
    /* R1186 (c393 receipts): the t=46 park-signature close-out. Park state
     * (fldfrz t=46..110s, byte-identical): cd_read_active=1, cd_data_loaded=1,
     * stale FIFO 0/2060, cd_pending=0, cd_arm_int1_pending=0, cd_resp_n=0,
     * cd_resp_pos=0, FDF8=0 — the game's request is fully consumed while the
     * model still claims an active read, which blocks the standing GetStat
     * re-prime (gated !cd_read_active) forever. Both prior close-outs sit
     * below this state: R503 lives in cd_read() (the game never touches CD
     * registers in this park — proven by zero fldbell receipts with R1185
     * live) and R113 wants FE1C==5 (park has FE1C=0). The c218 lesson: arms
     * gated on the spin-context detector die when the wait loop changes
     * shape at t~46 — exactly when this park forms. This copy follows the
     * R458 precedent: TOP of on_alarm, unconditional, fires every round.
     * No FE1C window condition — FE1C is not load-bearing (the c346/c387
     * window-artifact lesson); the invariant is FDF8==0 (request consumed)
     * with nothing pending/armed/schedulable while the model claims reading.
     * Actions identical to R503's proven close-out: discard stale FIFO
     * leftover, clear read_active, unlock the re-prime. Budget-capped;
     * receipt every fire. */
    {
        static int parkclose_budget = 8;
        if (parkclose_budget > 0
            && cd_read_active && cd_data_loaded
            && cd_pending == 0u
            && cd_arm_int1_pending == 0u
            && cd_resp_n == 0u && cd_resp_pos == 0u
            && cd_scheduled == 0u
            && xenolift_mem_read32(0x8004FDF8u) == 0u) {
            parkclose_budget--;
            if (cd_data_pos < cd_data_n) {
                r861_out("[parkclose] R1186: stale FIFO leftover %u bytes discarded (parked stalled-dead read)\n",
                        cd_data_n - cd_data_pos);
                cd_data_pos = cd_data_n = 0;
                cd_data_loaded = 0;
            }
            cd_read_active = 0;
            r861_out("[parkclose] R1186: parked stalled-dead read closed at seek=%u (FDF8=0, re-prime unlocked)\n",
                    cd_seek_lba);
        }
    }
    /* R1191 (c476/c477): CELL-ANCHORED DELIVERY DOOR. c476 receipts: the
     * second-epoch member-2 request froze with CONSISTENT cells (FE04=108754
     * = file#2's LBA, FDF8=61680 = file#2's size, FE1C=1) but the CD never
     * scheduled (seek=0, no Setloc issued) - the game spun on 0x1F801800=0x24
     * for 1.6 BILLION polls to the watchdog. The seek-anchored sdoor (R896)
     * never sees this class because no seek command is issued; the R496 arm
     * fires only at cell-write time in its own band. This door anchors on the
     * CELLS: if the request posture matches a known ftab file EXACTLY (both
     * LBA and size), the CD machinery is completely idle, and the posture
     * has been stuck for >= 5 alarm ticks, deliver the whole file
     * synchronously from the disc image - the proven R896/R897 pattern:
     * sectors to FE08, event announcement, completion stamps. One fire per
     * request posture; reset when FE1C returns to 0. Active deliveries
     * cannot trip it: their FDF8 counts DOWN from the table size and their
     * seek/scheduled state is nonzero. */
    {
        static uint32_t c191_lba, c191_fdf8, c191_ticks, c191_fired_lba;
        uint32_t fe04 = xenolift_mem_read32(0x8004FE04u);
        uint32_t fdf8 = xenolift_mem_read32(0x8004FDF8u);
        uint32_t fe1c = xenolift_mem_read32(0x8004FE1Cu);
        if (fe1c == 1u && fdf8 != 0u && cd_seek_lba == 0u && cd_pending == 0u
            && !cd_read_active && !cd_scheduled) {
            if (fe04 == c191_lba && fdf8 == c191_fdf8) {
                if (c191_ticks < 0xFFFFFFu) c191_ticks++;
            } else { c191_lba = fe04; c191_fdf8 = fdf8; c191_ticks = 0; c191_fired_lba = 0; }
            static const struct { uint32_t lba, size; } c191_tab[] = {
                {108754u, 61680u},  {108785u, 155120u}, {108861u, 23744u},
                {108873u, 21984u},  {108884u, 2660u},   {108886u, 13768u},
                {108893u, 80284u},  {108933u, 125304u}, {108995u, 92180u},
                {109041u, 166564u}, {109123u, 70944u},  {109158u, 14360u},
            };
            uint32_t tsz = 0u; unsigned ti;
            for (ti = 0u; ti < sizeof c191_tab / sizeof c191_tab[0]; ti++)
                if (c191_tab[ti].lba == fe04 && c191_tab[ti].size == fdf8) { tsz = fdf8; break; }
            if (tsz != 0u && c191_ticks >= 5u && fe04 != c191_fired_lba) {
                uint32_t dst = xenolift_mem_read32(0x8004FE08u);
                if (dst >= 0x80010000u && dst < 0x801F0000u && (dst & 3u) == 0u) {
                    uint32_t nsec = (tsz + 2047u) / 2048u, i;
                    for (i = 0u; i < nsec; i++)
                        disc_read_lba(fe04 + i,
                            xenolift_mem + (dst - 0x80000000u) + i * 2048u);
                    xenolift_mem_write32(0x8006A22Cu,
                        xenolift_mem_read32(0x8006A22Cu) + 1u);
                    uint32_t c191_sb = xenolift_mem_read32(0x80056788u);
                    xenolift_mem_write32(0x80056788u, c191_sb | 6u);
                    { uint16_t c191_one = 1;
                      memcpy(xenolift_mem + (0x800578A6u & 0x1FFFFFFFu), &c191_one, 2); }
                    xenolift_mem_write32(0x8005FDFCu, 0u);
                    xenolift_mem_write32(0x8005FE48u, 1u);
                    xenolift_mem_write32(0x8004FDF8u, 0u);
                    xenolift_mem_write32(0x8004FE1Cu, 0u);
                    xenolift_mem_write32(0x8004FE04u, 0u);
                    c191_fired_lba = fe04;
                    r861_out("[c2door] R1191 cell-anchored delivery: LBA %u size %u -> %u sectors to dst %08X (stuck %u ticks; completion stamps per R896/R897)\n",
                            fe04, tsz, nsec, dst, c191_ticks);
                }
            }
        } else if (fe1c == 0u) { c191_ticks = 0; c191_lba = 0; c191_fdf8 = 0; c191_fired_lba = 0; }
    }
    /* R458 UNCONDITIONAL ARM (c218 verdict: the camera photographed the
     * stall THROUGH its last visible state (pend=3 cmd=01 FE1C=1) then went
     * DARK while [wd] kept printing every round — the fd-tick branch that
     * hosts the camera + R122 + all stall arms is gated by the spin-context
     * detector, which stops matching when the game's wait loop changes shape
     * at t~46. Every arm shipped there is dead on arrival. This copy lives at
     * the TOP of on_alarm, unconditional: fires every round no matter what
     * the guest is waiting on. Same unique-batch fence as R457 variant-B. */
    static uint32_t fld3_era; /* R459: latched once post-TOC streaming begins */
    /* R822 (c407): the streaming era now runs at file#2 LBAs 108754-108784
     * (fldsec #16-40 receipts) - the old >=108995 latch left the freeze
     * camera blind through exactly this new era (era-blindness lesson).
     * Widen the latch to ANY post-TOC content streaming. */
    if (cd_seek_lba >= 108754u && (cd_scheduled || cd_read_active)) fld3_era = 1u;
        /* R462: POST-FREEZE CAMERA — c24/c25 verdict: sector flow STOPS at LBA
         * 108946 (~t=32s) but the batch handler keeps ticking FDE4 on empty
         * (c25: FDE4 reached 105 with zero new sectors) — the existing camera
         * + arms stop matching at the new wait shape, leaving us blind.
         * Photograph the frozen drive state every 20s once no sector has been
         * delivered for 20s: batch-list cells, queue nodes, read struct. */
        if (fld3_era || g_stream_era) { /* R463/R823: historical latch (g_stream_era) heals the instantaneous-miss */
            static time_t frz_last_chg; static uint32_t frz_last_cnt; static uint32_t frz_n;
            if (g_fldsec_total != frz_last_cnt) {
                frz_last_cnt = g_fldsec_total; frz_last_chg = run_now;
            } else if (frz_n < 40u && (run_now - frz_last_chg) >= 15) {
                r861_out("[fldfrz] t=%lds sectors=%u | seek=%u pend=%u sched=%u act=%u arm1=%u loaded=%u data=%u/%u cmd=%02x resp=%u/%u | FDF8=%u FE04=%08x FE1C=%u FE20=%u FDE4=%08x FDE8=%08x | batch FE08=%08x FE0C=%08x FE10=%08x FE34=%08x | q10=%08x/%08x q18=%08x/%08x | rs+18=%08x rs+1C=%08x | R822 walker: FAEC=%08x 92C0=%08x 92BC=%08x 92D0=%08x F0C=%08x F10=%08x\n",
                        (long)(run_now - g_boot_wall_t0), g_fldsec_total,
                        cd_seek_lba, cd_pending, cd_scheduled, cd_read_active,
                        cd_arm_int1_pending, cd_data_loaded, cd_data_pos, cd_data_n,
                        cd_last_cmd, cd_resp_n, cd_resp_pos,
                        xenolift_mem_read32(0x8004FDF8u),
                        xenolift_mem_read32(0x8004FE04u),
                        xenolift_mem_read32(0x8004FE1Cu),
                        xenolift_mem_read32(0x8004FE20u),
                        xenolift_mem_read32(0x8004FDE4u),
                        xenolift_mem_read32(0x8004FDE8u),
                        xenolift_mem_read32(0x8004FE08u),
                        xenolift_mem_read32(0x8004FE0Cu),
                        xenolift_mem_read32(0x8004FE10u),
                        xenolift_mem_read32(0x8004FE34u),
                        xenolift_mem_read32(0x80059F10u), xenolift_mem_read32(0x80059F14u),
                        xenolift_mem_read32(0x80059F18u), xenolift_mem_read32(0x80059F1Cu),
                        xenolift_mem_read32(0x80059EF8u + 0x18u), xenolift_mem_read32(0x80059EF8u + 0x1Cu),
                        xenolift_mem_read32(0x8005FAECu /* R1175: was 0x80059FAECu (nine-digit typo, faulting class) */), /* R1171-HELD: nine-digit typo class (truncates to 0x0059FAEC); correction held for atos+guest-writer verification per Jos c360; its fault while held is the diagnostic being measured */
                        xenolift_mem_read32(0x800592C0u),
                        xenolift_mem_read32(0x800592BCu),
                        xenolift_mem_read32(0x800592D0u),
                        xenolift_mem_read32(0x80059F0Cu),
                        xenolift_mem_read32(0x80059F10u));
                frz_last_chg = run_now; frz_n++;
            }
        }
    /* R521[dirack] — c88 verdict: THE GLYPH WALL IS DEAD (glyphguard
     * restore #1, fault-kit 0 blocks, first full-budget run of the era,
     * 200s of textured menu rects). NEW WALL: the post-mount directory
     * scan asks for sector LBA 1 (Setloc 00:02:01) and then sits at
     * FE1C=10, cmd=0x02, resp_n=0 for 150+s (fldfrz t=64..192 frozen):
     * the game is polling for the 3-byte ack to its command and our
     * answer FIFO is EMPTY — the boot-era auto-answer armed answers for
     * the boot reads, not this request. The existing re-prime (R212)
     * only fires when (cd_pending || cd_last_cmd) at the moment
     * resp_pos >= resp_n, but here the pair was already consumed and
     * the drive shows idle bookkeeping. HEAL (R502 latch family): when
     * the directory-era state machine polls with an empty answer
     * window, arm one tick then prime the standard Setloc/ReadN ack
     * [02 01 01] into the response FIFO so the game pops it (rspop
     * path), advances its state machine, and issues the actual ReadN
     * for LBA 1 - which the generic sector loader then serves from
     * disc (disc_read_lba(1)), and the zrf0 force-deliver completes
     * the copy. 12-fire budget, flutter-tolerant arm (R510 pattern). */
    {
        static int da_armed; static int da_fires;
        uint32_t fe1c_da = xenolift_mem_read32(0x8004FE1Cu);
        if (da_fires < 12u && cd_seek_lba > 0u && cd_seek_lba < 150u
            && fe1c_da == 10u && cd_last_cmd == 0x02u
            && cd_resp_n == 0u && cd_resp_pos == 0u) {
            /* R522: c89 — the !cd_read_active gate blocked the heal
             * forever (fldfrz act=1 across the whole freeze while the
             * sector data already loads). Prime regardless of drive
             * state; the state-10 poll only wants its ack bytes. */
            if (da_armed) {
                da_armed = 0; da_fires++;
                cd_resp[0] = 0x02u; cd_resp[1] = 0x01u; cd_resp[2] = 0x01u;
                cd_resp_n = 3u; cd_resp_pos = 0u;
                /* R525: c92 — prime LANDED (fld2sig resp_n=3) but game never
                 * popped it (resp_pos=0 for 140s): an ack needs a DOORBELL.
                 * Arm pending so the boot-era handler-pair conversion rings the
                 * guest's CD handler -> rspop delivers the 3 bytes. */
                if (cd_pending == 0u) {
                    cd_pending = 1u;
                    r861_out("[dirack] R525: doorbell armed - handler pair will deliver the ack (rspop path)\n");
                }
                r861_out("[dirack] R521: empty-ack heal fire #%d (seek=%u FE1C=10 cmd=02) - [02 01 01] primed, game pops + advances\n",
                        da_fires, cd_seek_lba);
            } else {
                da_armed = 1;
            }
        } else {
            if (fe1c_da != 10u) da_armed = 0;
        }
    }

    /* R526 [dirack2]: c94 - R525 doorbell WORKED: the game popped the
     * Setloc ack, left state 10, issued ReadS (cmd 09) and now parks at
     * FE1C=0 with a short 1-byte answer staged (resp=1/0) and no bell.
     * Same family, next door: top the answer up to the full 3-byte ack
     * and ring the handler-pair bell so the guest pops it and advances. */
    {
        static int d9_armed; static int d9_fires;
        uint32_t fe1c_d9 = xenolift_mem_read32(0x8004FE1Cu);
        if (d9_fires < 24u && cd_seek_lba > 0u && cd_seek_lba < 150u
            && fe1c_d9 == 0u && cd_last_cmd == 0x09u
            && cd_resp_n > 0u && cd_resp_pos == 0u && cd_pending == 0u
            && cd_arm_int1_pending == 0) {
            if (d9_armed) {
                d9_armed = 0; d9_fires++;
                cd_resp[0] = 0x02u; cd_resp[1] = 0x01u; cd_resp[2] = 0x01u;
                cd_resp_n = 3u; cd_resp_pos = 0u;
                cd_pending = 1u;
                r861_out("[dirack2] R526: ReadS-ack doorbell fire #%d (seek=%u FE1C=0 cmd=09) - 3-byte ack + bell armed\n", d9_fires, cd_seek_lba);
            } else {
                d9_armed = 1;
            }
        } else {
            if (!(fe1c_d9 == 0u && cd_last_cmd == 0x09u)) d9_armed = 0;
        }
    }


    if (cd_seek_lba >= 108900u || (fld3_era && cd_pending == 0u)) {
        static uint32_t fld3_n;
        if (fld3_n < 60u) {
            r861_out("[fld2sig] UNCOND sched=%u seek=%u pend=%u arm1=%u loaded=%u data=%u/%u cmd=%02x FDF8=%u FE04=%08x FE1C=%u resp_n=%u\n",
                    cd_scheduled, cd_seek_lba, cd_pending, cd_arm_int1_pending,
                    cd_data_loaded, cd_data_pos, cd_data_n, cd_last_cmd,
                    xenolift_mem_read32(0x8004FDF8u),
                    xenolift_mem_read32(0x8004FE04u),
                    xenolift_mem_read32(0x8004FE1Cu), cd_resp_n);
                    /* R542 [fldbell2]: c108-c110 — three completion signals
                     * delivered (end-of-read FE04, read-active clear, sched
                     * clear) and the kernel STILL holds at its FE1C=10
                     * poll with our 3-byte answer primed but UNCONSUMED.
                     * In the working dance every step advanced by INT1
                     * delivery + answer pop; at the wall we armed the
                     * answer and silenced every bell (pending/sched all
                     * cleared) — nobody RANG. Re-arm the doorbell at the
                     * wall: arm pending INT1 (rate-limited) so the existing
                     * handler-pair machinery delivers it and the kernel
                     * consumes the GetStat answer. */
                    {
                        static uint32_t bell_n; static uint32_t bell_c;
                        uint32_t fe1c0 = xenolift_mem_read32(0x8004FE1Cu);
