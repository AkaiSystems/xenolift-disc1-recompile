     * the R967 wedge camera (cap 8) carry the visibility - both are
     * bounded, not cadence prints. A catch-up line prints on the first
     * clean boundary after a deferral streak. */
    { static int r969_deferred_streak; /* R969: one shared counter, no externs */
    if (g_guest_depth == 0) {
        if (r969_deferred_streak > 0) {
            r861_out("[wd] R969 t=%lds budget=%s (catch-up after %d deferred alarms mid-guest-step - [wd] prints now boundary-gated for async-signal-safety)\n",
                    (long)(run_now - g_boot_wall_t0), over_budget ? "OVER" : "ok", r969_deferred_streak);
            r969_deferred_streak = 0;
        } else {
            r861_out("[wd] t=%lds budget=%s\n", (long)(run_now - g_boot_wall_t0), over_budget ? "OVER" : "ok");
    /* R1225 (c64): ERA-INDEPENDENT SCREEN SAMPLE - on_alarm runs every
     * second on the anchor thread in EVERY era (this [wd] receipt line is
     * the proof of the always-hot path); gpu_screen_receipts() is
     * async-signal-safe (reads + write(2) only). 4s cadence; the block's
     * own >=4s gate and 12-sample cap govern the print rate. */
    {
        static time_t r1225_last;
        if (run_now - r1225_last >= 4) {
            r1225_last = run_now;
            gpu_screen_receipts();
        }
    }
        }
    } else {
        r969_deferred_streak++;
    }
    }

    /* R885 (c480, WARDEN): RE-ENTRANCY GUARD. The alarm fired while the
     * anchor was mid-guest-step (cur_fn=800415B4, r4=0x1F801803 - literally
     * inside the CD register read) and the drain machinery below ran
     * re-entrantly: defib5 pass stacked pending=3, the wait-loop
     * dispatched collector/handlers on top of the torn register state,
     * the resumed handler wild-deref'd host 0x09370D90 (SIGSEGV) and the
     * wild-write family landed one on the watcher stack (canary, same
     * tid every time). R350 banked this class long ago: never run guest
     * dispatches on top of an interrupted guest step. Enforce it
     * structurally: if the anchor is inside a dispatch (g_guest_depth>0),
     * do NOTHING heavy here - re-arm and return. The drain runs at the
     * next boundary (between dispatches - the boot loop and spin loops
     * cross boundaries constantly, so the cadence is one alarm period
     * at worst). vb_topup is safe to lose mid-step: the frame counter
     * self-drives on the game's own polling frequency (R209), not here. */
    if (g_guest_depth > 0) {
        static int r885_skips;
        if (r885_skips++ < 6)
            r861_out("[alarmguard] R885 on_alarm deferred - anchor mid-guest-step (depth=%d cur_fn=%08X) - drain runs at next dispatch boundary\n",
                    g_guest_depth, xenolift_cur_fn);
        /* R967 (b8-c76, TRAILBLAZER - WEDGE CAMERA): c76 froze 40s+ INSIDE
         * fn 80041B24 (kernel event family) after the R896 sync delivery at
         * LBA 108884 (file#6) posted its event - the alarmguard deferral
         * is correct, but "the next dispatch boundary" NEVER CAME because
         * the guest polls a condition that never flips. When the SAME
         * cur_fn defers 5+ times consecutively (10s wedged in one fn),
         * print the WEDGE STATE: the kernel event cells (the [chg] cell0-8
         * family @56788/56789/5678A/564B8/564C9/5A210/578A6/564AC/77448)
         * + the CD cells (FE1C FE04 FDF8 FDFC A22C) + flag578A6, every
         * 5th defer, capped - so the exact condition set the poll waits on
         * is named from receipts (Andriesse discipline 6: enumerate the
         * FULL contract, no one-guess-at-a-time). */
        {
            static uint32_t r967_fn; static uint32_t r967_streak; static uint32_t r967_prints;
            if (xenolift_cur_fn == r967_fn) r967_streak++; else { r967_fn = xenolift_cur_fn; r967_streak = 1; }
            g_r1194_wedge_streak = r967_streak;
            if (r967_streak >= 5u && (r967_streak % 5u) == 0u && r967_prints < 8u) {
                r967_prints++;
                g_r1195_host_read++; /* R1196: this print's own read32s are HOST reads */
                r861_out("[wedge] R967 STUCK %us in fn 0x%08X (print %u): cells c0=%02X c1=%02X c2=%02X c3=%02X c4=%02X c5=%02X c6=%02X c7=%02X c8=%02X | CD FE1C=%02X FE04=%08X FDF8=%08X FDFC=%08X A22C=%08X flag578A6=%02X | DRV act=%d loaded=%d pos=%u/%u sched=%d pend=%u cmd=%02X\n",
                        r967_streak * 2u, xenolift_cur_fn, r967_prints,
                        xenolift_mem[0x56788], xenolift_mem[0x56789], xenolift_mem[0x5678A],
                        xenolift_mem[0x564B8], xenolift_mem[0x564C9], xenolift_mem[0x5A210],
                        (uint8_t)(*(uint16_t *)(xenolift_mem + 0x578A6) & 0xFF), xenolift_mem[0x564AC],
                        (uint8_t)(xenolift_mem_read32(0x77448u) & 0xFFu),
                        (uint8_t)(xenolift_mem_read32(0x8004FE1Cu) & 0xFFu),
                        xenolift_mem_read32(0x8004FE04u), xenolift_mem_read32(0x8004FDF8u),
                        xenolift_mem_read32(0x8004FDFCu), xenolift_mem_read32(0x8006A22Cu),
                        (uint8_t)(*(uint16_t *)(xenolift_mem + 0x578A6) & 0xFF),
                        cd_read_active ? 1 : 0, cd_data_loaded ? 1 : 0,
                        (unsigned)cd_data_pos, (unsigned)cd_data_n,
                        cd_scheduled ? 1 : 0, (unsigned)cd_pending,
                        (unsigned)cd_last_cmd);
                r861_out("[wedge] R1193 regs r2=%08X r4=%08X r9=%08X r10=%08X | last-gate=%c(0x%02X) gate-calls=%u\n",
                        r[2], r[4], r[9], r[10],
                        (g_r1193_last_gate == 0xA0u) ? 'A' : (g_r1193_last_gate == 0xB0u) ? 'B' : (g_r1193_last_gate == 0xC0u) ? 'C' : '?',
                        (unsigned)(g_r1193_last_fn & 0xFFu), g_r1193_gate_n);
                /* R1195 (c484, Jos): (a) pump liveness receipts on the SAME
                 * wedge print - kick enter/exit/active + notifier
